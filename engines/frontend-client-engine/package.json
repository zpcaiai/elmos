{
  "name": "@elmos/frontend-client-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "3.3.18"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "check": "pnpm run test",
    "frt": "node dist/src/frt-cli.js",
    "miniapp": "node dist/src/miniapp-cli.js",
    "polyglot": "node dist/src/polyglot-cli.js",
    "project:generate": "node dist/src/project-cli.js",
    "frontend:formal": "node dist/src/frontend-formal-cli.js",
    "frontend:interaction-formal": "node dist/src/frontend-interaction-formal-cli.js"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@vue/compiler-sfc": "3.5.39"
  }
}
