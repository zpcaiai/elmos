{"$id":"https://schemas.elmos.ai/pdhi/v1/durable-job-state.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"active_agents":{"items":{"maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"type":"array","uniqueItems":true},"completed_effects":{"items":{"maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"type":"array","uniqueItems":true},"cost":{"pattern":"^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$","type":"string"},"job_id":{"maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"last_durable_checkpoint":{"maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"leases":{"items":{"maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"type":"array","uniqueItems":true},"pending_effects":{"items":{"maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"type":"array","uniqueItems":true},"provider_sessions":{"items":{"maxLength":256,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$","type":"string"},"type":"array","uniqueItems":true},"retries":{"additionalProperties":{"minimum":0,"type":"integer"},"type":"object"},"state":{"enum":["QUEUED","PREFLIGHT","PLANNING","EXECUTING","VERIFYING","CERTIFYING","READY_TO_RELEASE","RELEASED","PAUSED","BLOCKED","RETRYING","ROLLING_BACK","FAILED","CANCELLED","QUARANTINED"]},"tokens":{"minimum":0,"type":"integer"},"version":{"minimum":1,"type":"integer"},"wall_clock":{"minimum":0,"type":"integer"}},"required":["job_id","state","version","last_durable_checkpoint","completed_effects","pending_effects"],"title":"DurableJobState","type":"object"}
