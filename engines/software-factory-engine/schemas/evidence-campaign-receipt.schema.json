{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/software-factory/evidence-campaign-receipt/1.0",
  "title": "ELMOS deterministic local campaign receipt",
  "type": "object",
  "required": [
    "schema_version", "campaign_type", "scope", "target_artifact_digest",
    "environment_digest", "corpus_digest", "runtime_binding_digest", "manifest_digest", "status",
    "evidence_state", "case_results", "execution_digest", "replay",
    "external_states", "limitations", "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_type": {
      "enum": ["local-holdout", "provider-contract-simulation", "production-like-rehearsal"]
    },
    "scope": {"$ref": "#/$defs/scope"},
    "target_artifact_digest": {"$ref": "#/$defs/digest"},
    "environment_digest": {"$ref": "#/$defs/digest"},
    "corpus_digest": {"$ref": "#/$defs/digest"},
    "runtime_binding_digest": {"$ref": "#/$defs/digest"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "status": {"enum": ["PASSED", "BLOCKED", "FAILED"]},
    "evidence_state": {
      "enum": [
        "LOCAL_HOLDOUT_EXECUTED_SELF_ATTESTED",
        "LOCAL_PROVIDER_CONTRACT_SIMULATED_SELF_ATTESTED",
        "LOCAL_PRODUCTION_LIKE_REHEARSAL_SELF_ATTESTED"
      ]
    },
    "case_results": {"type": "array", "minItems": 1},
    "execution_digest": {"$ref": "#/$defs/digest"},
    "replay": {
      "type": "object",
      "required": ["operation", "campaign_type", "manifest_digest", "expected_execution_digest"],
      "properties": {
        "operation": {"const": "campaign-replay"},
        "campaign_type": {
          "enum": ["local-holdout", "provider-contract-simulation", "production-like-rehearsal"]
        },
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "expected_execution_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "external_states": {
      "const": {
        "archive_scripts_executed": false,
        "independent_holdout": "NOT_RUN",
        "provider_execution": "NOT_RUN",
        "production_canary": "NOT_RUN",
        "production_deployment": "NOT_RUN",
        "production_writes": "NOT_RUN",
        "independent_verification": "NOT_RUN",
        "external_certification": "NOT_CERTIFIED"
      }
    },
    "limitations": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/token"}, "uniqueItems": true
    },
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "oneOf": [
    {
      "properties": {
        "campaign_type": {"const": "local-holdout"},
        "evidence_state": {"const": "LOCAL_HOLDOUT_EXECUTED_SELF_ATTESTED"},
        "case_results": {"items": {"$ref": "#/$defs/localCaseResult"}},
        "replay": {"properties": {"campaign_type": {"const": "local-holdout"}}}
      }
    },
    {
      "properties": {
        "campaign_type": {"const": "provider-contract-simulation"},
        "evidence_state": {"const": "LOCAL_PROVIDER_CONTRACT_SIMULATED_SELF_ATTESTED"},
        "case_results": {"items": {"$ref": "#/$defs/providerCaseResult"}},
        "replay": {"properties": {"campaign_type": {"const": "provider-contract-simulation"}}}
      }
    },
    {
      "properties": {
        "campaign_type": {"const": "production-like-rehearsal"},
        "evidence_state": {"const": "LOCAL_PRODUCTION_LIKE_REHEARSAL_SELF_ATTESTED"},
        "case_results": {"items": {"$ref": "#/$defs/rehearsalCaseResult"}},
        "replay": {"properties": {"campaign_type": {"const": "production-like-rehearsal"}}}
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,191}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableToken": {"oneOf": [{"$ref": "#/$defs/token"}, {"type": "null"}]},
    "executionStatus": {"enum": ["EXECUTED", "BLOCKED", "REQUIRES_ADAPTER", "FAILED"]},
    "localCaseResult": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "case_id", "status", "case_digest", "request_digest", "observed_status",
            "observed_error_code", "observed_result_digest"
          ],
          "properties": {
            "case_id": {"$ref": "#/$defs/token"},
            "status": {"enum": ["PASSED", "FAILED"]},
            "case_digest": {"$ref": "#/$defs/digest"},
            "request_digest": {"$ref": "#/$defs/digest"},
            "observed_status": {"$ref": "#/$defs/executionStatus"},
            "observed_error_code": {"$ref": "#/$defs/nullableToken"},
            "observed_result_digest": {"$ref": "#/$defs/digest"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["case_id", "status", "overlap"],
          "properties": {
            "case_id": {"const": "corpus-separation"},
            "status": {"const": "BLOCKED"},
            "overlap": {
              "type": "array", "minItems": 1, "uniqueItems": true,
              "items": {"$ref": "#/$defs/digest"}
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "providerCaseResult": {
      "type": "object",
      "required": [
        "case_id", "status", "case_digest", "provider_request_digest",
        "provider_response_digest", "simulated_provider_state", "mapped_error",
        "bounded_runtime_state", "bounded_runtime_error", "runtime_request_digest",
        "runtime_result_digest", "skill_registry_digest", "capability_registry_digest",
        "public_method_registry_digest", "provider_calls_executed"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/token"},
        "status": {"enum": ["PASSED", "FAILED"]},
        "case_digest": {"$ref": "#/$defs/digest"},
        "provider_request_digest": {"$ref": "#/$defs/digest"},
        "provider_response_digest": {"$ref": "#/$defs/digest"},
        "simulated_provider_state": {"enum": ["SUCCEEDED", "FAILED", "UNKNOWN", "TIMEOUT"]},
        "mapped_error": {"$ref": "#/$defs/nullableToken"},
        "bounded_runtime_state": {"$ref": "#/$defs/executionStatus"},
        "bounded_runtime_error": {"$ref": "#/$defs/nullableToken"},
        "runtime_request_digest": {"$ref": "#/$defs/digest"},
        "runtime_result_digest": {"$ref": "#/$defs/digest"},
        "skill_registry_digest": {"$ref": "#/$defs/digest"},
        "capability_registry_digest": {"$ref": "#/$defs/digest"},
        "public_method_registry_digest": {"$ref": "#/$defs/digest"},
        "provider_calls_executed": {"const": false}
      },
      "additionalProperties": false
    },
    "rehearsalCaseResult": {
      "type": "object",
      "required": [
        "case_id", "status", "initial_state_digest", "canary_state_digest",
        "rollback_state_digest", "event_set_digest", "error_basis_points",
        "uncertain_outcome", "control_decision", "rollback_complete",
        "network_calls_executed", "provider_calls_executed", "production_writes_executed"
      ],
      "properties": {
        "case_id": {"const": "canary-rehearsal"},
        "status": {"enum": ["PASSED", "BLOCKED"]},
        "initial_state_digest": {"$ref": "#/$defs/digest"},
        "canary_state_digest": {"$ref": "#/$defs/digest"},
        "rollback_state_digest": {"$ref": "#/$defs/digest"},
        "event_set_digest": {"$ref": "#/$defs/digest"},
        "error_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "uncertain_outcome": {"type": "boolean"},
        "control_decision": {"enum": ["PROMOTE", "ROLLBACK"]},
        "rollback_complete": {"type": "boolean"},
        "network_calls_executed": {"const": false},
        "provider_calls_executed": {"const": false},
        "production_writes_executed": {"const": 0}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["tenant_id", "project_id", "campaign_id", "policy_revision", "source_revision"],
      "properties": {
        "tenant_id": {"$ref": "#/$defs/token"},
        "project_id": {"$ref": "#/$defs/token"},
        "campaign_id": {"$ref": "#/$defs/token"},
        "policy_revision": {"$ref": "#/$defs/token"},
        "source_revision": {"$ref": "#/$defs/token"}
      },
      "additionalProperties": false
    }
  }
}
