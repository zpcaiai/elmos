{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/proof-harness/v3/environment-authority.schema.json",
  "title": "Revocable environment authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["authorityId", "tenantId", "projectId", "environmentId", "revision", "executionEpoch", "fencingGeneration", "capabilities", "networkMode", "issuedAt", "expiresAt", "revoked"],
  "properties": {
    "authorityId": {"type": "string", "minLength": 1, "maxLength": 160},
    "tenantId": {"type": "string", "minLength": 1, "maxLength": 160},
    "projectId": {"type": "string", "minLength": 1, "maxLength": 160},
    "environmentId": {"type": "string", "minLength": 1, "maxLength": 160},
    "revision": {"$ref": "#/$defs/digest"},
    "executionEpoch": {"type": "integer", "minimum": 1},
    "fencingGeneration": {"type": "integer", "minimum": 1},
    "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}},
    "networkMode": {"enum": ["deny", "setup-only", "allowlist"]},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "revoked": {"type": "boolean"},
    "revocationId": {"type": ["string", "null"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "capability": {"type": "object", "additionalProperties": false, "required": ["name", "operations", "pathPrefixes", "parameterConstraints"], "properties": {"name": {"type": "string", "minLength": 1}, "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "pathPrefixes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}}, "parameterConstraints": {"type": "object"}}}
  }
}
