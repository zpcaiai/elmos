{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/proof-harness/v3/adapter-contract.schema.json",
  "title": "Least-privileged harness or verifier adapter contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["adapterId", "version", "kind", "capabilities", "requiredAuthority", "lifecycle", "losses", "implementationState", "externalEvidence"],
  "properties": {
    "adapterId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
    "version": {"type": "string", "minLength": 1},
    "kind": {"enum": ["harness", "verifier", "compiler-frontend", "provider"]},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requiredAuthority": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "executableDigest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "lifecycle": {"type": "object", "additionalProperties": false, "required": ["timeout", "cancellation", "replay", "idempotency", "reconciliation"], "properties": {"timeout": {"type": "boolean"}, "cancellation": {"type": "boolean"}, "replay": {"type": "boolean"}, "idempotency": {"type": "boolean"}, "reconciliation": {"type": "boolean"}}},
    "losses": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "implementationState": {"enum": ["LOCAL", "PARTIAL", "ADAPTER_REQUIRED", "PLAN"]},
    "externalEvidence": {"enum": ["NOT_RUN", "VERIFIED", "BLOCKED", "FAILED", "UNKNOWN"]}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
