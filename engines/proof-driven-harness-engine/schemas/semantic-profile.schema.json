{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/proof-harness/v3/semantic-profile.schema.json",
  "title": "Versioned language or framework semantic profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileId", "kind", "name", "version", "frontend", "semanticDomains", "unsupportedPolicy", "profileDigest", "externalEvidence"],
  "properties": {
    "profileId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
    "kind": {"enum": ["language", "framework"]},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "frontend": {"type": "object", "additionalProperties": false, "required": ["syntax", "semantic", "authoritative"], "properties": {"syntax": {"type": "string", "minLength": 1}, "semantic": {"type": "string", "minLength": 1}, "authoritative": {"type": "boolean"}}},
    "semanticDomains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["types", "numeric", "nullability", "control-flow", "data-flow", "effects", "exceptions", "resources", "concurrency", "memory-model", "protocol", "data-transaction", "framework", "deployment"]}},
    "dynamicBoundaries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unsupportedPolicy": {"enum": ["explicit-gap", "block", "runtime-monitor"]},
    "profileDigest": {"$ref": "#/$defs/digest"},
    "externalEvidence": {"enum": ["NOT_RUN", "VERIFIED", "BLOCKED", "FAILED", "UNKNOWN"]}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
