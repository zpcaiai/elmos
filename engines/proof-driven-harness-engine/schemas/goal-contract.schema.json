{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/proof-harness/v3/goal-contract.schema.json",
  "title": "Tenant-scoped goal contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["goalId", "tenantId", "projectId", "objective", "requirements", "acceptanceScenarios", "assumptions", "revisionSetId", "createdAt"],
  "properties": {
    "goalId": {"$ref": "#/$defs/id"},
    "tenantId": {"$ref": "#/$defs/id"},
    "projectId": {"$ref": "#/$defs/id"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 8192},
    "requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement"}},
    "acceptanceScenarios": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
    "revisionSetId": {"$ref": "#/$defs/id"},
    "budget": {"type": "object", "additionalProperties": false, "properties": {"wallClockSeconds": {"type": "integer", "minimum": 1}, "costMicrounits": {"type": "integer", "minimum": 0}}},
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,159}$"},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["id", "text", "criticality"], "properties": {"id": {"$ref": "#/$defs/id"}, "text": {"type": "string", "minLength": 1, "maxLength": 8192}, "criticality": {"enum": ["critical", "high", "medium", "low"]}}}
  }
}
