{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/proof-harness/v3/domain-pack.schema.json",
  "title": "Directional proof-driven domain pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "businessLine", "scope", "sourceProfiles", "targetProfiles", "kernelSequence", "proofRequirements", "minimumCertification", "directional", "certification"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"},
    "version": {"type": "string", "minLength": 1},
    "businessLine": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "sourceProfiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "targetProfiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "kernelSequence": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^elmos-[a-z0-9-]+$"}},
    "proofRequirements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["templateId", "family", "severity", "requiredEvidence", "unknownPolicy", "waiverAllowed"], "properties": {"templateId": {"type": "string", "minLength": 1}, "family": {"type": "string", "minLength": 1}, "severity": {"enum": ["critical", "high", "medium", "low"]}, "requiredEvidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "unknownPolicy": {"enum": ["BLOCK", "REVIEW"]}, "waiverAllowed": {"type": "boolean"}}}},
    "minimumCertification": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "directional": {"const": true},
    "certification": {"enum": ["NOT_CERTIFIED", "READY_FOR_EXTERNAL_GATE", "CERTIFIED"]}
  }
}
