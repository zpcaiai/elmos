  "capabilities": [
    {
      "id": "typed-query-ast",
      "scope": "SELECT, CTE, joins, set operations, aggregates, windows, ordering and pagination",
      "state": "SYNTAX_EXPERIMENTAL"
    },
    {
      "id": "typed-dml-ast",
      "scope": "INSERT, UPDATE, DELETE and MERGE when the source and target emitters report no unsupported semantics",
      "state": "SYNTAX_EXPERIMENTAL"
    },
    {
      "id": "typed-ddl-ast",
      "scope": "CREATE, ALTER and DROP syntax only; schema, type, constraint and transaction equivalence require a route pack",
      "state": "CONDITIONAL"
    },
    {
      "id": "stored-procedure-and-trigger",
      "scope": "PL/SQL, T-SQL, PL/pgSQL, MySQL routines and triggers",
      "state": "BLOCKED",
      "reason": "Procedural control flow and transaction semantics require the Batch 31 routine migration pipeline."
    },
    {
      "id": "optimizer-hints-and-plan-shape",
      "scope": "Vendor hints, plan guides, optimizer directives and physical access paths",
      "state": "BLOCKED",
      "reason": "Syntax emission cannot prove equivalent optimizer behavior."
    },
    {
      "id": "runtime-result-equivalence",
      "scope": "Row values, types, cardinality, duplicate behavior, ordering, errors and locks",
      "state": "NOT_RUN"
    }
  ],
  "knownConditionalPairs": [
    {
      "sourceProfile": "mysql-8.4.10-lts",
      "targetProfile": "sqlite-3.53.3",
      "feature": "GROUP_CONCAT_ORDER_BY",
      "state": "BLOCKED",
      "reason": "SQLite GROUP_CONCAT has no equivalent aggregate-local ORDER BY syntax."
    },
    {
      "sourceProfile": "oracle-26ai-ee",
      "targetProfile": "mysql-8.4.10-lts",
      "feature": "ORACLE_TRUNC_DATETIME_FORMAT",
      "state": "BLOCKED",
      "reason": "The exact target emitter reports unsupported Oracle datetime TRUNC format semantics."
    }
  ],
  "extensions": [
    {
      "id": "mariadb-11.8.8",
      "state": "COMPATIBILITY_ADAPTER_REQUIRED",
      "reason": "The current parser backend aliases MariaDB to MySQL and cannot prove MariaDB-specific semantics."
    },
    {
      "id": "ibm-db2-11.5.9",
      "state": "DETECTED_ONLY",
      "reason": "No exact DB2 grammar/emitter is configured."
    },
