{
  "name": "@elmos/component-dialect-engine",
  "version": "0.1.0",
  "description": "Certified-subset UI component translation (certified-component-v1) across React, TypeScript, Vue 3, Vue 2-compatible SFCs, Angular, Svelte, React Native, WeChat Mini Program, HarmonyOS ArkUI and Flutter, built on maintained compiler frontends rather than string templates. Fails closed outside the certified subset.",
  "private": true,
  "bin": {
    "elmos-component-dialect": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "miniapp-worker": "node dist/miniapp-worker.js",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "typescript": "5.9.2",
    "vue": "3.5.42",
    "@vue/compiler-dom": "3.5.42",
    "@vue/compiler-sfc": "3.5.42",
    "@vue/server-renderer": "3.5.42",
    "svelte": "5.56.10",
    "@angular/compiler": "22.1.4",
    "@wxml/parser": "0.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "jest": "29.7.0",
    "@types/jest": "29.5.14",
    "ts-jest": "29.2.5"
  },
  "overrides": {
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
    "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
    "nanoid@<3.3.18": "3.3.18",
    "serialize-javascript@<7.0.5": "7.0.5"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "nanoid@<3.3.18": "3.3.18",
      "serialize-javascript@<7.0.5": "7.0.5"
    }
  }
}
