{
  "name": "@elmos/component-dialect-engine",
  "version": "0.1.0",
  "description": "Certified-subset UI component translation (certified-component-v1) across React, TypeScript, Vue 3, Vue 2, Angular, Svelte, React Native, WeChat Mini Program, HarmonyOS ArkUI and Flutter, built on each framework's real compiler frontend rather than string templates. Fails closed outside the certified subset.",
  "private": true,
  "bin": {
    "elmos-component-dialect": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "miniapp-worker": "node dist/miniapp-worker.js",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "typescript": "5.9.2",
    "vue": "3.5.13",
    "@vue/compiler-sfc": "3.5.13",
    "@vue/server-renderer": "3.5.13",
    "vue-template-compiler": "2.7.16",
    "vue-server-renderer": "2.7.16",
    "vue2": "npm:vue@2.7.16",
    "svelte": "5.14.5",
    "@angular/compiler": "18.2.13",
    "@wxml/parser": "0.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "jest": "29.7.0",
    "@types/jest": "29.5.14",
    "ts-jest": "29.2.5"
  }
}
