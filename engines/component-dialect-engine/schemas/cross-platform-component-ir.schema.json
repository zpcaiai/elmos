{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.local/schemas/cross-platform-component-ir.schema.json",
  "title": "ELMOS Cross Platform Component IR",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "componentId",
    "source",
    "sourceTrace",
    "renderTree",
    "state",
    "interactions",
    "collections",
    "slots",
    "platformSemantics",
    "styling",
    "accessibility",
    "obligations",
    "targetAdapters",
    "canonical",
    "irDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "elmos.cross-platform-component-ir" },
    "componentId": { "type": "string", "minLength": 1 },
    "source": { "type": "object", "required": ["framework", "file", "componentName", "parserProfile"] },
    "sourceTrace": { "type": "object", "required": ["sourceFile", "componentName", "canonicalPath", "sourceRange", "traceStatus"] },
    "renderTree": { "type": "object", "required": ["kind"] },
    "state": { "type": "object", "required": ["variables", "transitions", "effects", "cleanupObligations"] },
    "interactions": { "type": "array" },
    "collections": { "type": "array" },
    "slots": { "type": "array" },
    "platformSemantics": { "type": "array" },
    "styling": { "type": "object", "required": ["source", "tokens", "targetPolicy"] },
    "accessibility": { "type": "object", "required": ["roles", "attributes", "focusable", "keyboardEvents", "localization"] },
    "obligations": { "type": "array" },
    "targetAdapters": { "type": "object", "minProperties": 1 },
    "canonical": { "type": "object", "required": ["name", "props", "state", "root"] },
    "irDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
