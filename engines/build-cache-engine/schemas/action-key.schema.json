{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/action-key.schema.json",
  "title": "ELMOS ActionKey Document",
  "type": "object",
  "required": [
    "schema_version",
    "stage_id",
    "stage_version",
    "stage_contract_schema",
    "inputs",
    "target",
    "toolchain",
    "action_key"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "stage_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_version": {
      "type": "string",
      "minLength": 1
    },
    "stage_contract_schema": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "object"
    },
    "target": {
      "type": "object"
    },
    "toolchain": {
      "type": "object"
    },
    "rule_pack_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model_profile": {
      "type": [
        "object",
        "null"
      ]
    },
    "declared_environment": {
      "type": "object"
    },
    "feature_flags": {
      "type": "object"
    },
    "action_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "explanation": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
