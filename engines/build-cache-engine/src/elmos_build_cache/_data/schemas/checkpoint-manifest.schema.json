{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/checkpoint-manifest.schema.json",
  "title": "ELMOS Checkpoint Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "checkpoint_id",
    "run_id",
    "node_id",
    "attempt",
    "sequence",
    "source_snapshot",
    "action_key",
    "artifacts",
    "journal_sequence"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "checkpoint_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "node_id": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "source_snapshot": {
      "type": "string"
    },
    "action_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "staged_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "completed_partitions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "side_effect_receipts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "journal_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "resume_cursor": {},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compatibility": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
