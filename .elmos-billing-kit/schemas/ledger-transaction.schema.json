{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/ledger-transaction.v1.json",
  "title": "Elmos Ledger Transaction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transaction_id",
    "tenant_id",
    "operation_type",
    "idempotency_key",
    "correlation_id",
    "unit",
    "entries"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "pattern": "^ltx_[A-Za-z0-9_-]+$"
    },
    "tenant_id": {
      "type": "string"
    },
    "operation_type": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": [
        "object",
        "null"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "account_id",
          "side",
          "amount_units"
        ],
        "properties": {
          "entry_id": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "side": {
            "type": "string",
            "enum": [
              "debit",
              "credit"
            ]
          },
          "amount_units": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
