UV ?= uv
BATCH39_PYTHON ?= $(UV) run --quiet --with jsonschema --with pyyaml python
.PHONY: batch39-check batch39-scaffold batch39-gate batch39-gaps batch39-score batch39-manifest batch39-request
batch39-check:
	$(BATCH39_PYTHON) scripts/mature_product_toolkit.py validate --batch 39
	$(BATCH39_PYTHON) -m unittest discover -s tests/batch39 -p 'test_*.py'
batch39-scaffold:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(OWNER)" || (echo "OWNER=<owner> required" && exit 2)
	$(BATCH39_PYTHON) scripts/mature_product_toolkit.py scaffold --batch 39 --key $(PACK) --owner $(OWNER)
batch39-gate:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(TRUST_STORE)" || (echo "TRUST_STORE=<external-trust-store.json> required" && exit 2)
	$(BATCH39_PYTHON) scripts/mature_product_toolkit.py gate --batch 39 mature-product-packs/batch39/$(PACK) --trust-store $(TRUST_STORE)
batch39-gaps:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH39_PYTHON) scripts/mature_product_toolkit.py gaps --batch 39 mature-product-packs/batch39/$(PACK)
batch39-score:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH39_PYTHON) scripts/mature_product_toolkit.py score --batch 39 mature-product-packs/batch39/$(PACK)/candidates.json $(if $(WRITE),--write,)
batch39-manifest:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(EXECUTOR)" || (echo "EXECUTOR=<identity> required" && exit 2)
	@test -n "$(VERIFIER)" || (echo "VERIFIER=<independent identity> required" && exit 2)
	@test -n "$(AUTHORIZATION)" || (echo "AUTHORIZATION=<ref> required" && exit 2)
	@test -n "$(REPLAY)" || (echo "REPLAY=<command> required" && exit 2)
	@test -n "$(STARTED_AT)" || (echo "STARTED_AT=<ISO-8601> required" && exit 2)
	@test -n "$(FINISHED_AT)" || (echo "FINISHED_AT=<ISO-8601> required" && exit 2)
	$(BATCH39_PYTHON) scripts/mature_product_toolkit.py manifest --batch 39 mature-product-packs/batch39/$(PACK) \
		--artifact mature-product-packs/batch39/$(PACK)/$(ARTIFACT) \
		--environment mature-product-packs/batch39/$(PACK)/$(ENVIRONMENT) \
		--executor $(EXECUTOR) --verifier $(VERIFIER) --authorization $(AUTHORIZATION) \
		--replay-command "$(REPLAY)" --started-at $(STARTED_AT) --finished-at $(FINISHED_AT) \
		--attest-verifier-independent --attest-corpus-independence
batch39-request:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(KEY_ID)" || (echo "KEY_ID=<certification key id> required" && exit 2)
	$(BATCH39_PYTHON) scripts/mature_product_toolkit.py request --batch 39 mature-product-packs/batch39/$(PACK) --key-id $(KEY_ID)
