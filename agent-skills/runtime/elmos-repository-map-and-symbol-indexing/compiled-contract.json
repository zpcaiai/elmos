    ],
    "name": "elmos-repository-map-and-symbol-indexing",
    "objective": "从多语言项目生成可增量、可查询、带源码范围的 Repository Map，为代码理解、生成、转换、测试和上下文装载提供结构事实。",
    "ordinal": 48,
    "outputs": [
      "RepositoryMap",
      "符号与依赖索引",
      "影响/测试映射",
      "解析覆盖报告"
    ],
    "responsibilities": [
      "按项目画像选择解析器、LSP、tree-sitter、编译器前端或安全静态分析器，不执行项目安装脚本。",
      "索引模块、包/命名空间、类型、函数、字段、路由、API、数据实体、消息主题、配置键和测试。",
      "建立 import、调用、继承、实现、读写、API、数据库、消息、构建和测试覆盖关系。",
      "为每个符号保留路径、字节/行范围、签名、可见性、语言、版本、哈希和解析置信度。",
      "识别动态关系、反射、代码生成和框架约定，无法确定时保留候选与置信度。",
      "根据 manifest diff 只重建变更符号及受影响边，并进行孤儿和一致性检查。",
      "为下游提供符号搜索、调用链、影响分析、入口点、测试映射和图导出。",
      "监控索引覆盖、陈旧节点、解析失败和跨语言边准确率。"
    ],
    "schema_version": "1.0.0",
    "title": "仓库地图与符号索引"
  },
