{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/run-manifest.schema.json",
  "title": "ELMOS Run Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "tenant_id",
    "project_id",
    "run_id",
    "source_snapshot",
    "pipeline_version",
    "status",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "source_snapshot": {
      "type": "string"
    },
    "pipeline_version": {
      "type": "string"
    },
    "source_profile": {
      "type": "object"
    },
    "target_profile": {
      "type": "object"
    },
    "status": {
      "enum": [
        "PENDING",
        "RUNNING",
        "PAUSED",
        "SUCCEEDED",
        "FAILED",
        "CANCELED",
        "RECOVERING",
        "STALE"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "published_tree_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_bundle_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
