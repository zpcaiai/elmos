{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/cache/v1.2/environment-snapshot.schema.json",
  "title": "Environment Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "snapshot_key",
    "platform",
    "layers",
    "trust_namespace",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "snapshot_id": {
      "type": "string"
    },
    "snapshot_key": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "platform": {
      "type": "object",
      "required": [
        "os",
        "arch"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "libc": {
          "type": "string"
        }
      }
    },
    "base_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "setup_script_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "maintenance_script_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lockfile_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "toolchain_digests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "approved_environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "secret_reference_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "layer_type",
          "digest",
          "size_bytes"
        ],
        "properties": {
          "layer_type": {
            "enum": [
              "BASE",
              "TOOLCHAIN",
              "DEPENDENCIES",
              "INDEX",
              "PROJECT_WARM_STATE"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "trust_namespace": {
      "type": "string"
    },
    "status": {
      "enum": [
        "BUILDING",
        "SEALED",
        "AVAILABLE",
        "QUARANTINED",
        "REVOKED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
