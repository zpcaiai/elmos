{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/cache/v1.2/prompt-prefix-manifest.schema.json",
  "title": "Prompt Prefix Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "provider_namespace",
    "compatibility_group",
    "segments",
    "stable_prefix_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.2.0"
    },
    "manifest_id": {
      "type": "string"
    },
    "provider_namespace": {
      "type": "string"
    },
    "compatibility_group": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "effort": {
      "type": "string"
    },
    "tool_schema_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stable_prefix_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "estimated_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "breakpoint_after_segment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "stability_class",
          "digest",
          "byte_length"
        ],
        "properties": {
          "segment_id": {
            "type": "string"
          },
          "schema_version": {
            "type": "string"
          },
          "stability_class": {
            "enum": [
              "GLOBAL_STABLE",
              "PROJECT_STABLE",
              "SESSION_APPEND_ONLY",
              "TURN_VOLATILE"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "estimated_tokens": {
            "type": "integer",
            "minimum": 0
          },
          "sensitivity": {
            "enum": [
              "PUBLIC",
              "INTERNAL",
              "CONFIDENTIAL",
              "SECRET_REF_ONLY"
            ]
          }
        }
      }
    },
    "change_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
