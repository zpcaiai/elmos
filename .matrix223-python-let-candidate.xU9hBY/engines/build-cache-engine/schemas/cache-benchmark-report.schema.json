{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/cache-benchmark-report.schema.json",
  "title": "ELMOS Cache Benchmark Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "trace_corpus_digest",
    "capacity_bytes",
    "baseline",
    "candidates",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "report_id": {
      "type": "string"
    },
    "trace_corpus_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capacity_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "baseline": {
      "type": "string"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "policy",
          "metrics"
        ],
        "properties": {
          "policy": {
            "type": "string"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "configuration": {
            "type": "object"
          }
        }
      }
    },
    "cohorts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gates": {
      "type": "object",
      "required": [
        "correctness_failures",
        "selected"
      ],
      "properties": {
        "correctness_failures": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": [
            "string",
            "null"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "workload_features": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "selector_recommendation": {
      "type": "object",
      "required": [
        "policy",
        "confidence",
        "reason_codes"
      ],
      "properties": {
        "policy": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
