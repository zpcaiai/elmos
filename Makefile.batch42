UV ?= uv
BATCH42_PYTHON ?= $(UV) run --quiet --with jsonschema --with pyyaml python
.PHONY: batch42-check batch42-scaffold batch42-gate batch42-gaps batch42-score batch42-manifest batch42-request
batch42-check:
	$(BATCH42_PYTHON) scripts/mature_product_toolkit.py validate --batch 42
	$(BATCH42_PYTHON) -m unittest discover -s tests/batch42 -p 'test_*.py'
batch42-scaffold:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(OWNER)" || (echo "OWNER=<owner> required" && exit 2)
	$(BATCH42_PYTHON) scripts/mature_product_toolkit.py scaffold --batch 42 --key $(PACK) --owner $(OWNER)
batch42-gate:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(TRUST_STORE)" || (echo "TRUST_STORE=<external-trust-store.json> required" && exit 2)
	$(BATCH42_PYTHON) scripts/mature_product_toolkit.py gate --batch 42 mature-product-packs/batch42/$(PACK) --trust-store $(TRUST_STORE)
batch42-gaps:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH42_PYTHON) scripts/mature_product_toolkit.py gaps --batch 42 mature-product-packs/batch42/$(PACK)
batch42-score:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH42_PYTHON) scripts/mature_product_toolkit.py score --batch 42 mature-product-packs/batch42/$(PACK)/candidates.json $(if $(WRITE),--write,)
batch42-manifest:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(EXECUTOR)" || (echo "EXECUTOR=<identity> required" && exit 2)
	@test -n "$(VERIFIER)" || (echo "VERIFIER=<independent identity> required" && exit 2)
	@test -n "$(AUTHORIZATION)" || (echo "AUTHORIZATION=<ref> required" && exit 2)
	@test -n "$(REPLAY)" || (echo "REPLAY=<command> required" && exit 2)
	@test -n "$(STARTED_AT)" || (echo "STARTED_AT=<ISO-8601> required" && exit 2)
	@test -n "$(FINISHED_AT)" || (echo "FINISHED_AT=<ISO-8601> required" && exit 2)
	$(BATCH42_PYTHON) scripts/mature_product_toolkit.py manifest --batch 42 mature-product-packs/batch42/$(PACK) \
		--artifact mature-product-packs/batch42/$(PACK)/$(ARTIFACT) \
		--environment mature-product-packs/batch42/$(PACK)/$(ENVIRONMENT) \
		--executor $(EXECUTOR) --verifier $(VERIFIER) --authorization $(AUTHORIZATION) \
		--replay-command "$(REPLAY)" --started-at $(STARTED_AT) --finished-at $(FINISHED_AT) \
		--attest-verifier-independent --attest-corpus-independence
batch42-request:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(KEY_ID)" || (echo "KEY_ID=<certification key id> required" && exit 2)
	$(BATCH42_PYTHON) scripts/mature_product_toolkit.py request --batch 42 mature-product-packs/batch42/$(PACK) --key-id $(KEY_ID)
