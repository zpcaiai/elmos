UV ?= uv
BATCH38_PYTHON ?= $(UV) run --quiet --with jsonschema --with pyyaml python
.PHONY: batch38-check batch38-scaffold batch38-gate batch38-gaps batch38-score batch38-manifest batch38-request
batch38-check:
	$(BATCH38_PYTHON) scripts/mature_product_toolkit.py validate --batch 38
	$(BATCH38_PYTHON) -m unittest discover -s tests/batch38 -p 'test_*.py'
batch38-scaffold:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(OWNER)" || (echo "OWNER=<owner> required" && exit 2)
	$(BATCH38_PYTHON) scripts/mature_product_toolkit.py scaffold --batch 38 --key $(PACK) --owner $(OWNER)
batch38-gate:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(TRUST_STORE)" || (echo "TRUST_STORE=<external-trust-store.json> required" && exit 2)
	$(BATCH38_PYTHON) scripts/mature_product_toolkit.py gate --batch 38 mature-product-packs/batch38/$(PACK) --trust-store $(TRUST_STORE)
batch38-gaps:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH38_PYTHON) scripts/mature_product_toolkit.py gaps --batch 38 mature-product-packs/batch38/$(PACK)
batch38-score:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH38_PYTHON) scripts/mature_product_toolkit.py score --batch 38 mature-product-packs/batch38/$(PACK)/candidates.json $(if $(WRITE),--write,)
batch38-manifest:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(EXECUTOR)" || (echo "EXECUTOR=<identity> required" && exit 2)
	@test -n "$(VERIFIER)" || (echo "VERIFIER=<independent identity> required" && exit 2)
	@test -n "$(AUTHORIZATION)" || (echo "AUTHORIZATION=<ref> required" && exit 2)
	@test -n "$(REPLAY)" || (echo "REPLAY=<command> required" && exit 2)
	@test -n "$(STARTED_AT)" || (echo "STARTED_AT=<ISO-8601> required" && exit 2)
	@test -n "$(FINISHED_AT)" || (echo "FINISHED_AT=<ISO-8601> required" && exit 2)
	$(BATCH38_PYTHON) scripts/mature_product_toolkit.py manifest --batch 38 mature-product-packs/batch38/$(PACK) \
		--artifact mature-product-packs/batch38/$(PACK)/$(ARTIFACT) \
		--environment mature-product-packs/batch38/$(PACK)/$(ENVIRONMENT) \
		--executor $(EXECUTOR) --verifier $(VERIFIER) --authorization $(AUTHORIZATION) \
		--replay-command "$(REPLAY)" --started-at $(STARTED_AT) --finished-at $(FINISHED_AT) \
		--attest-verifier-independent --attest-corpus-independence
batch38-request:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(KEY_ID)" || (echo "KEY_ID=<certification key id> required" && exit 2)
	$(BATCH38_PYTHON) scripts/mature_product_toolkit.py request --batch 38 mature-product-packs/batch38/$(PACK) --key-id $(KEY_ID)
