UV ?= uv
BATCH41_PYTHON ?= $(UV) run --quiet --with jsonschema --with pyyaml python
.PHONY: batch41-check batch41-scaffold batch41-gate batch41-gaps batch41-score batch41-manifest batch41-request
batch41-check:
	$(BATCH41_PYTHON) scripts/mature_product_toolkit.py validate --batch 41
	$(BATCH41_PYTHON) -m unittest discover -s tests/batch41 -p 'test_*.py'
batch41-scaffold:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(OWNER)" || (echo "OWNER=<owner> required" && exit 2)
	$(BATCH41_PYTHON) scripts/mature_product_toolkit.py scaffold --batch 41 --key $(PACK) --owner $(OWNER)
batch41-gate:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(TRUST_STORE)" || (echo "TRUST_STORE=<external-trust-store.json> required" && exit 2)
	$(BATCH41_PYTHON) scripts/mature_product_toolkit.py gate --batch 41 mature-product-packs/batch41/$(PACK) --trust-store $(TRUST_STORE)
batch41-gaps:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH41_PYTHON) scripts/mature_product_toolkit.py gaps --batch 41 mature-product-packs/batch41/$(PACK)
batch41-score:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH41_PYTHON) scripts/mature_product_toolkit.py score --batch 41 mature-product-packs/batch41/$(PACK)/candidates.json $(if $(WRITE),--write,)
batch41-manifest:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(EXECUTOR)" || (echo "EXECUTOR=<identity> required" && exit 2)
	@test -n "$(VERIFIER)" || (echo "VERIFIER=<independent identity> required" && exit 2)
	@test -n "$(AUTHORIZATION)" || (echo "AUTHORIZATION=<ref> required" && exit 2)
	@test -n "$(REPLAY)" || (echo "REPLAY=<command> required" && exit 2)
	@test -n "$(STARTED_AT)" || (echo "STARTED_AT=<ISO-8601> required" && exit 2)
	@test -n "$(FINISHED_AT)" || (echo "FINISHED_AT=<ISO-8601> required" && exit 2)
	$(BATCH41_PYTHON) scripts/mature_product_toolkit.py manifest --batch 41 mature-product-packs/batch41/$(PACK) \
		--artifact mature-product-packs/batch41/$(PACK)/$(ARTIFACT) \
		--environment mature-product-packs/batch41/$(PACK)/$(ENVIRONMENT) \
		--executor $(EXECUTOR) --verifier $(VERIFIER) --authorization $(AUTHORIZATION) \
		--replay-command "$(REPLAY)" --started-at $(STARTED_AT) --finished-at $(FINISHED_AT) \
		--attest-verifier-independent --attest-corpus-independence
batch41-request:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(KEY_ID)" || (echo "KEY_ID=<certification key id> required" && exit 2)
	$(BATCH41_PYTHON) scripts/mature_product_toolkit.py request --batch 41 mature-product-packs/batch41/$(PACK) --key-id $(KEY_ID)
