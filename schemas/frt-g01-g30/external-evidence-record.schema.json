{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.io/frt-g01-g30/external-evidence-record.v1.schema.json",
  "title": "FRT independently verified external evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "pack_key", "check_id", "run_id", "authorization_ref", "profile_sha256", "package_manifest_sha256", "source_tree_sha256", "status", "started_at", "completed_at", "executor", "verifier", "approver", "environment", "metrics", "findings", "claims", "evidence", "signatures"],
  "properties": {
    "schema_version": { "const": 1 },
    "record_type": { "const": "FRT_EXTERNAL_EVIDENCE" },
    "pack_key": { "const": "frt-g01-g30-platform" },
    "check_id": { "$ref": "#/$defs/checkId" },
    "run_id": { "type": "string", "minLength": 1 },
    "authorization_ref": { "$ref": "#/$defs/evidenceRef" },
    "profile_sha256": { "$ref": "#/$defs/digest" },
    "package_manifest_sha256": { "$ref": "#/$defs/digest" },
    "source_tree_sha256": { "$ref": "#/$defs/digest" },
    "status": { "const": "PASSED" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "executor": { "$ref": "#/$defs/actor" },
    "verifier": { "$ref": "#/$defs/actor" },
    "approver": { "$ref": "#/$defs/actor" },
    "environment": { "type": "object", "minProperties": 1 },
    "metrics": { "type": "object" },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low", "unresolved"],
      "properties": {
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 }
      }
    },
    "claims": { "type": "object" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/roleEvidenceRef" }
    },
    "signatures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/signature" }
    }
  },
  "$defs": {
    "checkId": {
      "enum": ["real_source_target_builds", "device_matrix", "independent_holdout", "formal_proof", "performance", "chaos_dr", "penetration_test", "production_observation", "customer_acceptance"]
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "organization_id"],
      "properties": {
        "principal_id": { "type": "string", "minLength": 1 },
        "organization_id": { "type": "string", "minLength": 1 }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "roleEvidenceRef": {
      "allOf": [
        { "$ref": "#/$defs/evidenceRef" },
        {
          "type": "object",
          "required": ["role", "media_type", "classification", "redacted", "contains_personal_data"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "media_type": { "type": "string", "minLength": 1 },
            "classification": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL"] },
            "redacted": { "type": "boolean" },
            "contains_personal_data": { "const": false }
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "role", "signed_at", "payload_sha256", "signature_base64"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["EXECUTOR", "VERIFIER", "APPROVER"] },
        "signed_at": { "type": "string", "format": "date-time" },
        "payload_sha256": { "$ref": "#/$defs/digest" },
        "signature_base64": { "type": "string", "minLength": 1 }
      }
    }
  }
}
