{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.io/frt-g01-g30/external-qualification-local-execution.v1.schema.json",
  "title": "FRT external qualification local adapter execution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "generated_at", "plan_sha256", "preflight_sha256", "case_count", "cases", "code_contract_counts", "local_execution_counts", "external_state_counts", "production_operation_authorized", "production_certification", "note"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "FRT_EXTERNAL_QUALIFICATION_LOCAL_EXECUTION" },
    "generated_at": { "type": "string", "format": "date-time" },
    "plan_sha256": { "$ref": "#/$defs/digest" },
    "preflight_sha256": { "$ref": "#/$defs/digest" },
    "case_count": { "const": 15 },
    "cases": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/case" }
    },
    "code_contract_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["PASSED_LOCAL_TOOLING"],
      "properties": { "PASSED_LOCAL_TOOLING": { "const": 15 } }
    },
    "local_execution_counts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "BLOCKED_TOOLCHAIN": { "type": "integer", "minimum": 1, "maximum": 4 },
        "READY_FOR_LOCAL_EXECUTION": { "type": "integer", "minimum": 1, "maximum": 4 },
        "REQUIRES_EXTERNAL_AUTHORITY": { "const": 11 }
      }
    },
    "external_state_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["NOT_RUN"],
      "properties": { "NOT_RUN": { "const": 15 } }
    },
    "production_operation_authorized": { "const": false },
    "production_certification": { "const": "NOT_CERTIFIED" },
    "note": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "state", "detail"],
      "properties": {
        "observation_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "state": { "enum": ["PASSED", "BLOCKED", "NOT_APPLICABLE"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "adapter_id", "code_contract_state", "local_execution_state", "observations", "blockers", "external_state", "production_operation_authorized", "certification"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^FRT-EXT-[0-9]{3}-[A-Z0-9-]+$" },
        "adapter_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "code_contract_state": { "const": "PASSED_LOCAL_TOOLING" },
        "local_execution_state": { "enum": ["BLOCKED_TOOLCHAIN", "READY_FOR_LOCAL_EXECUTION", "REQUIRES_EXTERNAL_AUTHORITY"] },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/observation" }
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "external_state": { "const": "NOT_RUN" },
        "production_operation_authorized": { "const": false },
        "certification": { "const": "NOT_CERTIFIED" }
      }
    }
  }
}
