{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.io/frt-g01-g30/external-qualification-plan.v1.schema.json",
  "title": "FRT external qualification plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "pack_key", "profile_ref", "quality_matrix_ref", "package_manifest_sha256", "source_tree_sha256", "case_count", "cases", "boundaries"],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "const": "frt-g01-g30-external-qualification-v1" },
    "pack_key": { "const": "frt-g01-g30-platform" },
    "profile_ref": { "$ref": "#/$defs/reference" },
    "quality_matrix_ref": { "$ref": "#/$defs/reference" },
    "package_manifest_sha256": { "$ref": "#/$defs/digest" },
    "source_tree_sha256": { "$ref": "#/$defs/digest" },
    "case_count": { "const": 15 },
    "cases": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/case" }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_harness_is_external_evidence", "templates_are_evidence", "preflight_can_upgrade_external_state", "production_operation_authorized", "production_certification"],
      "properties": {
        "local_harness_is_external_evidence": { "const": false },
        "templates_are_evidence": { "const": false },
        "preflight_can_upgrade_external_state": { "const": false },
        "production_operation_authorized": { "const": false },
        "production_certification": { "const": "NOT_CERTIFIED" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "title", "category", "external_check_id", "adapter_id", "execution_authority", "exact_target", "required_tools", "required_environment", "local_assertions", "required_evidence_roles", "required_metrics", "required_claims", "external_state", "production_operation_authorized", "certification"],
      "properties": {
        "case_id": { "type": "string", "pattern": "^FRT-EXT-[0-9]{3}-[A-Z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "category": { "enum": ["BROWSER", "TOOLCHAIN", "VISUAL", "ASSISTIVE_TECHNOLOGY", "PHYSICAL_DEVICE", "CUSTOMER_REPOSITORY", "HOLDOUT", "FORMAL_PROOF", "PERFORMANCE", "PENETRATION", "DISASTER_RECOVERY", "PRODUCTION_OBSERVATION", "CUSTOMER_ACCEPTANCE"] },
        "external_check_id": { "enum": ["real_source_target_builds", "device_matrix", "independent_holdout", "formal_proof", "performance", "chaos_dr", "penetration_test", "production_observation", "customer_acceptance"] },
        "adapter_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "execution_authority": { "enum": ["LOCAL_EXACT_TOOLCHAIN", "INDEPENDENT_HUMAN", "INDEPENDENT_HUMAN_AND_RUNNER", "AUTHORIZED_EXTERNAL_RUNNER", "AUTHORIZED_EXTERNAL_RUNNER_AND_HUMAN", "AUTHORIZED_PRODUCTION_OBSERVER", "INDEPENDENT_CUSTOMER_AND_REVIEWER"] },
        "exact_target": { "type": "object", "minProperties": 1 },
        "required_tools": { "$ref": "#/$defs/nonEmptyStrings" },
        "required_environment": { "$ref": "#/$defs/nonEmptyStrings" },
        "local_assertions": { "$ref": "#/$defs/nonEmptyStrings" },
        "required_evidence_roles": { "$ref": "#/$defs/nonEmptyStrings" },
        "required_metrics": { "$ref": "#/$defs/nonEmptyStrings" },
        "required_claims": { "$ref": "#/$defs/nonEmptyStrings" },
        "external_state": { "const": "NOT_RUN" },
        "production_operation_authorized": { "const": false },
        "certification": { "const": "NOT_CERTIFIED" }
      }
    }
  }
}
