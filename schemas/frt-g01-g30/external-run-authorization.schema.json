{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.io/frt-g01-g30/external-run-authorization.v1.schema.json",
  "title": "FRT external run authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "pack_key", "check_id", "purpose", "environment", "evidence_root", "runner_capability", "run_parameters", "valid_from", "expires_at", "approver", "signature"],
  "properties": {
    "schema_version": { "const": 1 },
    "authorization_id": { "type": "string", "minLength": 1 },
    "pack_key": { "const": "frt-g01-g30-platform" },
    "check_id": { "$ref": "#/$defs/checkId" },
    "purpose": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "evidence_root": { "type": "string", "minLength": 1 },
    "runner_capability": { "type": "string", "minLength": 1 },
    "run_parameters": {
      "type": "object",
      "required": ["schema_version", "qualification_plan_sha256", "case_ids", "adapter_ids", "authorization_scope", "secret_reference_ids"],
      "properties": {
        "schema_version": { "const": 1 },
        "qualification_plan_sha256": { "$ref": "#/$defs/digest" },
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^FRT-EXT-[0-9]{3}-[A-Z0-9-]+$" }
        },
        "adapter_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
        },
        "authorization_scope": { "$ref": "#/$defs/authorizationScope" },
        "secret_reference_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "valid_from": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "approver": { "$ref": "#/$defs/actor" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
    "authorizationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "project_id", "environment_id", "region", "data_classification", "network_policy_id", "write_root_id"],
      "properties": {
        "tenant_id": { "$ref": "#/$defs/identifier" },
        "project_id": { "$ref": "#/$defs/identifier" },
        "environment_id": { "$ref": "#/$defs/identifier" },
        "region": { "$ref": "#/$defs/identifier" },
        "data_classification": { "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL"] },
        "network_policy_id": { "$ref": "#/$defs/identifier" },
        "write_root_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "checkId": {
      "enum": ["real_source_target_builds", "device_matrix", "independent_holdout", "formal_proof", "performance", "chaos_dr", "penetration_test", "production_observation", "customer_acceptance"]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "organization_id"],
      "properties": {
        "principal_id": { "type": "string", "minLength": 1 },
        "organization_id": { "type": "string", "minLength": 1 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "role", "signed_at", "payload_sha256", "signature_base64"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["EXECUTOR", "VERIFIER", "APPROVER"] },
        "signed_at": { "type": "string", "format": "date-time" },
        "payload_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "signature_base64": { "type": "string", "minLength": 1 }
      }
    }
  }
}
