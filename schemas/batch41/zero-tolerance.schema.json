{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.invalid/schemas/batch41/zero-tolerance.schema.json",
  "title": "Batch 41 zero tolerance",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "batch",
    "owner",
    "flags"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "batch": {
      "const": 41
    },
    "packKey": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    },
    "flags": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "evaluated",
          "observed",
          "evidenceRefs"
        ],
        "properties": {
          "name": {
            "enum": [
              "crossTenantReconstructionFindings",
              "expiredCertifiedAssetsUsed",
              "privateKnowledgeLeaks",
              "targetLeakageFindings",
              "testIntegrityViolations",
              "unattributedKnowledgeItems",
              "uncalibratedP0Predictions",
              "unsafeRecommendations"
            ]
          },
          "evaluated": {
            "type": "boolean"
          },
          "observed": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
