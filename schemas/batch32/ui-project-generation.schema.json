{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.io/batch32/ui-project-generation.v1.schema.json",
  "title": "Batch 32 UI project generation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectName",
    "applicationId",
    "title",
    "source",
    "targetFramework",
    "packageName",
    "bundleId",
    "uiIr"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "projectName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$"
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{1,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework",
        "version",
        "platform"
      ],
      "properties": {
        "framework": {
          "$ref": "#/$defs/framework"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:[0-9]+\\.)+[0-9]+(?:\\([0-9]+\\))?$"
        },
        "platform": {
          "enum": [
            "WEB",
            "ANDROID",
            "IOS",
            "HARMONYOS"
          ]
        }
      }
    },
    "targetFramework": {
      "$ref": "#/$defs/framework"
    },
    "packageName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,63}$"
    },
    "bundleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*){2,7}$"
    },
    "uiIr": {
      "$ref": "#/$defs/uiIr"
    }
  },
  "allOf": [
    { "$ref": "#/$defs/angularSource" },
    { "$ref": "#/$defs/flutterSource" },
    { "$ref": "#/$defs/harmonySource" },
    { "$ref": "#/$defs/jquerySource" },
    { "$ref": "#/$defs/reactSource" },
    { "$ref": "#/$defs/reactNativeSource" },
    { "$ref": "#/$defs/svelteSource" },
    { "$ref": "#/$defs/vue2Source" },
    { "$ref": "#/$defs/vue3Source" }
  ],
  "$defs": {
    "framework": {
      "enum": [
        "vue2",
        "vue3",
        "react",
        "react-native",
        "jquery",
        "flutter",
        "harmony-arkui",
        "angular",
        "svelte"
      ]
    },
    "stringSet": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "references",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "$ref": "#/$defs/stringSet"
        },
        "sourceRefs": {
          "$ref": "#/$defs/stringSet"
        }
      }
    },
    "plainNode": {
      "allOf": [
        { "$ref": "#/$defs/node" }
      ],
      "unevaluatedProperties": false
    },
    "unknown": {
      "allOf": [
        { "$ref": "#/$defs/node" },
        {
          "type": "object",
          "required": ["severity", "description", "owner"],
          "properties": {
            "severity": { "enum": ["critical", "high", "medium", "low"] },
            "description": { "type": "string", "minLength": 1 },
            "owner": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "component": {
      "allOf": [
        {
          "$ref": "#/$defs/node"
        },
        {
          "type": "object",
          "required": [
            "text",
            "accessibilityRole"
          ],
          "properties": {
            "text": {
              "type": "string"
            },
            "accessibilityRole": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "route": {
      "allOf": [
        {
          "$ref": "#/$defs/node"
        },
        {
          "type": "object",
          "required": [
            "path",
            "componentId",
            "requiresAuth",
            "deepLink"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^/[A-Za-z0-9_./:*-]*$"
            },
            "componentId": {
              "type": "string",
              "minLength": 1
            },
            "requiresAuth": {
              "type": "boolean"
            },
            "deepLink": {
              "type": "boolean"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "nodeList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/plainNode"
      }
    },
    "uiIr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "sourceSnapshotDigest",
        "routes",
        "views",
        "components",
        "states",
        "actions",
        "effects",
        "forms",
        "bindings",
        "permissions",
        "resources",
        "designTokens",
        "accessibility",
        "nativeBoundaries",
        "unknowns"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "sourceSnapshotDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "views": {
          "$ref": "#/$defs/nodeList"
        },
        "states": {
          "$ref": "#/$defs/nodeList"
        },
        "actions": {
          "$ref": "#/$defs/nodeList"
        },
        "effects": {
          "$ref": "#/$defs/nodeList"
        },
        "forms": {
          "$ref": "#/$defs/nodeList"
        },
        "bindings": {
          "$ref": "#/$defs/nodeList"
        },
        "permissions": {
          "$ref": "#/$defs/nodeList"
        },
        "resources": {
          "$ref": "#/$defs/nodeList"
        },
        "designTokens": {
          "$ref": "#/$defs/nodeList"
        },
        "accessibility": {
          "$ref": "#/$defs/nodeList"
        },
        "nativeBoundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/plainNode"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknown"
          }
        }
      }
    },
    "angularSource": {
      "if": { "properties": { "source": { "properties": { "framework": { "const": "angular" } } } } },
      "then": { "properties": { "source": { "properties": { "version": { "const": "22.0.8" }, "platform": { "const": "WEB" } } } } }
    },
    "flutterSource": {
      "if": { "properties": { "source": { "properties": { "framework": { "const": "flutter" } } } } },
      "then": { "properties": { "source": { "properties": { "version": { "const": "3.44.1" }, "platform": { "enum": ["ANDROID", "IOS", "WEB"] } } } } }
    },
    "harmonySource": {
      "if": { "properties": { "source": { "properties": { "framework": { "const": "harmony-arkui" } } } } },
      "then": { "properties": { "source": { "properties": { "version": { "const": "6.0.0(20)" }, "platform": { "const": "HARMONYOS" } } } } }
    },
    "jquerySource": {
      "if": { "properties": { "source": { "properties": { "framework": { "const": "jquery" } } } } },
      "then": { "properties": { "source": { "properties": { "version": { "const": "4.0.0" }, "platform": { "const": "WEB" } } } } }
    },
    "reactSource": {
      "if": { "properties": { "source": { "properties": { "framework": { "const": "react" } } } } },
      "then": { "properties": { "source": { "properties": { "version": { "const": "19.2.8" }, "platform": { "const": "WEB" } } } } }
    },
    "reactNativeSource": {
      "if": { "properties": { "source": { "properties": { "framework": { "const": "react-native" } } } } },
      "then": { "properties": { "source": { "properties": { "version": { "const": "0.86.0" }, "platform": { "enum": ["ANDROID", "IOS", "WEB"] } } } } }
    },
    "svelteSource": {
      "if": { "properties": { "source": { "properties": { "framework": { "const": "svelte" } } } } },
      "then": { "properties": { "source": { "properties": { "version": { "const": "5.56.8" }, "platform": { "const": "WEB" } } } } }
    },
    "vue2Source": {
      "if": { "properties": { "source": { "properties": { "framework": { "const": "vue2" } } } } },
      "then": { "properties": { "source": { "properties": { "version": { "const": "2.7.16" }, "platform": { "const": "WEB" } } } } }
    },
    "vue3Source": {
      "if": { "properties": { "source": { "properties": { "framework": { "const": "vue3" } } } } },
      "then": { "properties": { "source": { "properties": { "version": { "const": "3.5.40" }, "platform": { "const": "WEB" } } } } }
    }
  }
}
