{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/batch32/frontend-formal-external-route-block-replay-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "scope_digest", "route_id", "block_id",
    "corpus_case_ids", "execution_artifact_ids", "replay_environment_artifact_id",
    "verifier_organization_id", "replayed_at", "independently_reconstructed",
    "comparison_relation", "source_observation_artifact_id",
    "target_observation_artifact_id", "source_actuals_sha256",
    "target_actuals_sha256", "difference_count", "status"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "frontend-formal-route-block-replay-v2"},
    "scope_digest": {"$ref": "#/$defs/sha256"},
    "route_id": {"$ref": "#/$defs/routeId"},
    "block_id": {"$ref": "#/$defs/blockId"},
    "corpus_case_ids": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
    "execution_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "replay_environment_artifact_id": {"$ref": "#/$defs/sha256"},
    "verifier_organization_id": {"$ref": "#/$defs/nonEmpty"},
    "replayed_at": {"type": "string", "format": "date-time"},
    "independently_reconstructed": {"const": true},
    "comparison_relation": {"const": "EXACT_CANONICAL_ACTUAL_EQUALITY_V1"},
    "source_observation_artifact_id": {"$ref": "#/$defs/sha256"},
    "target_observation_artifact_id": {"$ref": "#/$defs/sha256"},
    "source_actuals_sha256": {"$ref": "#/$defs/sha256"},
    "target_actuals_sha256": {"$ref": "#/$defs/sha256"},
    "difference_count": {"const": 0},
    "status": {"enum": ["PASSED", "FAILED"]}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "routeId": {"type": "string", "pattern": "^(angular|flutter|harmony-arkui|jquery|react|react-native|svelte|vue2|vue3)--to--(angular|flutter|harmony-arkui|jquery|react|react-native|svelte|vue2|vue3)$"},
    "blockId": {"enum": ["route-navigation-deeplink-404", "component-template-view", "state-management", "action-event", "effect-lifecycle", "form-binding-validation", "api-network", "identity-permission", "rendering-hydration", "accessibility-focus", "i18n-theme-responsive", "native-platform"]}
  }
}
