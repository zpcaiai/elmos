{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/implementation-plan.schema.json",
  "title": "ELMOS Implementation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "repository",
    "scope",
    "status",
    "selected_skills",
    "tasks",
    "runtime_estimate",
    "validation",
    "production_claim"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "plan_id": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT",
        "APPROVED",
        "IN_PROGRESS",
        "BLOCKED",
        "VALIDATING",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "selected_skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ELMOS-[A-Z]+-[0-9]{3}$"
          },
          "status": {
            "enum": [
              "BACKLOG",
              "READY",
              "IN_PROGRESS",
              "BLOCKED",
              "IN_REVIEW",
              "VALIDATING",
              "DONE",
              "REJECTED"
            ]
          },
          "description": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_digest": {
            "$ref": "digest.schema.json"
          }
        }
      }
    },
    "runtime_estimate": {
      "$ref": "runtime-estimate.schema.json"
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "expected"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          }
        }
      }
    },
    "production_claim": {
      "type": "string"
    }
  }
}
