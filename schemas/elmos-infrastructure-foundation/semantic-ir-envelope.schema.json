{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/semantic-ir-envelope.schema.json",
  "title": "Canonical Semantic IR Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ir_id",
    "source_snapshot_digest",
    "adapter",
    "root_node_id",
    "nodes",
    "gaps",
    "ir_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "ir_id": {
      "type": "string"
    },
    "source_snapshot_digest": {
      "$ref": "digest.schema.json"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "digest"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "$ref": "digest.schema.json"
        }
      }
    },
    "root_node_id": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "language",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "start_line",
              "start_column",
              "end_line",
              "end_column"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "start_column": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_column": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "properties": {
            "type": "object",
            "additionalProperties": true
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "target"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "target": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "severity",
          "node_ids",
          "message",
          "certification_impact"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "UNSUPPORTED",
              "AMBIGUOUS",
              "APPROXIMATE",
              "MANUAL",
              "RUNTIME_ONLY"
            ]
          },
          "severity": {
            "enum": [
              "INFO",
              "LOW",
              "MEDIUM",
              "HIGH",
              "CRITICAL"
            ]
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "certification_impact": {
            "type": "string"
          }
        }
      }
    },
    "ir_digest": {
      "$ref": "digest.schema.json"
    }
  }
}
