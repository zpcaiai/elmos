{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.invalid/schemas/batch40/metrics.schema.json",
  "title": "Batch 40 metrics",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "batch",
    "owner",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "batch": {
      "const": 40
    },
    "packKey": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    },
    "metrics": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "threshold",
          "comparator",
          "measured",
          "value",
          "evidenceRefs"
        ],
        "properties": {
          "name": {
            "enum": [
              "auditEvidenceFreshnessRate",
              "criticalVulnerabilityCount",
              "evidenceTraceCoverage",
              "independentAssessmentClosureRate",
              "provenanceCoverage",
              "sbomCoverage",
              "secureSdlcControlCoverage",
              "signaturePassRate",
              "signatureVerificationRate",
              "supplyChainCoverageRate",
              "threatModelCoverage",
              "vulnerabilitySlaCompliance"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "comparator": {
            "enum": [
              "min",
              "max"
            ]
          },
          "measured": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
