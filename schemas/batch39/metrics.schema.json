{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.invalid/schemas/batch39/metrics.schema.json",
  "title": "Batch 39 metrics",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "batch",
    "owner",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "batch": {
      "const": 39
    },
    "packKey": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    },
    "metrics": {
      "type": "array",
      "minItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "threshold",
          "comparator",
          "measured",
          "value",
          "evidenceRefs"
        ],
        "properties": {
          "name": {
            "enum": [
              "evidenceTraceCoverage",
              "fairSchedulingPassRate",
              "incidentExercisePassRate",
              "incidentResponseExercisePassRate",
              "multiregionFailoverPassRate",
              "productionReadinessPassRate",
              "restorePassRate",
              "serviceCatalogCoverage",
              "sloComplianceRate",
              "sloPassRate",
              "supportSlaPassRate"
            ]
          },
          "threshold": {
            "type": "number"
          },
          "comparator": {
            "enum": [
              "min",
              "max"
            ]
          },
          "measured": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
