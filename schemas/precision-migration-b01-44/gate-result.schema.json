{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/precision-migration-b01-44/gate-result.schema.json",
  "title": "Precision Migration Repository Gate Result",
  "type": "object",
  "required": [
    "schema_version",
    "namespace",
    "batch_count",
    "child_skill_count",
    "runtime_skill_count",
    "decision",
    "local_ready",
    "external_checks_complete",
    "external_check_states",
    "verified_evidence",
    "gate_request_digest",
    "trust_store_digest",
    "failures",
    "maximum_local_decision",
    "production_certification",
    "production_operation_authorized",
    "result_digest"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "namespace": { "const": "precision-migration-b01-44" },
    "batch_count": { "const": 44 },
    "child_skill_count": { "const": 587 },
    "runtime_skill_count": { "const": 632 },
    "decision": { "enum": ["REJECTED", "NOT_READY", "READY_FOR_EXTERNAL_GATE"] },
    "local_ready": { "type": "boolean" },
    "external_checks_complete": { "type": "boolean" },
    "external_check_states": { "type": "object" },
    "verified_evidence": { "type": "object" },
    "gate_request_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "trust_store_digest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "failures": { "type": "array", "items": { "type": "string" } },
    "maximum_local_decision": { "const": "READY_FOR_EXTERNAL_GATE" },
    "production_certification": { "const": "NOT_CERTIFIED" },
    "production_operation_authorized": { "const": false },
    "result_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
