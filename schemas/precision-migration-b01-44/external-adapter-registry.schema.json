{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/precision-migration-b01-44/external-adapter-registry.schema.json",
  "title": "Signed Precision Migration External Adapter Registry",
  "type": "object",
  "required": ["algorithm", "key_id", "payload", "signature"],
  "properties": {
    "algorithm": { "const": "ed25519" },
    "key_id": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "required": ["record_type", "record_id", "actor_id", "registry_id", "profile_registry_digest", "adapters", "issued_at", "expires_at"],
      "properties": {
        "record_type": { "const": "PRECISION_EXTERNAL_ADAPTER_REGISTRY" },
        "record_id": { "type": "string", "minLength": 1 },
        "actor_id": { "type": "string", "minLength": 1 },
        "registry_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "profile_registry_digest": { "$ref": "#/$defs/digest" },
        "adapters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/adapter" } },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "signature": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "adapter": {
      "type": "object",
      "required": ["adapter_id", "stage", "executable", "executable_digest", "argv", "parameters", "environment_allowlist", "timeout_seconds", "effect_class", "compensation_adapter"],
      "properties": {
        "adapter_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "stage": { "enum": ["native_source_execution", "native_target_execution", "independent_holdout", "representative_customer_workload", "production_hsm", "authorized_canary", "verified_rollback"] },
        "executable": { "type": "string", "pattern": "^/" },
        "executable_digest": { "$ref": "#/$defs/digest" },
        "argv": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" }, "uniqueItems": true },
        "environment_allowlist": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "effect_class": { "enum": ["read-only", "reversible", "approval-required"] },
        "compensation_adapter": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "type": { "enum": ["identifier", "integer", "path", "digest"] },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
