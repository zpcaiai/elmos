{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/precision-migration-b01-44/external-engineering-results.schema.json",
  "title": "Precision Migration External Workflow Engineering Results",
  "type": "object",
  "required": ["schema_version", "suite", "decision", "evidence_class", "production_eligible", "skill_count", "case_count", "result_count", "actual_handler_invocation_count", "all_engineering_tests_passed", "test_type_summary", "engineering_stage_summary", "qualification_bindings", "case_suite_digest", "release_engineering_drill", "real_external_state", "limitations", "results"],
  "properties": {
    "schema_version": { "const": 1 },
    "suite": { "const": "precision-migration-external-engineering-v1" },
    "decision": { "const": "PASSED_LOCAL_ENGINEERING_SIMULATION" },
    "evidence_class": { "const": "LOCAL_ENGINEERING_SIMULATION" },
    "production_eligible": { "const": false },
    "skill_count": { "const": 557 },
    "case_count": { "const": 2785 },
    "result_count": { "const": 2785 },
    "actual_handler_invocation_count": { "const": 2785 },
    "all_engineering_tests_passed": { "const": true },
    "test_type_summary": { "type": "object", "minProperties": 5 },
    "engineering_stage_summary": { "type": "object", "minProperties": 5 },
    "qualification_bindings": { "type": "object", "minProperties": 3 },
    "case_suite_digest": { "$ref": "#/$defs/digest" },
    "release_engineering_drill": {
      "type": "object",
      "required": ["state", "test_count", "scenarios", "scope", "test_module_digest", "engineering_hsm_signature_verification", "engineering_canary_and_rollback", "engineering_external_certificate", "production_hsm", "authorized_production_canary", "external_certification", "production_eligible"],
      "properties": {
        "state": { "const": "PASS" },
        "test_count": { "const": 8 },
        "scenarios": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true },
        "scope": { "const": "DISPOSABLE_TEST_TRUST_AND_LOCAL_LEDGER" },
        "test_module_digest": { "$ref": "#/$defs/digest" },
        "engineering_hsm_signature_verification": { "const": "PASSED_WITH_EPHEMERAL_ED25519_KEY" },
        "engineering_canary_and_rollback": { "const": "PASSED_WITH_LOCAL_SIGNED_ADAPTERS" },
        "engineering_external_certificate": { "const": "PASSED_WITH_EPHEMERAL_EXTERNAL_CERTIFIER" },
        "production_hsm": { "const": "NOT_RUN" },
        "authorized_production_canary": { "const": "NOT_RUN" },
        "external_certification": { "const": "NOT_RUN" },
        "production_eligible": { "const": false }
      },
      "additionalProperties": false
    },
    "real_external_state": {
      "type": "object",
      "required": ["decision", "verified_skill_count", "production_operation_authorized", "production_certification", "stage_states", "binding_digest"],
      "properties": {
        "decision": { "const": "NOT_READY" },
        "verified_skill_count": { "const": 0 },
        "production_operation_authorized": { "const": false },
        "production_certification": { "const": "NOT_CERTIFIED" },
        "stage_states": { "type": "object", "minProperties": 8 },
        "binding_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 1 } },
    "results": {
      "type": "array",
      "minItems": 2785,
      "maxItems": 2785,
      "items": {
        "type": "object",
        "required": ["case_id", "case_digest", "skill", "test_type", "engineering_stage", "engineering_state", "handler_invoked", "fresh_qualification_result_digest", "fixture_binding_digest", "evidence_class", "external_stage", "external_stage_state", "production_eligible", "result_digest"],
        "properties": {
          "case_id": { "type": "string", "pattern": "^PM-EXT-ENG-[0-9]{4}$" },
          "case_digest": { "$ref": "#/$defs/digest" },
          "skill": { "type": "string", "pattern": "^pm-b[0-9]{2}-" },
          "test_type": { "enum": ["positive", "integration", "negative", "holdout", "representative"] },
          "engineering_stage": { "type": "string", "minLength": 1 },
          "engineering_state": { "const": "PASS" },
          "handler_invoked": { "const": true },
          "fresh_qualification_result_digest": { "$ref": "#/$defs/digest" },
          "fixture_binding_digest": { "$ref": "#/$defs/digest" },
          "evidence_class": { "const": "LOCAL_ENGINEERING_SIMULATION" },
          "external_stage": { "type": ["string", "null"] },
          "external_stage_state": { "enum": ["NOT_RUN", "NOT_APPLICABLE"] },
          "production_eligible": { "const": false },
          "result_digest": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
