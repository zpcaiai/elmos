{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/batch35/frontend-formal-external-corpus-manifest-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "scope_digest", "corpus_id", "corpus_kind",
    "source_organization_id", "created_at", "license_or_authorization",
    "case_ids", "status"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "frontend-formal-external-corpus-manifest-v2"},
    "scope_digest": {"$ref": "#/$defs/sha256"},
    "corpus_id": {"$ref": "#/$defs/nonEmpty"},
    "corpus_kind": {"enum": ["holdout", "representative", "customer"]},
    "source_organization_id": {"$ref": "#/$defs/nonEmpty"},
    "created_at": {"type": "string", "format": "date-time"},
    "license_or_authorization": {"$ref": "#/$defs/nonEmpty"},
    "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
    "status": {"const": "PASSED"}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
