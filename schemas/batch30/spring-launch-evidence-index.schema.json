{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/batch30/spring-launch-evidence-index.schema.json",
  "title": "Batch 30 Spring launch controlled evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace", "index_id", "generated_at", "entries"],
  "properties": {
    "schema_version": {"const": 1},
    "namespace": {"const": "batch30-spring-launch-external-evidence"},
    "index_id": {"$ref": "#/$defs/identity"},
    "generated_at": {"$ref": "#/$defs/utcInstant"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entry_id",
          "uri",
          "digest",
          "size_bytes",
          "media_type",
          "recorded_at"
        ],
        "properties": {
          "entry_id": {"$ref": "#/$defs/identity"},
          "uri": {
            "type": "string",
            "pattern": "^(?:https|s3|gs|az|cas)://[^\\s]+$"
          },
          "digest": {"$ref": "#/$defs/digest"},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 200},
          "recorded_at": {"$ref": "#/$defs/utcInstant"}
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]{1,199}$"
    },
    "digest": {"type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"},
    "utcInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    }
  }
}
