{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/batch30/spring-launch-trust-store.schema.json",
  "title": "Batch 30 Spring launch external evidence trust store",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "namespace", "keys", "revoked_record_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "namespace": {"const": "batch30-spring-launch-external-evidence"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/trustedKey"}
    },
    "revoked_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identity"}
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]{1,199}$"
    },
    "utcInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "trustedKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "actor_id",
        "organization_id",
        "roles",
        "public_key_path",
        "not_before",
        "not_after",
        "revoked"
      ],
      "properties": {
        "key_id": {"$ref": "#/$defs/identity"},
        "actor_id": {"$ref": "#/$defs/identity"},
        "organization_id": {"$ref": "#/$defs/identity"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "spring-launch-evidence-executor",
              "spring-launch-gate-verifier",
              "spring-launch-independent-reviewer",
              "spring-launch-release-approver",
              "spring-launch-design-partner-approver",
              "spring-launch-evidence-index-authority"
            ]
          }
        },
        "public_key_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\s]+$"
        },
        "not_before": {"$ref": "#/$defs/utcInstant"},
        "not_after": {"$ref": "#/$defs/utcInstant"},
        "revoked": {"type": "boolean"}
      }
    }
  }
}
