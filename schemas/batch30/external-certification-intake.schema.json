{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/batch30/external-certification-intake.schema.json",
  "title": "Batch 30 signed 13-class external certification evidence intake",
  "type": "object",
  "required": [
    "schema_version",
    "namespace",
    "intake_id",
    "producer_organization_id",
    "customer_organization_id",
    "rootless_organization_id",
    "independent_organization_id",
    "certification_organization_id",
    "binding",
    "artifact",
    "execution_profile",
    "evidence_executors",
    "customer_authorization",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "namespace": {
      "const": "batch30-framework-external-certification"
    },
    "intake_id": {
      "$ref": "#/$defs/identity"
    },
    "producer_organization_id": {
      "$ref": "#/$defs/identity"
    },
    "customer_organization_id": {
      "$ref": "#/$defs/identity"
    },
    "rootless_organization_id": {
      "$ref": "#/$defs/identity"
    },
    "independent_organization_id": {
      "$ref": "#/$defs/identity"
    },
    "certification_organization_id": {
      "$ref": "#/$defs/identity"
    },
    "binding": {
      "$ref": "#/$defs/binding"
    },
    "artifact": {
      "$ref": "#/$defs/contentReference"
    },
    "execution_profile": {
      "$ref": "#/$defs/contentReference"
    },
    "evidence_executors": {
      "$ref": "#/$defs/evidenceExecutors"
    },
    "customer_authorization": {
      "$ref": "#/$defs/signedEnvelope"
    },
    "evidence": {
      "type": "object",
      "required": [
        "source_build",
        "target_build",
        "source_startup",
        "target_startup",
        "behavioral_equivalence",
        "security",
        "performance",
        "operability",
        "sbom",
        "rollback",
        "independent_review",
        "customer_acceptance",
        "external_certification"
      ],
      "properties": {
        "source_build": {
          "$ref": "#/$defs/evidenceItem"
        },
        "target_build": {
          "$ref": "#/$defs/evidenceItem"
        },
        "source_startup": {
          "$ref": "#/$defs/evidenceItem"
        },
        "target_startup": {
          "$ref": "#/$defs/evidenceItem"
        },
        "behavioral_equivalence": {
          "$ref": "#/$defs/evidenceItem"
        },
        "security": {
          "$ref": "#/$defs/evidenceItem"
        },
        "performance": {
          "$ref": "#/$defs/evidenceItem"
        },
        "operability": {
          "$ref": "#/$defs/evidenceItem"
        },
        "sbom": {
          "$ref": "#/$defs/evidenceItem"
        },
        "rollback": {
          "$ref": "#/$defs/evidenceItem"
        },
        "independent_review": {
          "$ref": "#/$defs/evidenceItem"
        },
        "customer_acceptance": {
          "$ref": "#/$defs/evidenceItem"
        },
        "external_certification": {
          "$ref": "#/$defs/evidenceItem"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{1,199}$",
      "not": {
        "enum": [
          "UNKNOWN",
          "INCONCLUSIVE",
          "NOT_RUN",
          "NOT_EVALUATED",
          "BLOCKED"
        ]
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "exactTuple": {
      "type": "object",
      "required": [
        "framework",
        "framework_version",
        "runtime",
        "runtime_version",
        "build_tool",
        "provider_versions"
      ],
      "properties": {
        "framework": {
          "$ref": "#/$defs/identity"
        },
        "framework_version": {
          "$ref": "#/$defs/identity"
        },
        "runtime": {
          "$ref": "#/$defs/identity"
        },
        "runtime_version": {
          "$ref": "#/$defs/identity"
        },
        "build_tool": {
          "$ref": "#/$defs/identity"
        },
        "provider_versions": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "pack_key",
        "pack_version",
        "pack_manifest_digest",
        "source_tuple",
        "target_tuple",
        "version_matrix_digest",
        "recipe_manifest_digest",
        "target_profile_digest",
        "artifact_digest",
        "artifact_size_bytes",
        "execution_profile_digest",
        "execution_profile_size_bytes"
      ],
      "properties": {
        "pack_key": {
          "$ref": "#/$defs/identity"
        },
        "pack_version": {
          "$ref": "#/$defs/identity"
        },
        "pack_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "source_tuple": {
          "$ref": "#/$defs/exactTuple"
        },
        "target_tuple": {
          "$ref": "#/$defs/exactTuple"
        },
        "version_matrix_digest": {
          "$ref": "#/$defs/digest"
        },
        "recipe_manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "target_profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "execution_profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "execution_profile_size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "contentReference": {
      "type": "object",
      "required": [
        "uri",
        "digest",
        "size_bytes",
        "media_type"
      ],
      "properties": {
        "uri": {
          "type": "string",
          "pattern": "^file://"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidencePrincipal": {
      "type": "object",
      "required": [
        "actor_id",
        "organization_id"
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/identity"
        },
        "organization_id": {
          "$ref": "#/$defs/identity"
        }
      },
      "additionalProperties": false
    },
    "evidenceExecutors": {
      "type": "object",
      "required": [
        "source_build",
        "target_build",
        "source_startup",
        "target_startup",
        "behavioral_equivalence",
        "security",
        "performance",
        "operability",
        "sbom",
        "rollback",
        "independent_review",
        "customer_acceptance",
        "external_certification"
      ],
      "properties": {
        "source_build": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "target_build": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "source_startup": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "target_startup": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "behavioral_equivalence": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "security": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "performance": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "operability": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "sbom": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "rollback": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "independent_review": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "customer_acceptance": {
          "$ref": "#/$defs/evidencePrincipal"
        },
        "external_certification": {
          "$ref": "#/$defs/evidencePrincipal"
        }
      },
      "additionalProperties": false
    },
    "authorizationScope": {
      "type": "object",
      "required": [
        "action",
        "pack_key",
        "pack_version",
        "binding_digest",
        "artifact_digest",
        "execution_profile_digest",
        "producer_organization_id",
        "customer_organization_id",
        "rootless_organization_id",
        "independent_organization_id",
        "certification_organization_id",
        "evidence_types",
        "evidence_executors",
        "evidence_content_digests"
      ],
      "properties": {
        "action": {
          "const": "validate-batch30-external-certification-intake"
        },
        "pack_key": {
          "$ref": "#/$defs/identity"
        },
        "pack_version": {
          "$ref": "#/$defs/identity"
        },
        "binding_digest": {
          "$ref": "#/$defs/digest"
        },
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "execution_profile_digest": {
          "$ref": "#/$defs/digest"
        },
        "producer_organization_id": {
          "$ref": "#/$defs/identity"
        },
        "customer_organization_id": {
          "$ref": "#/$defs/identity"
        },
        "rootless_organization_id": {
          "$ref": "#/$defs/identity"
        },
        "independent_organization_id": {
          "$ref": "#/$defs/identity"
        },
        "certification_organization_id": {
          "$ref": "#/$defs/identity"
        },
        "evidence_types": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            {
              "const": "source_build"
            },
            {
              "const": "target_build"
            },
            {
              "const": "source_startup"
            },
            {
              "const": "target_startup"
            },
            {
              "const": "behavioral_equivalence"
            },
            {
              "const": "security"
            },
            {
              "const": "performance"
            },
            {
              "const": "operability"
            },
            {
              "const": "sbom"
            },
            {
              "const": "rollback"
            },
            {
              "const": "independent_review"
            },
            {
              "const": "customer_acceptance"
            },
            {
              "const": "external_certification"
            }
          ],
          "items": false
        },
        "evidence_executors": {
          "$ref": "#/$defs/evidenceExecutors"
        },
        "evidence_content_digests": {
          "type": "object",
          "required": [
            "source_build",
            "target_build",
            "source_startup",
            "target_startup",
            "behavioral_equivalence",
            "security",
            "performance",
            "operability",
            "sbom",
            "rollback",
            "independent_review",
            "customer_acceptance",
            "external_certification"
          ],
          "properties": {
            "source_build": {
              "$ref": "#/$defs/digest"
            },
            "target_build": {
              "$ref": "#/$defs/digest"
            },
            "source_startup": {
              "$ref": "#/$defs/digest"
            },
            "target_startup": {
              "$ref": "#/$defs/digest"
            },
            "behavioral_equivalence": {
              "$ref": "#/$defs/digest"
            },
            "security": {
              "$ref": "#/$defs/digest"
            },
            "performance": {
              "$ref": "#/$defs/digest"
            },
            "operability": {
              "$ref": "#/$defs/digest"
            },
            "sbom": {
              "$ref": "#/$defs/digest"
            },
            "rollback": {
              "$ref": "#/$defs/digest"
            },
            "independent_review": {
              "$ref": "#/$defs/digest"
            },
            "customer_acceptance": {
              "$ref": "#/$defs/digest"
            },
            "external_certification": {
              "$ref": "#/$defs/digest"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "authorizationPayload": {
      "type": "object",
      "required": [
        "record_id",
        "issued_at",
        "expires_at",
        "actor_id",
        "organization_id",
        "role",
        "intake_id",
        "binding_digest",
        "scope",
        "outcome",
        "synthetic",
        "unknowns",
        "not_run"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/identity"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor_id": {
          "$ref": "#/$defs/identity"
        },
        "organization_id": {
          "$ref": "#/$defs/identity"
        },
        "role": {
          "const": "batch30-customer-authorizer"
        },
        "intake_id": {
          "$ref": "#/$defs/identity"
        },
        "binding_digest": {
          "$ref": "#/$defs/digest"
        },
        "scope": {
          "$ref": "#/$defs/authorizationScope"
        },
        "outcome": {
          "const": "AUTHORIZED"
        },
        "synthetic": {
          "const": false
        },
        "unknowns": {
          "type": "array",
          "maxItems": 0
        },
        "not_run": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    },
    "attestationPayload": {
      "type": "object",
      "required": [
        "record_id",
        "issued_at",
        "expires_at",
        "actor_id",
        "organization_id",
        "role",
        "intake_id",
        "binding_digest",
        "authorization_record_id",
        "authorization_payload_digest",
        "evidence_type",
        "content_digest",
        "content_size_bytes",
        "executor_actor_id",
        "executor_organization_id",
        "outcome",
        "evidence_class",
        "synthetic",
        "unknowns",
        "not_run",
        "claims"
      ],
      "properties": {
        "record_id": {
          "$ref": "#/$defs/identity"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "actor_id": {
          "$ref": "#/$defs/identity"
        },
        "organization_id": {
          "$ref": "#/$defs/identity"
        },
        "role": {
          "$ref": "#/$defs/identity"
        },
        "intake_id": {
          "$ref": "#/$defs/identity"
        },
        "binding_digest": {
          "$ref": "#/$defs/digest"
        },
        "authorization_record_id": {
          "$ref": "#/$defs/identity"
        },
        "authorization_payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "evidence_type": {
          "$ref": "#/$defs/identity"
        },
        "content_digest": {
          "$ref": "#/$defs/digest"
        },
        "content_size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "executor_actor_id": {
          "$ref": "#/$defs/identity"
        },
        "executor_organization_id": {
          "$ref": "#/$defs/identity"
        },
        "outcome": {
          "enum": [
            "PASS",
            "ACCEPTED",
            "CERTIFIED"
          ]
        },
        "evidence_class": {
          "const": "EXTERNAL_NON_SYNTHETIC"
        },
        "synthetic": {
          "const": false
        },
        "unknowns": {
          "type": "array",
          "maxItems": 0
        },
        "not_run": {
          "type": "array",
          "maxItems": 0
        },
        "claims": {
          "type": "object"
        }
      },
      "oneOf": [
        {
          "properties": {
            "evidence_type": {
              "const": "source_build"
            },
            "role": {
              "const": "batch30-source-build-verifier"
            },
            "outcome": {
              "const": "PASS"
            },
            "claims": {
              "const": {
                "passed": true,
                "native": true,
                "exact_toolchain": true
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "target_build"
            },
            "role": {
              "const": "batch30-target-build-verifier"
            },
            "outcome": {
              "const": "PASS"
            },
            "claims": {
              "const": {
                "passed": true,
                "native": true,
                "exact_toolchain": true,
                "rootless": true,
                "privileged": false
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "source_startup"
            },
            "role": {
              "const": "batch30-source-runtime-verifier"
            },
            "outcome": {
              "const": "PASS"
            },
            "claims": {
              "const": {
                "passed": true,
                "native": true,
                "readiness": true
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "target_startup"
            },
            "role": {
              "const": "batch30-target-runtime-verifier"
            },
            "outcome": {
              "const": "PASS"
            },
            "claims": {
              "const": {
                "passed": true,
                "native": true,
                "readiness": true,
                "rootless": true,
                "privileged": false
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "behavioral_equivalence"
            },
            "role": {
              "const": "batch30-behavior-verifier"
            },
            "outcome": {
              "const": "PASS"
            },
            "claims": {
              "const": {
                "passed": true,
                "critical_mismatch_count": 0,
                "route_coverage": 1,
                "independent_holdout": true,
                "representative_repository": true,
                "authorized_customer_repository": true,
                "rootless": true,
                "privileged": false
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "security"
            },
            "role": {
              "const": "batch30-security-verifier"
            },
            "outcome": {
              "const": "PASS"
            },
            "claims": {
              "const": {
                "passed": true,
                "critical_findings": 0
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "performance"
            },
            "role": {
              "const": "batch30-performance-verifier"
            },
            "outcome": {
              "const": "PASS"
            },
            "claims": {
              "const": {
                "passed": true,
                "capacity_validated": true
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "operability"
            },
            "role": {
              "const": "batch30-operability-verifier"
            },
            "outcome": {
              "const": "PASS"
            },
            "claims": {
              "const": {
                "passed": true,
                "endpoints_verified": [
                  "/livez",
                  "/readyz",
                  "/metrics",
                  "/version"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "sbom"
            },
            "role": {
              "const": "batch30-sbom-verifier"
            },
            "outcome": {
              "const": "PASS"
            },
            "claims": {
              "const": {
                "passed": true,
                "artifact_bound": true
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "rollback"
            },
            "role": {
              "const": "batch30-rollback-verifier"
            },
            "outcome": {
              "const": "PASS"
            },
            "claims": {
              "const": {
                "passed": true,
                "rehearsed": true
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "independent_review"
            },
            "role": {
              "const": "batch30-independent-reviewer"
            },
            "outcome": {
              "const": "PASS"
            },
            "claims": {
              "const": {
                "passed": true,
                "organizationally_independent": true,
                "separate_executor_and_verifier": true,
                "all_required_evidence_reviewed": true
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "customer_acceptance"
            },
            "role": {
              "const": "batch30-customer-acceptance-approver"
            },
            "outcome": {
              "const": "ACCEPTED"
            },
            "claims": {
              "const": {
                "acceptance_subject_bound": true,
                "accepted_exact_artifact_and_profile": true,
                "customer_owned_holdout": true,
                "customer_decision": "ACCEPTED"
              }
            }
          }
        },
        {
          "properties": {
            "evidence_type": {
              "const": "external_certification"
            },
            "role": {
              "const": "batch30-external-certifier"
            },
            "outcome": {
              "const": "CERTIFIED"
            },
            "claims": {
              "const": {
                "certification_scope_bound": true,
                "independent_certification_authority": true,
                "certificate_decision": "CERTIFIED"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "signedEnvelope": {
      "type": "object",
      "required": [
        "algorithm",
        "key_id",
        "payload",
        "signature"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "key_id": {
          "$ref": "#/$defs/identity"
        },
        "payload": {
          "oneOf": [
            {
              "$ref": "#/$defs/authorizationPayload"
            },
            {
              "$ref": "#/$defs/attestationPayload"
            }
          ]
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_+/=-]+$"
        }
      },
      "additionalProperties": false
    },
    "evidenceItem": {
      "type": "object",
      "required": [
        "content",
        "attestation"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/contentReference"
        },
        "attestation": {
          "$ref": "#/$defs/signedEnvelope"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
