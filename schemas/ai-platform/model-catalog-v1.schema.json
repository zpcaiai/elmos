{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elmos.ai-platform.model-catalog.v1",
  "title": "ELMOS Coding Agent model catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogId",
    "purpose",
    "governedBy",
    "routesThroughAdapter",
    "note",
    "consumers",
    "models",
    "externalEvidenceStatus",
    "certificationStatus"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "catalogId": {"const": "elmos.coding-agent-model-catalog"},
    "purpose": {"type": "string", "minLength": 1},
    "governedBy": {"type": "string", "minLength": 1},
    "routesThroughAdapter": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["MLFLOW", "FEAST", "KUBEFLOW", "KSERVE", "INFERENCE_GATEWAY", "ENVOY_AI_GATEWAY", "CLOUD_AI", "VECTOR_STORE", "AGENT_FRAMEWORK", "OPENTELEMETRY", "HUMAN_REVIEW"]}
    },
    "note": {"type": "string", "minLength": 1},
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["project-synthesis-engine", "spring-upgrade-coding-agent", "cross-language-lowering-coding-agent"]}
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model_entry"}
    },
    "externalEvidenceStatus": {"const": "NOT_RUN"},
    "certificationStatus": {"const": "NOT_CERTIFIED"}
  },
  "$defs": {
    "model_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelId", "displayName", "vendor", "modelFamily", "suggestedRole", "status"],
      "properties": {
        "modelId": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"},
        "displayName": {"type": "string", "minLength": 1},
        "vendor": {"type": "string", "minLength": 1},
        "modelFamily": {"type": "string", "minLength": 1},
        "suggestedRole": {
          "enum": ["SPEC_CLARIFICATION", "LONG_TAIL_CODE_FIX", "IDIOMATIZATION_REVIEW", "FAST_ITERATION"]
        },
        "status": {"const": "NOT_CONFIGURED"}
      }
    }
  }
}
