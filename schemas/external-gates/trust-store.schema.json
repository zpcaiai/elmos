{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/external-gates/trust-store.schema.json",
  "title": "ELMOS external gate Ed25519 trust store",
  "type": "object",
  "required": ["schema_version", "keys", "revoked_record_ids"],
  "properties": {
    "schema_version": { "const": 1 },
    "keys": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "key_id", "roles", "actor_id", "organization_id", "public_key_path",
          "not_before", "not_after", "revoked"
        ],
        "properties": {
          "key_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{2,128}$" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["external-executor", "independent-verifier", "customer-workload-authorizer"]
            }
          },
          "actor_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{2,128}$" },
          "organization_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{2,128}$" },
          "public_key_path": { "type": "string", "minLength": 1 },
          "not_before": { "type": "string", "format": "date-time" },
          "not_after": { "type": "string", "format": "date-time" },
          "revoked": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "revoked_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
