{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/external-gates/subject-snapshot.schema.json",
  "title": "ELMOS external gate subject snapshot",
  "x-elmos-resource-limits": {
    "max_subject_files": 20000,
    "max_single_subject_bytes": 536870912,
    "max_total_subject_bytes": 4294967296,
    "max_subject_scan_depth": 64,
    "max_subject_scan_entries": 40000
  },
  "type": "object",
  "required": ["schema_version", "kind", "key", "version", "repository_revision", "file_set_policy", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "enum": ["batch29-route", "batch35-verification-pack"] },
    "key": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{2,160}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "repository_revision": {
      "type": "string",
      "pattern": "^(git:[0-9a-f]{40,64}|sha256:[0-9a-f]{64})$"
    },
    "file_set_policy": { "const": "exact" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "required": ["path", "role", "sha256", "byte_size"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,80}$" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "byte_size": { "type": "integer", "minimum": 0, "maximum": 536870912 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
