{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.invalid/schemas/batch43/support-matrix.schema.json",
  "title": "Batch 43 support-matrix",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "batch",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "batch": {
      "const": 43
    },
    "packKey": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "minItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "capabilityId",
          "status",
          "owner",
          "evidenceRefs"
        ],
        "properties": {
          "capabilityId": {
            "enum": [
              "b43-automated-upgrade-tooling",
              "b43-compatibility-test-matrix",
              "b43-customer-upgrade-readiness",
              "b43-database-migration-compatibility",
              "b43-deprecation-removal",
              "b43-event-schema-compatibility",
              "b43-feature-flag-progressive-enable",
              "b43-product-lifecycle-factory",
              "b43-product-lifecycle-gate",
              "b43-psp-uir-schema-compatibility",
              "b43-public-api-compatibility",
              "b43-recipe-pack-extension-compatibility",
              "b43-release-channel-governance",
              "b43-release-documentation",
              "b43-rolling-mixed-version-upgrade",
              "b43-runner-protocol-compatibility",
              "b43-sdk-compatibility",
              "b43-security-fix-backport",
              "b43-support-eol-policy",
              "b43-version-specification"
            ]
          },
          "status": {
            "enum": [
              "research",
              "experimental",
              "limited",
              "certified",
              "deprecated",
              "blocked"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
