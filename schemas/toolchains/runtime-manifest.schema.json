{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/toolchains/runtime-manifest.schema.json",
  "title": "ELMOS task-scoped language runtime manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "description",
    "toolchain_root_env",
    "default_toolchain_root",
    "claim_boundary",
    "profiles",
    "runtimes",
    "batch_bindings"
  ],
  "properties": {
    "$schema": {"const": "../schemas/toolchains/runtime-manifest.schema.json"},
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "description": {"type": "string", "minLength": 1},
    "toolchain_root_env": {"const": "ELMOS_PROJECT_SYNTHESIS_TOOLCHAIN_ROOT"},
    "default_toolchain_root": {"type": "string", "minLength": 1},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_local_state", "external_evidence_status", "certification_status", "limitations"],
      "properties": {
        "maximum_local_state": {"const": "TOOLCHAIN_READY"},
        "external_evidence_status": {"const": "NOT_RUN"},
        "certification_status": {"const": "NOT_CERTIFIED"},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "profiles": {
      "type": "object",
      "required": ["core", "synthesis", "routes-macos", "b66-80", "spring-legacy", "frontend-native", "language-packs", "all"],
      "additionalProperties": false,
      "properties": {
        "core": {"$ref": "#/$defs/profile"},
        "synthesis": {"$ref": "#/$defs/profile"},
        "routes-macos": {"$ref": "#/$defs/profile"},
        "b66-80": {"$ref": "#/$defs/profile"},
        "spring-legacy": {"$ref": "#/$defs/profile"},
        "frontend-native": {"$ref": "#/$defs/profile"},
        "language-packs": {"$ref": "#/$defs/profile"},
        "all": {"$ref": "#/$defs/profile"}
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/runtime"}
    },
    "batch_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["b66-80", "b81-95"],
      "properties": {
        "b66-80": {"$ref": "#/$defs/batchBindings66To80"},
        "b81-95": {"$ref": "#/$defs/batchBindings81To95"}
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "required", "optional"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(any|darwin-arm64|linux-(x86_64|arm64)|windows-x86_64)$"}
        },
        "required": {"$ref": "#/$defs/runtimeIds"},
        "optional": {"$ref": "#/$defs/runtimeIds"}
      }
    },
    "runtimeIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"}
    },
    "nonEmptyRuntimeIds": {
      "allOf": [
        {"$ref": "#/$defs/runtimeIds"},
        {"minItems": 1}
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected", "pattern"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
        "expected": {"type": "string", "minLength": 1},
        "pattern": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "languages", "version", "install_policy", "platforms", "required_by"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
        "display_name": {"type": "string", "minLength": 1},
        "languages": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"}
        },
        "version": {"type": "string", "minLength": 1},
        "install_policy": {
          "enum": ["managed-or-host", "repository-lock", "host-apple", "profile-selected", "container-profile", "vendor-external", "external-service"]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(any|darwin-arm64|linux-(x86_64|arm64)|windows-x86_64)$"}
        },
        "required_by": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string", "minLength": 1},
        "probes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/probe"}
        },
        "observational_probes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/probe"}
        }
      }
    },
    "batchBindings66To80": {
      "type": "object",
      "minProperties": 15,
      "maxProperties": 15,
      "propertyNames": {"pattern": "^(6[6-9]|7[0-9]|80)$"},
      "additionalProperties": {"$ref": "#/$defs/nonEmptyRuntimeIds"}
    },
    "batchBindings81To95": {
      "type": "object",
      "minProperties": 15,
      "maxProperties": 15,
      "propertyNames": {"pattern": "^(8[1-9]|9[0-5])$"},
      "additionalProperties": {"$ref": "#/$defs/nonEmptyRuntimeIds"}
    }
  }
}
