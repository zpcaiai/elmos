{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/batch29/vcpp6-toolchain-binding.schema.json",
  "title": "Governed Microsoft Visual C++ 6.0 SP6 Toolchain Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "product",
    "service_pack",
    "host_os",
    "host_architecture",
    "compiler_architecture",
    "compiler_path",
    "compiler_sha256",
    "compiler_version",
    "linker_path",
    "linker_sha256",
    "linker_version",
    "runtime_path",
    "runtime_sha256",
    "runtime_version",
    "runner_id",
    "authorization_ref",
    "evidence_class"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "elmos.vcpp6-sp6-toolchain-binding"},
    "product": {"const": "Microsoft Visual C++ 6.0 SP6"},
    "service_pack": {"const": 6},
    "host_os": {"const": "Windows"},
    "host_architecture": {"enum": ["x86", "i386", "i686", "amd64", "x86_64"]},
    "compiler_architecture": {"const": "x86"},
    "compiler_path": {"type": "string", "minLength": 3},
    "compiler_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiler_version": {"type": "string", "minLength": 1},
    "linker_path": {"type": "string", "minLength": 3},
    "linker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "linker_version": {"type": "string", "minLength": 1},
    "runtime_path": {"type": "string", "minLength": 3},
    "runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_version": {"type": "string", "minLength": 1},
    "runner_id": {"type": "string", "minLength": 1},
    "authorization_ref": {"type": "string", "minLength": 1},
    "evidence_class": {"const": "GOVERNED_EXTERNAL_SELF_ATTESTED"}
  }
}
