{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Batch29SupportMatrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_key",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "route_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*-to-[a-z][a-z0-9]*$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "strategy",
          "reason",
          "evidence_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "certified",
              "supported",
              "conditional",
              "experimental",
              "detected-only",
              "blocked"
            ]
          },
          "strategy": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
