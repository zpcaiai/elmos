{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/batch29/formal-input-module-function.schema.json",
  "title": "Batch29TypedPureModuleFunctionFormalInput",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "profile",
    "route",
    "input_domain",
    "module_input_sha256",
    "symbol",
    "signature",
    "source_function",
    "source_function_sha256",
    "target_function",
    "target_function_sha256",
    "case_manifest_sha256",
    "identifier_hygiene"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "kind": {"const": "typed-pure-module-function-formal-input"},
    "profile": {"const": "typed-pure-module-v1"},
    "route": {"$ref": "#/$defs/route"},
    "input_domain": {
      "enum": [
        "canonical-finite-no-error-input-domain",
        "nodejs-es2022-esm-safe-integer-finite-v1"
      ]
    },
    "module_input_sha256": {"$ref": "#/$defs/sha256"},
    "symbol": {"$ref": "#/$defs/identifier"},
    "signature": {"$ref": "#/$defs/signature"},
    "source_function": {"$ref": "#/$defs/function"},
    "source_function_sha256": {"$ref": "#/$defs/sha256"},
    "target_function": {"$ref": "#/$defs/function"},
    "target_function_sha256": {"$ref": "#/$defs/sha256"},
    "case_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "identifier_hygiene": {"$ref": "#/$defs/identifier_hygiene"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "pattern": "^(?=.*[^/]$)(?!/)(?!.*[\\u0000-\\u001f\\u007f])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\).+$"
    },
    "unit_namespace": {
      "type": "object",
      "required": ["schema_version", "kind", "scope", "repository_snapshot_sha256", "work_unit_id", "source_logical_path", "source_sha256"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "kind": {"const": "elmos.identifier-unit-namespace"},
        "scope": {"enum": ["standalone-semantic-ir", "standalone-artifact", "repository-work-unit"]},
        "repository_snapshot_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "work_unit_id": {"oneOf": [{"type": "string", "pattern": "^WU-[0-9]{5}(?:-F[0-9]{3})?$"}, {"type": "null"}]},
        "source_logical_path": {"$ref": "#/$defs/relative_path"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "repository-work-unit"}}, "required": ["scope"]},
          "then": {"properties": {"repository_snapshot_sha256": {"$ref": "#/$defs/sha256"}, "work_unit_id": {"type": "string", "pattern": "^WU-[0-9]{5}(?:-F[0-9]{3})?$"}}},
          "else": {"properties": {"repository_snapshot_sha256": {"type": "null"}, "work_unit_id": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "java",
        "python",
        "csharp",
        "typescript",
        "go",
        "rust",
        "cpp",
        "objc",
        "swift",
        "php",
        "kotlin",
        "react",
        "flutter"
      ]
    },
    "route": {
      "type": "object",
      "required": ["route_key", "source_language", "target_language"],
      "properties": {
        "route_key": {"type": "string", "pattern": "^[a-z]+-to-[a-z]+$"},
        "source_language": {"$ref": "#/$defs/language"},
        "target_language": {"$ref": "#/$defs/language"}
      },
      "additionalProperties": false
    },
    "canonical_type": {
      "enum": ["integer", "number", "boolean", "string"]
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "type": {"$ref": "#/$defs/canonical_type"}
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["parameters", "return_type"],
      "properties": {
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter"}
        },
        "return_type": {"$ref": "#/$defs/canonical_type"}
      },
      "additionalProperties": false
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "name"},
            "value": {"$ref": "#/$defs/identifier"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": {"const": "literal"},
            "value": {"type": ["integer", "number", "boolean", "string"]}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "operator", "left", "right"],
          "properties": {
            "kind": {"const": "binary"},
            "operator": {
              "enum": [
                "+",
                "-",
                "*",
                "/",
                "%",
                "<",
                "<=",
                ">",
                ">=",
                "==",
                "!=",
                "&&",
                "||"
              ]
            },
            "left": {"$ref": "#/$defs/expression"},
            "right": {"$ref": "#/$defs/expression"}
          },
          "additionalProperties": false
        }
      ]
    },
    "statement": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "expression"],
          "properties": {
            "kind": {"const": "return"},
            "expression": {"$ref": "#/$defs/expression"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "condition", "then", "else"],
          "properties": {
            "kind": {"const": "if"},
            "condition": {"$ref": "#/$defs/expression"},
            "then": {
              "type": "array",
              "items": {"$ref": "#/$defs/statement"}
            },
            "else": {
              "type": "array",
              "items": {"$ref": "#/$defs/statement"}
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "function": {
      "type": "object",
      "required": ["name", "parameters", "return_type", "body"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter"}
        },
        "return_type": {"$ref": "#/$defs/canonical_type"},
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/statement"}
        }
      },
      "additionalProperties": false
    },
    "artifact_ref": {
      "oneOf": [
        {
          "type": "object",
          "required": ["role", "path", "sha256", "bytes"],
          "properties": {
            "role": {"const": "identifier-plan"},
            "path": {"const": "identifier-plan.json"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["role", "path", "sha256", "bytes"],
          "properties": {
            "role": {"const": "raw-target-ir"},
            "path": {"const": "target-semantic-ir.raw.json"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["role", "path", "sha256", "bytes"],
          "properties": {
            "role": {"const": "normalized-target-ir"},
            "path": {"const": "target-semantic-ir.normalized.json"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      ]
    },
    "parameter_mapping": {
      "type": "object",
      "required": ["raw_name", "canonical_name", "canonical_type"],
      "properties": {
        "raw_name": {"$ref": "#/$defs/identifier"},
        "canonical_name": {"$ref": "#/$defs/identifier"},
        "canonical_type": {"$ref": "#/$defs/canonical_type"}
      },
      "additionalProperties": false
    },
    "function_mapping": {
      "type": "object",
      "required": ["raw_symbol", "canonical_symbol", "parameters"],
      "properties": {
        "raw_symbol": {"$ref": "#/$defs/identifier"},
        "canonical_symbol": {"$ref": "#/$defs/identifier"},
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter_mapping"}
        }
      },
      "additionalProperties": false
    },
    "identifier_hygiene": {
      "type": "object",
      "required": ["plan", "unit_namespace", "unit_namespace_sha256", "raw_target_ir", "normalized_target_ir", "function"],
      "properties": {
        "plan": {"$ref": "#/$defs/artifact_ref"},
        "unit_namespace": {"$ref": "#/$defs/unit_namespace"},
        "unit_namespace_sha256": {"$ref": "#/$defs/sha256"},
        "raw_target_ir": {"$ref": "#/$defs/artifact_ref"},
        "normalized_target_ir": {"$ref": "#/$defs/artifact_ref"},
        "function": {"$ref": "#/$defs/function_mapping"}
      },
      "additionalProperties": false
    }
  }
}
