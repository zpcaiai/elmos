{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Batch29RouteManifest",
  "type": "object",
  "required": [
    "schema_version",
    "route_key",
    "version",
    "status",
    "owner",
    "source",
    "target",
    "paths",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "route_key": {
      "type": "string",
      "pattern": "^[a-z]+-to-[a-z]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "status": {
      "enum": [
        "research",
        "experimental",
        "limited",
        "certified",
        "deprecated",
        "blocked"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "maintenance_owner": {
      "type": "string",
      "minLength": 1
    },
    "review_date": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "language",
        "versions",
        "engine_path"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        },
        "engine_path": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "language",
        "versions",
        "engine_path"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": ".*\\S.*"
          }
        },
        "engine_path": {
          "type": "string",
          "minLength": 1,
          "pattern": ".*\\S.*"
        }
      }
    },
    "paths": {
      "type": "object",
      "required": [
        "support_matrix",
        "corpus",
        "certification"
      ]
    },
    "gates": {
      "type": "object"
    },
    "profiles": {
      "type": "object"
    },
    "framework_profiles": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "research"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "profiles",
          "framework_profiles"
        ],
        "properties": {
          "profiles": {
            "const": {
              "semantic_profile": "",
              "target_profile": ""
            }
          },
          "framework_profiles": {
            "const": []
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
