{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/batch31/chinadb-skill-request.schema.json",
  "title": "ELMOS bounded ChinaDB Skill request envelope",
  "description": "Common tenant/project/actor envelope for one exact repository-owned ChinaDB Skill handler. Handler-specific fields are validated by the selected typed handler.",
  "type": "object",
  "required": ["scope"],
  "minProperties": 2,
  "maxProperties": 2000,
  "properties": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "projectId", "actorId"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/scopeToken" },
        "projectId": { "$ref": "#/$defs/scopeToken" },
        "actorId": { "$ref": "#/$defs/scopeToken" }
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "scopeToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    }
  }
}
