{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/batch31/chinadb-production-qualification-request.schema.json",
  "title": "ELMOS ChinaDB production qualification request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "capabilitySnapshotDigest",
    "trustStoreDigest",
    "implementer",
    "targets"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "scope": { "$ref": "#/$defs/scope" },
    "capabilitySnapshotDigest": { "$ref": "#/$defs/digest" },
    "trustStoreDigest": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/digest" }
      ]
    },
    "implementer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "organizationId"],
      "properties": {
        "actorId": { "$ref": "#/$defs/scopeToken" },
        "organizationId": { "$ref": "#/$defs/scopeToken" }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "targetId": {
      "enum": [
        "dm8",
        "kingbasees",
        "opengauss",
        "tidb",
        "gbase-8s",
        "gbase-8c",
        "gbase-8a",
        "highgo-hgdb",
        "oceanbase-oracle",
        "oceanbase-mysql",
        "gaussdb-oracle",
        "gaussdb-m",
        "goldendb"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "exactTuple",
        "disposableEnvironment",
        "vendorTools",
        "independentVerifier",
        "receipts"
      ],
      "properties": {
        "targetId": { "$ref": "#/$defs/targetId" },
        "exactTuple": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/exactTuple" }
          ]
        },
        "disposableEnvironment": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/environment" }
          ]
        },
        "vendorTools": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/vendorTool" }
        },
        "independentVerifier": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/verifier" }
          ]
        },
        "receipts": { "$ref": "#/$defs/receipts" }
      }
    },
    "exactTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productId",
        "productVersion",
        "edition",
        "compatibilityMode",
        "deploymentTopology",
        "provider",
        "serviceTier",
        "region",
        "driver",
        "charset",
        "collation",
        "timeZone",
        "timeZoneDataVersion",
        "sqlMode",
        "extensions",
        "runtimeArtifactDigest"
      ],
      "properties": {
        "productId": { "$ref": "#/$defs/targetId" },
        "productVersion": { "$ref": "#/$defs/exactToken" },
        "edition": { "$ref": "#/$defs/exactToken" },
        "compatibilityMode": { "$ref": "#/$defs/exactToken" },
        "deploymentTopology": { "$ref": "#/$defs/exactToken" },
        "provider": { "$ref": "#/$defs/exactToken" },
        "serviceTier": { "$ref": "#/$defs/exactToken" },
        "region": { "$ref": "#/$defs/exactToken" },
        "driver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "artifactDigest"],
          "properties": {
            "name": { "$ref": "#/$defs/exactToken" },
            "version": { "$ref": "#/$defs/exactToken" },
            "artifactDigest": { "$ref": "#/$defs/digest" }
          }
        },
        "charset": { "$ref": "#/$defs/exactToken" },
        "collation": { "$ref": "#/$defs/exactToken" },
        "timeZone": { "$ref": "#/$defs/exactToken" },
        "timeZoneDataVersion": { "$ref": "#/$defs/exactToken" },
        "sqlMode": { "$ref": "#/$defs/exactToken" },
        "extensions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "$ref": "#/$defs/exactToken" },
              "version": { "$ref": "#/$defs/exactToken" }
            }
          }
        },
        "runtimeArtifactDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentId",
        "kind",
        "endpointRef",
        "credentialRef",
        "providerResourceRef",
        "dataProfile",
        "productionData",
        "writeScope",
        "expiresAt",
        "cleanupDeadline"
      ],
      "properties": {
        "environmentId": { "$ref": "#/$defs/exactToken" },
        "kind": {
          "enum": [
            "DISPOSABLE_INSTANCE",
            "DISPOSABLE_SCHEMA",
            "APPROVED_LICENSED_SANDBOX"
          ]
        },
        "endpointRef": { "$ref": "#/$defs/exactToken" },
        "credentialRef": { "$ref": "#/$defs/exactToken" },
        "providerResourceRef": { "$ref": "#/$defs/exactToken" },
        "dataProfile": { "enum": ["SYNTHETIC", "MASKED", "APPROVED_SNAPSHOT"] },
        "productionData": { "const": false },
        "writeScope": { "const": "DISPOSABLE_ONLY" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "cleanupDeadline": { "$ref": "#/$defs/timestamp" }
      }
    },
    "vendorTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolId",
        "version",
        "artifactDigest",
        "licenseRef",
        "adapterId",
        "operations"
      ],
      "properties": {
        "toolId": { "$ref": "#/$defs/exactToken" },
        "version": { "$ref": "#/$defs/exactToken" },
        "artifactDigest": { "$ref": "#/$defs/digest" },
        "licenseRef": { "$ref": "#/$defs/exactToken" },
        "adapterId": { "$ref": "#/$defs/exactToken" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifierId", "actorId", "organizationId", "engagementRef"],
      "properties": {
        "verifierId": { "$ref": "#/$defs/scopeToken" },
        "actorId": { "$ref": "#/$defs/scopeToken" },
        "organizationId": { "$ref": "#/$defs/scopeToken" },
        "engagementRef": { "$ref": "#/$defs/scopeToken" }
      }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization",
        "execution",
        "independentVerification",
        "certification"
      ],
      "properties": {
        "authorization": { "$ref": "#/$defs/nullableAuthorizationEnvelope" },
        "execution": { "$ref": "#/$defs/nullableExecutionEnvelope" },
        "independentVerification": { "$ref": "#/$defs/nullableVerificationEnvelope" },
        "certification": { "$ref": "#/$defs/nullableCertificationEnvelope" }
      }
    },
    "nullableEnvelope": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/envelope" }
      ]
    },
    "nullableAuthorizationEnvelope": {
      "anyOf": [
        { "type": "null" },
        {
          "allOf": [
            { "$ref": "#/$defs/envelope" },
            {
              "properties": {
                "payload": { "$ref": "#/$defs/authorizationPayload" }
              }
            }
          ]
        }
      ]
    },
    "nullableExecutionEnvelope": {
      "anyOf": [
        { "type": "null" },
        {
          "allOf": [
            { "$ref": "#/$defs/envelope" },
            {
              "properties": {
                "payload": { "$ref": "#/$defs/executionPayload" }
              }
            }
          ]
        }
      ]
    },
    "nullableVerificationEnvelope": {
      "anyOf": [
        { "type": "null" },
        {
          "allOf": [
            { "$ref": "#/$defs/envelope" },
            {
              "properties": {
                "payload": { "$ref": "#/$defs/verificationPayload" }
              }
            }
          ]
        }
      ]
    },
    "nullableCertificationEnvelope": {
      "anyOf": [
        { "type": "null" },
        {
          "allOf": [
            { "$ref": "#/$defs/envelope" },
            {
              "properties": {
                "payload": { "$ref": "#/$defs/certificationPayload" }
              }
            }
          ]
        }
      ]
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "payload", "signature"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "$ref": "#/$defs/exactToken" },
        "payload": {
          "oneOf": [
            { "$ref": "#/$defs/authorizationPayload" },
            { "$ref": "#/$defs/executionPayload" },
            { "$ref": "#/$defs/verificationPayload" },
            { "$ref": "#/$defs/certificationPayload" }
          ]
        },
        "signature": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      }
    },
    "authorizationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "recordId",
        "scopeDigest",
        "targetId",
        "qualificationInputDigest",
        "environmentId",
        "implementerActorId",
        "implementerOrganizationId",
        "allowedOperations",
        "issuedAt",
        "expiresAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "const": "CHINADB_TARGET_EXECUTION_AUTHORIZATION" },
        "recordId": { "$ref": "#/$defs/exactToken" },
        "scopeDigest": { "$ref": "#/$defs/digest" },
        "targetId": { "$ref": "#/$defs/targetId" },
        "qualificationInputDigest": { "$ref": "#/$defs/digest" },
        "environmentId": { "$ref": "#/$defs/exactToken" },
        "implementerActorId": { "$ref": "#/$defs/scopeToken" },
        "implementerOrganizationId": { "$ref": "#/$defs/scopeToken" },
        "allowedOperations": {
          "const": [
            "APPLY_SANDBOX",
            "BACKUP_RESTORE",
            "CAPABILITY_PROBE",
            "CAPTURE_PLAN",
            "CDC_RECONCILIATION",
            "CLEANUP",
            "EXECUTE_WORKLOAD",
            "INTROSPECT",
            "RENDER",
            "VERSION_PROBE"
          ]
        },
        "issuedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "executionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "recordId",
        "authorizationRecordId",
        "authorizationEnvelopeDigest",
        "scopeDigest",
        "targetId",
        "qualificationInputDigest",
        "environmentId",
        "exactTupleDigest",
        "vendorToolDigests",
        "artifactDigests",
        "evidenceDigests",
        "routeEnvironmentSummary",
        "databaseSurfaceSummary",
        "cdcSummary",
        "reconciliationSummary",
        "failureInjectionSummary",
        "performanceSummary",
        "executedAt",
        "checks",
        "criticalUnknowns",
        "criticalDifferences",
        "testIntegrityViolations"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "const": "CHINADB_TARGET_EXECUTION_RECEIPT" },
        "recordId": { "$ref": "#/$defs/exactToken" },
        "authorizationRecordId": { "$ref": "#/$defs/exactToken" },
        "authorizationEnvelopeDigest": { "$ref": "#/$defs/digest" },
        "scopeDigest": { "$ref": "#/$defs/digest" },
        "targetId": { "$ref": "#/$defs/targetId" },
        "qualificationInputDigest": { "$ref": "#/$defs/digest" },
        "environmentId": { "$ref": "#/$defs/exactToken" },
        "exactTupleDigest": { "$ref": "#/$defs/digest" },
        "vendorToolDigests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "artifactDigests": { "$ref": "#/$defs/artifactDigests" },
        "evidenceDigests": { "$ref": "#/$defs/evidenceDigests" },
        "routeEnvironmentSummary": { "$ref": "#/$defs/routeEnvironmentSummary" },
        "databaseSurfaceSummary": { "$ref": "#/$defs/databaseSurfaceSummary" },
        "cdcSummary": { "$ref": "#/$defs/cdcSummary" },
        "reconciliationSummary": { "$ref": "#/$defs/reconciliationSummary" },
        "failureInjectionSummary": { "$ref": "#/$defs/failureInjectionSummary" },
        "performanceSummary": { "$ref": "#/$defs/performanceSummary" },
        "executedAt": { "$ref": "#/$defs/timestamp" },
        "checks": { "$ref": "#/$defs/executionChecks" },
        "criticalUnknowns": { "const": 0 },
        "criticalDifferences": { "const": 0 },
        "testIntegrityViolations": { "const": 0 }
      }
    },
    "performanceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runnerClass",
        "isolation",
        "measurementClock",
        "runnerAttestationDigest",
        "runnerAttestationVerified",
        "sloP95Milliseconds",
        "maximumMeasurementAttempts",
        "measurementAttemptCount",
        "warmupCountPerQuery",
        "sampleCountPerQuery",
        "queryCount",
        "normalizedOneMinuteLoad",
        "maximumObservedSourceP95Milliseconds",
        "maximumObservedTargetP95Milliseconds"
      ],
      "properties": {
        "runnerClass": { "const": "DEDICATED" },
        "isolation": { "const": "EXCLUSIVE_SINGLE_QUALIFICATION" },
        "measurementClock": { "const": "MONOTONIC_HIGH_RESOLUTION" },
        "runnerAttestationDigest": { "$ref": "#/$defs/digest" },
        "runnerAttestationVerified": { "const": true },
        "sloP95Milliseconds": { "const": 75.0 },
        "maximumMeasurementAttempts": { "const": 2 },
        "measurementAttemptCount": { "type": "integer", "minimum": 1, "maximum": 2 },
        "warmupCountPerQuery": { "const": 5 },
        "sampleCountPerQuery": { "const": 40 },
        "queryCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "normalizedOneMinuteLoad": { "type": "number", "minimum": 0, "maximum": 1.0 },
        "maximumObservedSourceP95Milliseconds": { "type": "number", "minimum": 0, "maximum": 75.0 },
        "maximumObservedTargetP95Milliseconds": { "type": "number", "minimum": 0, "maximum": 75.0 }
      }
    },
    "routeEnvironmentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceEnvironmentId", "sourceEnvironmentKind", "targetEnvironmentId",
        "targetEnvironmentKind", "sourceProductId", "sourceProductVersion",
        "sourceEdition", "sourceDriverName", "sourceDriverVersion",
        "sourceRuntimeArtifactDigest", "sourceDriverArtifactDigest",
        "sourceDisposable", "targetDisposable", "environmentsIndependent",
        "networkIsolated", "targetPatchVersion", "targetLicenseRef",
        "targetLicenseDigest", "targetLicenseVerified", "targetRuntimeArtifactDigest",
        "targetDriverArtifactDigest", "deploymentTopology", "compatibilityMode",
        "charset", "collation", "timeZone", "rowLevelSecurityMode"
      ],
      "properties": {
        "sourceEnvironmentId": { "$ref": "#/$defs/exactToken" },
        "sourceEnvironmentKind": { "enum": ["DISPOSABLE_INSTANCE", "DISPOSABLE_SCHEMA", "APPROVED_LICENSED_SANDBOX"] },
        "targetEnvironmentId": { "$ref": "#/$defs/exactToken" },
        "targetEnvironmentKind": { "enum": ["DISPOSABLE_INSTANCE", "DISPOSABLE_SCHEMA", "APPROVED_LICENSED_SANDBOX"] },
        "sourceProductId": { "$ref": "#/$defs/exactToken" },
        "sourceProductVersion": { "$ref": "#/$defs/exactToken" },
        "sourceEdition": { "$ref": "#/$defs/exactToken" },
        "sourceDriverName": { "$ref": "#/$defs/exactToken" },
        "sourceDriverVersion": { "$ref": "#/$defs/exactToken" },
        "sourceRuntimeArtifactDigest": { "$ref": "#/$defs/digest" },
        "sourceDriverArtifactDigest": { "$ref": "#/$defs/digest" },
        "sourceDisposable": { "const": true },
        "targetDisposable": { "const": true },
        "environmentsIndependent": { "const": true },
        "networkIsolated": { "const": true },
        "targetPatchVersion": { "$ref": "#/$defs/exactToken" },
        "targetLicenseRef": { "$ref": "#/$defs/exactToken" },
        "targetLicenseDigest": { "$ref": "#/$defs/digest" },
        "targetLicenseVerified": { "const": true },
        "targetRuntimeArtifactDigest": { "$ref": "#/$defs/digest" },
        "targetDriverArtifactDigest": { "$ref": "#/$defs/digest" },
        "deploymentTopology": { "$ref": "#/$defs/exactToken" },
        "compatibilityMode": { "$ref": "#/$defs/exactToken" },
        "charset": { "$ref": "#/$defs/exactToken" },
        "collation": { "$ref": "#/$defs/exactToken" },
        "timeZone": { "$ref": "#/$defs/exactToken" },
        "rowLevelSecurityMode": { "$ref": "#/$defs/exactToken" }
      }
    },
    "surfaceCaseSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positiveCaseCount", "negativeCaseCount", "status"],
      "properties": {
        "positiveCaseCount": { "type": "integer", "minimum": 1 },
        "negativeCaseCount": { "type": "integer", "minimum": 1 },
        "status": { "const": "PASSED" }
      }
    },
    "databaseSurfaceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ddl", "dml", "typeBoundary", "constraints", "indexes", "sequences", "routines", "triggers", "privileges", "rowLevelSecurity"],
      "properties": {
        "ddl": { "$ref": "#/$defs/surfaceCaseSummary" },
        "dml": { "$ref": "#/$defs/surfaceCaseSummary" },
        "typeBoundary": { "$ref": "#/$defs/surfaceCaseSummary" },
        "constraints": { "$ref": "#/$defs/surfaceCaseSummary" },
        "indexes": { "$ref": "#/$defs/surfaceCaseSummary" },
        "sequences": { "$ref": "#/$defs/surfaceCaseSummary" },
        "routines": { "$ref": "#/$defs/surfaceCaseSummary" },
        "triggers": { "$ref": "#/$defs/surfaceCaseSummary" },
        "privileges": { "$ref": "#/$defs/surfaceCaseSummary" },
        "rowLevelSecurity": { "$ref": "#/$defs/surfaceCaseSummary" }
      }
    },
    "cdcSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backfillCheckpointed", "durableCheckpoint", "checkpointCount", "lastSourcePosition", "lastTargetPosition", "lagSloMilliseconds", "maximumObservedLagMilliseconds", "missingEventCount", "duplicateEffectCount", "insertPropagation", "updatePropagation", "deletePropagation", "duplicateSuppression", "outOfOrderHandling", "restartResume"],
      "properties": {
        "backfillCheckpointed": { "const": true },
        "durableCheckpoint": { "const": true },
        "checkpointCount": { "type": "integer", "minimum": 1 },
        "lastSourcePosition": { "$ref": "#/$defs/exactToken" },
        "lastTargetPosition": { "$ref": "#/$defs/exactToken" },
        "lagSloMilliseconds": { "type": "number", "exclusiveMinimum": 0 },
        "maximumObservedLagMilliseconds": { "type": "number", "minimum": 0 },
        "missingEventCount": { "const": 0 },
        "duplicateEffectCount": { "const": 0 },
        "insertPropagation": { "const": "PASSED" },
        "updatePropagation": { "const": "PASSED" },
        "deletePropagation": { "const": "PASSED" },
        "duplicateSuppression": { "const": "PASSED" },
        "outOfOrderHandling": { "const": "PASSED" },
        "restartResume": { "const": "PASSED" }
      }
    },
    "reconciliationSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["granularity", "tableCount", "primaryKeyCount", "rowCount", "fieldCount", "moneyColumnCount", "moneyPrecisionExact", "moneyScaleExact", "p0DifferenceCount", "missingRowCount", "duplicateRowCount", "fieldMismatchCount"],
      "properties": {
        "granularity": { "const": "TABLE_PRIMARY_KEY_ROW_FIELD" },
        "tableCount": { "type": "integer", "minimum": 1 },
        "primaryKeyCount": { "type": "integer", "minimum": 1 },
        "rowCount": { "type": "integer", "minimum": 1 },
        "fieldCount": { "type": "integer", "minimum": 1 },
        "moneyColumnCount": { "type": "integer", "minimum": 1 },
        "moneyPrecisionExact": { "const": true },
        "moneyScaleExact": { "const": true },
        "p0DifferenceCount": { "const": 0 },
        "missingRowCount": { "const": 0 },
        "duplicateRowCount": { "const": 0 },
        "fieldMismatchCount": { "const": 0 }
      }
    },
    "failureInjectionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarios", "targetWindowWriteCount", "targetWindowWriteLossCount", "rollbackPreservedTargetWindowWrites", "forwardRecoveryVerified"],
      "properties": {
        "scenarios": {
          "type": "object",
          "additionalProperties": false,
          "required": ["processTermination", "networkInterruption", "duplicateEvent", "outOfOrderEvent", "diskPressure", "cdcRestart", "cutoverFailure", "rollback"],
          "properties": {
            "processTermination": { "const": "PASSED" },
            "networkInterruption": { "const": "PASSED" },
            "duplicateEvent": { "const": "PASSED" },
            "outOfOrderEvent": { "const": "PASSED" },
            "diskPressure": { "const": "PASSED" },
            "cdcRestart": { "const": "PASSED" },
            "cutoverFailure": { "const": "PASSED" },
            "rollback": { "const": "PASSED" }
          }
        },
        "targetWindowWriteCount": { "type": "integer", "minimum": 1 },
        "targetWindowWriteLossCount": { "const": 0 },
        "rollbackPreservedTargetWindowWrites": { "const": true },
        "forwardRecoveryVerified": { "const": true }
      }
    },
    "verificationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "recordId",
        "scopeDigest",
        "targetId",
        "qualificationInputDigest",
        "executionRecordId",
        "executionEnvelopeDigest",
        "rawEvidenceDigest",
        "holdoutCorpusDigest",
        "representativeWorkloadDigest",
        "decision",
        "criticalFindings",
        "verifiedAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "const": "CHINADB_INDEPENDENT_VERIFICATION_RECEIPT" },
        "recordId": { "$ref": "#/$defs/exactToken" },
        "scopeDigest": { "$ref": "#/$defs/digest" },
        "targetId": { "$ref": "#/$defs/targetId" },
        "qualificationInputDigest": { "$ref": "#/$defs/digest" },
        "executionRecordId": { "$ref": "#/$defs/exactToken" },
        "executionEnvelopeDigest": { "$ref": "#/$defs/digest" },
        "rawEvidenceDigest": { "$ref": "#/$defs/digest" },
        "holdoutCorpusDigest": { "$ref": "#/$defs/digest" },
        "representativeWorkloadDigest": { "$ref": "#/$defs/digest" },
        "decision": { "const": "PASSED" },
        "criticalFindings": { "const": 0 },
        "verifiedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "certificationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "recordId",
        "scopeDigest",
        "targetId",
        "qualificationInputDigest",
        "verificationRecordId",
        "verificationEnvelopeDigest",
        "decision",
        "certifiedAt",
        "expiresAt"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "kind": { "const": "CHINADB_PRODUCTION_CERTIFICATION_RECEIPT" },
        "recordId": { "$ref": "#/$defs/exactToken" },
        "scopeDigest": { "$ref": "#/$defs/digest" },
        "targetId": { "$ref": "#/$defs/targetId" },
        "qualificationInputDigest": { "$ref": "#/$defs/digest" },
        "verificationRecordId": { "$ref": "#/$defs/exactToken" },
        "verificationEnvelopeDigest": { "$ref": "#/$defs/digest" },
        "decision": { "const": "CERTIFIED" },
        "certifiedAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "artifactDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSnapshotDigest",
        "sourceCatalogDigest",
        "sourceDataDigest",
        "sourceWorkloadDigest",
        "targetSnapshotDigest",
        "targetReleaseDigest",
        "canonicalIrDigest",
        "transformationDigest",
        "compatibilityRuntimeDigest",
        "runnerDigest",
        "toolchainDigest",
        "developmentCorpusDigest",
        "negativeCorpusDigest",
        "holdoutCorpusDigest",
        "representativeWorkloadDigest",
        "dataFixtureDigest",
        "queryPlanDigest",
        "targetSqlDigest",
        "acceptanceProfileDigest",
        "gateResultDigest"
      ],
      "properties": {
        "sourceSnapshotDigest": { "$ref": "#/$defs/digest" },
        "sourceCatalogDigest": { "$ref": "#/$defs/digest" },
        "sourceDataDigest": { "$ref": "#/$defs/digest" },
        "sourceWorkloadDigest": { "$ref": "#/$defs/digest" },
        "targetSnapshotDigest": { "$ref": "#/$defs/digest" },
        "targetReleaseDigest": { "$ref": "#/$defs/digest" },
        "canonicalIrDigest": { "$ref": "#/$defs/digest" },
        "transformationDigest": { "$ref": "#/$defs/digest" },
        "compatibilityRuntimeDigest": { "$ref": "#/$defs/digest" },
        "runnerDigest": { "$ref": "#/$defs/digest" },
        "toolchainDigest": { "$ref": "#/$defs/digest" },
        "developmentCorpusDigest": { "$ref": "#/$defs/digest" },
        "negativeCorpusDigest": { "$ref": "#/$defs/digest" },
        "holdoutCorpusDigest": { "$ref": "#/$defs/digest" },
        "representativeWorkloadDigest": { "$ref": "#/$defs/digest" },
        "dataFixtureDigest": { "$ref": "#/$defs/digest" },
        "queryPlanDigest": { "$ref": "#/$defs/digest" },
        "targetSqlDigest": { "$ref": "#/$defs/digest" },
        "acceptanceProfileDigest": { "$ref": "#/$defs/digest" },
        "gateResultDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidenceDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "versionProbeDigest",
        "capabilityProbeDigest",
        "renderDigest",
        "targetApplyDigest",
        "introspectionDigest",
        "schemaTypeDigest",
        "queryRoutineDigest",
        "transactionDigest",
        "dataReconciliationDigest",
        "performanceDigest",
        "securityDigest",
        "backupRestoreDigest",
        "cdcDigest",
        "rollbackDigest",
        "cleanupDigest",
        "rawEvidenceDigest"
      ],
      "properties": {
        "versionProbeDigest": { "$ref": "#/$defs/digest" },
        "capabilityProbeDigest": { "$ref": "#/$defs/digest" },
        "renderDigest": { "$ref": "#/$defs/digest" },
        "targetApplyDigest": { "$ref": "#/$defs/digest" },
        "introspectionDigest": { "$ref": "#/$defs/digest" },
        "schemaTypeDigest": { "$ref": "#/$defs/digest" },
        "queryRoutineDigest": { "$ref": "#/$defs/digest" },
        "transactionDigest": { "$ref": "#/$defs/digest" },
        "dataReconciliationDigest": { "$ref": "#/$defs/digest" },
        "performanceDigest": { "$ref": "#/$defs/digest" },
        "securityDigest": { "$ref": "#/$defs/digest" },
        "backupRestoreDigest": { "$ref": "#/$defs/digest" },
        "cdcDigest": { "$ref": "#/$defs/digest" },
        "rollbackDigest": { "$ref": "#/$defs/digest" },
        "cleanupDigest": { "$ref": "#/$defs/digest" },
        "rawEvidenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "executionChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityProbe",
        "cleanup",
        "dataReconciliation",
        "performanceSecurityRollback",
        "schemaTypeQueryRoutineTransaction",
        "targetApplyIntrospection",
        "targetRender",
        "versionProbe"
      ],
      "properties": {
        "capabilityProbe": { "const": "PASSED" },
        "cleanup": { "const": "PASSED" },
        "dataReconciliation": { "const": "PASSED" },
        "performanceSecurityRollback": { "const": "PASSED" },
        "schemaTypeQueryRoutineTransaction": { "const": "PASSED" },
        "targetApplyIntrospection": { "const": "PASSED" },
        "targetRender": { "const": "PASSED" },
        "versionProbe": { "const": "PASSED" }
      }
    },
    "operation": {
      "enum": [
        "APPLY_SANDBOX",
        "BACKUP_RESTORE",
        "CAPABILITY_PROBE",
        "CAPTURE_PLAN",
        "CDC_RECONCILIATION",
        "CLEANUP",
        "EXECUTE_WORKLOAD",
        "INTROSPECT",
        "RENDER",
        "VERSION_PROBE"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "projectId", "actorId"],
      "properties": {
        "tenantId": { "$ref": "#/$defs/scopeToken" },
        "projectId": { "$ref": "#/$defs/scopeToken" },
        "actorId": { "$ref": "#/$defs/scopeToken" }
      }
    },
    "scopeToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
    },
    "exactToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+~-]{0,255}$",
      "not": { "enum": ["latest", "current", "unknown", "unspecified", "unset", "*", "x"] }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
