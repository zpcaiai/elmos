{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "profile_key", "version", "owner", "engine", "versions", "edition", "dialect", "driver_versions", "charset", "collation", "timezone", "extensions", "provision", "health_check", "security", "migration"],
  "properties": {
    "schema_version": {"const": 1},
    "profile_key": {"type": "string", "minLength": 1},
    "version": {"type": ["string", "integer"]},
    "owner": {"type": "string", "minLength": 1},
    "engine": {"type": "string", "minLength": 1},
    "versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "edition": {"type": "string", "minLength": 1},
    "dialect": {"type": "string", "minLength": 1},
    "driver_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "charset": {"type": "string", "minLength": 1},
    "collation": {"type": "string", "minLength": 1},
    "timezone": {"type": "string", "minLength": 1},
    "extensions": {"type": "array", "items": {"type": "string"}},
    "provision": {"type": "object"},
    "health_check": {"type": "object"},
    "security": {"type": "object"},
    "migration": {"type": "object"}
  }
}
