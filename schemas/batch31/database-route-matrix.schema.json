{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_key", "tuples", "recertification_triggers"],
  "properties": {
    "schema_version": {"const": 1},
    "pack_key": {"type": "string", "minLength": 1},
    "tuples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "status", "evidence_refs"],
        "properties": {
          "source": {"$ref": "#/$defs/side"},
          "target": {"$ref": "#/$defs/side"},
          "status": {"enum": ["research", "experimental", "limited", "certified", "blocked"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "restrictions": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "recertification_triggers": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "side": {
      "type": "object",
      "additionalProperties": true,
      "required": ["engine", "versions", "edition", "dialect", "driver_versions", "charset", "collation", "timezone", "extensions"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "edition": {"type": "string", "minLength": 1},
        "dialect": {"type": "string", "minLength": 1},
        "driver_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "charset": {"type": "string", "minLength": 1},
        "collation": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1},
        "extensions": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
