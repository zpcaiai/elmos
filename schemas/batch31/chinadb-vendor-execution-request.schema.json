{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "kind", "idempotencyKey", "scope", "scopeDigest", "targetId", "adapterId", "qualificationInputDigest", "exactTuple", "exactTupleDigest", "disposableEnvironment", "environmentDigest", "vendorTools", "vendorToolDigests", "allowedOperations", "inputArtifactDigests", "authorizationEnvelope", "authorizationEnvelopeDigest", "safety", "externalExecution", "certification", "requestDigest"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "protocolVersion": {"const": "1.1.0"},
    "kind": {"const": "CHINADB_VENDOR_EXECUTION_REQUEST"},
    "idempotencyKey": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope": {"type": "object"},
    "scopeDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "targetId": {"type": "string", "minLength": 1},
    "adapterId": {"type": "string", "minLength": 1},
    "qualificationInputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "exactTuple": {"type": "object"},
    "exactTupleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "disposableEnvironment": {"type": "object"},
    "environmentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "vendorTools": {"type": "array", "minItems": 1},
    "vendorToolDigests": {"type": "array", "minItems": 1},
    "allowedOperations": {
      "type": "array",
      "const": ["APPLY_SANDBOX", "BACKUP_RESTORE", "CAPABILITY_PROBE", "CAPTURE_PLAN", "CDC_RECONCILIATION", "CLEANUP", "EXECUTE_WORKLOAD", "INTROSPECT", "RENDER", "VERSION_PROBE"]
    },
    "inputArtifactDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSnapshotDigest", "sourceCatalogDigest", "sourceDataDigest", "sourceWorkloadDigest", "canonicalIrDigest", "transformationDigest", "compatibilityRuntimeDigest", "runnerDigest", "toolchainDigest", "developmentCorpusDigest", "negativeCorpusDigest", "holdoutCorpusDigest", "representativeWorkloadDigest", "dataFixtureDigest", "targetSqlDigest", "acceptanceProfileDigest"],
      "properties": {
        "sourceSnapshotDigest": {"$ref": "#/$defs/digest"},
        "sourceCatalogDigest": {"$ref": "#/$defs/digest"},
        "sourceDataDigest": {"$ref": "#/$defs/digest"},
        "sourceWorkloadDigest": {"$ref": "#/$defs/digest"},
        "canonicalIrDigest": {"$ref": "#/$defs/digest"},
        "transformationDigest": {"$ref": "#/$defs/digest"},
        "compatibilityRuntimeDigest": {"$ref": "#/$defs/digest"},
        "runnerDigest": {"$ref": "#/$defs/digest"},
        "toolchainDigest": {"$ref": "#/$defs/digest"},
        "developmentCorpusDigest": {"$ref": "#/$defs/digest"},
        "negativeCorpusDigest": {"$ref": "#/$defs/digest"},
        "holdoutCorpusDigest": {"$ref": "#/$defs/digest"},
        "representativeWorkloadDigest": {"$ref": "#/$defs/digest"},
        "dataFixtureDigest": {"$ref": "#/$defs/digest"},
        "targetSqlDigest": {"$ref": "#/$defs/digest"},
        "acceptanceProfileDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "authorizationEnvelope": {"type": "object"},
    "authorizationEnvelopeDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionData", "writeScope", "secretTransport", "cleanupRequired", "unknownOutcomePolicy"],
      "properties": {
        "productionData": {"const": false},
        "writeScope": {"const": "DISPOSABLE_ONLY"},
        "secretTransport": {"const": "OPAQUE_REFERENCE_ONLY"},
        "cleanupRequired": {"const": true},
        "unknownOutcomePolicy": {"const": "RECONCILE_BEFORE_RETRY"}
      }
    },
    "externalExecution": {"const": "NOT_RUN"},
    "certification": {"const": "NOT_CERTIFIED"},
    "requestDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
