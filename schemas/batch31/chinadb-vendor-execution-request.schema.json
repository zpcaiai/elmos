{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "kind", "idempotencyKey", "scope", "scopeDigest", "targetId", "adapterId", "qualificationInputDigest", "exactTuple", "exactTupleDigest", "disposableEnvironment", "environmentDigest", "vendorTools", "vendorToolDigests", "allowedOperations", "inputArtifactDigests", "authorizationEnvelope", "authorizationEnvelopeDigest", "phase1ExecutionContract", "performanceContract", "safety", "externalExecution", "certification", "requestDigest"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "protocolVersion": {"const": "1.3.0"},
    "kind": {"const": "CHINADB_VENDOR_EXECUTION_REQUEST"},
    "idempotencyKey": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope": {"type": "object"},
    "scopeDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "targetId": {"type": "string", "minLength": 1},
    "adapterId": {"type": "string", "minLength": 1},
    "qualificationInputDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "exactTuple": {"type": "object"},
    "exactTupleDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "disposableEnvironment": {"type": "object"},
    "environmentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "vendorTools": {"type": "array", "minItems": 1},
    "vendorToolDigests": {"type": "array", "minItems": 1},
    "allowedOperations": {
      "type": "array",
      "const": ["APPLY_SANDBOX", "BACKUP_RESTORE", "CAPABILITY_PROBE", "CAPTURE_PLAN", "CDC_RECONCILIATION", "CLEANUP", "EXECUTE_WORKLOAD", "INTROSPECT", "RENDER", "VERSION_PROBE"]
    },
    "inputArtifactDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceSnapshotDigest", "sourceCatalogDigest", "sourceDataDigest", "sourceWorkloadDigest", "canonicalIrDigest", "transformationDigest", "compatibilityRuntimeDigest", "runnerDigest", "toolchainDigest", "developmentCorpusDigest", "negativeCorpusDigest", "holdoutCorpusDigest", "representativeWorkloadDigest", "dataFixtureDigest", "targetSqlDigest", "acceptanceProfileDigest"],
      "properties": {
        "sourceSnapshotDigest": {"$ref": "#/$defs/digest"},
        "sourceCatalogDigest": {"$ref": "#/$defs/digest"},
        "sourceDataDigest": {"$ref": "#/$defs/digest"},
        "sourceWorkloadDigest": {"$ref": "#/$defs/digest"},
        "canonicalIrDigest": {"$ref": "#/$defs/digest"},
        "transformationDigest": {"$ref": "#/$defs/digest"},
        "compatibilityRuntimeDigest": {"$ref": "#/$defs/digest"},
        "runnerDigest": {"$ref": "#/$defs/digest"},
        "toolchainDigest": {"$ref": "#/$defs/digest"},
        "developmentCorpusDigest": {"$ref": "#/$defs/digest"},
        "negativeCorpusDigest": {"$ref": "#/$defs/digest"},
        "holdoutCorpusDigest": {"$ref": "#/$defs/digest"},
        "representativeWorkloadDigest": {"$ref": "#/$defs/digest"},
        "dataFixtureDigest": {"$ref": "#/$defs/digest"},
        "targetSqlDigest": {"$ref": "#/$defs/digest"},
        "acceptanceProfileDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "authorizationEnvelope": {"type": "object"},
    "authorizationEnvelopeDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "phase1ExecutionContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "databaseSurfaces", "cdcChecks", "failureScenarios", "reconciliationGranularity", "moneyComparison", "p0DifferenceCount", "targetWindowWriteLossCount", "performance", "certificationAuthority"],
      "properties": {
        "route": {"type": "object"},
        "databaseSurfaces": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true},
        "cdcChecks": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true},
        "failureScenarios": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true},
        "reconciliationGranularity": {"const": "TABLE_PRIMARY_KEY_ROW_FIELD"},
        "moneyComparison": {"const": "EXACT_PRECISION_AND_SCALE"},
        "p0DifferenceCount": {"const": 0},
        "targetWindowWriteLossCount": {"const": 0},
        "performance": {"type": "object"},
        "certificationAuthority": {"const": "BATCH31_GATE_ONLY"}
      }
    },
    "performanceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runnerClass", "isolation", "measurementClock", "sloP95Milliseconds", "maximumMeasurementAttempts", "warmupCountPerQuery", "sampleCountPerQuery", "maximumNormalizedOneMinuteLoad", "invalidEnvironmentState"],
      "properties": {
        "runnerClass": {"const": "DEDICATED"},
        "isolation": {"const": "EXCLUSIVE_SINGLE_QUALIFICATION"},
        "measurementClock": {"const": "MONOTONIC_HIGH_RESOLUTION"},
        "sloP95Milliseconds": {"const": 75.0},
        "maximumMeasurementAttempts": {"const": 2},
        "warmupCountPerQuery": {"const": 5},
        "sampleCountPerQuery": {"const": 40},
        "maximumNormalizedOneMinuteLoad": {"const": 1.0},
        "invalidEnvironmentState": {"const": "NOT_RUN_ENVIRONMENT_INVALID"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productionData", "writeScope", "secretTransport", "cleanupRequired", "unknownOutcomePolicy"],
      "properties": {
        "productionData": {"const": false},
        "writeScope": {"const": "DISPOSABLE_ONLY"},
        "secretTransport": {"const": "OPAQUE_REFERENCE_ONLY"},
        "cleanupRequired": {"const": true},
        "unknownOutcomePolicy": {"const": "RECONCILE_BEFORE_RETRY"}
      }
    },
    "externalExecution": {"const": "NOT_RUN"},
    "certification": {"const": "NOT_CERTIFIED"},
    "requestDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
