{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "pack_key", "metrics", "critical_unknowns", "silent_database_drops", "critical_precision_loss", "critical_collation_regressions", "critical_transaction_regressions", "critical_data_differences", "critical_security_regressions", "destructive_unapproved_changes", "test_integrity_violations", "evidence_status", "evidence_refs", "evidence_digests"],
  "properties": {
    "schema_version": {"const": 1},
    "pack_key": {"type": "string", "minLength": 1},
    "metrics": {"type": "object"},
    "critical_unknowns": {"type": "integer", "minimum": 0},
    "silent_database_drops": {"type": "integer", "minimum": 0},
    "critical_precision_loss": {"type": "integer", "minimum": 0},
    "critical_collation_regressions": {"type": "integer", "minimum": 0},
    "critical_transaction_regressions": {"type": "integer", "minimum": 0},
    "critical_data_differences": {"type": "integer", "minimum": 0},
    "critical_security_regressions": {"type": "integer", "minimum": 0},
    "destructive_unapproved_changes": {"type": "integer", "minimum": 0},
    "test_integrity_violations": {"type": "integer", "minimum": 0},
    "evidence_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_execution", "target_execution", "holdout", "representative_workload", "rollback", "security", "cdc", "cutover", "independent_verification", "external_certification"],
      "properties": {
        "source_execution": {"$ref": "#/$defs/status"},
        "target_execution": {"$ref": "#/$defs/status"},
        "holdout": {"$ref": "#/$defs/status"},
        "representative_workload": {"$ref": "#/$defs/status"},
        "rollback": {"$ref": "#/$defs/status"},
        "security": {"$ref": "#/$defs/status"},
        "cdc": {"$ref": "#/$defs/status"},
        "cutover": {"$ref": "#/$defs/status"},
        "independent_verification": {"$ref": "#/$defs/status"},
        "external_certification": {"$ref": "#/$defs/status"}
      }
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_digests": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}},
    "evidence_roles": {
      "type": "object",
      "properties": {
        "executor": {"type": "string"},
        "independent_verifier": {"type": "string"},
        "certification_authority": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["NOT_RUN", "NOT_APPLICABLE", "PASSED_LOCAL", "PASSED_EXTERNAL", "PASSED_INDEPENDENT", "FAILED", "BLOCKED"]
    }
  }
}
