{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/batch31/chinadb-production-target-input.schema.json",
  "title": "ELMOS ChinaDB single-target production input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targetId",
    "exactTuple",
    "disposableEnvironment",
    "vendorTools",
    "independentVerifier"
  ],
  "properties": {
    "targetId": {
      "enum": [
        "dm8",
        "kingbasees",
        "opengauss",
        "tidb",
        "gbase-8s",
        "gbase-8c",
        "gbase-8a",
        "highgo-hgdb",
        "oceanbase-oracle",
        "oceanbase-mysql",
        "gaussdb-oracle",
        "gaussdb-m",
        "goldendb"
      ]
    },
    "exactTuple": { "$ref": "chinadb-production-qualification-request.schema.json#/$defs/exactTuple" },
    "disposableEnvironment": { "$ref": "chinadb-production-qualification-request.schema.json#/$defs/environment" },
    "vendorTools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "chinadb-production-qualification-request.schema.json#/$defs/vendorTool" }
    },
    "independentVerifier": { "$ref": "chinadb-production-qualification-request.schema.json#/$defs/verifier" }
  }
}
