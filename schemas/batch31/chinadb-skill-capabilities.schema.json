{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/batch31/chinadb-skill-capabilities.schema.json",
  "title": "ELMOS ChinaDB repository-owned bounded Skill bindings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "package",
    "runtimeVersion",
    "skillCount",
    "codeImplementedCount",
    "boundedLocalHandlerCoverage",
    "importedSpecificationStatus",
    "productionDefinitionOfDoneCount",
    "productionDefinitionOfDone",
    "bindings",
    "bindingDigest",
    "externalExecution",
    "independentVerification",
    "certification",
    "claim"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "package": { "const": "chinadb-commercial-migration-skills" },
    "runtimeVersion": { "const": "1.0.0" },
    "skillCount": { "const": 47 },
    "codeImplementedCount": { "const": 47 },
    "boundedLocalHandlerCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implemented", "total", "rate"],
      "properties": {
        "implemented": { "const": 47 },
        "total": { "const": 47 },
        "rate": { "const": 1.0 }
      }
    },
    "importedSpecificationStatus": { "const": "SPEC_ONLY" },
    "productionDefinitionOfDoneCount": { "const": 0 },
    "productionDefinitionOfDone": { "const": "BLOCKED_EXTERNAL_EVIDENCE" },
    "bindings": {
      "type": "array",
      "minItems": 47,
      "maxItems": 47,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "skillId",
          "alias",
          "handlerId",
          "category",
          "dependencies",
          "externalEffects",
          "localCodeStatus",
          "externalExecution",
          "independentVerification",
          "certification"
        ],
        "properties": {
          "skillId": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" },
          "alias": { "type": "string", "pattern": "^chinadb-[0-9]{2}-[a-z0-9-]+$" },
          "handlerId": { "type": "string", "minLength": 1, "maxLength": 160 },
          "category": { "type": "string", "minLength": 1, "maxLength": 64 },
          "dependencies": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+$" }
          },
          "externalEffects": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "localCodeStatus": { "const": "CODE_IMPLEMENTED" },
          "externalExecution": { "const": "NOT_RUN" },
          "independentVerification": { "const": "NOT_RUN" },
          "certification": { "const": "NOT_CERTIFIED" }
        }
      }
    },
    "bindingDigest": { "$ref": "#/$defs/digest" },
    "externalExecution": { "const": "NOT_RUN" },
    "independentVerification": { "const": "NOT_RUN" },
    "certification": { "const": "NOT_CERTIFIED" },
    "claim": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
