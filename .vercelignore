# ELMOS is a 100k+ file monorepo. Vercel must receive only the Web Console and
# the exact repository contracts that its server routes read or trace.
*
!.vercelignore

# Vercel Git integration may evaluate the repository fallback from the
# configured apps/web-console project root. Keep an equivalent project-root
# allowlist so that this policy cannot reduce the upload to an empty tree.
!/app
!/app/**
!/lib
!/lib/**
!/public
!/public/**
!/.npmrc
!/next-env.d.ts
!/next.config.ts
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/proxy.ts
!/tsconfig.json
!/vercel.json

# Repository-root evaluation used by the CLI and external-source collector.
!apps
!apps/web-console
!apps/web-console/**

# Static JSON import used by app/lib/pricingCatalog.ts.
!contracts
!contracts/pricing-catalog-schema
!contracts/pricing-catalog-schema/elmos-cny-self-serve-v1.json

# Runtime route-contract reader. Do not upload corpora, formal artifacts, or
# vendor trees: the console reads only these bounded contract/evidence files.
!routes
!routes/inventory.json
!routes/*
!routes/*/route.json
!routes/*/support-matrix.json
!routes/*/certification
!routes/*/certification/certification.json
!routes/*/certification/evidence.json

# Repository marker required by the fail-closed route contract locator.
!/pom.xml

# Exact analyzer/emitter existence bindings validated by translationRoutes.ts.
!engines
!engines/dotnet-engine
!engines/dotnet-engine/src
!engines/dotnet-engine/src/Elmos.Dotnet.SemanticCli
!engines/dotnet-engine/src/Elmos.Dotnet.SemanticCli/Elmos.Dotnet.SemanticCli.csproj
!engines/frontend-client-engine
!engines/frontend-client-engine/src
!engines/frontend-client-engine/src/polyglot.ts
!engines/polyglot-route-engine
!engines/polyglot-route-engine/native
!engines/polyglot-route-engine/native/dart
!engines/polyglot-route-engine/native/dart/analyzer.dart
!engines/polyglot-route-engine/native/go
!engines/polyglot-route-engine/native/go/analyzer.go
!engines/polyglot-route-engine/native/java
!engines/polyglot-route-engine/native/java/Analyzer.java
!engines/polyglot-route-engine/native/kotlin
!engines/polyglot-route-engine/native/kotlin/analyzer.kt
!engines/polyglot-route-engine/native/php
!engines/polyglot-route-engine/native/php/analyzer.php
!engines/polyglot-route-engine/native/react
!engines/polyglot-route-engine/native/react/analyzer.mjs
!engines/polyglot-route-engine/native/rust
!engines/polyglot-route-engine/native/rust/src
!engines/polyglot-route-engine/native/rust/src/main.rs
!engines/polyglot-route-engine/native/swift
!engines/polyglot-route-engine/native/swift/Sources
!engines/polyglot-route-engine/native/swift/Sources/ElmosSwiftAnalyzer
!engines/polyglot-route-engine/native/swift/Sources/ElmosSwiftAnalyzer/main.swift
!engines/polyglot-route-engine/src
!engines/polyglot-route-engine/src/elmos_polyglot_route
!engines/polyglot-route-engine/src/elmos_polyglot_route/clang_analyzer.py
!engines/polyglot-route-engine/src/elmos_polyglot_route/emitter.py
!engines/polyglot-route-engine/src/elmos_polyglot_route/python_analyzer.py

# Exact ChinaDB capability snapshot traced by Next.js server functions.
!engines/database-data-engine
!engines/database-data-engine/sql-transpiler
!engines/database-data-engine/sql-transpiler/src
!engines/database-data-engine/sql-transpiler/src/elmos_sql_transpiler
!engines/database-data-engine/sql-transpiler/src/elmos_sql_transpiler/data
!engines/database-data-engine/sql-transpiler/src/elmos_sql_transpiler/data/chinadb-commercial-v1.json

# Never upload locally derived build, dependency, report, or cache trees.
apps/web-console/.next/**
apps/web-console/node_modules/**
apps/web-console/test-results/**
apps/web-console/playwright-report/**
apps/web-console/coverage/**
apps/web-console/.turbo/**
.next/**
node_modules/**
test-results/**
playwright-report/**
coverage/**
.turbo/**
