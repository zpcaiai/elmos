UV ?= uv
BATCH44_PYTHON ?= $(UV) run --quiet --with jsonschema --with pyyaml python
.PHONY: batch44-check batch44-scaffold batch44-gate batch44-gaps batch44-score batch44-manifest batch44-request
batch44-check:
	$(BATCH44_PYTHON) scripts/mature_product_toolkit.py validate --batch 44
	$(BATCH44_PYTHON) -m unittest discover -s tests/batch44 -p 'test_*.py'
batch44-scaffold:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(OWNER)" || (echo "OWNER=<owner> required" && exit 2)
	$(BATCH44_PYTHON) scripts/mature_product_toolkit.py scaffold --batch 44 --key $(PACK) --owner $(OWNER)
batch44-gate:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(TRUST_STORE)" || (echo "TRUST_STORE=<external-trust-store.json> required" && exit 2)
	$(BATCH44_PYTHON) scripts/mature_product_toolkit.py gate --batch 44 mature-product-packs/batch44/$(PACK) --trust-store $(TRUST_STORE)
batch44-gaps:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH44_PYTHON) scripts/mature_product_toolkit.py gaps --batch 44 mature-product-packs/batch44/$(PACK)
batch44-score:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH44_PYTHON) scripts/mature_product_toolkit.py score --batch 44 mature-product-packs/batch44/$(PACK)/candidates.json $(if $(WRITE),--write,)
batch44-manifest:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(EXECUTOR)" || (echo "EXECUTOR=<identity> required" && exit 2)
	@test -n "$(VERIFIER)" || (echo "VERIFIER=<independent identity> required" && exit 2)
	@test -n "$(AUTHORIZATION)" || (echo "AUTHORIZATION=<ref> required" && exit 2)
	@test -n "$(REPLAY)" || (echo "REPLAY=<command> required" && exit 2)
	@test -n "$(STARTED_AT)" || (echo "STARTED_AT=<ISO-8601> required" && exit 2)
	@test -n "$(FINISHED_AT)" || (echo "FINISHED_AT=<ISO-8601> required" && exit 2)
	$(BATCH44_PYTHON) scripts/mature_product_toolkit.py manifest --batch 44 mature-product-packs/batch44/$(PACK) \
		--artifact mature-product-packs/batch44/$(PACK)/$(ARTIFACT) \
		--environment mature-product-packs/batch44/$(PACK)/$(ENVIRONMENT) \
		--executor $(EXECUTOR) --verifier $(VERIFIER) --authorization $(AUTHORIZATION) \
		--replay-command "$(REPLAY)" --started-at $(STARTED_AT) --finished-at $(FINISHED_AT) \
		--attest-verifier-independent --attest-corpus-independence
batch44-request:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(KEY_ID)" || (echo "KEY_ID=<certification key id> required" && exit 2)
	$(BATCH44_PYTHON) scripts/mature_product_toolkit.py request --batch 44 mature-product-packs/batch44/$(PACK) --key-id $(KEY_ID)
