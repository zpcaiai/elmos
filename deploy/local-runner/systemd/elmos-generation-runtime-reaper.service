[Unit]
Description=ELMOS generation rootless runtime lease reaper
After=network.target

[Service]
Type=simple
User=elmos-runner
Group=elmos-runner
EnvironmentFile=/etc/elmos/generation-runner.env
# The helper receives only the validated ELMOS-prefixed engine context. Never
# inherit an operator shell's Docker context or a rootful/TCP endpoint.
UnsetEnvironment=HOME XDG_RUNTIME_DIR DOCKER_HOST DOCKER_CONTEXT CONTAINER_HOST
ExecStart=/usr/bin/python3 ${ELMOS_REPOSITORY_ROOT}/scripts/operations/generation_runtime_reaper.py --root ${ELMOS_LOCAL_RUNNER_ROOT} --repository-root ${ELMOS_REPOSITORY_ROOT} --engine ${ELMOS_LOCAL_RUNNER_CONTAINER_ENGINE} --interval-seconds 1
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
LockPersonality=true
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
