# Copy to an owner-only file outside the repository and replace every placeholder.
ELMOS_LOCAL_RUNNER_ENABLED=true
ELMOS_LOCAL_RUNNER_ROOT=/absolute/path/to/elmos-runner-state
ELMOS_REPOSITORY_ROOT=/absolute/path/to/elmos
ELMOS_UV_PATH=/absolute/path/to/uv
ELMOS_LOCAL_RUNNER_EXECUTOR=ROOTLESS_CONTAINER
ELMOS_LOCAL_RUNNER_CONTAINER_ENGINE=/absolute/path/to/rootless/podman
# Optional for direct rootless Podman. When configured it must be the canonical,
# owner-only absolute XDG runtime directory used by both the Web Console and reaper.
ELMOS_LOCAL_RUNNER_ENGINE_XDG_RUNTIME_DIR=/run/user/1000
# Required when the engine basename is docker. Supply an absolute AF_UNIX socket
# path, not a unix:// URI; tcp/http/ssh Docker engines are rejected.
# ELMOS_LOCAL_RUNNER_DOCKER_UNIX_SOCKET=/run/user/1000/docker.sock
# none is the production-safe default. slirp4netns is an explicit rootless
# Podman build-only exception. Docker accepts only a pre-created network labeled
# io.elmos.network-purpose=approved-build-egress and io.elmos.approved=true.
ELMOS_LOCAL_RUNNER_BUILD_NETWORK=none
ELMOS_LOCAL_RUNNER_AUTH_TOKEN_FILE=/absolute/owner-only/path/runner-token
# UTC or offset timestamp no more than 24 hours in the future.
ELMOS_LOCAL_RUNNER_AUTH_TOKEN_EXPIRES_AT=CHANGE_ME_WITHIN_24_HOURS
ELMOS_LOCAL_RUNNER_TENANT_ID=local-dev
ELMOS_LOCAL_RUNNER_ACTOR_ID=user:reviewer
# Direct GitHub publication is disabled unless explicitly enabled. It inherits
# the one exact tenant above; this local surface is not a multi-tenant publisher.
ELMOS_LOCAL_GITHUB_PUBLISH_ENABLED=false
# Production accepts exactly 7, 30, or 90 days. Physical deletion is the
# offline, backup-bound workflow documented in README.md.
ELMOS_GENERATION_JOB_RETENTION_SECONDS=604800
ELMOS_GENERATION_MAX_JOBS_PER_TENANT=100
ELMOS_GENERATION_MAX_STORAGE_BYTES_PER_TENANT=5368709120
