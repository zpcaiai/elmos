# Runner-only data file. Copy outside the repository, replace every CHANGE_ME,
# set the immediate parent to 0700 and this file to 0400 or 0600. Never source
# or eval it. validate_spring_runner_topology.py accepts exactly these keys.
ELMOS_ALLOWED_GIT_HOSTS=github.com
ELMOS_COMMAND_ARTIFACT_HOST_PATH=/srv/elmos/spring-runner/command-artifacts
ELMOS_EGRESS_PROXY_IMAGE_DIGEST=sha256:CHANGE_ME
ELMOS_JAVA_RUNTIME_IMAGE_DIGEST=sha256:CHANGE_ME
ELMOS_JAVA_UPGRADE_EGRESS_HOSTS=github.com,api.github.com,objects.githubusercontent.com
ELMOS_JAVA_UPGRADE_WORKSPACE_HOST_PATH=/srv/elmos/spring-shared/runs
ELMOS_NETWORK_POLICY_VERSION=CHANGE_ME
ELMOS_ROOTLESS_DOCKER_SOCKET=/run/user/CHANGE_ME/docker.sock
ELMOS_ROOTLESS_GID=CHANGE_ME
ELMOS_ROOTLESS_UID=CHANGE_ME
ELMOS_SNAPSHOT_ARTIFACT_HOST_PATH=/srv/elmos/spring-runner/snapshot-artifacts
ELMOS_SNAPSHOT_HELPER_IMAGE_DIGEST=sha256:CHANGE_ME
ELMOS_SPRING_BROKER_RUNTIME_HMAC_SECRET_HOST_PATH=/srv/elmos/spring-runner/broker-secrets/runtime.hmac
ELMOS_SPRING_BROKER_SECRET_MAPPED_GID=CHANGE_ME
ELMOS_SPRING_BROKER_SECRET_MAPPED_UID=CHANGE_ME
ELMOS_SPRING_BROKER_SECRET_ROOT=/srv/elmos/spring-runner/broker-secrets
ELMOS_SPRING_BROKER_TRANSFORMER_HMAC_SECRET_HOST_PATH=/srv/elmos/spring-runner/broker-secrets/transformer.hmac
ELMOS_SPRING_BROKER_VERIFIER_HMAC_SECRET_HOST_PATH=/srv/elmos/spring-runner/broker-secrets/verifier.hmac
ELMOS_SPRING_EGRESS_PROXY_IMAGE=registry.CHANGE_ME/elmos/egress-proxy@sha256:CHANGE_ME
ELMOS_SPRING_INGRESS_CONFIG_HOST_PATH=/srv/elmos/spring-runner/nginx.spring-runner.conf
ELMOS_SPRING_INGRESS_IMAGE=registry.CHANGE_ME/nginx-unprivileged@sha256:CHANGE_ME
ELMOS_SPRING_INGRESS_SECRET_MAPPED_GID=CHANGE_ME
ELMOS_SPRING_INGRESS_SECRET_MAPPED_UID=CHANGE_ME
ELMOS_SPRING_INGRESS_TLS_CERT_HOST_PATH=/srv/elmos/spring-runner/tls/tls.crt
ELMOS_SPRING_INGRESS_TLS_KEY_HOST_PATH=/srv/elmos/spring-runner/tls/tls.key
ELMOS_SPRING_INGRESS_TLS_SECRET_ROOT=/srv/elmos/spring-runner/tls
ELMOS_SPRING_RUNNER_CONTROL_NETWORK=elmos-spring-runner-control
ELMOS_SPRING_RUNNER_DATABASE_PASSWORD=CHANGE_ME
ELMOS_SPRING_RUNNER_DATABASE_URL=jdbc:postgresql://spring-runner-database-proxy:5432/elmos?sslmode=require
ELMOS_SPRING_RUNNER_DATABASE_USER=CHANGE_ME
ELMOS_SPRING_RUNNER_ENV_FILE=/srv/elmos/spring-runner/runner.env
ELMOS_SPRING_RUNNER_HTTPS_BIND_ADDRESS=CHANGE_ME_PRIVATE_IP
ELMOS_SPRING_RUNNER_HTTPS_PORT=8443
ELMOS_SPRING_RUNNER_REPLAY_HOST_PATH=/srv/elmos/spring-replay/runner
ELMOS_SPRING_TRANSFORMER_IMAGE_DIGEST=sha256:CHANGE_ME
ELMOS_SPRING_UPGRADE_VERIFIER_ID=CHANGE_ME
ELMOS_SPRING_VERIFIER_IMAGE_DIGEST=sha256:CHANGE_ME
ELMOS_SPRING_WORKSPACE_SERVICE_IMAGE=registry.CHANGE_ME/elmos/workspace-service@sha256:CHANGE_ME
ELMOS_VERIFIER_EVIDENCE_HOST_PATH=/srv/elmos/spring-runner/verifier-evidence
