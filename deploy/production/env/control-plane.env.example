# Control-plane persistence, repository and artifact configuration only.
ELMOS_DATABASE_URL=jdbc:postgresql://CHANGE_ME/elmos?sslmode=require
ELMOS_DATABASE_USER=CHANGE_ME
ELMOS_DATABASE_PASSWORD=CHANGE_ME
ELMOS_DATABASE_DATA_PREFLIGHT_ENABLED=false
ELMOS_OIDC_ISSUER_URI=https://CHANGE_ME
ELMOS_OIDC_JWKS_URI=https://CHANGE_ME
ELMOS_OIDC_AUDIENCE=CHANGE_ME
ELMOS_IDENTITY_PEPPER_FILE=/run/secrets/elmos/identity-destination-pepper
ELMOS_LOCAL_IDENTITY_ENABLED=false
ELMOS_RUNNER_IMAGE_GENERATION=CHANGE_ME@sha256:CHANGE_ME
ELMOS_RUNNER_IMAGE_TRANSLATION=CHANGE_ME@sha256:CHANGE_ME
ELMOS_RUNNER_IMAGE_SPRING_UPGRADE=CHANGE_ME@sha256:CHANGE_ME
ELMOS_RUNNER_IMAGE_REPOSITORY_WORKSPACE=CHANGE_ME@sha256:CHANGE_ME
ELMOS_RUNNER_IMAGE_MODERNIZATION_PROOF=CHANGE_ME@sha256:CHANGE_ME
ELMOS_EXECUTION_REAPER_INTERVAL_MS=15000
ELMOS_OBJECT_STORAGE_CREDENTIAL_REFERENCE=secret://CHANGE_ME
ELMOS_OBJECT_STORAGE_ACCESS_KEY_ID_FILE=/run/secrets/elmos/object-access-key-id
ELMOS_OBJECT_STORAGE_SECRET_ACCESS_KEY_FILE=/run/secrets/elmos/object-secret-access-key
ELMOS_OBJECT_STORAGE_SESSION_TOKEN_FILE=
ELMOS_OBJECT_STORAGE_GC_INTERVAL_MS=3600000
ELMOS_REPOSITORY_WORKSPACE_ENABLED=true
ELMOS_REPOSITORY_LEGACY_API_KEY_ENABLED=false
ELMOS_REPOSITORY_WORKSPACE_ROOT=/srv/elmos/workspaces
ELMOS_REPOSITORY_CREDENTIAL_ROOT=/run/secrets/elmos/repository
ELMOS_GITHUB_APP_ENABLED=true
ELMOS_GITHUB_APP_ID=CHANGE_ME
ELMOS_GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/elmos/github-app-private-key.pem
ELMOS_GITHUB_APP_SLUG=CHANGE_ME
ELMOS_GITHUB_APP_CLIENT_ID=CHANGE_ME
ELMOS_GITHUB_APP_CLIENT_SECRET_PATH=/run/secrets/elmos/github-app-client-secret
ELMOS_GITHUB_APP_CALLBACK_URL=https://CHANGE_ME/api/v1/github/installations/callback
ELMOS_GITHUB_CLONE_BASE_URL=https://github.com
ELMOS_GITHUB_APP_SUCCESS_URL=https://CHANGE_ME/repositories
ELMOS_GITHUB_ONBOARDING_STATE_SECRET_PATH=/run/secrets/elmos/github-onboarding-state
ELMOS_GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/elmos/github-webhook-secret
ELMOS_ACTION_CACHE_ENABLED=false
ELMOS_ACTION_CACHE_EXECUTION_CALLER_ENABLED=false
ELMOS_ACTION_CACHE_SAMPLE_RECOMPUTE_ONE_IN_N=0
