# Server-side operator probe bindings. Never expose the operations key to a browser.
ELMOS_CONTROL_PLANE_BASE_URL=https://REPLACE_WITH_CONTROL_PLANE_ENDPOINT
ELMOS_OPERATIONS_API_KEY=REPLACE_WITH_SHORT_LIVED_OPERATIONS_KEY
ELMOS_OPERATIONS_TENANT_ID=REPLACE_WITH_TENANT_ID
ELMOS_OPERATIONS_ACTOR_ID=REPLACE_WITH_OPERATOR_ACTOR_ID

# Exact expected Runner registration and immutable artifacts.
ELMOS_RUNNER_NODE_ID=REPLACE_WITH_STABLE_RUNNER_NODE_ID
ELMOS_RUNNER_POOL_ID=REPLACE_WITH_RUNNER_POOL_ID
ELMOS_RUNNER_CAPABILITIES=generation:multi
ELMOS_RUNNER_AGENT_VERSION=REPLACE_WITH_EXACT_SEMVER
ELMOS_RUNNER_AGENT_IMAGE=registry.example.com/elmos/runner-agent@sha256:REPLACE_WITH_64_HEX_DIGEST
ELMOS_RUNNER_IMAGE_GENERATION=registry.example.com/elmos/generation@sha256:REPLACE_WITH_64_HEX_DIGEST
ELMOS_RUNNER_IMAGE_ALLOWLIST_VERSION=REPLACE_WITH_ALLOWLIST_VERSION

# One-shot probe authorization. Must equal gate_id in ai-runtime-plan.json.
ELMOS_RUNTIME_PROBE_ACK=elmos-ai-control-plane-runner-v1
