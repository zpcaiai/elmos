# Commercial API resource-server, database and payment configuration only.
ELMOS_OIDC_ISSUER_URI=https://CHANGE_ME
ELMOS_OIDC_JWK_SET_URI=https://CHANGE_ME
ELMOS_OIDC_AUDIENCE=CHANGE_ME
ELMOS_TRIAL_IDENTITY_PEPPER=CHANGE_ME
ELMOS_COMMERCIAL_DATABASE_URL=jdbc:postgresql://CHANGE_ME/elmos_commercial?sslmode=require
ELMOS_COMMERCIAL_DATABASE_USERNAME=CHANGE_ME
ELMOS_COMMERCIAL_DATABASE_PASSWORD=CHANGE_ME
ELMOS_PAYMENT_PROVIDER=ALIPAY_CHECKOUT
ELMOS_ALIPAY_APP_ID=CHANGE_ME
ELMOS_ALIPAY_PRIVATE_KEY_FILE=/run/secrets/elmos/alipay-app-private-key.pem
ELMOS_ALIPAY_PUBLIC_KEY_FILE=/run/secrets/elmos/alipay-public-key.pem
ELMOS_ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ELMOS_ALIPAY_NOTIFY_URL=https://CHANGE_ME/api/payments/alipay/notify
ELMOS_ALIPAY_RETURN_URL=https://CHANGE_ME/billing
ELMOS_BILLING_LIVE_ENABLED=true
ELMOS_USAGE_EMAIL_ALERTS_ENABLED=false
