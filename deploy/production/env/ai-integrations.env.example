# Elasticsearch: use one disposable, versioned projection index. PostgreSQL remains authoritative.
ELMOS_ELASTICSEARCH_URL=https://REPLACE_WITH_ELASTIC_ENDPOINT
ELMOS_ELASTICSEARCH_API_KEY=REPLACE_IN_SECRET_MANAGER
ELMOS_ELASTICSEARCH_INDEX=elmos-project-intelligence-v1
ELMOS_ELASTICSEARCH_VECTOR_DIMENSIONS=REPLACE_WITH_EMBEDDING_DIMENSIONS
ELMOS_ELASTICSEARCH_EXPECTED_VERSION=8.19.3
ELMOS_ELASTICSEARCH_TIMEOUT_SECONDS=30
# Set only for a private CA. The file must be mounted read-only.
ELMOS_ELASTICSEARCH_CA_CERTS=

# Dify: the API key must belong to one Workflow application, not a workspace-wide admin key.
ELMOS_DIFY_URL=https://REPLACE_WITH_DIFY_ENDPOINT
ELMOS_DIFY_API_KEY=REPLACE_IN_SECRET_MANAGER
ELMOS_DIFY_WORKFLOW_ID=REPLACE_WITH_EXACT_WORKFLOW_ID
ELMOS_DIFY_EXPECTED_VERSION=REPLACE_WITH_EXACT_SERVER_VERSION
ELMOS_DIFY_TIMEOUT_SECONDS=60

# One-shot external execution authorization. Set this only for the authorized run,
# then remove it. Its value must equal authorization.authorization_id in the request.
ELMOS_EXTERNAL_EXECUTION_ACK=REPLACE_WITH_AUTHORIZATION_ID
