# Web/BFF identity and notification credentials only. Database and payment
# credentials belong to their backend service files and are rejected here.
ELMOS_OIDC_CLIENT_ID=CHANGE_ME
ELMOS_OIDC_CLIENT_SECRET=CHANGE_ME
ELMOS_OIDC_AUTHORIZATION_ENDPOINT=https://CHANGE_ME
ELMOS_OIDC_TOKEN_ENDPOINT=https://CHANGE_ME
ELMOS_OIDC_USERINFO_ENDPOINT=https://CHANGE_ME
ELMOS_OIDC_JWKS_URI=https://CHANGE_ME
ELMOS_OIDC_END_SESSION_ENDPOINT=https://CHANGE_ME
ELMOS_OIDC_REVOCATION_ENDPOINT=https://CHANGE_ME
ELMOS_OIDC_REDIRECT_URI=https://CHANGE_ME/api/auth/callback
ELMOS_PUBLIC_ORIGIN=https://CHANGE_ME
ELMOS_SESSION_SECRET=CHANGE_ME
# Provisioned by Vercel Marketplace Descope User Auth.
NEXT_PUBLIC_DESCOPE_PROJECT_ID=CHANGE_ME
NEXT_PUBLIC_DESCOPE_BASE_URL=https://api.descope.com
ELMOS_DESCOPE_DEFAULT_ORGANIZATION_ID=elmos-public
# Keep unset until the matching custom OAuth provider is fully configured in Descope.
ELMOS_DESCOPE_WECHAT_PROVIDER=
ELMOS_DATABASE_SQL_PREFLIGHT_ENABLED=false
ELMOS_OPERATIONS_API_KEY=CHANGE_ME
ELMOS_OPERATIONS_API_KEY_EXPIRES_AT=CHANGE_ME
ELMOS_OPERATIONS_TENANT_ID=CHANGE_ME
ELMOS_OPERATIONS_ACTOR_ID=CHANGE_ME
ELMOS_ADMIN_LOGIN_NOTIFICATIONS_ENABLED=true
ELMOS_ADMIN_LOGIN_EMAIL_FROM=CHANGE_ME
# Vercel Marketplace supplies RESEND_API_KEY. Non-Vercel deployments use the owner-only file below.
# RESEND_API_KEY=managed-by-vercel-marketplace
ELMOS_RESEND_API_KEY_FILE=/run/secrets/elmos/resend-api-key
ELMOS_BUSINESS_AUDIT_REQUIRED=true
ELMOS_REPOSITORY_WORKSPACE_API_KEY=CHANGE_ME
ELMOS_REPOSITORY_WORKSPACE_API_KEY_EXPIRES_AT=CHANGE_ME
ELMOS_REPOSITORY_WORKSPACE_TENANT_ID=CHANGE_ME
ELMOS_REPOSITORY_WORKSPACE_ACTOR_ID=CHANGE_ME
