# ELMOS 生产环境变量模板
#
# 用途：把上线所需的全部环境变量集中为一份可逐项签收的清单。
# 本文件只包含占位符，不包含任何真实凭据，可安全提交到版本库。
#
# 使用方式：
#   cp deploy/production/elmos-commercial.env.example /srv/elmos/elmos.env
#   chmod 0600 /srv/elmos/elmos.env
#   逐项填写；未填写项保持 CHANGE_ME 时对应能力将失败关闭（这是预期行为）。
#
# 状态图例：
#   [REQUIRED]  上线必填
#   [COND]      条件必填（见说明）
#   [OPTIONAL]  可选
#   [NEW]       随 D-01/D-03 规格新增，**代码尚未读取**。填了也不会生效，
#               直到对应实现落地（见 docs/commercialization/ 下的两份规格）。
#               保留在此是为了让运维一次性把清单备齐，不是声称已支持。
#
# 生成日期：2026-07-28

# =============================================================================
# 1. 运行时基础
# =============================================================================
# [REQUIRED]
NODE_ENV=production
# [REQUIRED] 优雅停机超时
ELMOS_SHUTDOWN_TIMEOUT=30s
# [REQUIRED] 运行时状态目录（owner-only）
ELMOS_RUNTIME_STATE_DIR=/srv/elmos/state

# =============================================================================
# 2. 服务间地址（Tier 1 拓扑）
# =============================================================================
# [REQUIRED]
ELMOS_CONTROL_PLANE_BASE_URL=CHANGE_ME
# [REQUIRED]
ELMOS_COMMERCIAL_API_URL=CHANGE_ME
# [REQUIRED]
ELMOS_COMMERCIAL_API_PORT=CHANGE_ME
# [COND] 上 /repositories 业务线时必填
ELMOS_REPOSITORY_WORKSPACE_BASE_URL=CHANGE_ME
# [COND] 上 Spring 升级业务线时必填
JAVA_ENGINE_BASE_URL=CHANGE_ME

# =============================================================================
# 3. 身份（OIDC）—— 见 GO_LIVE_RUNBOOK 阶段 1
# -----------------------------------------------------------------------------
# 注意：Web Console 与 Commercial API 使用**不同的变量名**读取同一个 IdP，
#       其中 JWKS 端点分别叫 ELMOS_OIDC_JWKS_URI 与 ELMOS_OIDC_JWK_SET_URI，
#       两者都要设置，不要只设其一。
# =============================================================================

# --- 3.1 Web Console（授权码流程，accountSession.ts）---------------------------
# [REQUIRED] 本小节 12 项全部必填，缺任一项登录链路失败关闭
ELMOS_OIDC_CLIENT_ID=CHANGE_ME
ELMOS_OIDC_CLIENT_SECRET=CHANGE_ME
ELMOS_OIDC_AUTHORIZATION_ENDPOINT=CHANGE_ME
ELMOS_OIDC_TOKEN_ENDPOINT=CHANGE_ME
ELMOS_OIDC_USERINFO_ENDPOINT=CHANGE_ME
ELMOS_OIDC_JWKS_URI=CHANGE_ME
ELMOS_OIDC_END_SESSION_ENDPOINT=CHANGE_ME
ELMOS_OIDC_REVOCATION_ENDPOINT=CHANGE_ME
ELMOS_OIDC_REDIRECT_URI=CHANGE_ME
ELMOS_OIDC_SCOPES=CHANGE_ME
# [REQUIRED] 对外公开 Origin，用于同源写保护与回调校验
ELMOS_PUBLIC_ORIGIN=CHANGE_ME
# [REQUIRED] 会话 Cookie 密封密钥；openssl rand -base64 48
ELMOS_SESSION_SECRET=CHANGE_ME

# --- 3.2 Commercial API（资源服务器，Java）------------------------------------
# [REQUIRED] 缺失时计费路由返回 401，属预期失败关闭
ELMOS_OIDC_ISSUER_URI=CHANGE_ME
# [REQUIRED]
ELMOS_OIDC_JWK_SET_URI=CHANGE_ME
# [REQUIRED]
ELMOS_OIDC_AUDIENCE=CHANGE_ME
# [REQUIRED] ≥32 字节随机；openssl rand -base64 48
ELMOS_TRIAL_IDENTITY_PEPPER=CHANGE_ME

# =============================================================================
# 4. 生产数据库 —— 见 GO_LIVE_RUNBOOK 阶段 2
# =============================================================================
# [REQUIRED] 不得内嵌凭据；必须 sslmode=require 或 verify-full
ELMOS_COMMERCIAL_DATABASE_URL=CHANGE_ME
# [REQUIRED] 最小权限运行身份：NOSUPERUSER NOBYPASSRLS，且不得复用迁移 owner
ELMOS_COMMERCIAL_DATABASE_USERNAME=CHANGE_ME
ELMOS_COMMERCIAL_DATABASE_PASSWORD=CHANGE_ME
# [OPTIONAL] 非默认端口时填写
ELMOS_COMMERCIAL_DATABASE_PORT=5432
#
# 以下三项属于 CI 迁移流水线（GitHub commercial-production Environment），
# 不要放进应用运行时环境：
#   Secret   ELMOS_COMMERCIAL_DATABASE_MIGRATION_USERNAME
#   Secret   ELMOS_COMMERCIAL_DATABASE_MIGRATION_PASSWORD
#   Variable ELMOS_COMMERCIAL_DATABASE_EXPECTED_HOST
#   Variable ELMOS_COMMERCIAL_DATABASE_EXPECTED_DATABASE
#   Variable ELMOS_COMMERCIAL_DATABASE_RUNTIME_USERNAME

# =============================================================================
# 5. 支付 —— D-01 已决：中国大陆主体 + 支付宝/微信支付
#    见 GO_LIVE_RUNBOOK 阶段 5 与 docs/commercialization/PAYMENT_CN_ADAPTER_SPEC.md
# =============================================================================
# 提示：定价目录 status=DRAFT 时付费入口保持禁用，即使下列变量已填。
#       目录转 PUBLISHED 需先完成主体、税务、支付、成本四项，
#       并通过 scripts/commercial/validate_pricing_catalog_publication.py
#
# ⚠ 私钥一律使用 _FILE 形式：owner-only(0600)、非符号链接、绝对路径。
#   绝不把私钥内容写进环境变量值，也绝不入版本库。

# [NEW] 首发建议先接一家，另一家二期。适配器未实现前该变量无效。
ELMOS_PAYMENT_PROVIDER=ALIPAY_CHECKOUT        # 或 WECHAT_PAY_NATIVE

# --- 5.1 支付宝（电脑网站支付）------------------------------------------------
# [NEW][COND] ELMOS_PAYMENT_PROVIDER=ALIPAY_CHECKOUT 时必填；适配器未实现
ELMOS_ALIPAY_APP_ID=CHANGE_ME
ELMOS_ALIPAY_PRIVATE_KEY_FILE=/srv/elmos/secrets/alipay-app-private-key.pem
ELMOS_ALIPAY_PUBLIC_KEY_FILE=/srv/elmos/secrets/alipay-public-key.pem
ELMOS_ALIPAY_GATEWAY_URL=CHANGE_ME
ELMOS_ALIPAY_NOTIFY_URL=CHANGE_ME             # 必须是已备案域名下的 HTTPS 地址
ELMOS_ALIPAY_RETURN_URL=CHANGE_ME

# --- 5.2 微信支付（Native 扫码，APIv3）----------------------------------------
# [NEW][COND] ELMOS_PAYMENT_PROVIDER=WECHAT_PAY_NATIVE 时必填；适配器未实现
ELMOS_WECHATPAY_MCHID=CHANGE_ME
ELMOS_WECHATPAY_APIV3_KEY_FILE=/srv/elmos/secrets/wechatpay-apiv3.key
ELMOS_WECHATPAY_CERT_SERIAL_NO=CHANGE_ME
ELMOS_WECHATPAY_PRIVATE_KEY_FILE=/srv/elmos/secrets/wechatpay-apiclient-key.pem
ELMOS_WECHATPAY_PLATFORM_CERT_FILE=/srv/elmos/secrets/wechatpay-platform-cert.pem
ELMOS_WECHATPAY_NOTIFY_URL=CHANGE_ME          # 必须是已备案域名下的 HTTPS 地址

# --- 5.3 Stripe（D-01 后不启用，代码保留）--------------------------------------
# [DISABLED] 大陆主体无法在 Stripe 收单。以下六项一律保持为空；
# 若将来开境外主体做出海业务，再单独启用。填了非空值会被发布门禁指出。
ELMOS_STRIPE_SECRET_KEY=
ELMOS_STRIPE_MONTHLY_PRICE_ID=
ELMOS_STRIPE_ANNUAL_PRICE_ID=
ELMOS_STRIPE_WEBHOOK_SECRET=
ELMOS_STRIPE_SUCCESS_URL=
ELMOS_STRIPE_CANCEL_URL=

# =============================================================================
# 6. 计费与计量开关
# =============================================================================
# [REQUIRED] 生产必须为 true，否则额度不强制
ELMOS_BILLING_ENFORCEMENT_ENABLED=true
# [REQUIRED]
ELMOS_BILLING_LIVE_ENABLED=true
# [REQUIRED]
ELMOS_USAGE_METER_ENABLED=true
# [COND] 邮件通道未完成退订/频控/地址验证/回执/隐私评审前，保持 false
ELMOS_USAGE_EMAIL_ALERTS_ENABLED=false

# =============================================================================
# 7. 执行面（Runner）—— 见 GO_LIVE_RUNBOOK 阶段 3
# =============================================================================
# [REQUIRED]
ELMOS_LOCAL_RUNNER_ENABLED=true
# [REQUIRED] 生产唯一允许值；HOST_DEVELOPMENT 在 NODE_ENV=production 下被拒绝
ELMOS_LOCAL_RUNNER_EXECUTOR=ROOTLESS_CONTAINER
# [REQUIRED] 专用绝对目录；不得为文件系统根、仓库根或仓库祖先目录
ELMOS_LOCAL_RUNNER_ROOT=/srv/elmos/runner
# [REQUIRED] rootless podman/docker 的绝对路径
ELMOS_LOCAL_RUNNER_CONTAINER_ENGINE=/usr/bin/podman
# [REQUIRED] 本仓库绝对路径
ELMOS_REPOSITORY_ROOT=/srv/elmos/repo
# [REQUIRED] uv 可执行文件绝对路径
ELMOS_UV_PATH=/usr/local/bin/uv
#
# ⚠ 以下四项是当前的单租户令牌模型：令牌唯一绑定一个 tenant + 一个 actor，
#   有效期 ≤ 24 小时。D-03 选定 SaaS 多租户后，这四个变量在 Runner Agent
#   （路线 A）落地时**整组删除**，不保留兼容分支——保留即等于保留一条
#   绕过多租户隔离的后门。详见 docs/commercialization/RUNNER_AGENT_SPEC.md。
#   令牌本身建议用 _FILE 变体（0600、非符号链接、绝对路径），二者只能配置其一。
# [COND]
ELMOS_LOCAL_RUNNER_AUTH_TOKEN_FILE=/srv/elmos/secrets/runner.token
ELMOS_LOCAL_RUNNER_AUTH_TOKEN_EXPIRES_AT=CHANGE_ME
ELMOS_LOCAL_RUNNER_TENANT_ID=CHANGE_ME
ELMOS_LOCAL_RUNNER_ACTOR_ID=CHANGE_ME

# =============================================================================
# 8. 整库转换（首发不上线时全部留空）
# =============================================================================
# [COND] 仅当开放 /translation 时填写；必须是管理员物化的只读绝对目录
ELMOS_TRANSLATION_SOURCE_ROOT=
ELMOS_TRANSLATION_CASES_ROOT=
# [COND] 必须为 name@sha256:<64 hex> 不可变镜像
ELMOS_TRANSLATION_RUNNER_IMAGE=

# =============================================================================
# 9. Spring 升级代理（首发不上线时全部留空）
# =============================================================================
# [COND] 仅当开放 /spring 时填写
ELMOS_SPRING_PROXY_ENABLED=false
ELMOS_SPRING_PROXY_AUTH_TOKEN_FILE=
ELMOS_SPRING_PROXY_AUTH_TOKEN_EXPIRES_AT=
ELMOS_SPRING_PROXY_ACTOR_ID=
# ⚠ 单租户假设：多租户上线前必须移除对该变量的依赖
ELMOS_TRUSTED_SINGLE_TENANT_ORGANIZATION_ID=

# =============================================================================
# 10. 运维与管理端
# =============================================================================
# [REQUIRED]
ELMOS_OPERATIONS_API_KEY=CHANGE_ME
ELMOS_OPERATIONS_TENANT_ID=CHANGE_ME
ELMOS_OPERATIONS_ACTOR_ID=CHANGE_ME
# [REQUIRED] 生产必须为 false
ELMOS_ADMIN_ALLOW_TOKEN_FALLBACK=false
# [REQUIRED]
ELMOS_BUSINESS_AUDIT_REQUIRED=true

# =============================================================================
# 11. 绝不设置的变量
# =============================================================================
# 以下变量只在仓库内部或测试语境有意义，生产环境设置它们会造成状态失真：
#   ELMOS_CERTIFIED / ELMOS_VALIDATED / ELMOS_OFFICIAL / ELMOS_INTERNAL
#   ELMOS_BILLING_TEST_* （一次性可销毁数据库测试专用）
#   ELMOS_E2E_*          （端到端测试专用）
