# ELMOS 生产环境变量模板
#
# 用途：把上线所需的全部环境变量集中为一份可逐项签收的清单。
# 本文件只包含占位符，不包含任何真实凭据，可安全提交到版本库。
#
# 使用方式：
#   cp deploy/production/elmos-commercial.env.example /srv/elmos/elmos.env
#   chmod 0600 /srv/elmos/elmos.env
#   逐项填写；未填写项保持 CHANGE_ME 时对应能力将失败关闭（这是预期行为）。
#
# 状态图例：
#   [REQUIRED]  上线必填
#   [COND]      条件必填（见说明）
#   [OPTIONAL]  可选
#   [NOT_RUN]   代码或模板已存在，但真实供应商/集群执行尚无证据。
#
# 更新日期：2026-07-29

# =============================================================================
# 1. 运行时基础
# =============================================================================
# [REQUIRED]
NODE_ENV=production
# [REQUIRED] Compose 主机上的实际 env 文件位置
ELMOS_ENV_FILE=/srv/elmos/elmos.env
# [REQUIRED] 优雅停机超时
ELMOS_SHUTDOWN_TIMEOUT=30s
# [REQUIRED] 运行时状态目录（owner-only）
ELMOS_RUNTIME_STATE_DIR=/srv/elmos/state
# [REQUIRED] 由编排器只读挂载到 /run/secrets/elmos
ELMOS_SECRET_ROOT=/srv/elmos/secrets

# =============================================================================
# 2. 服务间地址（Tier 1 拓扑）
# =============================================================================
# [REQUIRED] Compose 模板会覆盖成精确内部服务名；非 Compose 部署应使用 HTTPS。
ELMOS_CONTROL_PLANE_BASE_URL=https://CHANGE_ME
# [REQUIRED]
ELMOS_COMMERCIAL_API_URL=https://CHANGE_ME
# [REQUIRED]
ELMOS_COMMERCIAL_API_PORT=CHANGE_ME
# [REQUIRED] 独立 Workspace Service readiness 地址
ELMOS_WORKSPACE_SERVICE_URL=https://CHANGE_ME
# [COND] 上 /repositories 业务线时必填
ELMOS_REPOSITORY_WORKSPACE_BASE_URL=https://CHANGE_ME
# [COND] 上 Spring 升级业务线时必填
JAVA_ENGINE_BASE_URL=https://CHANGE_ME
# [REQUIRED] 仅同一受控 Compose bridge 可为 true；只放行精确服务名。
ELMOS_TRUSTED_INTERNAL_HTTP=false

# =============================================================================
# 3. 身份（OIDC）—— 见 GO_LIVE_RUNBOOK 阶段 1
# -----------------------------------------------------------------------------
# 注意：Web Console 与 Commercial API 使用**不同的变量名**读取同一个 IdP，
#       其中 JWKS 端点分别叫 ELMOS_OIDC_JWKS_URI 与 ELMOS_OIDC_JWK_SET_URI，
#       两者都要设置，不要只设其一。
# =============================================================================

# --- 3.1 Web Console（授权码流程，accountSession.ts）---------------------------
# [REQUIRED] 本小节 12 项全部必填，缺任一项登录链路失败关闭
ELMOS_OIDC_CLIENT_ID=CHANGE_ME
ELMOS_OIDC_CLIENT_SECRET=CHANGE_ME
ELMOS_OIDC_AUTHORIZATION_ENDPOINT=CHANGE_ME
ELMOS_OIDC_TOKEN_ENDPOINT=CHANGE_ME
ELMOS_OIDC_USERINFO_ENDPOINT=CHANGE_ME
ELMOS_OIDC_JWKS_URI=CHANGE_ME
ELMOS_OIDC_END_SESSION_ENDPOINT=CHANGE_ME
ELMOS_OIDC_REVOCATION_ENDPOINT=CHANGE_ME
ELMOS_OIDC_REDIRECT_URI=CHANGE_ME
ELMOS_OIDC_SCOPES=CHANGE_ME
# [REQUIRED] 对外公开 Origin，用于同源写保护与回调校验
ELMOS_PUBLIC_ORIGIN=CHANGE_ME
# [REQUIRED] 会话 Cookie 密封密钥；openssl rand -base64 48
ELMOS_SESSION_SECRET=CHANGE_ME

# --- 3.2 Commercial API（资源服务器，Java）------------------------------------
# [REQUIRED] 缺失时计费路由返回 401，属预期失败关闭
ELMOS_OIDC_ISSUER_URI=CHANGE_ME
# [REQUIRED]
ELMOS_OIDC_JWK_SET_URI=CHANGE_ME
# [REQUIRED]
ELMOS_OIDC_AUDIENCE=CHANGE_ME
# [REQUIRED] ≥32 字节随机；openssl rand -base64 48
ELMOS_TRIAL_IDENTITY_PEPPER=CHANGE_ME
# [REQUIRED] 邀请地址匹配 HMAC；owner-only 文件，不与试用 pepper 复用
ELMOS_IDENTITY_PEPPER_FILE=/run/secrets/elmos/identity-destination-pepper
# 生产主认证源是 OIDC；内建手机号/邮箱认证默认关闭
ELMOS_LOCAL_IDENTITY_ENABLED=false

# =============================================================================
# 4. 生产数据库 —— 见 GO_LIVE_RUNBOOK 阶段 2
# =============================================================================
# --- 4.1 Control Plane / 身份 / 执行队列 / 产物 -------------------------------
# [REQUIRED] JDBC PostgreSQL URL；必须 sslmode=require 或 verify-full
ELMOS_DATABASE_URL=CHANGE_ME
# [REQUIRED] 应用运行角色：LOGIN NOSUPERUSER NOBYPASSRLS
ELMOS_DATABASE_USER=CHANGE_ME
ELMOS_DATABASE_PASSWORD=CHANGE_ME
# 以下三项只供迁移后最小权限授权脚本，不注入应用容器：
#   ELMOS_DATABASE_MIGRATION_USER
#   ELMOS_DATABASE_MIGRATION_PASSWORD
#   ELMOS_DATABASE_RUNTIME_USER
#
# 执行：
#   scripts/operations/configure_control_plane_runtime_role.sh

# --- 4.2 Commercial API ------------------------------------------------------
# [REQUIRED] 不得内嵌凭据；必须 sslmode=require 或 verify-full
ELMOS_COMMERCIAL_DATABASE_URL=CHANGE_ME
# [REQUIRED] 最小权限运行身份：NOSUPERUSER NOBYPASSRLS，且不得复用迁移 owner
ELMOS_COMMERCIAL_DATABASE_USERNAME=CHANGE_ME
ELMOS_COMMERCIAL_DATABASE_PASSWORD=CHANGE_ME
# [OPTIONAL] 非默认端口时填写
ELMOS_COMMERCIAL_DATABASE_PORT=5432
#
# 以下三项属于 CI 迁移流水线（GitHub commercial-production Environment），
# 不要放进应用运行时环境：
#   Secret   ELMOS_COMMERCIAL_DATABASE_MIGRATION_USERNAME
#   Secret   ELMOS_COMMERCIAL_DATABASE_MIGRATION_PASSWORD
#   Variable ELMOS_COMMERCIAL_DATABASE_EXPECTED_HOST
#   Variable ELMOS_COMMERCIAL_DATABASE_EXPECTED_DATABASE
#   Variable ELMOS_COMMERCIAL_DATABASE_RUNTIME_USERNAME

# =============================================================================
# 5. 支付 —— D-01 已决：中国大陆主体 + 支付宝/微信支付
#    见 GO_LIVE_RUNBOOK 阶段 5 与 docs/commercialization/PAYMENT_CN_ADAPTER_SPEC.md
# =============================================================================
# 提示：定价目录 status=DRAFT 时付费入口保持禁用，即使下列变量已填。
#       目录转 PUBLISHED 需先完成主体、税务、支付、成本四项，
#       并通过 scripts/commercial/validate_pricing_catalog_publication.py
#
# ⚠ 私钥一律使用 _FILE 形式：owner-only(0600)、非符号链接、绝对路径。
#   绝不把私钥内容写进环境变量值，也绝不入版本库。

# [NEW] 首发建议先接一家，另一家二期。适配器未实现前该变量无效。
ELMOS_PAYMENT_PROVIDER=ALIPAY_CHECKOUT        # 或 WECHAT_PAY_NATIVE

# --- 5.1 支付宝（电脑网站支付）------------------------------------------------
# [NEW][COND] ELMOS_PAYMENT_PROVIDER=ALIPAY_CHECKOUT 时必填；适配器未实现
ELMOS_ALIPAY_APP_ID=CHANGE_ME
ELMOS_ALIPAY_PRIVATE_KEY_FILE=/srv/elmos/secrets/alipay-app-private-key.pem
ELMOS_ALIPAY_PUBLIC_KEY_FILE=/srv/elmos/secrets/alipay-public-key.pem
ELMOS_ALIPAY_GATEWAY_URL=CHANGE_ME
ELMOS_ALIPAY_NOTIFY_URL=CHANGE_ME             # 必须是已备案域名下的 HTTPS 地址
ELMOS_ALIPAY_RETURN_URL=CHANGE_ME

# --- 5.2 微信支付（Native 扫码，APIv3）----------------------------------------
# [NEW][COND] ELMOS_PAYMENT_PROVIDER=WECHAT_PAY_NATIVE 时必填；适配器未实现
ELMOS_WECHATPAY_MCHID=CHANGE_ME
ELMOS_WECHATPAY_APIV3_KEY_FILE=/srv/elmos/secrets/wechatpay-apiv3.key
ELMOS_WECHATPAY_CERT_SERIAL_NO=CHANGE_ME
ELMOS_WECHATPAY_PRIVATE_KEY_FILE=/srv/elmos/secrets/wechatpay-apiclient-key.pem
ELMOS_WECHATPAY_PLATFORM_CERT_FILE=/srv/elmos/secrets/wechatpay-platform-cert.pem
ELMOS_WECHATPAY_NOTIFY_URL=CHANGE_ME          # 必须是已备案域名下的 HTTPS 地址

# --- 5.3 Stripe（D-01 后不启用，代码保留）--------------------------------------
# [DISABLED] 大陆主体无法在 Stripe 收单。以下六项一律保持为空；
# 若将来开境外主体做出海业务，再单独启用。填了非空值会被发布门禁指出。
ELMOS_STRIPE_SECRET_KEY=
ELMOS_STRIPE_MONTHLY_PRICE_ID=
ELMOS_STRIPE_ANNUAL_PRICE_ID=
ELMOS_STRIPE_WEBHOOK_SECRET=
ELMOS_STRIPE_SUCCESS_URL=
ELMOS_STRIPE_CANCEL_URL=

# =============================================================================
# 6. 计费与计量开关
# =============================================================================
# [REQUIRED] 生产必须为 true，否则额度不强制
ELMOS_BILLING_ENFORCEMENT_ENABLED=true
# [REQUIRED]
ELMOS_BILLING_LIVE_ENABLED=true
# [REQUIRED]
ELMOS_USAGE_METER_ENABLED=true
# [COND] 邮件通道未完成退订/频控/地址验证/回执/隐私评审前，保持 false
ELMOS_USAGE_EMAIL_ALERTS_ENABLED=false

# =============================================================================
# 7. 多租户托管执行、产物和真实仓库
# =============================================================================
# --- 7.1 Web -> Control Plane 持久队列 --------------------------------------
ELMOS_HOSTED_EXECUTION_ENABLED=true
# 生产禁止 Web BFF 直接执行客户进程
ELMOS_LOCAL_RUNNER_ENABLED=false
# [REQUIRED] 全部必须是 name@sha256:<64 hex>
ELMOS_RUNNER_IMAGE_GENERATION=CHANGE_ME
ELMOS_RUNNER_IMAGE_TRANSLATION=CHANGE_ME
ELMOS_RUNNER_IMAGE_SPRING_UPGRADE=CHANGE_ME
ELMOS_RUNNER_IMAGE_REPOSITORY_WORKSPACE=CHANGE_ME
# [REQUIRED] 开启 Batch 105-108 证明闭环前必须由构建脚本生成并固定为 name@sha256:<64 hex>
ELMOS_RUNNER_IMAGE_MODERNIZATION_PROOF=CHANGE_ME
ELMOS_EXECUTION_REAPER_INTERVAL_MS=15000

# --- 7.2 对象存储 ------------------------------------------------------------
# [REQUIRED] 必须与数据库 object_storage_backends.credential_reference 完全一致
ELMOS_OBJECT_STORAGE_CREDENTIAL_REFERENCE=secret://CHANGE_ME
# [REQUIRED] 容器内 owner-only 只读文件；不得把值写进本文件
ELMOS_OBJECT_STORAGE_ACCESS_KEY_ID_FILE=/run/secrets/elmos/object-access-key-id
ELMOS_OBJECT_STORAGE_SECRET_ACCESS_KEY_FILE=/run/secrets/elmos/object-secret-access-key
# [COND] 临时 STS 凭据启用时填写
ELMOS_OBJECT_STORAGE_SESSION_TOKEN_FILE=
ELMOS_OBJECT_STORAGE_GC_INTERVAL_MS=3600000
# [REQUIRED] Exact comma-separated host[:port] allowlist for signed generation
# artifact download tickets. Wildcards are not accepted.
ELMOS_GENERATION_ARTIFACT_DOWNLOAD_ALLOWED_HOSTS=CHANGE_ME
# 后端 endpoint/bucket/SSE/CMK 用以下脚本显式激活：
#   deploy/production/postgres/configure_hosted_runtime.sql

# --- 7.3 Runner Agent（独立部署，不在 Web/Control Plane compose 中）----------
# 每个节点必须有自己的一次性 enrollment Secret；不得跨副本复用。
ELMOS_ENVIRONMENT=production
ELMOS_RUNNER_NODE_ID=CHANGE_ME
ELMOS_RUNNER_POOL_ID=CHANGE_ME
ELMOS_RUNNER_CAPABILITIES=generation:multi,modernization:proof-loop
ELMOS_RUNNER_MAX_CONCURRENCY=2
ELMOS_RUNNER_WORK_ROOT=/var/lib/elmos-runner
ELMOS_RUNNER_CONTAINER_ENGINE=/usr/bin/podman
ELMOS_RUNNER_CLAIM_BATCH=2
ELMOS_RUNNER_LEASE_SECONDS=120
ELMOS_RUNNER_HEARTBEAT_SECONDS=30
ELMOS_RUNNER_CANCEL_GRACE_SECONDS=30
ELMOS_RUNNER_METRICS_PORT=9464
ELMOS_RUNNER_IMAGE_ALLOWLIST_VERSION=CHANGE_ME
ELMOS_RUNNER_ENROLMENT_TOKEN_FILE=/var/run/secrets/elmos/enrolment-token

# --- 7.4 真实 SCM ------------------------------------------------------------
# Hosted browser generation does not publish to GitHub from the Web BFF:
# /api/generation/jobs/:id/github returns explicit NOT_RUN before reading the
# request body or contacting GitHub. A separately approved direct self-hosted
# deployment is single-tenant only and must bind both tenant and owners; missing
# bindings fail closed. Do not configure these as a multi-tenant GitHub surface.
# ELMOS_GENERATION_GITHUB_ALLOWED_TENANT_ID=CHANGE_ME
# ELMOS_GENERATION_GITHUB_ALLOWED_OWNERS=CHANGE_ME
# ELMOS_GENERATION_GITHUB_ALLOWED_API_HOSTS=api.github.com
# ELMOS_GENERATION_GITHUB_ALLOWED_WEB_HOSTS=github.com
ELMOS_REPOSITORY_WORKSPACE_ENABLED=true
ELMOS_REPOSITORY_LEGACY_API_KEY_ENABLED=false
ELMOS_REPOSITORY_WORKSPACE_ROOT=/srv/elmos/workspaces
ELMOS_REPOSITORY_CREDENTIAL_ROOT=/run/secrets/elmos/repository
ELMOS_GITHUB_APP_ENABLED=true
ELMOS_GITHUB_APP_ID=CHANGE_ME
ELMOS_GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/elmos/github-app-private-key.pem
ELMOS_GITHUB_APP_SLUG=CHANGE_ME
ELMOS_GITHUB_APP_CLIENT_ID=CHANGE_ME
ELMOS_GITHUB_APP_CLIENT_SECRET_PATH=/run/secrets/elmos/github-app-client-secret
ELMOS_GITHUB_APP_CALLBACK_URL=https://CHANGE_ME/api/v1/github/installations/callback
ELMOS_GITHUB_CLONE_BASE_URL=https://github.com
ELMOS_GITHUB_APP_SUCCESS_URL=https://CHANGE_ME/repositories
ELMOS_GITHUB_ONBOARDING_STATE_SECRET_PATH=/run/secrets/elmos/github-onboarding-state
ELMOS_GITHUB_WEBHOOK_SECRET=
ELMOS_GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/elmos/github-webhook-secret
# [COND] 轮换窗口内可同时验证上一把密钥
ELMOS_GITHUB_WEBHOOK_PREVIOUS_SECRET_FILE=

# --- 7.4 ActionCache production caller --------------------------------------
# Keep disabled until the deployment supplies exactly one current-trust
# revalidator, authorization adapter and synchronous action-runner adapter.
# No permissive default is installed; incomplete enablement fails startup.
ELMOS_ACTION_CACHE_ENABLED=false
ELMOS_ACTION_CACHE_EXECUTION_CALLER_ENABLED=false
ELMOS_ACTION_CACHE_SAMPLE_RECOMPUTE_ONE_IN_N=0

# --- 7.5 Snapshot lease/reconciliation and CAS / production KMS broker ------
# Every control-plane replica needs a stable, unique lease holder. The global
# scheduler remains disabled until one elected workload has its own stable ID.
ELMOS_SNAPSHOT_STAGING_ROOT=/srv/elmos/snapshot-staging
ELMOS_SNAPSHOT_ARTIFACT_ROOT=/srv/elmos/snapshot-artifacts
ELMOS_SNAPSHOT_MATERIALIZED_ROOT=/srv/elmos/snapshot-materialized
ELMOS_SNAPSHOT_MATERIALIZATION_LEASE_HOLDER_ID=CHANGE_ME-control-plane-1
ELMOS_SNAPSHOT_MATERIALIZATION_LEASE_DURATION=PT2M
ELMOS_SNAPSHOT_MATERIALIZATION_LEASE_HEARTBEAT_INTERVAL=PT30S
ELMOS_SNAPSHOT_MATERIALIZATION_LEASE_HEARTBEAT_THREADS=2
ELMOS_SNAPSHOT_RECONCILIATION_SCHEDULER_ENABLED=false
ELMOS_SNAPSHOT_RECONCILIATION_WORKER_ID=
ELMOS_SNAPSHOT_RECONCILIATION_TENANT_LIMIT=16
ELMOS_SNAPSHOT_RECONCILIATION_PER_TENANT_LIMIT=100
ELMOS_SNAPSHOT_RECONCILIATION_SCHEDULER_LEASE=PT2M
ELMOS_SNAPSHOT_RECONCILIATION_FAILURE_RETRY=PT1M
ELMOS_SNAPSHOT_RECONCILIATION_SCHEDULER_INTERVAL_MS=30000
# Remains disabled until the deployment supplies a workload-identity SSLContext
# provider that resolves these opaque references outside repository configuration.
ELMOS_SNAPSHOT_CAS_ENABLED=false
ELMOS_SNAPSHOT_CAS_ENCRYPTION_ENABLED=false
ELMOS_SNAPSHOT_CAS_ENCRYPTION_PROVIDER=KMS
ELMOS_CAS_KMS_BROKER_ENDPOINT=https://CHANGE_ME/kms/v1
ELMOS_CAS_KMS_BROKER_CONNECT_TIMEOUT=5s
ELMOS_CAS_KMS_BROKER_OPERATION_TIMEOUT=15s
ELMOS_CAS_KMS_WORKLOAD_SPIFFE_ID=spiffe://CHANGE_ME/control-plane/cas
ELMOS_CAS_KMS_MTLS_SECRET_REFERENCE=secret://CHANGE_ME/cas-kms-mtls
ELMOS_CAS_KMS_AUTHORIZATION_SECRET_REFERENCE=secret://CHANGE_ME/cas-kms-policy

# =============================================================================
# 8. 整库转换（首发不上线时全部留空）
# =============================================================================
# [COND] 仅当开放 /translation 时填写；必须是管理员物化的只读绝对目录。
# 生产 API 只接受 control-plane 已按租户授权的 repositoryWorkspaceId；
# 行为用例布局固定为 <ELMOS_TRANSLATION_CASES_ROOT>/<tenantId>/<bundleId>。
ELMOS_TRANSLATION_SOURCE_ROOT=
ELMOS_TRANSLATION_CASES_ROOT=
# 托管翻译镜像已在 ELMOS_RUNNER_IMAGE_TRANSLATION 配置。

# =============================================================================
# 9. Spring 升级代理（首发不上线时全部留空）
# =============================================================================
# [COND] 仅当开放 /spring 时填写
ELMOS_SPRING_PROXY_ENABLED=false
ELMOS_SPRING_PROXY_AUTH_TOKEN_FILE=
ELMOS_SPRING_PROXY_AUTH_TOKEN_EXPIRES_AT=
ELMOS_SPRING_PROXY_ACTOR_ID=
# ⚠ 单租户假设：多租户上线前必须移除对该变量的依赖
ELMOS_TRUSTED_SINGLE_TENANT_ORGANIZATION_ID=

# =============================================================================
# 10. 运维与管理端
# =============================================================================
# [REQUIRED]
ELMOS_OPERATIONS_API_KEY=CHANGE_ME
# [REQUIRED] RFC3339，签发时不得超过未来 24 小时
ELMOS_OPERATIONS_API_KEY_EXPIRES_AT=CHANGE_ME
ELMOS_OPERATIONS_TENANT_ID=CHANGE_ME
ELMOS_OPERATIONS_ACTOR_ID=CHANGE_ME
# [REQUIRED] 生产必须为 false
ELMOS_ADMIN_ALLOW_TOKEN_FALLBACK=false
# [COND] 仅获批 break-glass 窗口设置；四项身份必须与 operations 绑定一致
ELMOS_ADMIN_OBSERVABILITY_TOKEN=
ELMOS_ADMIN_OBSERVABILITY_TOKEN_EXPIRES_AT=
ELMOS_ADMIN_OBSERVABILITY_TENANT_ID=
ELMOS_ADMIN_OBSERVABILITY_ACTOR_ID=
ELMOS_ADMIN_OBSERVABILITY_ROLE=
# [REQUIRED]
ELMOS_BUSINESS_AUDIT_REQUIRED=true

# Workspace Service 危险执行面使用独立的短租约，不复用 operations/admin key。
# [REQUIRED] ≥24 字节且不超过未来 24 小时；租户和 actor 精确绑定。
ELMOS_REPOSITORY_WORKSPACE_API_KEY=CHANGE_ME
ELMOS_REPOSITORY_WORKSPACE_API_KEY_EXPIRES_AT=CHANGE_ME
ELMOS_REPOSITORY_WORKSPACE_TENANT_ID=CHANGE_ME
ELMOS_REPOSITORY_WORKSPACE_ACTOR_ID=CHANGE_ME

# =============================================================================
# 11. 绝不设置的变量
# =============================================================================
# 以下变量只在仓库内部或测试语境有意义，生产环境设置它们会造成状态失真：
#   ELMOS_CERTIFIED / ELMOS_VALIDATED / ELMOS_OFFICIAL / ELMOS_INTERNAL
#   ELMOS_BILLING_TEST_* （一次性可销毁数据库测试专用）
#   ELMOS_E2E_*          （端到端测试专用）
