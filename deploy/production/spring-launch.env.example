# Copy this exact 20-key Spring-only template to /controlled/spring/spring.env.
# Its immediate parent /controlled/spring must be owned by the current gate
# process UID:GID with mode 0700; set the file itself to mode 0600 or 0400.
# Replace values only after the corresponding external attestation exists.
# The launch validator parses this file as data; shell syntax and interpolation
# are forbidden. Checked-in defaults intentionally cannot pass the launch gate.
ELMOS_SPRING_PROXY_ENABLED=false
ELMOS_SPRING_PROXY_MULTI_TENANT=true
ELMOS_SPRING_ENGINE_AUTH_ENABLED=false
ELMOS_SPRING_UPGRADE_ROOTLESS_ATTESTED=false
ELMOS_SPRING_UPGRADE_NETWORK_POLICY_ATTESTED=false
ELMOS_SPRING_UPGRADE_VERIFIER_ENABLED=false
ELMOS_SPRING_TRANSFORMER_BROKER_ENABLED=false
ELMOS_SPRING_RUNTIME_RUNNER_ENABLED=false
ELMOS_SPRING_UPGRADE_EXPERIMENTAL_ROUTES_ENABLED=false
ELMOS_SPRING_CODING_AGENT_ENABLED=false
ELMOS_SPRING_UPGRADE_VERIFIER_ID=
ELMOS_SPRING_UPGRADE_VERIFIER_BASE_URL=
ELMOS_SPRING_TRANSFORMER_BROKER_BASE_URL=
ELMOS_SPRING_RUNTIME_RUNNER_BASE_URL=
ELMOS_JAVA_UPGRADE_WORKSPACE_HOST_PATH=/srv/elmos/spring-shared/runs
ELMOS_SPRING_ENGINE_HMAC_SECRET_HOST_PATH=/srv/elmos/spring-secrets/application/engine.hmac
ELMOS_VERIFIER_HMAC_SECRET_HOST_PATH=/srv/elmos/spring-secrets/application/verifier.hmac
ELMOS_TRANSFORMER_HMAC_SECRET_HOST_PATH=/srv/elmos/spring-secrets/application/transformer.hmac
ELMOS_SPRING_RUNTIME_HMAC_SECRET_HOST_PATH=/srv/elmos/spring-secrets/application/runtime.hmac
ELMOS_SPRING_ENGINE_REPLAY_HOST_PATH=/srv/elmos/spring-replay/application/engine
