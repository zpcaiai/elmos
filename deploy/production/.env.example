# Compose interpolation manifest only. Copy outside the repository, keep the
# parent directory 0700 and the file 0400/0600, then pass it with --env-file.
# This file is never injected into a container and must contain no credential.
ELMOS_ENV_FILE=/srv/elmos/config/compose.env
ELMOS_WEB_ENV_FILE=/srv/elmos/config/web-console.env
ELMOS_CONTROL_PLANE_ENV_FILE=/srv/elmos/config/control-plane.env
ELMOS_COMMERCIAL_API_ENV_FILE=/srv/elmos/config/commercial-api.env
ELMOS_WORKSPACE_SERVICE_ENV_FILE=/srv/elmos/config/workspace-service.env
ELMOS_DATABASE_DATA_ENGINE_ENV_FILE=/srv/elmos/config/database-data-engine.env
ELMOS_EGRESS_PROXY_ENV_FILE=/srv/elmos/config/egress-proxy.env
ELMOS_MINIO_ENV_FILE=/srv/elmos/config/minio.env
ELMOS_SECRET_ROOT=/srv/elmos/secrets
