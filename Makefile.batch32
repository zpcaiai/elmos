UV ?= uv
BATCH32_PYTHON ?= $(UV) run --quiet --with jsonschema --with pyyaml python
.PHONY: batch32-validate batch32-test batch32-check batch32-portable-check batch32-score
batch32-validate:
	$(BATCH32_PYTHON) scripts/batch32/validate_skill_bundle.py .agents/skills
batch32-test:
	$(BATCH32_PYTHON) -m unittest discover -s tests/batch32 -p 'test_*.py'
batch32-check: batch32-validate batch32-test
batch32-portable-check: batch32-validate
	@set -eu; \
	for test_file in tests/batch32/test_*.py; do \
		case "$$test_file" in \
			tests/batch32/test_frontend_formal_route_campaign.py|tests/batch32/test_frontend_formal_route_campaign_v2.py) \
				echo "SKIP $$test_file: receipt-bound macOS formal runtime"; continue ;; \
		esac; \
		$(BATCH32_PYTHON) "$$test_file"; \
	done
batch32-score:
	$(BATCH32_PYTHON) scripts/batch32/score_client_candidates.py templates/batch32/client-candidates.json --output /tmp/batch32-client-candidates-result.json
