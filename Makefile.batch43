UV ?= uv
BATCH43_PYTHON ?= $(UV) run --quiet --with jsonschema --with pyyaml python
.PHONY: batch43-evidence batch43-check batch43-scaffold batch43-gate batch43-gaps batch43-score batch43-manifest batch43-request
batch43-check:
	$(BATCH43_PYTHON) scripts/mature_product_toolkit.py validate --batch 43
	$(BATCH43_PYTHON) -m unittest discover -s tests/batch43 -p 'test_*.py'
batch43-scaffold:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(OWNER)" || (echo "OWNER=<owner> required" && exit 2)
	$(BATCH43_PYTHON) scripts/mature_product_toolkit.py scaffold --batch 43 --key $(PACK) --owner $(OWNER)
batch43-gate:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(TRUST_STORE)" || (echo "TRUST_STORE=<external-trust-store.json> required" && exit 2)
	$(BATCH43_PYTHON) scripts/mature_product_toolkit.py gate --batch 43 mature-product-packs/batch43/$(PACK) --trust-store $(TRUST_STORE)
batch43-gaps:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH43_PYTHON) scripts/mature_product_toolkit.py gaps --batch 43 mature-product-packs/batch43/$(PACK)
batch43-score:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH43_PYTHON) scripts/mature_product_toolkit.py score --batch 43 mature-product-packs/batch43/$(PACK)/candidates.json $(if $(WRITE),--write,)
batch43-manifest:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(EXECUTOR)" || (echo "EXECUTOR=<identity> required" && exit 2)
	@test -n "$(VERIFIER)" || (echo "VERIFIER=<independent identity> required" && exit 2)
	@test -n "$(AUTHORIZATION)" || (echo "AUTHORIZATION=<ref> required" && exit 2)
	@test -n "$(REPLAY)" || (echo "REPLAY=<command> required" && exit 2)
	@test -n "$(STARTED_AT)" || (echo "STARTED_AT=<ISO-8601> required" && exit 2)
	@test -n "$(FINISHED_AT)" || (echo "FINISHED_AT=<ISO-8601> required" && exit 2)
	$(BATCH43_PYTHON) scripts/mature_product_toolkit.py manifest --batch 43 mature-product-packs/batch43/$(PACK) \
		--artifact mature-product-packs/batch43/$(PACK)/$(ARTIFACT) \
		--environment mature-product-packs/batch43/$(PACK)/$(ENVIRONMENT) \
		--executor $(EXECUTOR) --verifier $(VERIFIER) --authorization $(AUTHORIZATION) \
		--replay-command "$(REPLAY)" --started-at $(STARTED_AT) --finished-at $(FINISHED_AT) \
		--attest-verifier-independent --attest-corpus-independence
batch43-request:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(KEY_ID)" || (echo "KEY_ID=<certification key id> required" && exit 2)
	$(BATCH43_PYTHON) scripts/mature_product_toolkit.py request --batch 43 mature-product-packs/batch43/$(PACK) --key-id $(KEY_ID)
batch43-evidence:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	python3 scripts/batch43_schema_compatibility_check.py --root schemas --root contracts --root telemetry \
		--output mature-product-packs/batch43/$(PACK)/evidence/execution/b43-schema-compatibility-run.json
	python3 scripts/mature_product_run_context.py --pack mature-product-packs/batch43/$(PACK) \
		--run-report mature-product-packs/batch43/$(PACK)/evidence/execution/b43-schema-compatibility-run.json \
		--claim b43-schema-surface-compatibility --surface-root schemas --surface-root contracts --surface-root telemetry
