# Generated Spring route reference build (175M of regenerable output).
build/
# Scratch snapshot kept only for a single debugging session.
_to_delete/

# --- 打包产物（可重新生成，不入库） ---
/elmos-*.tar.gz
/modules/cas/elmos-cas-wave3-repo.tar.gz
/elmos-*.skill
/elmos-*.bundle
/artifacts/batch105-108/
/artifacts/frontend-to-miniapp/local-runtime-receipt-v1/
/docs/migration-spec-source-batches.tar.gz
/skills/*.zip
/skills/batch_01_to_44_complete_skill_system/

# --- 单次运行的痕迹 ---
# .ai/ 同时装着要留档的 markdown（EVIDENCE / HANDOFF / IMPLEMENTATION_STATUS /
# TASK / TEST_RESULTS）和一次性运行留下的日志、状态与 pid 文件，所以这里按后缀
# 逐条排除，不整目录忽略 —— 否则那五份记录会一起消失。
/.ai/*.log
/.ai/*.status
/.ai/*.pid
/.ai/*.pgid
/.ai/*.runner-pid
/.ai/*.basetemp
/.ai/*.sha256
/.ai/*.meta
/.ai/*.command.txt
/.ai/*.bak-*
/.ai-tmp/

# pytest --basetemp 取证时的落点。不加前导斜杠：--basetemp 是相对于
# 当前工作目录的，而这些命令通常在某个 engines/<x>/ 下面跑，不在仓库根。
_pytest_tmp/
**/_pytest_tmp/

# --- 工具链与运行时在仓库根部留下的缓存 ---
/.hvigor/
/.pnpm-store/
/__cmake_systeminformation/
erl_crash.dump
**/erl_crash.dump

# --- 调试快照与临时探针 ---
**/_snapshot-*/
**/probe.tmp.*
/gate-triage.sh
apps/web-console/test-results/

