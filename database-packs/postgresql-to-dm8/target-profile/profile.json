{
  "schema_version": 1,
  "profile_key": "postgresql-to-dm8-target",
  "version": "1.0.0",
  "owner": "ELMOS ChinaDB Adapter Maintainers",
  "engine": "dm8",
  "versions": [
    "8.1.3.140"
  ],
  "edition": "enterprise",
  "dialect": "dm8-oracle-compatible",
  "driver_versions": [
    "dm-jdbc:8.1.3.140"
  ],
  "charset": "UTF-8",
  "collation": "BINARY",
  "timezone": "Asia/Shanghai",
  "extensions": [],
  "provision": {
    "commands": [
      "dmserver --version",
      "disql SELECT id_code FROM v$instance"
    ],
    "image_digests": []
  },
  "health_check": {
    "query": "SELECT 1"
  },
  "security": {
    "credential_mode": "ephemeral",
    "tls": "required"
  },
  "migration": {
    "ddl_strategy": "typed-ir-then-dm8-render",
    "data_strategy": "disabled-until-authorized"
  },
  "providers": {
    "compatibility_mode": "oracle-compatible-explicit",
    "adapter_id": "chinadb.dm8.target-adapter.v1",
    "licensed_disposable_sandbox": "NOT_PROVISIONED"
  }
}
