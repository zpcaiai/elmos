{
  "schema_version": 1,
  "profile_key": "postgresql-to-dm8-target",
  "version": "1.0.0",
  "owner": "ELMOS ChinaDB Adapter Maintainers",
  "engine": "dm8",
  "versions": [
    "8.1.3.140"
  ],
  "patch_version": "8.1.3.140",
  "edition": "enterprise",
  "dialect": "dm8-oracle-compatible",
  "driver_versions": [
    "dm-jdbc:8.1.3.140"
  ],
  "charset": "UTF-8",
  "collation": "BINARY",
  "timezone": "Asia/Shanghai",
  "extensions": [],
  "provision": {
    "commands": [
      "dmserver --version",
      "disql SELECT id_code FROM v$instance"
    ],
    "image_digests": [],
    "image_digest_status": "NOT_PROVISIONED",
    "required_architecture": "operator-selected-exact-linux-architecture"
  },
  "health_check": {
    "query": "SELECT 1"
  },
  "security": {
    "credential_mode": "ephemeral",
    "tls": "required"
  },
  "migration": {
    "ddl_strategy": "typed-ir-then-dm8-render",
    "data_strategy": "disabled-until-authorized"
  },
  "providers": {
    "compatibility_mode": "oracle-compatible-explicit",
    "adapter_id": "chinadb.dm8.target-adapter.v1",
    "deployment_topology": "single-instance-non-mpp",
    "sql_mode": "oracle-compatible-explicit",
    "licensed_disposable_sandbox": "NOT_PROVISIONED",
    "license_ref": null,
    "license_digest": null,
    "license_verification": "NOT_RUN",
    "rls": {
      "mode": "DBMS_RLS_ENABLE_RLS_1_NON_MPP",
      "enable_rls": 1,
      "initialization": "SP_INIT_RLS_SYS(1)",
      "mpp_supported": false
    }
  }
}
