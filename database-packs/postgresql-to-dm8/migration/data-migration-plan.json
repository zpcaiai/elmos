{
  "schema_version": 1,
  "pack_key": "postgresql-to-dm8",
  "owner": "ELMOS Database Migration",
  "status": "blocked",
  "strategy": "checkpoint-backfill-then-cdc-with-detail-reconciliation",
  "source": {
    "engine": "postgresql",
    "versions": ["17.5"],
    "edition": "community",
    "dialect": "postgresql",
    "driver_versions": ["psql:17.5"],
    "charset": "UTF8",
    "collation": "C",
    "timezone": "UTC",
    "extensions": [],
    "authority": "retained"
  },
  "target": {
    "engine": "dm8",
    "versions": ["8.1.3.140"],
    "edition": "enterprise",
    "dialect": "dm8-oracle-compatible",
    "driver_versions": ["dm-jdbc:8.1.3.140"],
    "charset": "UTF-8",
    "collation": "BINARY",
    "timezone": "Asia/Shanghai",
    "extensions": [],
    "compatibility_mode": "oracle-compatible-explicit",
    "provisioning": "NOT_RUN"
  },
  "backfill": {
    "plan_ref": "backfill/plan.json",
    "batch_size": 1000,
    "partitions": ["NOT_RUN_NO_AUTHORIZED_TARGET"],
    "checkpoint": "tenant_id,id",
    "checkpoint_store": "durable",
    "idempotent": true
  },
  "cdc": {
    "enabled": false,
    "status": "NOT_RUN",
    "plan_ref": "cdc/plan.json",
    "reason": "No authorized DM8 target or durable CDC lease is available.",
    "position_store": "durable",
    "delete_propagation": true
  },
  "authority": {
    "before_cutover": "source",
    "after_cutover": "NOT_RUN"
  },
  "reconciliation": [
    {
      "status": "NOT_RUN",
      "plan_ref": "reconciliation/plan.json",
      "grain": "table-primary-key-row-field",
      "keys": ["tenant_id", "id"],
      "money": {"field": "amount", "precision": 19, "scale": 4, "comparison": "exact-value-and-scale"},
      "money_comparison": "exact-decimal-no-tolerance",
      "required_difference_count": 0,
      "required_p0_difference_count": 0
    }
  ],
  "rollback": {
    "strategy": "retain-postgresql-authority-and-replay-target-window-journal",
    "cutover_plan_ref": "cutover/plan.json",
    "failure_injection_plan_ref": "failure-injection/plan.json",
    "required_target_window_write_loss_count": 0
  },
  "privacy": {
    "classification": "synthetic",
    "production_data": false,
    "residency": ["local-disposable-or-approved-china-region-sandbox"],
    "retention": "delete-after-evidence-retention-window"
  },
  "authorization": {
    "source_read": "NOT_GRANTED",
    "target_provision": "NOT_GRANTED",
    "target_write": "NOT_GRANTED",
    "cutover": "NOT_GRANTED"
  }
}
