{
  "schema_version": 1,
  "pack_key": "postgresql-to-dm8",
  "tuples": [
    {
      "source_engine": "postgresql",
      "source_version": "17.5",
      "source_edition": "community",
      "target_engine": "dm8",
      "target_version": "8.1.3.140",
      "target_edition": "enterprise",
      "source_driver": "psql:17.5",
      "target_driver": "dm-jdbc:8.1.3.140",
      "target_compatibility_mode": "oracle-compatible-explicit",
      "status": "experimental",
      "evidence_refs": [
        "certification/local-postgresql-dm8-query-evidence.json"
      ]
    }
  ],
  "recertification_triggers": [
    "PostgreSQL patch or collation change",
    "DM8 version edition compatibility mode or driver change",
    "adapter renderer or SQLGlot version change",
    "capability snapshot or workload scope change"
  ]
}
