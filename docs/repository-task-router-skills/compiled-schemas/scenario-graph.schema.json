{
  "$id": "https://elmos.dev/schemas/repository-task-router/scenario-graph.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "scenarios": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "happy",
              "failure",
              "boundary",
              "compatibility",
              "rollback",
              "operational"
            ]
          },
          "statement": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "statement"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "scenarios",
    "edges"
  ],
  "type": "object"
}
