{
  "$id": "https://elmos.dev/schemas/repository-task-router/plan-revision.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assumptions_changed": {
      "type": "array"
    },
    "changes": {
      "type": "array"
    },
    "invalidated_evidence": {
      "type": "array"
    },
    "parent_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "preserved_evidence": {
      "type": "array"
    },
    "revision": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "trigger": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "revision",
    "trigger",
    "changes",
    "assumptions_changed",
    "invalidated_evidence"
  ],
  "type": "object"
}
