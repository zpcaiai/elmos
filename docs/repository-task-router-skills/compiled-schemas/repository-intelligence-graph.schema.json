{
  "$id": "https://elmos.dev/schemas/repository-task-router/repository-intelligence-graph.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "nodes": {
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "revision": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "revision",
    "nodes",
    "edges"
  ],
  "type": "object"
}
