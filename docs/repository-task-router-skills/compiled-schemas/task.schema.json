{
  "$id": "https://elmos.dev/schemas/repository-task-router/task.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "owned_paths": {
              "minItems": 1
            }
          },
          "required": [
            "owned_paths"
          ]
        },
        {
          "properties": {
            "read_only": {
              "const": true
            }
          },
          "required": [
            "read_only"
          ]
        }
      ]
    }
  ],
  "description": "Atomic planning input. Complexity and status are optional stage-owned annotations added by the estimator and journal after decomposition.",
  "properties": {
    "acceptance": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "complexity": {
      "type": "object"
    },
    "context_pack": {
      "type": "object"
    },
    "cross_boundary_coupling": {
      "type": [
        "string",
        "integer"
      ]
    },
    "dependencies": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "forbidden_paths": {
      "items": {
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "granularity": {
      "type": "object"
    },
    "hierarchy_level": {
      "enum": [
        "goal",
        "capability",
        "changeset",
        "atomic_task",
        "microstep"
      ]
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "type": "string"
    },
    "impact_confidence": {
      "type": [
        "string",
        "integer"
      ]
    },
    "incoming_contract_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "invariant_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "objective": {
      "minLength": 1,
      "type": "string"
    },
    "outgoing_contract_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "owned_paths": {
      "items": {
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "plan_revision": {
      "minLength": 1,
      "type": "string"
    },
    "proof_obligation_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "read_only": {
      "type": "boolean"
    },
    "read_paths": {
      "items": {
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "risk": {
      "type": "object"
    },
    "routing": {
      "type": "object"
    },
    "scenario_refs": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "semantic_cohesion": {
      "type": [
        "string",
        "integer"
      ]
    },
    "status": {
      "enum": [
        "planned",
        "ready",
        "running",
        "blocked",
        "failed",
        "passed",
        "waived"
      ]
    },
    "task_class": {
      "minLength": 1,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "uncertainty": {
      "type": [
        "object",
        "string"
      ]
    },
    "verification_locality": {
      "type": [
        "string",
        "integer"
      ]
    }
  },
  "required": [
    "id",
    "title",
    "objective",
    "acceptance"
  ],
  "type": "object"
}
