{
  "$id": "https://elmos.dev/schemas/repository-task-router/invariant-ledger.v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "invariants": {
      "items": {
        "properties": {
          "evidence_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "scope": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "statement": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "enum": [
              "VERIFIED",
              "UNVERIFIED",
              "VIOLATED"
            ]
          }
        },
        "required": [
          "id",
          "statement",
          "risk",
          "status"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "invariants"
  ],
  "type": "object"
}
