<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.elmos</groupId>
    <artifactId>elmos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>elmos-runner-agent</artifactId>

  <!--
    Deliberately empty. The Runner Agent is the one component that sits next to
    untrusted customer workloads on every node, so its dependency tree is its
    attack surface. Everything it needs - HTTP client, virtual threads, an HTTP
    server for /metrics, SHA-256 - is in the JDK 21 platform.

    This also means the produced jar is a few hundred kilobytes, starts in
    milliseconds, and can be audited end to end by reading fourteen files.
    Do not add a dependency here without an explicit security review.
  -->
  <dependencies/>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>io.elmos.runner.RunnerAgentMain</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>21</release>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <!--
        The acceptance suite is a plain main class, not a JUnit run, so that the
        zero-dependency rule also holds for test scope. It compiles the test
        sources and executes them; a non-zero exit fails the build.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>runner-agent-self-test</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.elmos.runner.AgentSelfTest</mainClass>
              <classpathScope>test</classpathScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
