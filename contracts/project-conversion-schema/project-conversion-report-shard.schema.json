{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/contracts/project-conversion-report-shard.schema.json",
  "title": "ELMOS project language conversion report shard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "report_id", "status", "repository", "route", "metric",
    "status_counts", "code_artifact_ready", "functions", "exclusions", "blockers", "build_verification",
    "evidence_boundary", "markdown_renderer_version", "markdown_sha256", "certification_status", "shard"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "kind": { "const": "elmos.project-language-conversion-report-shard" },
    "report_id": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "status": { "enum": ["COMPLETE", "PARTIAL", "BLOCKED"] },
    "repository": { "$ref": "project-conversion-report.schema.json#/properties/repository" },
    "route": { "$ref": "project-conversion-report.schema.json#/properties/route" },
    "metric": { "$ref": "project-conversion-report.schema.json#/properties/metric" },
    "status_counts": { "$ref": "project-conversion-report.schema.json#/properties/status_counts" },
    "code_artifact_ready": { "type": "boolean" },
    "functions": { "type": "array", "minItems": 1, "maxItems": 2000, "items": { "$ref": "project-conversion-report.schema.json#/$defs/function" } },
    "exclusions": { "type": "array", "maxItems": 0 },
    "blockers": { "type": "array", "maxItems": 2000, "items": { "type": "string", "maxLength": 120 } },
    "build_verification": { "$ref": "project-conversion-report.schema.json#/properties/build_verification" },
    "evidence_boundary": { "$ref": "project-conversion-report.schema.json#/properties/evidence_boundary" },
    "markdown_renderer_version": { "const": "elmos-functional-conversion-markdown/v1" },
    "markdown_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "certification_status": { "const": "NOT_CERTIFIED" },
    "shard": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "total", "function_count", "status_counts", "obligation_ids_sha256"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "total": { "type": "integer", "minimum": 1, "maximum": 5 },
        "function_count": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "status_counts": { "$ref": "project-conversion-report.schema.json#/properties/status_counts" },
        "obligation_ids_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
