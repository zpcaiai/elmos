{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/pricing-catalog/elmos-pricing-catalog.schema.json",
  "title": "ELMOS CNY pricing catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "status",
    "currency",
    "effectiveFrom",
    "effectiveUntil",
    "authoritativeSource",
    "sellerLegalEntityStatus",
    "taxStatus",
    "taxPresentation",
    "paymentStatus",
    "paymentProvider",
    "costValidationStatus",
    "overagePolicy",
    "allowanceScope",
    "plans",
    "tokenClasses",
    "creditRates",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "SUPERSEDED"
      ]
    },
    "currency": {
      "const": "CNY"
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date-time"
    },
    "effectiveUntil": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "authoritativeSource": {
      "type": "string",
      "minLength": 1
    },
    "sellerLegalEntityStatus": {
      "enum": [
        "NOT_CONFIGURED",
        "CONFIGURED"
      ]
    },
    "taxStatus": {
      "enum": [
        "NOT_CONFIGURED",
        "CONFIGURED"
      ]
    },
    "taxPresentation": {
      "enum": [
        "UNSPECIFIED",
        "TAX_INCLUSIVE",
        "TAX_EXCLUSIVE"
      ]
    },
    "paymentStatus": {
      "enum": [
        "NOT_CONFIGURED",
        "CONFIGURED"
      ]
    },
    "paymentProvider": {
      "enum": [
        "STRIPE_CHECKOUT",
        "ALIPAY_CHECKOUT",
        "WECHAT_PAY_NATIVE"
      ]
    },
    "costValidationStatus": {
      "enum": [
        "NOT_RUN",
        "VALIDATED"
      ]
    },
    "overagePolicy": {
      "const": "HARD_STOP_NO_AUTOMATIC_CHARGE"
    },
    "allowanceScope": {
      "enum": [
        "ORGANIZATION",
        "ACTOR"
      ]
    },
    "plans": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/plan"
      }
    },
    "creditRates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/creditRate"
      }
    },
    "tokenClasses": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/tokenClass"
      },
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "integerQuantity": {
      "type": "integer",
      "minimum": 0
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "name",
        "eyebrow",
        "description",
        "priceFen",
        "billingLabel",
        "billingPeriod",
        "effectiveMonthlyFen",
        "termDays",
        "allowanceWindow",
        "tokens",
        "credits",
        "annualTokens",
        "annualCredits",
        "activeProjects",
        "concurrentJobs",
        "artifactRetentionDays",
        "featured",
        "trialEligibilityPolicy",
        "features"
      ],
      "properties": {
        "planId": {
          "enum": [
            "elmos-free-trial",
            "elmos-pro-monthly",
            "elmos-pro-annual"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "eyebrow": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "priceFen": {
          "$ref": "#/$defs/integerQuantity"
        },
        "billingLabel": {
          "type": "string",
          "minLength": 1
        },
        "billingPeriod": {
          "enum": [
            "TRIAL",
            "MONTH",
            "YEAR"
          ]
        },
        "effectiveMonthlyFen": {
          "$ref": "#/$defs/integerQuantity"
        },
        "termDays": {
          "type": "integer",
          "minimum": 1
        },
        "allowanceWindow": {
          "enum": [
            "TRIAL_TERM",
            "MONTHLY"
          ]
        },
        "tokens": {
          "$ref": "#/$defs/integerQuantity"
        },
        "credits": {
          "$ref": "#/$defs/integerQuantity"
        },
        "annualTokens": {
          "$ref": "#/$defs/integerQuantity"
        },
        "annualCredits": {
          "$ref": "#/$defs/integerQuantity"
        },
        "activeProjects": {
          "type": "integer",
          "minimum": 1
        },
        "concurrentJobs": {
          "type": "integer",
          "minimum": 1
        },
        "artifactRetentionDays": {
          "type": "integer",
          "minimum": 1
        },
        "featured": {
          "type": "boolean"
        },
        "trialEligibilityPolicy": {
          "enum": [
            "ONE_PER_VERIFIED_ORGANIZATION",
            "NOT_APPLICABLE"
          ]
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "creditRate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationKey",
        "label",
        "credits",
        "unit",
        "meterVersion"
      ],
      "properties": {
        "operationKey": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "credits": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "meterVersion": {
          "const": "platform-credit-v1"
        }
      }
    },
    "tokenClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tokenClass",
        "unit",
        "providerReceiptRequired"
      ],
      "properties": {
        "tokenClass": {
          "enum": [
            "INPUT",
            "OUTPUT",
            "CACHE_READ",
            "CACHE_WRITE"
          ]
        },
        "unit": {
          "const": "token"
        },
        "providerReceiptRequired": {
          "const": true
        }
      }
    }
  }
}
