{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/pricing-catalog/elmos-pricing-catalog.schema.json",
  "title": "ELMOS CNY pricing catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "status",
    "currency",
    "sellerLegalEntityStatus",
    "taxStatus",
    "paymentStatus",
    "overagePolicy",
    "plans",
    "creditRates",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "PUBLISHED", "SUPERSEDED"] },
    "currency": { "const": "CNY" },
    "sellerLegalEntityStatus": { "enum": ["NOT_CONFIGURED", "CONFIGURED"] },
    "taxStatus": { "enum": ["NOT_CONFIGURED", "CONFIGURED"] },
    "paymentStatus": { "enum": ["NOT_CONFIGURED", "CONFIGURED"] },
    "overagePolicy": { "const": "HARD_STOP_NO_AUTOMATIC_CHARGE" },
    "plans": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/plan" }
    },
    "creditRates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/creditRate" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "integerQuantity": {
      "type": "integer",
      "minimum": 0
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planId",
        "name",
        "eyebrow",
        "description",
        "priceFen",
        "billingLabel",
        "effectiveMonthlyFen",
        "termDays",
        "allowanceWindow",
        "tokens",
        "credits",
        "annualTokens",
        "annualCredits",
        "activeProjects",
        "concurrentJobs",
        "artifactRetentionDays",
        "featured",
        "features"
      ],
      "properties": {
        "planId": {
          "enum": ["elmos-free-trial", "elmos-pro-monthly", "elmos-pro-annual"]
        },
        "name": { "type": "string", "minLength": 1 },
        "eyebrow": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "priceFen": { "$ref": "#/$defs/integerQuantity" },
        "billingLabel": { "type": "string", "minLength": 1 },
        "effectiveMonthlyFen": { "$ref": "#/$defs/integerQuantity" },
        "termDays": { "type": "integer", "minimum": 1 },
        "allowanceWindow": { "enum": ["TRIAL_TERM", "MONTHLY"] },
        "tokens": { "$ref": "#/$defs/integerQuantity" },
        "credits": { "$ref": "#/$defs/integerQuantity" },
        "annualTokens": { "$ref": "#/$defs/integerQuantity" },
        "annualCredits": { "$ref": "#/$defs/integerQuantity" },
        "activeProjects": { "type": "integer", "minimum": 1 },
        "concurrentJobs": { "type": "integer", "minimum": 1 },
        "artifactRetentionDays": { "type": "integer", "minimum": 1 },
        "featured": { "type": "boolean" },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "creditRate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationKey", "label", "credits", "unit"],
      "properties": {
        "operationKey": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "credits": { "type": "integer", "minimum": 1 },
        "unit": { "type": "string", "minLength": 1 }
      }
    }
  }
}
