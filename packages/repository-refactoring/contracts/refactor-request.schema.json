{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/refactor-request.schema.json",
  "title": "Elmos RefactorRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.dev/v1"
    },
    "kind": {
      "const": "RefactorRequest"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenantId",
        "projectId"
      ],
      "properties": {
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories",
        "intent",
        "execution"
      ],
      "properties": {
        "repositories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri",
              "revision"
            ],
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 7
              },
              "subPath": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "primary",
                  "provider",
                  "consumer",
                  "shared",
                  "generated-client"
                ]
              },
              "credentialRef": {
                "type": "string"
              },
              "readOnly": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "goals"
          ],
          "properties": {
            "type": {
              "enum": [
                "structural-refactor",
                "architecture-refactor",
                "framework-upgrade",
                "language-upgrade",
                "api-migration",
                "data-schema-refactor",
                "distributed-system-refactor",
                "performance-refactor",
                "security-refactor",
                "ui-client-refactor",
                "custom"
              ]
            },
            "goals": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 3
              }
            },
            "nonGoals": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "acceptanceCriteria": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "context": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "behaviorCompatibility": {
              "enum": [
                "strict",
                "equivalent-for-covered-workloads",
                "approved-change"
              ]
            },
            "publicApiCompatibility": {
              "enum": [
                "strict",
                "backward-compatible",
                "versioned-break",
                "approved-break"
              ]
            },
            "binaryCompatibility": {
              "enum": [
                "strict",
                "best-effort",
                "not-required"
              ]
            },
            "databaseStrategy": {
              "enum": [
                "none",
                "expand-contract",
                "maintenance-window",
                "approved-destructive"
              ]
            },
            "maximumChangedFiles": {
              "type": "integer",
              "minimum": 1
            },
            "maximumChangedLines": {
              "type": "integer",
              "minimum": 1
            },
            "maximumCostUsd": {
              "type": "number",
              "minimum": 0
            },
            "maximumWallClockSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "allowedPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "forbiddenPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "requiredTests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "performanceGuardrails": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "number",
                  "string"
                ]
              }
            },
            "securityPolicyRef": {
              "type": "string"
            },
            "licensePolicyRef": {
              "type": "string"
            }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "analyze-only",
                "proposal",
                "supervised",
                "autonomous-low-risk",
                "fleet-wave"
              ]
            },
            "createPullRequest": {
              "type": "boolean",
              "default": true
            },
            "targetBranch": {
              "type": "string"
            },
            "maxParallelShards": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            "repairBudget": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxAttempts": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 50
                },
                "maxCostUsd": {
                  "type": "number",
                  "minimum": 0
                },
                "maxChangedFiles": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "approvalPolicyRef": {
              "type": "string"
            },
            "sandboxProfile": {
              "type": "string"
            },
            "networkPolicy": {
              "enum": [
                "deny",
                "restore-only",
                "allowlisted"
              ]
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
