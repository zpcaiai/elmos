{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/pi-harness/signed-verification-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "verifier_id", "verifier_trust_domain", "key_id", "statement", "verdict", "issued_at", "expires_at", "signature_algorithm", "signature", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "elmos.pi-harness.signed-verification/v1"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "verifier_id": {"type": "string", "minLength": 1},
    "verifier_trust_domain": {"type": "string", "minLength": 1},
    "key_id": {"type": "string", "minLength": 1},
    "statement": {
      "type": "object", "additionalProperties": false,
      "required": ["statement_id", "scope", "producer_id", "producer_trust_domain", "subject_digest", "environment_digest", "raw_evidence_digests", "authorization_id", "executor_id", "started_at", "completed_at", "result", "limitations"],
      "properties": {
        "statement_id": {"type": "string", "format": "uuid"},
        "scope": {"type": "string", "minLength": 1},
        "producer_id": {"type": "string", "minLength": 1},
        "producer_trust_domain": {"type": "string", "minLength": 1},
        "subject_digest": {"$ref": "#/$defs/digest"},
        "environment_digest": {"$ref": "#/$defs/digest"},
        "raw_evidence_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "authorization_id": {"type": "string", "minLength": 1},
        "executor_id": {"type": "string", "minLength": 1},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "result": {"enum": ["PASS", "FAIL", "BLOCKED", "UNKNOWN", "NOT_RUN"]},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "verdict": {"enum": ["VERIFIED", "REJECTED", "INCONCLUSIVE"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "signature_algorithm": {"const": "Ed25519"},
    "signature": {"type": "string", "minLength": 1, "contentEncoding": "base64"},
    "receipt_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
