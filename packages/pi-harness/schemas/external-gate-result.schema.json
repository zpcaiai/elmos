{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/pi-harness/external-gate-result-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_id", "gap_id", "release_digest", "target",
    "authorization_id", "executor_id", "producer_trust_domain",
    "environment_digest", "started_at", "completed_at",
    "raw_evidence_digests", "replay_reference", "status", "certified",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "elmos.pi-harness.external-gate-result/v1"},
    "result_id": {"type": "string", "format": "uuid"},
    "gap_id": {"enum": ["P0-G01", "P0-G02", "P0-G03", "P0-G04", "P0-G05", "P0-G06", "P1-G07", "P0-G08"]},
    "release_digest": {"$ref": "#/$defs/digest"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "service", "version", "region", "account_id", "environment"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "service": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "region": {"type": "string", "minLength": 1},
        "account_id": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1}
      }
    },
    "authorization_id": {"type": "string", "minLength": 1},
    "executor_id": {"type": "string", "minLength": 1},
    "producer_trust_domain": {"type": "string", "minLength": 1},
    "environment_digest": {"$ref": "#/$defs/digest"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "raw_evidence_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "replay_reference": {"type": "string", "minLength": 1},
    "status": {"enum": ["EXECUTED", "FAILED", "UNKNOWN"]},
    "certified": {"const": false},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
