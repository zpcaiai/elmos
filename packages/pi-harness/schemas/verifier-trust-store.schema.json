{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/pi-harness/verifier-trust-store-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verifiers"],
  "properties": {
    "schema_version": {"const": "elmos.pi-harness.verifier-trust-store/v1"},
    "verifiers": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["verifier_id", "trust_domain", "key_id", "public_key_base64", "not_before", "not_after", "revoked", "allowed_scopes", "roles"],
        "properties": {
          "verifier_id": {"type": "string", "minLength": 1},
          "trust_domain": {"type": "string", "minLength": 1},
          "key_id": {"type": "string", "minLength": 1},
          "public_key_base64": {"type": "string", "minLength": 1, "contentEncoding": "base64"},
          "not_before": {"type": "string", "format": "date-time"},
          "not_after": {"type": "string", "format": "date-time"},
          "revoked": {"type": "boolean"},
          "allowed_scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "external_gate:P0-G01", "external_gate:P0-G02", "external_gate:P0-G03", "external_gate:P0-G04",
                "external_gate:P0-G05", "external_gate:P0-G06", "external_gate:P1-G07", "external_gate:P0-G08",
                "external_gate_acceptance:P0-G01", "external_gate_acceptance:P0-G02",
                "external_gate_acceptance:P0-G03", "external_gate_acceptance:P0-G04",
                "external_gate_acceptance:P0-G05", "external_gate_acceptance:P0-G06",
                "external_gate_acceptance:P1-G07", "external_gate_acceptance:P0-G08"
              ]
            }
          },
          "roles": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"enum": ["independent_verifier", "acceptance_authority", "customer_authority", "release_authority"]}}
        }
      }
    }
  }
}
