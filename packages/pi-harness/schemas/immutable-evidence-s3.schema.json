{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/pi-harness/immutable-evidence-s3-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bucket", "region", "account_id", "kms_key_arn", "retention_days", "retention_mode", "prefix"],
  "properties": {
    "bucket": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{1,61}[a-z0-9])$"},
    "region": {"type": "string", "pattern": "^[a-z]{2}(?:-[a-z0-9]+)+-[0-9]+$"},
    "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
    "kms_key_arn": {"type": "string", "pattern": "^arn:(?:aws|aws-us-gov|aws-cn):kms:[^:]+:[0-9]{12}:key/[A-Za-z0-9-]+$"},
    "retention_days": {"type": "integer", "minimum": 90, "maximum": 3650},
    "retention_mode": {"enum": ["COMPLIANCE", "GOVERNANCE"]},
    "prefix": {"type": "string", "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"}
  }
}
