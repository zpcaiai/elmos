{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/execution-intelligence/time-comparison.schema.json",
  "title": "time-comparison",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "project_id",
    "definition_of_done",
    "confidence",
    "assumptions",
    "exclusions",
    "system_autonomous",
    "human_only",
    "human_assisted",
    "comparison",
    "same_definition_of_done_for_both_baselines"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact": {
      "const": "time-comparison"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string"
    },
    "definition_of_done": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "system_autonomous": {
      "type": "object",
      "required": [
        "wall_clock_hours",
        "excludes"
      ],
      "properties": {
        "wall_clock_hours": {
          "$ref": "envelope.schema.json"
        },
        "excludes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "human_only": {
      "type": "object",
      "required": [
        "person_hours",
        "calendar_weeks"
      ],
      "properties": {
        "person_hours": {
          "$ref": "envelope.schema.json"
        },
        "person_months": {
          "type": "object"
        },
        "calendar_weeks": {
          "$ref": "envelope.schema.json"
        }
      }
    },
    "human_assisted": {
      "type": "object",
      "required": [
        "end_to_end_hours",
        "review_person_hours"
      ]
    },
    "comparison": {
      "type": "object",
      "required": [
        "calendar_speedup",
        "automation_coverage"
      ]
    },
    "same_definition_of_done_for_both_baselines": {
      "const": true
    }
  }
}
