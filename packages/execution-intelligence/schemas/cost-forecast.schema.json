{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/execution-intelligence/cost-forecast.schema.json",
  "title": "cost-forecast",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "project_id",
    "definition_of_done",
    "confidence",
    "assumptions",
    "exclusions",
    "models",
    "rankings_by_currency",
    "cross_currency_comparison"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact": {
      "const": "cost-forecast"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string"
    },
    "definition_of_done": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "registry_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_currency": {
      "type": "string"
    },
    "currencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "model_id",
          "currency",
          "cost",
          "not_for_billing",
          "effective_date",
          "verified_at",
          "source_reference"
        ],
        "properties": {
          "model_id": {
            "type": "string"
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "billing_mode": {
            "type": [
              "string",
              "null"
            ]
          },
          "not_for_billing": {
            "type": "boolean"
          },
          "cost": {
            "$ref": "envelope.schema.json"
          },
          "mean_cost_by_category": {
            "type": "object"
          }
        }
      }
    },
    "rankings_by_currency": {
      "type": "object"
    },
    "cross_currency_comparison": {
      "const": null
    },
    "cross_currency_note": {
      "type": "string"
    },
    "warning": {
      "type": "string"
    },
    "token_totals_used": {
      "$ref": "envelope.schema.json"
    }
  }
}
