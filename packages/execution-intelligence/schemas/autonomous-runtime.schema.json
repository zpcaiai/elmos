{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/execution-intelligence/autonomous-runtime.schema.json",
  "title": "autonomous-runtime",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "project_id",
    "definition_of_done",
    "confidence",
    "assumptions",
    "exclusions",
    "wall_clock_hours",
    "active_worker_hours",
    "critical_path_hours",
    "scope",
    "excludes"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact": {
      "const": "autonomous-runtime"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string"
    },
    "definition_of_done": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runs": {
      "type": "integer"
    },
    "seed": {
      "type": "integer"
    },
    "configured_workers": {
      "type": "number"
    },
    "effective_worker_capacity": {
      "type": "number"
    },
    "global_overhead_ratio": {
      "type": "number"
    },
    "wall_clock_hours": {
      "$ref": "envelope.schema.json"
    },
    "active_worker_hours": {
      "$ref": "envelope.schema.json"
    },
    "critical_path_hours": {
      "$ref": "envelope.schema.json"
    },
    "scope": {
      "const": "machine-autonomous execution only"
    },
    "excludes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "expected_completion_at": {
      "type": "object"
    }
  }
}
