{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/execution-intelligence/telemetry-ingest.schema.json",
  "title": "telemetry-ingest",
  "description": "Provenance for telemetry ingested from real run artefacts. `measurement` records how the number was obtained so an aggregate is never mistaken for a per-task observation.",
  "type": "object",
  "required": ["schema_version", "artifact", "source", "rows", "logs", "measurement", "token_data_available", "rule"],
  "properties": {
    "schema_version": { "type": "string" },
    "artifact": { "const": "telemetry-ingest" },
    "source": { "type": "string", "minLength": 1 },
    "rows": { "type": "integer", "minimum": 0 },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["log", "total_seconds", "executed_nodes"],
        "properties": {
          "log": { "type": "string" },
          "total_seconds": { "type": "number", "exclusiveMinimum": 0 },
          "executed_nodes": { "type": "integer", "minimum": 1 },
          "passed": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "deselected": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 },
          "mean_seconds_per_node": { "type": "number", "exclusiveMinimum": 0 },
          "aborted_early": { "type": "boolean" }
        }
      }
    },
    "total_executed_nodes": { "type": "integer", "minimum": 0 },
    "total_seconds": { "type": "number", "minimum": 0 },
    "measurement": { "enum": ["aggregate_mean_per_node", "per_task_observed"] },
    "token_data_available": { "type": "boolean" },
    "rule": { "type": "string" }
  }
}
