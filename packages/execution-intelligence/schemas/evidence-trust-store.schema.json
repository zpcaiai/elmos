{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/execution-intelligence/evidence-trust-store.schema.json",
  "title": "evidence-trust-store",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "trust_store_id",
    "keys"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact": {
      "const": "evidence-trust-store"
    },
    "trust_store_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "principal_id",
          "organization_id",
          "authority_id",
          "role",
          "algorithm",
          "public_key_base64",
          "not_before",
          "expires_at",
          "revoked"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "principal_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "organization_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "authority_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "role": {
            "enum": [
              "executor",
              "independent_verifier"
            ]
          },
          "algorithm": {
            "const": "Ed25519"
          },
          "public_key_base64": {
            "type": "string",
            "minLength": 44,
            "maxLength": 44
          },
          "not_before": {
            "type": "string",
            "minLength": 20
          },
          "expires_at": {
            "type": "string",
            "minLength": 20
          },
          "revoked": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
