{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/execution-intelligence/human-effort.schema.json",
  "title": "human-effort",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "project_id",
    "definition_of_done",
    "confidence",
    "assumptions",
    "exclusions",
    "person_hours",
    "person_days",
    "person_months",
    "calendar_weeks",
    "same_definition_of_done"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact": {
      "const": "human-effort"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string"
    },
    "definition_of_done": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runs": {
      "type": "integer"
    },
    "seed": {
      "type": "integer"
    },
    "person_hours": {
      "$ref": "envelope.schema.json"
    },
    "person_days": {
      "type": "object"
    },
    "person_months": {
      "type": "object"
    },
    "calendar_weeks": {
      "$ref": "envelope.schema.json"
    },
    "critical_path_work_hours": {
      "$ref": "envelope.schema.json"
    },
    "role_person_hours": {
      "type": "object",
      "additionalProperties": {
        "$ref": "envelope.schema.json"
      }
    },
    "team": {
      "type": "object"
    },
    "overhead_multiplier": {
      "type": "number"
    },
    "focus_ratio": {
      "type": "number"
    },
    "same_definition_of_done": {
      "const": true
    },
    "baseline_rule": {
      "type": "string"
    }
  }
}
