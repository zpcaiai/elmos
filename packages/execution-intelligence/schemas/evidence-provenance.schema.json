{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/execution-intelligence/evidence-provenance.schema.json",
  "title": "evidence-provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "issued_at",
    "expires_at",
    "subject",
    "attestations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact": {
      "const": "evidence-provenance"
    },
    "issued_at": {
      "type": "string",
      "minLength": 20
    },
    "expires_at": {
      "type": "string",
      "minLength": 20
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_set_id",
        "policy",
        "files"
      ],
      "properties": {
        "evidence_set_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "certifier",
            "policy_version",
            "min_calibration_samples",
            "required_roles"
          ],
          "properties": {
            "certifier": {
              "const": "elmos-execution-intelligence"
            },
            "policy_version": {
              "const": "2.0.0"
            },
            "min_calibration_samples": {
              "type": "integer",
              "minimum": 20
            },
            "required_roles": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "enum": [
                  "executor",
                  "independent_verifier"
                ]
              }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "size_bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "attestations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "key_id",
          "signed_at",
          "signature"
        ],
        "properties": {
          "role": {
            "enum": [
              "executor",
              "independent_verifier"
            ]
          },
          "key_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "signed_at": {
            "type": "string",
            "minLength": 20
          },
          "signature": {
            "type": "string",
            "minLength": 88,
            "maxLength": 88
          }
        }
      }
    }
  }
}
