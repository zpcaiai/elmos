{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/execution-intelligence/production-readiness.schema.json",
  "title": "production-readiness",
  "type": "object",
  "required": [
    "schema_version",
    "artifact",
    "decision",
    "gates",
    "counts",
    "rule"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact": {
      "const": "production-readiness"
    },
    "evidence_dir": {
      "type": "string"
    },
    "decision": {
      "enum": [
        "release",
        "not_certified",
        "block"
      ]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "required",
          "status",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_EXECUTED"
            ]
          },
          "detail": {
            "type": "string"
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "pass",
        "fail",
        "not_executed"
      ]
    },
    "rule": {
      "type": "string"
    },
    "supported_confidence": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
