{
  "version": "1.0.0",
  "notes": [
    "Coefficients are seeds, not measurements. They exist so that a task DAG is derived from measurable repository facts instead of being hand-typed.",
    "minutes = base + coefficient x driver, clamped to [floor, ceiling]. Tokens work the same way, per category.",
    "After the first executed milestone, run `calibrate` and `apply-calibration`; the multipliers correct these seeds with real telemetry.",
    "peak_context declares the largest single-call context a task is expected to need. It gates model routing: a model whose window is narrower is ineligible. Omit it and the constraint is reported as unchecked rather than silently assumed to pass."
  ],
  "drivers": {
    "routes": "declared directed routes in the route matrix (1 if absent)",
    "languages": "language identities in the matrix, else distinct languages by file census",
    "pending_languages": "languages declared but without an analyzer",
    "pending_routes": "routes that touch at least one pending-analyzer language",
    "language_pairs": "languages x (languages - 1)",
    "corpus_mtokens": "one-pass corpus tokens, in millions",
    "kfiles": "scanned files, in thousands"
  },
  "token_split": {
    "comment": "How a task's total token estimate is divided across the five disjoint categories. Cache-heavy because agentic coding re-reads the same context across turns.",
    "input": 0.24,
    "cached_input": 0.63,
    "cache_write": 0.07,
    "output": 0.04,
    "reasoning_output": 0.02
  },
