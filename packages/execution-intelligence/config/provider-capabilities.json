{
  "version": "1.0.0",
  "notes": [
    "Capability tiers are a routing constraint, not a marketing claim. A task may only be routed to a model whose tier meets the task's floor.",
    "Tiers are ordinal: economy < mid < frontier. The tier assigned to each model here is an engineering judgement about task difficulty, not a vendor claim.",
    "A model with an unknown capability profile is never routed to; the optimizer refuses rather than assuming.",
    "max_context_tokens is not yet enforced by the optimizer; it is recorded so a context-aware constraint can be added without another data-gathering pass."
  ],
  "tier_order": [
    "economy",
    "mid",
    "frontier"
  ],
  "complexity_floor": {
    "low": "economy",
    "medium": "mid",
    "high": "frontier"
  },
  "category_floor": {
    "discovery": "mid",
    "engine": "frontier",
    "generation": "frontier",
    "performance": "mid",
    "verification": "mid",
    "compliance": "mid",
    "delivery": "economy",
    "fix": "frontier"
  },
