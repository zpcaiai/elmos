{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/transformation-rule/1.0",
  "title": "Transformation Rule",
  "type": "object",
  "required": [
    "rule_id",
    "version",
    "maturity",
    "source_pattern",
    "target_strategy",
    "semantic_invariants",
    "applicability",
    "verification"
  ],
  "properties": {
    "rule_id": {
      "type": "string",
      "pattern": "^RULE-[A-Z0-9_-]+$"
    },
    "version": {
      "type": "string"
    },
    "maturity": {
      "enum": [
        "experimental",
        "candidate",
        "validated",
        "trusted",
        "certified",
        "deprecated"
      ]
    },
    "source_pattern": {
      "type": "object"
    },
    "target_strategy": {
      "type": "object"
    },
    "semantic_invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "applicability": {
      "type": "object"
    },
    "known_exceptions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "enum": [
        "tenant",
        "organization",
        "global"
      ]
    }
  },
  "additionalProperties": true
}
