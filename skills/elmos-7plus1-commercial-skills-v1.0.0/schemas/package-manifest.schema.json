{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/package-manifest/1.0",
  "title": "Elmos Package Manifest",
  "type": "object",
  "required": [
    "package_id",
    "name",
    "version",
    "phase",
    "dependencies",
    "capabilities"
  ],
  "properties": {
    "package_id": {
      "type": "string",
      "pattern": "^P0[0-7]$"
    },
    "name": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "phase": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P0[0-7]$"
      },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "maturity": {
            "enum": [
              "design",
              "experimental",
              "beta",
              "ga",
              "deprecated"
            ]
          }
        }
      }
    },
    "source_pins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subskills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
