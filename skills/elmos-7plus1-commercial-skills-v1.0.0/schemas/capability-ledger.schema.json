{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/capability-ledger/1.0",
  "title": "Capability Ledger",
  "type": "object",
  "required": [
    "snapshot_id",
    "repository_revision",
    "capabilities",
    "blind_spots"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string"
    },
    "repository_revision": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "risk",
          "state",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CAP-[0-9]{5,}$"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "state": {
            "enum": [
              "discovered",
              "mapped",
              "generated",
              "compiled",
              "tested",
              "verified",
              "blocked",
              "unsupported",
              "semantic_gap"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "blind_spots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "reason",
          "risk"
        ],
        "properties": {
          "scope": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
