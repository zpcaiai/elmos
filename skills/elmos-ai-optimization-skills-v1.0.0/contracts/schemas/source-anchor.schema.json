{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elmos:ao:v1:source-anchor",
  "type": "object",
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "blob_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "start_byte": {
      "type": "integer",
      "minimum": 0
    },
    "end_byte": {
      "type": "integer",
      "minimum": 1
    },
    "symbol": {
      "type": "string"
    }
  },
  "required": [
    "repository",
    "snapshot",
    "generation",
    "path",
    "blob_digest",
    "start_byte",
    "end_byte",
    "symbol"
  ],
  "additionalProperties": false
}
