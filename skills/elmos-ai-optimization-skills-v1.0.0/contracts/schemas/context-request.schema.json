{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elmos:ao:v1:context-request",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "ao.v1"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "maxLength": 4096
    },
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "exact",
        "lexical",
        "hybrid"
      ]
    },
    "selector": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "snapshot_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "context_token_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32768
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "query",
    "mode",
    "snapshot_refs",
    "top_k",
    "context_token_budget"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "exact"
          }
        }
      },
      "then": {
        "required": [
          "selector"
        ],
        "properties": {
          "selector": {
            "minProperties": 1
          }
        }
      }
    }
  ]
}
