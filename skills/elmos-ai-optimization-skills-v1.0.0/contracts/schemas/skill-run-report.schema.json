{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elmos:ao:v1:skill-run-report",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "ao.v1"
      ]
    },
    "batch": {
      "type": "string",
      "enum": [
        "B0",
        "B1",
        "B2",
        "B3",
        "B4",
        "B5",
        "B6"
      ]
    },
    "host_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "blocked",
        "verified"
      ]
    },
    "machine_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "approval_wait_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "not_run": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "batch",
    "host_revision",
    "status",
    "machine_seconds",
    "approval_wait_seconds",
    "artifact_refs",
    "not_run"
  ],
  "additionalProperties": false
}
