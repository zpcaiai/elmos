{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elmos:ao:v1:action-intent",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "ao.v1"
      ]
    },
    "run_ref": {
      "type": "string",
      "minLength": 1
    },
    "logical_step": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "intent_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "requested_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "budget_ref": {
      "type": "string",
      "minLength": 1
    },
    "verification_plan_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "run_ref",
    "logical_step",
    "base_revision",
    "intent_digest",
    "artifact_ref",
    "requested_capabilities",
    "budget_ref",
    "verification_plan_ref"
  ],
  "additionalProperties": false
}
