{
  "schemaVersion": "elmos.technology-registry/v1",
  "kind": "TechnologyRegistry",
  "metadata": {
    "name": "elmos-polyglot-technology-registry-v2",
    "version": "2.0.0"
  },
  "spec": {
    "notes": [
      "React and Flutter are frameworks, not programming languages.",
      "Flutter uses Dart as an implicit implementation substrate; Dart is not exposed as a separate source technology in this bundle.",
      "Node.js and build tools are runtimes/toolchains and are represented inside adapters rather than as languages.",
      "v2 adds 14 P0 legacy language families.",
      "JCL/REXX/CL/Copybook/BMS/MFS/DDS/legacy SQL routines are repository support surfaces registered separately.",
      "All static technology and route entries default to not-run until executed evidence exists."
    ],
    "technologies": [
      {
        "id": "java",
        "display": "Java",
        "kind": "language",
        "adapter_skill": "elmos-adapter-java",
        "extensions": [
          ".java"
