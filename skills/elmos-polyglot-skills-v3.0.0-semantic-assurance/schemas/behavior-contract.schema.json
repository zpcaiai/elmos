{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/behavior-contract.schema.json",
  "title": "ELMOS Behavior Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshotId",
    "contractId",
    "scope",
    "inputs",
    "observations",
    "comparators",
    "nondeterminism",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "elmos.behavior-contract/v1"
    },
    "snapshotId": {
      "type": "string"
    },
    "contractId": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "kind",
        "ref"
      ]
    },
    "inputs": {
      "type": "array"
    },
    "observations": {
      "type": "array",
      "minItems": 1
    },
    "comparators": {
      "type": "array",
      "minItems": 1
    },
    "nondeterminism": {
      "type": "array"
    },
    "provenance": {
      "type": "array",
      "minItems": 1
    },
    "status": {
      "enum": [
        "observed",
        "declared",
        "inferred",
        "unresolved",
        "approved-change"
      ]
    }
  }
}
