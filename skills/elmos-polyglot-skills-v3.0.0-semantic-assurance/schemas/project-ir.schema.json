{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/project-ir.schema.json",
  "title": "ELMOS Project IR",
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshotId",
    "irId",
    "entities",
    "relationships",
    "coverage",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": "elmos.project-ir/v1"
    },
    "snapshotId": {
      "type": "string"
    },
    "irId": {
      "type": "string"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "expected",
        "observed",
        "ratio"
      ],
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "confidence"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "span": {
          "type": "object"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "from",
        "to",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "attributes": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    }
  }
}
