{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/skill-bundle-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "technologies",
    "repository_surfaces",
    "skills"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "2.0"
    },
    "package": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "version",
        "skill_count",
        "technology_count",
        "default_readiness",
        "entry_skills"
      ]
    },
    "technologies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "repository_surfaces": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version",
          "batch",
          "layer",
          "risk",
          "path",
          "description",
          "dependencies",
          "outputs",
          "readiness"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ELMOS-POLY-\\d{3}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string"
          },
          "batch": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E",
              "F",
              "G",
              "H",
              "I"
            ]
          },
          "layer": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "path": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "readiness": {
            "const": "not-run"
          }
        }
      }
    }
  }
}
