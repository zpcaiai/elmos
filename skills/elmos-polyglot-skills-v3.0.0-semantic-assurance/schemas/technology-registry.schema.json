{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/technology-registry.schema.json",
  "title": "ELMOS Technology Registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "schemaVersion": {
      "const": "elmos.technology-registry/v1"
    },
    "kind": {
      "const": "TechnologyRegistry"
    },
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version"
      ]
    },
    "spec": {
      "type": "object",
      "required": [
        "technologies"
      ],
      "properties": {
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "technologies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "display",
              "kind",
              "adapter_skill",
              "extensions",
              "build_tools",
              "parsers",
              "frameworks",
              "verification"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "display": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "language",
                  "framework"
                ]
              },
              "adapter_skill": {
                "type": "string"
              },
              "extensions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "build_tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "parsers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "frameworks": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "verification": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "host_languages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "implicit_runtime": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
