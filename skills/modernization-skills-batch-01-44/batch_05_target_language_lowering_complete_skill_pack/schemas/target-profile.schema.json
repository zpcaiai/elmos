{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:batch-05:target-profile",
  "title": "TargetProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "build_tool",
    "language",
    "language_version",
    "profile_id",
    "record_id",
    "schema_version",
    "scope"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "language_version": {
      "type": "string",
      "minLength": 1
    },
    "framework": {
      "type": "string",
      "minLength": 1
    },
    "framework_version": {
      "type": "string",
      "minLength": 1
    },
    "build_tool": {
      "type": "string",
      "minLength": 1
    },
    "platform_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
