{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:batch-03:ir-node-header",
  "title": "IRNodeHeader",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "node_kind",
    "record_id",
    "schema_version",
    "scope",
    "semantic_level"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "node_kind": {
      "type": "string",
      "minLength": 1
    },
    "semantic_level": {
      "enum": [
        "syntax",
        "resolved",
        "typed",
        "effectful",
        "canonical"
      ]
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "span_ref": {
      "type": "string",
      "minLength": 1
    },
    "unknown_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
