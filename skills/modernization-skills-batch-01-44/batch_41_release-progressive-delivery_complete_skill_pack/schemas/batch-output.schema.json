{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:batch-41:output",
  "title": "Batch 41 Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "status",
    "artifact_refs",
    "evidence_refs",
    "limitations"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed",
        "blocked",
        "cancelled",
        "stale"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
