{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:batch-02:migration-candidate",
  "title": "MigrationCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "asset_ref",
    "record_id",
    "schema_version",
    "scope",
    "source_stack",
    "strategy",
    "target_stack"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "asset_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_stack": {
      "type": "string",
      "minLength": 1
    },
    "target_stack": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "enum": [
        "rehost",
        "replatform",
        "refactor",
        "rearchitect",
        "rewrite"
      ]
    },
    "blocking_unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
