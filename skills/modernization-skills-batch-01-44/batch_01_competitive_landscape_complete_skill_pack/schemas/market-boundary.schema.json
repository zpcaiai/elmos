{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:batch-01:market-boundary",
  "title": "MarketBoundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "boundary_name",
    "explicit_exclusions",
    "included_capabilities",
    "record_id",
    "schema_version",
    "scope"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundary_name": {
      "type": "string",
      "minLength": 1
    },
    "included_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explicit_exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusion_rationale": {
      "type": "string",
      "minLength": 1
    }
  }
}
