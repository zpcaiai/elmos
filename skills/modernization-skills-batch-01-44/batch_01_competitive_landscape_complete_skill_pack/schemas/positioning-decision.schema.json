{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:batch-01:positioning-decision",
  "title": "PositioningDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "differentiators",
    "explicit_non_goals",
    "record_id",
    "schema_version",
    "scope"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "type": "string",
      "minLength": 1
    },
    "differentiators": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explicit_non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supporting_fact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_by": {
      "type": "string",
      "format": "date-time"
    }
  }
}
