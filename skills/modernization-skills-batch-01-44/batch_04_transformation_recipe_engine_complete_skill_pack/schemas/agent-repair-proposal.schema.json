{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:batch-04:agent-repair-proposal",
  "title": "AgentRepairProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "diff_digest",
    "human_reviewed",
    "proposal_id",
    "record_id",
    "schema_version",
    "scope",
    "touches_gate",
    "touches_golden",
    "touches_tests"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "minLength": 1
    },
    "diff_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "touches_tests": {
      "type": "boolean"
    },
    "touches_golden": {
      "type": "boolean"
    },
    "touches_gate": {
      "type": "boolean"
    },
    "human_reviewed": {
      "type": "boolean"
    }
  }
}
