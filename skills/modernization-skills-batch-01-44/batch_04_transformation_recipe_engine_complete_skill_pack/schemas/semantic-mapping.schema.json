{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:batch-04:semantic-mapping",
  "title": "SemanticMapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "loss_class",
    "mapping_id",
    "record_id",
    "schema_version",
    "scope",
    "source_construct",
    "target_construct"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mapping_id": {
      "type": "string",
      "minLength": 1
    },
    "source_construct": {
      "type": "string",
      "minLength": 1
    },
    "target_construct": {
      "type": "string",
      "minLength": 1
    },
    "loss_class": {
      "enum": [
        "lossless",
        "normalized",
        "approximate",
        "requires-adapter",
        "unsupported"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
