{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElmosAtomicTask",
  "type": "object",
  "required": [
    "id",
    "title",
    "objective",
    "owned_paths",
    "dependencies",
    "acceptance",
    "complexity",
    "risk",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "task_class": {
      "type": "string"
    },
    "owned_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "complexity": {
      "type": "object"
    },
    "risk": {
      "type": "object"
    },
    "context_pack": {
      "type": "object"
    },
    "routing": {
      "type": "object"
    },
    "status": {
      "enum": [
        "planned",
        "ready",
        "running",
        "blocked",
        "failed",
        "passed",
        "waived"
      ]
    }
  }
}