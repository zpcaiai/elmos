{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "case_id",
    "status",
    "artifact_digest",
    "environment_digest",
    "started_at",
    "finished_at",
    "evidence"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not-run",
        "waived"
      ]
    },
    "artifact_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environment_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "failure_class": {
      "type": "string"
    },
    "replay_command": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
