{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "skill",
    "batches",
    "capability",
    "severity",
    "test_type",
    "title",
    "preconditions",
    "steps",
    "assertions",
    "evidence_required",
    "anti_cheat"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9-]+$"
    },
    "skill": {
      "type": "string"
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 37
      }
    },
    "capability": {
      "type": "string",
      "minLength": 2
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "test_type": {
      "enum": [
        "happy_path",
        "boundary",
        "negative",
        "dependency_failure",
        "security",
        "replay_idempotency",
        "version_drift",
        "evidence_tamper"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "evidence_required": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "anti_cheat": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "holdout_required": {
      "type": "boolean"
    },
    "representative_workload_required": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
