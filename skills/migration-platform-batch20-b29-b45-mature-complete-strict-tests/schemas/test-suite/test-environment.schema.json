{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "environment_id",
    "version",
    "isolated",
    "toolchains",
    "network_policy",
    "data_policy"
  ],
  "properties": {
    "environment_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "isolated": {
      "const": true
    },
    "toolchains": {
      "type": "array",
      "minItems": 1
    },
    "network_policy": {
      "type": "object"
    },
    "data_policy": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
