{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "waiver_id",
    "case_id",
    "severity",
    "owner",
    "expires_at",
    "reason",
    "compensating_controls"
  ],
  "properties": {
    "waiver_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "P1",
        "P2",
        "P3"
      ]
    },
    "owner": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 20
    },
    "compensating_controls": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": false
}
