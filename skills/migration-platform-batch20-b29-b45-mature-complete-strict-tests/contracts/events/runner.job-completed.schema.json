{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example/events/runner.job-completed.schema.json",
  "title": "RunnerJobCompletedData",
  "type": "object",
  "required": [
    "job_id",
    "runner_id",
    "status"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "runner_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "additionalProperties": false
}
