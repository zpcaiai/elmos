{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example/events/event-envelope.schema.json",
  "title": "PlatformEventEnvelope",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "aggregate",
    "scope",
    "trace",
    "producer",
    "occurred_at",
    "recorded_at",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "aggregate": {
      "type": "object",
      "required": [
        "type",
        "id",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": [
        "tenant_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "organization_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "required": [
        "correlation_id"
      ],
      "properties": {
        "correlation_id": {
          "type": "string"
        },
        "causation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": [
        "service",
        "version"
      ],
      "properties": {
        "service": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "type": "string",
      "default": "internal"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
