{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.local/schemas/project-package-manifest.schema.json",
  "title": "Elmos ProjectPackageManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "package_version_id",
    "tenant_id",
    "project_id",
    "root_names",
    "entries",
    "entry_count",
    "total_bytes",
    "manifest_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "manifest_id": {
      "type": "string"
    },
    "package_version_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "root_names": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "entry_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
    },
    "merkle_root": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_type": {
      "enum": [
        "FOLDER",
        "ZIP",
        "TAR",
        "TAR_GZ",
        "TGZ",
        "GZIP",
        "MULTI_FILE",
        "OTHER"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "relative_path",
        "entry_type",
        "size_bytes",
        "status"
      ],
      "properties": {
        "entry_id": {
          "type": "string"
        },
        "relative_path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|^[A-Za-z]:[\\\\/]|(^|[\\\\/])\\.\\.([\\\\/]|$))"
          }
        },
        "display_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "entry_type": {
          "enum": [
            "FILE",
            "DIRECTORY",
            "SYMLINK",
            "HARDLINK",
            "ARCHIVE",
            "SPECIAL",
            "OTHER"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoding": {
          "type": [
            "string",
            "null"
          ]
        },
        "modified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "link_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "classification": {
          "enum": [
            "INCLUDED",
            "METADATA_ONLY",
            "EXCLUDED",
            "QUARANTINED",
            "GENERATED",
            "VENDORED",
            "BINARY",
            "SECRET_SUSPECTED",
            "UNCLASSIFIED"
          ]
        },
        "status": {
          "enum": [
            "DECLARED",
            "UPLOADING",
            "VERIFIED",
            "PROCESSING",
            "READY",
            "FAILED",
            "QUARANTINED",
            "EXCLUDED"
          ]
        },
        "source_entry_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "security_finding_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}