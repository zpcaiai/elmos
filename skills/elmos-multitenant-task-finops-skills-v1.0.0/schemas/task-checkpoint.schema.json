{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/multitenant-task-finops/1.0/task-checkpoint.schema.json",
  "title": "Elmos Task Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "tenant_id",
    "task_id",
    "task_run_id",
    "checkpoint_no",
    "input_manifest_sha256",
    "state_sha256",
    "completed_side_effect_receipts",
    "cache_keys",
    "tool_versions",
    "model_versions",
    "policy_version",
    "compatibility",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "checkpoint_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "node_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "node_attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoint_no": {
      "type": "integer",
      "minimum": 1
    },
    "input_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repository_revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "object_uri": {
      "type": [
        "string",
        "null"
      ]
    },
    "object_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "object_size_bytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "completed_side_effect_receipts": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "cache_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "model_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "next_node_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "compatibility": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "object_uri": {
            "type": "string"
          }
        },
        "required": [
          "object_uri"
        ]
      },
      "then": {
        "required": [
          "object_sha256",
          "object_size_bytes"
        ]
      }
    }
  ]
}
