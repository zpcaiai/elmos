{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/multitenant-task-finops/1.0/revenue-entry.schema.json",
  "title": "Elmos Revenue Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revenue_entry_id",
    "tenant_id",
    "kind",
    "billing_mode",
    "idempotency_key",
    "amount",
    "currency",
    "base_currency",
    "fx_rate",
    "base_amount",
    "status",
    "policy_version",
    "occurred_at",
    "posted_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "revenue_entry_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "account_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_run_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "billing_account_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_entry_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "enum": [
        "QUOTE",
        "CHARGE",
        "CREDIT",
        "REFUND",
        "RECOGNITION",
        "COLLECTION",
        "PAYMENT_FEE",
        "TAX",
        "ADJUSTMENT"
      ]
    },
    "billing_mode": {
      "enum": [
        "PREPAID_CREDIT",
        "PAY_AS_YOU_GO",
        "SUBSCRIPTION",
        "FIXED_PROJECT",
        "DEDICATED_TENANT",
        "PRIVATE_DEPLOYMENT",
        "OFFLINE_LICENSE"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "external_object_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "base_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "fx_rate": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "base_amount": {
      "type": "string",
      "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
    },
    "recognition_basis": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "posted_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
