{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/multitenant-task-finops/1.0/side-effect-receipt.schema.json",
  "title": "Elmos Side Effect Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "tenant_id",
    "task_id",
    "task_run_id",
    "node_key",
    "attempt_no",
    "effect_type",
    "idempotency_key",
    "status",
    "effect_hash",
    "occurred_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "task_run_id": {
      "type": "string",
      "format": "uuid"
    },
    "node_key": {
      "type": "string",
      "minLength": 1
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "effect_type": {
      "type": "string",
      "minLength": 1
    },
    "target_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PREPARED",
        "COMMITTED",
        "CONFIRMED",
        "COMPENSATED",
        "UNKNOWN"
      ]
    },
    "provider_receipt_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "effect_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compensation_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "details": {
      "type": "object"
    }
  }
}
