{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/task-quote.v1.json",
  "title": "Elmos Task Quote v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "quote_id",
    "tenant_id",
    "task_id",
    "scope_hash",
    "estimate_id",
    "price_book_id",
    "quality_mode",
    "currency",
    "estimated_cost",
    "hard_cap",
    "machine_runtime",
    "expires_at",
    "acceptance"
  ],
  "properties": {
    "quote_id": {
      "type": "string",
      "pattern": "^quo_[A-Za-z0-9_-]+$"
    },
    "tenant_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "scope_hash": {
      "type": "string",
      "minLength": 16
    },
    "estimate_id": {
      "type": "string"
    },
    "price_book_id": {
      "type": "string"
    },
    "quality_mode": {
      "type": "string",
      "enum": [
        "economy",
        "balanced",
        "best_quality"
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "estimated_cost": {
      "$ref": "#/$defs/range"
    },
    "hard_cap": {
      "$ref": "#/$defs/money"
    },
    "machine_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50_seconds",
        "p90_seconds"
      ],
      "properties": {
        "p50_seconds": {
          "type": "integer",
          "minimum": 0
        },
        "p90_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "human_effort_reference": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "hours",
            "person_days"
          ]
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "acceptance": {
      "type": "object",
      "required": [
        "tests",
        "criteria"
      ],
      "properties": {
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "breakdown": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "minor_units"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "minor_units": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p50",
        "p80",
        "p90"
      ],
      "properties": {
        "p50": {
          "$ref": "#/$defs/money"
        },
        "p80": {
          "$ref": "#/$defs/money"
        },
        "p90": {
          "$ref": "#/$defs/money"
        }
      }
    }
  }
}
