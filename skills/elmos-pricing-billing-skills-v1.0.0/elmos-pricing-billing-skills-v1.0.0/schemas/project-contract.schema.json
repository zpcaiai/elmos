{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/project-contract.v1.json",
  "title": "Elmos Project Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_contract_id",
    "tenant_id",
    "contract_type",
    "source_repository_hash",
    "requirements_version",
    "scope_hash",
    "price",
    "acceptance",
    "included_revisions",
    "exclusions",
    "change_order_policy"
  ],
  "properties": {
    "project_contract_id": {
      "type": "string",
      "pattern": "^prj_[A-Za-z0-9_-]+$"
    },
    "tenant_id": {
      "type": "string"
    },
    "contract_type": {
      "type": "string",
      "enum": [
        "discovery",
        "capped",
        "fixed"
      ]
    },
    "source_repository_hash": {
      "type": "string",
      "minLength": 16
    },
    "requirements_version": {
      "type": "string"
    },
    "scope_hash": {
      "type": "string",
      "minLength": 16
    },
    "price": {
      "type": "object",
      "required": [
        "currency",
        "fixed_minor_units"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "fixed_minor_units": {
          "type": "integer",
          "minimum": 0
        },
        "cap_minor_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "acceptance": {
      "type": "object"
    },
    "included_revisions": {
      "type": "integer",
      "minimum": 0
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "change_order_policy": {
      "type": "object"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
