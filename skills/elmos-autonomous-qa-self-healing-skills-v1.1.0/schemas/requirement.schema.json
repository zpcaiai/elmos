{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/requirement.schema.json",
  "title": "NormalizedRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_id",
    "kind",
    "title",
    "statement",
    "priority",
    "required",
    "source_refs",
    "acceptance_criteria",
    "status"
  ],
  "properties": {
    "requirement_id": {
      "type": "string",
      "pattern": "^(REQ|CONSTRAINT|UXR|NFR|AC)-[A-Za-z0-9._-]+$"
    },
    "kind": {
      "enum": [
        "functional",
        "constraint",
        "user_experience",
        "non_functional",
        "acceptance_criterion"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "quote_hash": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data_classification": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "risk_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "status": {
      "enum": [
        "ready",
        "ambiguous",
        "conflicting",
        "blocked",
        "deprecated"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  }
}
