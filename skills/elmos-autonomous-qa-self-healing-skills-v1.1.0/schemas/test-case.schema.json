{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/test-case.schema.json",
  "title": "ExecutableTestCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "test_case_id",
    "title",
    "test_type",
    "priority",
    "required",
    "requirement_refs",
    "preconditions",
    "steps",
    "oracles",
    "evidence_requirements",
    "cleanup",
    "executor"
  ],
  "properties": {
    "test_case_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "test_type": {
      "enum": [
        "unit",
        "component",
        "functional",
        "api",
        "contract",
        "database",
        "migration",
        "message",
        "workflow",
        "ui_e2e",
        "visual",
        "accessibility",
        "compatibility",
        "performance",
        "load",
        "stress",
        "spike",
        "soak",
        "capacity",
        "security",
        "fuzz",
        "property",
        "mutation",
        "resilience",
        "chaos",
        "recovery"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "risk_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameters": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "action"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "input": {},
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "oracle_id",
          "kind",
          "assertion"
        ],
        "properties": {
          "oracle_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "value",
              "state",
              "data",
              "event",
              "security",
              "timing",
              "resource",
              "visual",
              "accessibility",
              "invariant",
              "differential"
            ]
          },
          "assertion": {
            "type": "string"
          },
          "tolerance": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "cleanup": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "executor": {
      "type": "object",
      "required": [
        "adapter",
        "command"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment_profile": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stability": {
      "type": "object",
      "properties": {
        "deterministic": {
          "type": "boolean"
        },
        "retry_for_classification_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "estimated_duration_seconds": {
      "type": "number",
      "minimum": 0
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planned_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "language": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "native_test_target": {
          "type": "string"
        },
        "validation_status": {
          "enum": [
            "planned",
            "generated",
            "syntax_valid",
            "buildable",
            "discovered",
            "executed",
            "certified",
            "blocked",
            "stale"
          ]
        }
      }
    }
  }
}
