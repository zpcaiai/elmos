{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/ai-factory/v4/search-index-ir.schema.json",
  "title": "Search Index Ir",
  "type": "object",
  "required": [
    "schema_version",
    "tenant_id",
    "revision_set_id",
    "artifact_id",
    "status",
    "content_hash",
    "evidence_refs",
    "nodes",
    "edges",
    "semantic_gaps"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_set_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY",
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN",
        "UNSUPPORTED"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{16,128}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "semantic_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
