{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/ai-factory/v4/vector-store-benchmark-result.schema.json",
  "title": "Vector Store Benchmark Result",
  "type": "object",
  "required": [
    "schema_version",
    "tenant_id",
    "revision_set_id",
    "artifact_id",
    "status",
    "content_hash",
    "evidence_refs",
    "findings",
    "metrics",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_set_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY",
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN",
        "UNSUPPORTED"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{16,128}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "BLOCK",
        "REVIEW",
        "RECERTIFY"
      ]
    }
  },
  "additionalProperties": false
}
