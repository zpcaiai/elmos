{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/ai-factory/v4/online-schema-change-plan.schema.json",
  "title": "Online Schema Change Plan",
  "type": "object",
  "required": [
    "schema_version",
    "tenant_id",
    "revision_set_id",
    "artifact_id",
    "status",
    "content_hash",
    "evidence_refs",
    "steps",
    "rollback_steps",
    "proof_obligations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_set_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "DRAFT",
        "READY",
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN",
        "UNSUPPORTED"
      ]
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{16,128}$"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "rollback_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_obligations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
