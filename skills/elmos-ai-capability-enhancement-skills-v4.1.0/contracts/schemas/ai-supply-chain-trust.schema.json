{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AISupplyChainTrust",
  "type": "object",
  "required": [
    "packageId",
    "publisher",
    "signatureStatus",
    "sbomHash",
    "declaredPermissions",
    "observedPermissions",
    "decision"
  ],
  "properties": {
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "signatureStatus": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "verified",
        "missing",
        "invalid",
        "revoked"
      ]
    },
    "sbomHash": {
      "type": "string",
      "minLength": 1
    },
    "aibomHash": {
      "type": "string",
      "minLength": 1
    },
    "declaredPermissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observedPermissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reproducibleBuild": {
      "type": "boolean"
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "trusted",
        "bounded",
        "blocked"
      ]
    }
  },
  "additionalProperties": false
}
