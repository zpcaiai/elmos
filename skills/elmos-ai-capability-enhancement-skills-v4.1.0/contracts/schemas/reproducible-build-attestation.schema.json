{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/reproducible-build-attestation.schema.json",
  "title": "ReproducibleBuildAttestation",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "ReproducibleBuildAttestation"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "sourceDigest",
        "builderIdentity",
        "environmentDigest",
        "artifactDigests"
      ],
      "properties": {
        "sourceDigest": {
          "type": "string"
        },
        "builderIdentity": {
          "type": "string"
        },
        "environmentDigest": {
          "type": "string"
        },
        "artifactDigests": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
