{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/polyglot-differential-result.schema.json",
  "title": "PolyglotDifferentialResult",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "PolyglotDifferentialResult"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "sourceRun",
        "targetRun",
        "scenarioCount",
        "mismatches",
        "decision"
      ],
      "properties": {
        "sourceRun": {
          "type": "string"
        },
        "targetRun": {
          "type": "string"
        },
        "scenarioCount": {
          "type": "integer"
        },
        "mismatches": {
          "type": "array"
        },
        "decision": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
