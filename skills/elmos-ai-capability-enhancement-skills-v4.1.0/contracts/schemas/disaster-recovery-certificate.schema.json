{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/disaster-recovery-certificate.schema.json",
  "title": "DisasterRecoveryCertificate",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "DisasterRecoveryCertificate"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "topology",
        "rtoSeconds",
        "rpoSeconds",
        "drillResults"
      ],
      "properties": {
        "topology": {
          "type": "object"
        },
        "rtoSeconds": {
          "type": "integer"
        },
        "rpoSeconds": {
          "type": "integer"
        },
        "drillResults": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
