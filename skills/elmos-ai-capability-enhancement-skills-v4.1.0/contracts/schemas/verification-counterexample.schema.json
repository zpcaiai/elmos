{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/verification-counterexample.schema.json",
  "title": "VerificationCounterexample",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "VerificationCounterexample"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "obligationId",
        "minimalInput",
        "observation",
        "regressionId"
      ],
      "properties": {
        "obligationId": {
          "type": "string"
        },
        "minimalInput": {
          "type": "object"
        },
        "observation": {
          "type": "object"
        },
        "regressionId": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
