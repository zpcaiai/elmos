{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/semantic-gap-obligation.schema.json",
  "title": "SemanticGapObligation",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "SemanticGapObligation"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "dimension",
        "classification",
        "severity",
        "requiredEvidence"
      ],
      "properties": {
        "dimension": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "requiredEvidence": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
