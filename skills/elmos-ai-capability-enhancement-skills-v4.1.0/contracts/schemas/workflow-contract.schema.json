{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowContract",
  "type": "object",
  "required": [
    "stateSchema",
    "nodes",
    "edges",
    "durability"
  ],
  "properties": {
    "stateSchema": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "sideEffect"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string"
          },
          "sideEffect": {
            "type": "string",
            "enum": [
              "none",
              "read",
              "write",
              "external-write"
            ]
          },
          "retrySafe": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "durability": {
      "type": "object",
      "required": [
        "checkpoint",
        "pauseResume",
        "cancellation"
      ],
      "properties": {
        "checkpoint": {
          "type": "boolean"
        },
        "pauseResume": {
          "type": "boolean"
        },
        "cancellation": {
          "type": "boolean"
        },
        "humanApproval": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "liveness": {
      "type": "object",
      "properties": {
        "boundedLoops": {
          "type": "boolean"
        },
        "terminalReachable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
