{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/database-dialect-profile.schema.json",
  "title": "DatabaseDialectProfile",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "DatabaseDialectProfile"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "database",
        "engineVersion",
        "compatibilityMode",
        "semantics"
      ],
      "properties": {
        "database": {
          "type": "string"
        },
        "engineVersion": {
          "type": "string"
        },
        "compatibilityMode": {
          "type": "string"
        },
        "semantics": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
