{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UnsupportedFeatureLedger",
  "type": "object",
  "required": [
    "entries"
  ],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "feature",
          "target",
          "status",
          "criticality",
          "decision"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "conditional",
              "emulated",
              "runtime-monitored",
              "waived",
              "unsupported",
              "blocked"
            ]
          },
          "criticality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "decision": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "expiry": {
            "type": "string",
            "format": "date-time"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
