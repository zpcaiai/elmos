{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/release-attestation-policy.schema.json",
  "title": "ReleaseAttestationPolicy",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "ReleaseAttestationPolicy"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "requiredPredicates",
        "trustedBuilders",
        "minimumSignatures",
        "decision"
      ],
      "properties": {
        "requiredPredicates": {
          "type": "array"
        },
        "trustedBuilders": {
          "type": "array"
        },
        "minimumSignatures": {
          "type": "integer"
        },
        "decision": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
