{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromptProgram",
  "type": "object",
  "required": [
    "name",
    "version",
    "instructions",
    "outputSchema",
    "contentHash"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "visibleTools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outputSchema": {
      "type": "string",
      "minLength": 1
    },
    "policyBindings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contentHash": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
