{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/localization-conformance.schema.json",
  "title": "LocalizationConformance",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "LocalizationConformance"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "locales",
        "unicodeResults",
        "timezoneResults",
        "rtlResults"
      ],
      "properties": {
        "locales": {
          "type": "array"
        },
        "unicodeResults": {
          "type": "array"
        },
        "timezoneResults": {
          "type": "array"
        },
        "rtlResults": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
