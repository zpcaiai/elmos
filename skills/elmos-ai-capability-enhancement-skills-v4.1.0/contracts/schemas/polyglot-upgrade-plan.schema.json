{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/polyglot-upgrade-plan.schema.json",
  "title": "PolyglotUpgradePlan",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "PolyglotUpgradePlan"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "fromEnvelope",
        "toEnvelope",
        "affectedObligations",
        "rollback"
      ],
      "properties": {
        "fromEnvelope": {
          "type": "string"
        },
        "toEnvelope": {
          "type": "string"
        },
        "affectedObligations": {
          "type": "array"
        },
        "rollback": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
