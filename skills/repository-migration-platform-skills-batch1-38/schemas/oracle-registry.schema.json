{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaimOracleRegistry",
  "type": "object",
  "required": ["schema_version", "namespace", "entry_count", "entries", "status_boundary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "namespace": {"const": "repository-migration-platform-b01-38"},
    "entry_count": {"const": 347},
    "entries": {
      "type": "array",
      "minItems": 347,
      "maxItems": 347,
      "items": {
        "type": "object",
        "required": ["batch", "claim_type", "claim_index", "claim", "claim_sha256", "oracle_id", "executor_id", "required_corpora", "subject_type"],
        "properties": {
          "batch": {"type": "integer", "minimum": 1, "maximum": 38},
          "claim_type": {"enum": ["output", "test", "external"]},
          "claim_index": {"type": "integer", "minimum": 0},
          "claim": {"type": "string", "minLength": 1},
          "claim_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
          "oracle_id": {"type": "string", "minLength": 1},
          "executor_id": {"type": "string", "minLength": 1},
          "required_corpora": {"type": "array", "minItems": 1, "items": {"enum": ["development", "negative", "holdout", "representative", "production"]}},
          "subject_type": {"const": "claim-oracle-result"}
        },
        "additionalProperties": false
      }
    },
    "status_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
