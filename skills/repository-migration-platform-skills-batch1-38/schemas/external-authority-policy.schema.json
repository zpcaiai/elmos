{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Digest-pinned external authority policy",
  "type": "object",
  "required": ["schema_version", "policy_id", "tenant_id", "external_store_id",
               "external_store_sha256", "authority_organization_id", "authority_class",
               "purposes", "issued_at", "expires_at", "revoked"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "external_store_id": {"type": "string", "minLength": 1},
    "external_store_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority_organization_id": {"type": "string", "minLength": 1},
    "authority_class": {"enum": ["certification-body", "source-archive"]},
    "purposes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["independent-certification", "source-provenance"]}
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revoked": {"const": false}
  },
  "additionalProperties": false
}

