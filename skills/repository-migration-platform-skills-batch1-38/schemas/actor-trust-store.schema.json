{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActorTrustStore",
  "type": "object",
  "required": ["schema_version", "actors", "revoked_record_ids"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["actor_id", "key_id", "roles", "public_key_path", "not_before", "not_after", "revoked"],
        "properties": {
          "actor_id": {"type": "string", "minLength": 1},
          "key_id": {"type": "string", "minLength": 1},
          "roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "public_key_path": {"type": "string", "minLength": 1},
          "not_before": {"type": "string", "format": "date-time"},
          "not_after": {"type": "string", "format": "date-time"},
          "revoked": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "revoked_record_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
