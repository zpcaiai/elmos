{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.local/schemas/domain-execution-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch", "executor_id", "claim", "corpus", "source_fingerprint", "environment", "toolchain", "assertions", "raw_evidence", "decision", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch": {"type": "integer", "minimum": 1, "maximum": 38},
    "executor_id": {"type": "string", "minLength": 1},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "index", "sha256"],
      "properties": {
        "type": {"enum": ["output", "test", "external"]},
        "index": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "id", "sha256", "independent"],
      "properties": {
        "role": {"enum": ["development", "negative", "holdout", "representative", "production"]},
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "independent": {"type": "boolean"}
      }
    },
    "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment": {"type": "object"},
    "toolchain": {"type": "array", "minItems": 1},
    "assertions": {"type": "array", "minItems": 1},
    "raw_evidence": {"type": "array", "minItems": 1},
    "decision": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "BLOCKED", "NOT_RUN"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
