{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.local/schemas/domain-execution-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch", "executor_id", "claim", "corpus", "source_fingerprint", "environment", "domain_contract", "toolchain", "assertions", "raw_evidence", "decision", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch": {"type": "integer", "minimum": 1, "maximum": 38},
    "executor_id": {"type": "string", "minLength": 1},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "index", "sha256"],
      "properties": {
        "type": {"enum": ["output", "test", "external"]},
        "index": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "id", "sha256", "independent"],
      "properties": {
        "role": {"enum": ["development", "negative", "holdout", "representative", "production"]},
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "independent": {"type": "boolean"}
      }
    },
    "source_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["local", "clean", "holdout", "representative", "sandbox", "production"]},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "domain_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handler", "contract_version", "operation", "capabilities", "safety_controls"],
      "properties": {
        "handler": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "contract_version": {"const": "1.0"},
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}},
        "safety_controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}}
      }
    },
    "toolchain": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "version", "argv_sha256", "exit_code", "evidence_role"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "argv_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "exit_code": {"type": "integer"},
          "evidence_role": {"type": "string", "minLength": 1}
        }
      }
    },
    "assertions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "outcome", "detail"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "BLOCKED", "NOT_RUN"]},
          "detail": {"type": "string", "minLength": 1}
        }
      }
    },
    "raw_evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "role"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "decision": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "BLOCKED", "NOT_RUN"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
