{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BatchExecutionPlan",
  "type": "object",
  "required": ["schema_version", "batch", "source_fingerprint", "target_objective", "steps", "required_claims", "external_claims", "execution_policy"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch": {"type": "integer", "minimum": 1, "maximum": 38},
    "source_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "target_objective": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["step_id", "name", "claim_type", "claim_index", "argv", "cwd", "producer_id", "timeout_seconds"],
        "properties": {
          "step_id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "claim_type": {"enum": ["output", "test"]},
          "claim_index": {"type": "integer", "minimum": 0},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "cwd": {"type": "string", "minLength": 1},
          "producer_id": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
        },
        "additionalProperties": false
      }
    },
    "required_claims": {"type": "array"},
    "external_claims": {"type": "array"},
    "execution_policy": {
      "type": "object",
      "required": ["argv_only", "shell", "source_or_workspace_cwd_only", "external_claims_allowed", "maximum_steps"],
      "properties": {
        "argv_only": {"const": true},
        "shell": {"const": false},
        "source_or_workspace_cwd_only": {"const": true},
        "external_claims_allowed": {"const": false},
        "maximum_steps": {"const": 1000}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
