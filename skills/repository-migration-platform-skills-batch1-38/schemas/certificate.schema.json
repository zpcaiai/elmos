{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExternalBatchCertificate",
  "type": "object",
  "required": ["batch", "decision", "issuer_id", "request_sha256", "source_fingerprint", "evidence_root", "evaluated_revision", "policy_id", "issued_at", "expires_at"],
  "properties": {
    "batch": {"type": "integer", "minimum": 1, "maximum": 38},
    "decision": {"const": "CERTIFIED"},
    "issuer_id": {"type": "string", "minLength": 1},
    "request_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "source_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "evidence_root": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "evaluated_revision": {"type": "integer", "minimum": 0},
    "policy_id": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
