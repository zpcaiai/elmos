      "\u8bc1\u636e\u5b8c\u6574",
      "\u654f\u611f\u4fe1\u606f\u53d7\u63a7",
      "\u9ed8\u8ba4Draft",
      "\u53ef\u7531Reviewer\u4e00\u773c\u5224\u65ad"
    ],
    "risk_controls": [
