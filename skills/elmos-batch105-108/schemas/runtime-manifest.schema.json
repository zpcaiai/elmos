{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/runtime-manifest.schema.json",
  "title": "ELMOS Runtime Manifest",
  "type": "object",
  "required": [
    "version",
    "project",
    "build",
    "runtime",
    "service",
    "lifecycle",
    "resources",
    "network",
    "security"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "language",
        "framework"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "language": {
          "enum": [
            "java",
            "python",
            "dotnet",
            "go",
            "node",
            "container"
          ]
        },
        "framework": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "build": {
      "type": "object",
      "required": [
        "image",
        "command"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "@sha256:"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "workingDirectory": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "image",
        "command"
      ],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "@sha256:"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "protocol",
        "port",
        "health"
      ],
      "properties": {
        "protocol": {
          "enum": [
            "http",
            "https",
            "grpc-web",
            "tcp"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "health": {
          "type": "object",
          "required": [
            "path",
            "expectedStatus"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "expectedStatus": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "preview": {
      "type": "object",
      "properties": {
        "homepage": {
          "type": "string"
        },
        "apiDocs": {
          "type": "string"
        },
        "openapi": {
          "type": "string"
        },
        "screenshot": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "lifecycle": {
      "type": "object",
      "required": [
        "ttlSeconds",
        "startTtlAfterReady"
      ],
      "properties": {
        "ttlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "startTtlAfterReady": {
          "const": true
        },
        "idleTimeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "cpu",
        "memoryMb",
        "diskMb"
      ],
      "properties": {
        "cpu": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 8
        },
        "memoryMb": {
          "type": "integer",
          "minimum": 256,
          "maximum": 32768
        },
        "diskMb": {
          "type": "integer",
          "minimum": 512,
          "maximum": 65536
        }
      },
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "required": [
        "publicIngress",
        "outboundPolicy"
      ],
      "properties": {
        "publicIngress": {
          "type": "boolean"
        },
        "outboundPolicy": {
          "enum": [
            "deny",
            "restricted"
          ]
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [
        "authenticatedPreview",
        "readOnlyRootFilesystem",
        "blockCloudMetadata"
      ],
      "properties": {
        "authenticatedPreview": {
          "type": "boolean"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        },
        "blockCloudMetadata": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
