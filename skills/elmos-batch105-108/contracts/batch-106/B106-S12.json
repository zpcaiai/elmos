  "tests": [
    "非法状态跳转拒绝",
    "重复事件不重复副作用",
    "工作流重放保持终态",
    "探针超时进入HEALTH_FAILED",
    "取消在任意非终态可补偿"
  ],
  "evidence": [
    "state-history.json",
    "readiness-probes.json",
    "workflow-replay-test.json",
    "failure-reason.json"
  ],
  "definition_of_done": [
    "状态机封闭",
    "所有副作用幂等",
    "失败原因结构化",
    "可取消/恢复/重放",
    "READY必须有健康证据"
  ],
  "risk_controls": [
    "默认拒绝不完整输入",
    "所有跨租户访问必须由服务端身份解析",
    "失败不得通过删除测试、跳过门禁或伪造证据修复"
  ]
}
