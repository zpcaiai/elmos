  "dependencies": [
    "B106-S10",
    "B106-S11"
  ],
  "inputs": [
    "runtime run",
    "health policy",
    "workflow engine"
  ],
  "outputs": [
    "RunStateTransitions",
    "ready decision",
    "failure reason"
  ],
  "implementation": {
    "modules": [
      "runtime/workflow/PreviewRunWorkflow.java",
      "runtime/state/RuntimeRunStateMachine.java",
      "apps/web/src/features/runtime-run/"
    ],
    "interfaces": [
      "GET /api/runtime-runs/{id}",
      "event runtime-run.state-changed"
    ],
    "data": [
      "runtime_run_state",
      "runtime_event",
      "readiness_probe"
    ]
  },
  "workflow": [
    "创建带版本号的状态记录",
    "流转BUILDING/IMAGE_READY/STARTING",
    "按策略执行readiness探针与退避",
    "READY后创建或确认Endpoint",
    "失败进入BUILD_FAILED/START_FAILED/HEALTH_FAILED/POLICY_BLOCKED",
