  "evidence": [
    "demo-gate-input.json",
    "demo-gate-decision.json",
    "blocking-findings.json",
    "policy-evaluation.log"
  ],
  "definition_of_done": [
    "决定可重复",
    "默认保守",
    "所有阻断项可追溯",
    "签名包含Policy摘要",
    "无运行验证时最高只到ENGINEERING_READY"
  ],
  "risk_controls": [
    "默认拒绝不完整输入",
    "所有跨租户访问必须由服务端身份解析",
    "失败不得通过删除测试、跳过门禁或伪造证据修复"
  ]
}
