  "dependencies": [
    "B105-S07",
    "B105-S12",
    "B105-S13"
  ],
  "inputs": [
    "all Batch105 evidence",
    "policy version"
  ],
  "outputs": [
    "ModernizationDemoDecision",
    "blocking findings",
    "next actions"
  ],
  "implementation": {
    "modules": [
      "certification/demo/ModernizationDemoGate.java",
      "policies/demo-readiness.yaml",
      "apps/web/src/features/release-gate/"
    ],
    "interfaces": [
      "POST /api/projects/{id}/gates/demo-readiness",
      "event gate.demo-readiness.decided"
    ],
    "data": [
      "demo_gate_input",
      "demo_gate_decision",
      "blocking_finding"
    ]
  },
  "workflow": [
    "验证证据血缘和新鲜度",
    "检查Baseline可复现",
    "检查所有迁移阶段和修复Commit",
    "检查测试保护和矩阵范围",
