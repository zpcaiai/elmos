{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Behavior Contract",
  "type": "object",
  "required": [
    "operation",
    "inputs",
    "observations",
    "invariants"
  ],
  "properties": {
    "operation": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tolerances": {
      "type": "object"
    },
    "oracle_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
