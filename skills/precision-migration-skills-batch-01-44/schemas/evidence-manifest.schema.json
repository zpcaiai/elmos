{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence Manifest",
  "type": "object",
  "required": [
    "skill",
    "version",
    "status",
    "inputs",
    "unresolved"
  ],
  "properties": {
    "skill": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PROVED",
        "VERIFIED",
        "CONDITIONALLY_VERIFIED",
        "REQUIRES_ADAPTER",
        "REQUIRES_HUMAN_REVIEW",
        "UNSUPPORTED",
        "FAILED"
      ]
    },
    "inputs": {
      "type": "array"
    },
    "toolchain": {
      "type": "object"
    },
    "models": {
      "type": "array"
    },
    "findings": {
      "type": "array"
    },
    "changes": {
      "type": "array"
    },
    "tests": {
      "type": "array"
    },
    "proofs": {
      "type": "array"
    },
    "unresolved": {
      "type": "array"
    },
    "approvals": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
