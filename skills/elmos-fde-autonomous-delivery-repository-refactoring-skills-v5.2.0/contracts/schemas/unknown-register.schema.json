{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/fde/5.2.0/UnknownRegister.schema.json",
  "title": "UnknownRegister",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registerId",
    "revisionSetId",
    "items"
  ],
  "properties": {
    "registerId": {
      "type": "string",
      "minLength": 1
    },
    "revisionSetId": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "materiality",
          "owner",
          "resolutionPlan",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "materiality": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "resolutionPlan": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "open",
              "resolved",
              "waived",
              "unsupported"
            ]
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    }
  }
}
