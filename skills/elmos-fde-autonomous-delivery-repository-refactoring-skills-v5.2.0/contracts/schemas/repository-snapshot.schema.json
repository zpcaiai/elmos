{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/fde/5.2.0/RepositorySnapshot.schema.json",
  "title": "RepositorySnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repositoryId",
    "revisionSetId",
    "repositories",
    "capturedAt",
    "contentHash",
    "custody"
  ],
  "properties": {
    "repositoryId": {
      "type": "string",
      "minLength": 1
    },
    "revisionSetId": {
      "type": "string",
      "minLength": 1
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "uri",
          "revision"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "submodules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "contentHash": {
      "type": "string",
      "minLength": 1
    },
    "custody": {
      "type": "object",
      "required": [
        "source",
        "collector"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "collector": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dirty": {
      "type": "boolean"
    },
    "largeFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  }
}
