{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/fde/5.2.0/VerificationClaim.schema.json",
  "title": "VerificationClaim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claimId",
    "statement",
    "scope",
    "status",
    "supportingEvidence",
    "counterexamplesChecked",
    "confidence",
    "certificationLevel",
    "producerIndependent"
  ],
  "properties": {
    "claimId": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "proposed",
        "supported",
        "refuted",
        "unknown",
        "waived",
        "invalidated"
      ]
    },
    "supportingEvidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "counterexamplesChecked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "certificationLevel": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3"
      ]
    },
    "producerIndependent": {
      "type": "boolean"
    }
  }
}
