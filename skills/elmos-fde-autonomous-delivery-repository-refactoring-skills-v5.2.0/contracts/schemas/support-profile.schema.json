{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/fde/5.2.0/SupportProfile.schema.json",
  "title": "SupportProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revisionSetId",
    "components",
    "coverageSummary",
    "unknowns",
    "unsupported"
  ],
  "properties": {
    "revisionSetId": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component",
          "supportDepth",
          "evidenceLevel"
        ],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "supportDepth": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "S0",
              "S1",
              "S2",
              "S3",
              "S4",
              "S5"
            ]
          },
          "evidenceLevel": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "E0",
              "E1",
              "E2",
              "E3"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "coverageSummary": {
      "type": "object",
      "required": [
        "observed",
        "verifiedAbsent",
        "unknown",
        "unsupported"
      ],
      "properties": {
        "observed": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedAbsent": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "unsupported": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  }
}
