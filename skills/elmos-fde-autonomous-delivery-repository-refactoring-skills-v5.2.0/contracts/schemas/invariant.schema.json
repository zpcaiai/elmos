{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/fde/5.2.0/InvariantContract.schema.json",
  "title": "InvariantContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invariantId",
    "statement",
    "scope",
    "riskClass",
    "oracle",
    "evidenceObligations"
  ],
  "properties": {
    "invariantId": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "riskClass": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "oracle": {
      "type": "object",
      "required": [
        "type",
        "description"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "example",
            "property",
            "differential",
            "formal",
            "human-domain"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "evidenceObligations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "approvedBehaviorChanges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  }
}
