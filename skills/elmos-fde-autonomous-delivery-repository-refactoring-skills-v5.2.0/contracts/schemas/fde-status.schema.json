{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/fde/5.2.0/FDEStatusReport.schema.json",
  "title": "FDEStatusReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engagementId",
    "asOf",
    "scopeState",
    "milestones",
    "risks",
    "decisions",
    "cost",
    "nextGates"
  ],
  "properties": {
    "engagementId": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    },
    "scopeState": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "on-track",
        "at-risk",
        "blocked",
        "re-scope-required",
        "complete"
      ]
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "not-started",
              "in-progress",
              "blocked",
              "done",
              "unknown"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "cost": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "nextGates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    }
  }
}
