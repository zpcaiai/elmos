{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/fde/5.2.0/TaskContract.schema.json",
  "title": "TaskContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "tenantId",
    "engagementId",
    "intent",
    "scope",
    "acceptanceCriteria",
    "authorityProfile"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "engagementId": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": true
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "authorityProfile": {
      "type": "string",
      "minLength": 1
    },
    "riskClass": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "productionWritesAllowed": {
      "type": "boolean",
      "const": false
    }
  }
}
