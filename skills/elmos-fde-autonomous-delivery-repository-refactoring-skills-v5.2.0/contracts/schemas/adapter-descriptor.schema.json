{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/fde/5.2.0/AdapterDescriptor.schema.json",
  "title": "AdapterDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "port",
    "capabilities",
    "trustBoundary",
    "sideEffects",
    "completionAuthority"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "trustBoundary": {
      "type": "string",
      "minLength": 1
    },
    "sideEffects": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "completionAuthority": {
      "type": "boolean",
      "const": false
    },
    "conformanceTests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
