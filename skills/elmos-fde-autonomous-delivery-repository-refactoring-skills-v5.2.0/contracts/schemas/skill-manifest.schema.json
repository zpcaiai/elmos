{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/fde/5.2.0/ElmosSkillManifest.schema.json",
  "title": "ElmosSkillManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v1"
    },
    "kind": {
      "const": "Skill"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "package",
        "pack"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "pack": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": [
        "packageRole",
        "routable",
        "routeOwnerRef",
        "canonicalKernels",
        "owner",
        "priority",
        "riskClass",
        "maturity",
        "description",
        "triggers",
        "negativeTriggers",
        "inputs",
        "outputs",
        "tools",
        "dependencies",
        "externalDependencies",
        "authority",
        "evidence",
        "rollback",
        "telemetry",
        "dataUsePolicy",
        "compatibility",
        "specificationStatus"
      ],
      "additionalProperties": true,
      "properties": {
        "packageRole": {
          "type": "string",
          "minLength": 1
        },
        "routable": {
          "type": "boolean",
          "const": false
        },
        "routeOwnerRef": {
          "type": "string",
          "minLength": 1
        },
        "canonicalKernels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "businessLines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "P0",
            "P1",
            "P2"
          ]
        },
        "riskClass": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "maturity": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "negativeTriggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "inputs": {
          "type": "array",
          "items": {},
          "minItems": 0
        },
        "outputs": {
          "type": "array",
          "items": {},
          "minItems": 0
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "externalDependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "failureModes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "authority": {
          "type": "object"
        },
        "idempotency": {
          "type": "object"
        },
        "checkpointing": {
          "type": "object"
        },
        "evidence": {
          "type": "object"
        },
        "rollback": {
          "type": "object"
        },
        "telemetry": {
          "type": "object"
        },
        "dataUsePolicy": {
          "type": "object"
        },
        "compatibility": {
          "type": "object"
        },
        "specificationStatus": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
