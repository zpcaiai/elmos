{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository Transformation Contract",
  "type": "object",
  "required": [
    "source",
    "target",
    "semanticInvariants",
    "acceptance",
    "evidence",
    "rollback"
  ],
  "properties": {
    "source": {
      "type": "object"
    },
    "target": {
      "type": "object"
    },
    "semanticInvariants": {
      "type": "array",
      "minItems": 1
    },
    "acceptance": {
      "type": "object"
    },
    "evidence": {
      "type": "object"
    },
    "rollback": {
      "type": "object"
    }
  }
}
