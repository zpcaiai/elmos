{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentSkillIR",
  "type": "object",
  "required": [
    "name",
    "description",
    "triggers",
    "instructions",
    "authority"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority": {
      "type": "object"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
