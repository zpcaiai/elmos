{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentContract",
  "type": "object",
  "required": [
    "agents",
    "delegation",
    "termination"
  ],
  "properties": {
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "memoryScopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "delegation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "condition"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "condition": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "termination": {
      "type": "object",
      "required": [
        "maxIterations",
        "conditions"
      ],
      "properties": {
        "maxIterations": {
          "type": "integer",
          "minimum": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
