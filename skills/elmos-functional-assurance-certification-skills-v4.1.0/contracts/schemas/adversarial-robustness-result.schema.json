{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/certification/adversarial-robustness-result.schema.json",
  "title": "AdversarialRobustnessResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant_id",
    "project_id",
    "goal_id",
    "revision_set_id",
    "schema_version",
    "status",
    "scope",
    "claims",
    "evidence",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_set_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "enum": [
        "DRAFT",
        "PLANNED",
        "RUNNING",
        "PASS",
        "BOUNDED",
        "BLOCKED",
        "FAILED",
        "SUSPENDED",
        "WITHDRAWN",
        "EXPIRED"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "assurance_level",
        "applicable_profiles"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "assurance_level": {
          "type": "string",
          "minLength": 1
        },
        "applicable_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "excluded_features": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "jurisdictions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "statement",
          "status"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PROVED",
              "TESTED",
              "BOUNDED",
              "RUNTIME_MONITORED",
              "WAIVED",
              "UNKNOWN",
              "UNSUPPORTED",
              "REFUTED"
            ]
          },
          "uncertainty": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "decision_rule": {
            "type": [
              "string",
              "null"
            ]
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "sha256",
          "producer",
          "independent"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "producer": {
            "type": "string",
            "minLength": 1
          },
          "independent": {
            "type": "boolean"
          },
          "tool_digest": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
