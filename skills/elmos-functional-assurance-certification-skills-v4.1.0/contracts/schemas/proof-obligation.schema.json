{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProofObligation",
  "type": "object",
  "required": [
    "id",
    "subject",
    "claim",
    "criticality",
    "acceptedEvidence",
    "requiredAssurance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "criticality": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptedEvidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredAssurance": {
      "type": "string",
      "enum": [
        "A0",
        "A1",
        "A2",
        "A3",
        "A4"
      ]
    }
  },
  "additionalProperties": false
}
