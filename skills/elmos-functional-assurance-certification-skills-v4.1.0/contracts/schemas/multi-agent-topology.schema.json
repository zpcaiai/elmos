{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MultiAgentTopology",
  "type": "object",
  "required": [
    "topologyId",
    "agents",
    "delegations",
    "stateOwners",
    "termination"
  ],
  "properties": {
    "topologyId": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 1
    },
    "delegations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "stateOwners": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "termination": {
      "type": "object"
    },
    "budgets": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
