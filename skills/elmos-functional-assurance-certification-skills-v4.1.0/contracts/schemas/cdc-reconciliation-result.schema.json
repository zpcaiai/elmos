{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/cdc-reconciliation-result.schema.json",
  "title": "CdcReconciliationResult",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "CdcReconciliationResult"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "sourceOffset",
        "targetOffset",
        "gapCount",
        "duplicateCount",
        "decision"
      ],
      "properties": {
        "sourceOffset": {
          "type": "string"
        },
        "targetOffset": {
          "type": "string"
        },
        "gapCount": {
          "type": "integer"
        },
        "duplicateCount": {
          "type": "integer"
        },
        "decision": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
