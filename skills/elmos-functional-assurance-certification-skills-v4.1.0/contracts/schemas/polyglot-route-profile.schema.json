{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/polyglot-route-profile.schema.json",
  "title": "PolyglotRouteProfile",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "PolyglotRouteProfile"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "sourceProfile",
        "targetProfile",
        "preserve",
        "allowedDelta",
        "gates"
      ],
      "properties": {
        "sourceProfile": {
          "type": "string"
        },
        "targetProfile": {
          "type": "string"
        },
        "preserve": {
          "type": "array"
        },
        "allowedDelta": {
          "type": "array"
        },
        "gates": {
          "type": "array"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
