{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/3.0.0/polyglot-route-certificate.schema.json",
  "title": "PolyglotRouteCertificate",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "elmos.ai/v3alpha1"
    },
    "kind": {
      "const": "PolyglotRouteCertificate"
    },
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "version",
        "revisionSetId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revisionSetId": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "spec": {
      "type": "object",
      "required": [
        "routeId",
        "revisionSet",
        "assuranceEnvelope",
        "evidenceRoot"
      ],
      "properties": {
        "routeId": {
          "type": "string"
        },
        "revisionSet": {
          "type": "string"
        },
        "assuranceEnvelope": {
          "type": "object"
        },
        "evidenceRoot": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
