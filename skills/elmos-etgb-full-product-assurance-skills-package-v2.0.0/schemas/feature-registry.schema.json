{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/etgb/schemas/feature-registry.schema.json",
  "title": "Elmos Product Feature Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "generated_at",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "registry_id": {
      "type": "string",
      "minLength": 3
    },
    "generated_at": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "domain",
          "title",
          "priority",
          "status",
          "owner",
          "test_matrix",
          "required_adapter",
          "release_policy"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
          },
          "domain": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "status": {
            "enum": [
              "declared",
              "implemented",
              "deprecated",
              "retired"
            ]
          },
          "owner": {
            "type": "string"
          },
          "test_matrix": {
            "type": "string"
          },
          "required_adapter": {
            "type": "string"
          },
          "release_policy": {
            "enum": [
              "must-pass",
              "manual-approval"
            ]
          }
        }
      }
    }
  }
}
