{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/etgb/schemas/test-case.schema.json",
  "title": "ETGB Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "business_line",
    "family",
    "level",
    "priority",
    "profiles",
    "tags",
    "source",
    "target",
    "requirements",
    "execution",
    "oracles",
    "coverage",
    "forbidden_differences",
    "gates",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{5,159}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "business_line": {
      "enum": [
        "spring-modernization",
        "cross-language",
        "project-generation",
        "sql-conversion",
        "cross-cutting",
        "identity-access-tenant",
        "platform-control-plane",
        "repository-ingestion-context",
        "multimodal-document-processing",
        "ai-runtime-model-routing",
        "agent-protocol-tooling",
        "rag-memory-knowledge",
        "project-intelligence",
        "online-ide-debug",
        "artifact-document-diagram",
        "collaboration-integrations",
        "billing-entitlements",
        "payment-finance",
        "api-sdk-webhook",
        "storage-search-cache",
        "deployment-operations",
        "security-privacy-compliance",
        "ui-accessibility-localization",
        "analytics-admin-support",
        "notifications-scheduler",
        "ai-solution-factory",
        "data-bigdata-solution",
        "commercial-delivery-certification",
        "product-journey",
        "standards-assurance"
      ]
    },
    "family": {
      "type": "string",
      "minLength": 2
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "smoke",
          "pr",
          "nightly",
          "weekly",
          "release",
          "golden",
          "exhaustive"
        ]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "additionalProperties": true
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "critical"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "adapter",
        "timeout_seconds"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      },
      "additionalProperties": true
    },
    "oracles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "capability_id",
        "dimensions"
      ],
      "properties": {
        "capability_id": {
          "type": "string"
        },
        "dimensions": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "forbidden_differences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gates": {
      "type": "object",
      "required": [
        "claim_policy"
      ],
      "properties": {
        "claim_policy": {
          "enum": [
            "must-pass",
            "may-degrade-with-disclosure",
            "manual-approval"
          ]
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind",
        "generated_at"
      ],
      "properties": {
        "kind": {
          "type": "string"
        },
        "generated_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
