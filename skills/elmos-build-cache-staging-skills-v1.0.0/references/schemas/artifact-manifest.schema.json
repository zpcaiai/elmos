{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/artifact-manifest.schema.json",
  "title": "ELMOS Artifact Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "digest",
    "size",
    "media_type",
    "artifact_kind",
    "producer",
    "dependencies",
    "validation_level"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "artifact_id": {
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 0
    },
    "media_type": {
      "type": "string"
    },
    "artifact_kind": {
      "type": "string"
    },
    "logical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "producer": {
      "type": "object",
      "required": [
        "stage_id",
        "stage_version",
        "action_key"
      ],
      "properties": {
        "stage_id": {
          "type": "string"
        },
        "stage_version": {
          "type": "string"
        },
        "action_key": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_map_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "validation_level": {
      "enum": [
        "UNVERIFIED",
        "COMPILE_VERIFIED",
        "TEST_VERIFIED",
        "BEHAVIOR_VERIFIED",
        "PRODUCTION_CERTIFIED",
        "QUARANTINED"
      ]
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
