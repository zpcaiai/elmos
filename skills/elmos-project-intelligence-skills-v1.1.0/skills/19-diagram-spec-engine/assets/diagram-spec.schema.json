{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/diagram-spec.schema.json",
  "title": "Elmos Diagram Spec",
  "type": "object",
  "required": [
    "schema_version",
    "diagram_id",
    "type",
    "project_id",
    "revision_id",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "diagram_id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "revision_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "view": {
      "type": "object"
    },
    "theme": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "group_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "semantic": {
            "type": "object"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "position": {
            "type": [
              "object",
              "null"
            ]
          },
          "lock": {
            "type": "object",
            "properties": {
              "semantic": {
                "type": "boolean"
              },
              "layout": {
                "type": "boolean"
              }
            }
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": true
      }
    },
    "layout": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
