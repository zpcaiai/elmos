{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/project-manifest.schema.json",
  "title": "Elmos Project Revision Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "revision_id",
    "source_type",
    "content_hash",
    "files",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "enum": [
        "git",
        "zip",
        "directory",
        "elmos-generated",
        "elmos-converted"
      ]
    },
    "repository": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "remote_ref": {
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "size",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "kind": {
            "enum": [
              "source",
              "test",
              "config",
              "schema",
              "doc",
              "generated",
              "vendor",
              "binary",
              "other"
            ]
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "excluded": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "submodules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "commit_sha"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "commit_sha": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
