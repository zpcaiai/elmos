{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/evidence.schema.json",
  "title": "Elmos Claim and Evidence Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "project_id",
    "revision_id",
    "claims",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "bundle_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "revision_id": {
      "type": "string"
    },
    "analysis_run_id": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "status",
          "confidence",
          "evidence_refs"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "status": {
            "enum": [
              "confirmed",
              "inferred",
              "unknown",
              "recommended",
              "contradicted",
              "stale"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "counter_evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generator": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "locator",
          "hash"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "source",
              "ast",
              "config",
              "schema",
              "test",
              "trace",
              "log",
              "manual",
              "document"
            ]
          },
          "locator": {
            "type": "object"
          },
          "hash": {
            "type": "string"
          },
          "strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "classification": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
