{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/semantic-ir.schema.json",
  "title": "MiniApp Semantic IR",
  "type": "object",
  "required": [
    "schema_version",
    "application",
    "trace_index"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "application": {
      "type": "object",
      "required": [
        "id",
        "routes",
        "components",
        "state_stores",
        "capabilities",
        "assets"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "state_stores": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "styles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "trace_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ir_id",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "ir_id": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "required": [
              "path",
              "start_line",
              "end_line"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "start_line": {
                "type": "integer",
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": false
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "content_hash"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "props": {
          "type": "object",
          "additionalProperties": true
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
