{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/differential-result.schema.json",
  "title": "Semantic Differential Test Result",
  "type": "object",
  "required": [
    "result_id",
    "flow_id",
    "platform",
    "verdict",
    "source_trace",
    "target_trace",
    "diffs"
  ],
  "additionalProperties": false,
  "properties": {
    "result_id": {
      "type": "string"
    },
    "flow_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "wechat",
        "alipay",
        "douyin",
        "xiaohongshu"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked",
        "unknown"
      ]
    },
    "source_trace": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "target_trace": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "diffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "severity",
          "message"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "message": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "target_ref": {
            "type": "string"
          },
          "ir_ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "sequence",
        "type"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string"
        },
        "value": {},
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
