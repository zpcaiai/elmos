{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/repair-action.schema.json",
  "title": "Bounded Auto Repair Action",
  "type": "object",
  "required": [
    "repair_id",
    "finding_id",
    "iteration",
    "strategy",
    "patch_scope",
    "validation",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "repair_id": {
      "type": "string"
    },
    "finding_id": {
      "type": "string"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "strategy": {
      "type": "string",
      "enum": [
        "source-analyzer",
        "ir",
        "mapping-rule",
        "platform-adapter",
        "generator-template",
        "generated-local-patch"
      ]
    },
    "patch_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "patch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "rollback_ref": {
      "type": "string"
    },
    "validation": {
      "type": "object",
      "required": [
        "reproduction",
        "targeted_tests",
        "affected_gates"
      ],
      "properties": {
        "reproduction": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "targeted_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "affected_gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "applied",
        "passed",
        "failed",
        "rolled-back",
        "blocked"
      ]
    },
    "stop_reason": {
      "type": "string"
    }
  }
}
