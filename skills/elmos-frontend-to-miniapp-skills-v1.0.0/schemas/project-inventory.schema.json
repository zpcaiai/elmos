{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/project-inventory.schema.json",
  "title": "Project Inventory",
  "type": "object",
  "required": [
    "inventory_id",
    "source_revision",
    "files",
    "framework_candidates",
    "entrypoints",
    "dependencies",
    "coverage"
  ],
  "additionalProperties": false,
  "properties": {
    "inventory_id": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "kind",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "eligible",
              "excluded",
              "binary",
              "too-large",
              "parse-error"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "framework_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "framework",
          "confidence",
          "evidence"
        ],
        "properties": {
          "framework": {
            "type": "string"
          },
          "version_range": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "entrypoints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "version",
          "scope"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "direct",
              "transitive",
              "dev"
            ]
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "platform_api_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "total_files",
        "eligible_files",
        "processed_files",
        "ratio"
      ],
      "properties": {
        "total_files": {
          "type": "integer",
          "minimum": 0
        },
        "eligible_files": {
          "type": "integer",
          "minimum": 0
        },
        "processed_files": {
          "type": "integer",
          "minimum": 0
        },
        "ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
