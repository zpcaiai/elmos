{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/source-analysis.schema.json",
  "title": "Source Framework Analysis",
  "type": "object",
  "required": [
    "analysis_id",
    "framework",
    "confidence",
    "components",
    "routes",
    "state_nodes",
    "capabilities",
    "trace"
  ],
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "type": "string"
    },
    "framework": {
      "type": "string",
      "enum": [
        "vue2",
        "vue3",
        "react",
        "flutter",
        "h5",
        "taro",
        "uni-app",
        "native-miniapp"
      ]
    },
    "framework_version": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "state_nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "lifecycle_hooks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "unsupported_signals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "fact_id",
          "path",
          "start_line",
          "end_line"
        ],
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
