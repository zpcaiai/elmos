{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/capability-registry-entry.schema.json",
  "title": "MiniApp Capability Registry Entry",
  "type": "object",
  "required": [
    "id",
    "category",
    "source_patterns",
    "targets",
    "fallback",
    "verified_at",
    "source_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"
    },
    "category": {
      "type": "string"
    },
    "source_patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "framework",
          "symbol"
        ],
        "properties": {
          "framework": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "targets": {
      "type": "object",
      "required": [
        "wechat",
        "alipay",
        "douyin",
        "xiaohongshu"
      ],
      "additionalProperties": false,
      "properties": {
        "wechat": {
          "type": "object",
          "required": [
            "support",
            "runtime",
            "permission",
            "review_risk",
            "required_tests"
          ],
          "additionalProperties": false,
          "properties": {
            "support": {
              "type": "string",
              "enum": [
                "native",
                "adapter",
                "redesign",
                "decision",
                "unsupported"
              ]
            },
            "runtime": {
              "type": "string",
              "enum": [
                "client",
                "server",
                "hybrid"
              ]
            },
            "permission": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "review_risk": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "adapter": {
              "type": "string"
            },
            "required_tests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "alipay": {
          "type": "object",
          "required": [
            "support",
            "runtime",
            "permission",
            "review_risk",
            "required_tests"
          ],
          "additionalProperties": false,
          "properties": {
            "support": {
              "type": "string",
              "enum": [
                "native",
                "adapter",
                "redesign",
                "decision",
                "unsupported"
              ]
            },
            "runtime": {
              "type": "string",
              "enum": [
                "client",
                "server",
                "hybrid"
              ]
            },
            "permission": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "review_risk": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "adapter": {
              "type": "string"
            },
            "required_tests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "douyin": {
          "type": "object",
          "required": [
            "support",
            "runtime",
            "permission",
            "review_risk",
            "required_tests"
          ],
          "additionalProperties": false,
          "properties": {
            "support": {
              "type": "string",
              "enum": [
                "native",
                "adapter",
                "redesign",
                "decision",
                "unsupported"
              ]
            },
            "runtime": {
              "type": "string",
              "enum": [
                "client",
                "server",
                "hybrid"
              ]
            },
            "permission": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "review_risk": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "adapter": {
              "type": "string"
            },
            "required_tests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "xiaohongshu": {
          "type": "object",
          "required": [
            "support",
            "runtime",
            "permission",
            "review_risk",
            "required_tests"
          ],
          "additionalProperties": false,
          "properties": {
            "support": {
              "type": "string",
              "enum": [
                "native",
                "adapter",
                "redesign",
                "decision",
                "unsupported"
              ]
            },
            "runtime": {
              "type": "string",
              "enum": [
                "client",
                "server",
                "hybrid"
              ]
            },
            "permission": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "review_risk": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "adapter": {
              "type": "string"
            },
            "required_tests": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "fallback": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "type": "string"
        },
        "requires_approval": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "verified_at": {
      "type": "string",
      "format": "date"
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
