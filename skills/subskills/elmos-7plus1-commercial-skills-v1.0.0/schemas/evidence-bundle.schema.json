{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.dev/evidence-bundle/1.0",
  "title": "Evidence Bundle",
  "type": "object",
  "required": [
    "bundle_id",
    "source_revision",
    "target_revision",
    "policy_revision",
    "environment_fingerprint",
    "artifacts",
    "gate_decision"
  ],
  "properties": {
    "bundle_id": {
      "type": "string"
    },
    "source_revision": {
      "type": "string"
    },
    "target_revision": {
      "type": "string"
    },
    "policy_revision": {
      "type": "string"
    },
    "environment_fingerprint": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "uri",
          "sha256",
          "created_at"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "uri": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "tool_revision": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object"
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gate_decision": {
      "enum": [
        "pass",
        "fail",
        "blocked",
        "waived"
      ]
    },
    "integrity": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
