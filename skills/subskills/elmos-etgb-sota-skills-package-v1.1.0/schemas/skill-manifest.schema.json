{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/etgb/schemas/skill-manifest.schema.json",
  "title": "ETGB Skill Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package", "version", "skills", "entry_skill", "capability_model", "cli"],
  "properties": {
    "schema_version": {"const": "1.1"},
    "package": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "description", "depends_on", "category", "maturity"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "path": {"type": "string", "pattern": "^skills/.+/SKILL\\.md$"},
          "description": {"type": "string", "minLength": 20},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "category": {"enum": ["orchestration", "domain-validation", "assurance", "runtime-control", "governance", "operations", "certification"]},
          "maturity": {"enum": ["reference", "production-contract", "production-ready"]}
        }
      }
    },
    "entry_skill": {"type": "string"},
    "capability_model": {"type": "string"},
    "cli": {"type": "string"},
    "integration_contracts": {"type": "array", "items": {"type": "string"}}
  }
}
