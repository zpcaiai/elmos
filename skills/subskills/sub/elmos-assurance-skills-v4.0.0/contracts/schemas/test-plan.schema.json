{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.invalid/assurance/v4/test-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "4.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          },
          "kind": {
            "enum": [
              "build",
              "contract",
              "smoke",
              "regression",
              "differential",
              "mutation",
              "proof",
              "audit"
            ]
          },
          "critical": {
            "type": "boolean"
          },
          "case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "kind",
          "critical",
          "case_ids"
        ]
      },
      "minItems": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          },
          "obligation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "runner_adapter": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          },
          "fixture_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "oracle_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
          },
          "estimated_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "minItems": 1
          },
          "cleanup": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "assertion_program_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "runner_plan_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "obligation_ids",
          "runner_adapter",
          "fixture_digest",
          "oracle_id",
          "estimated_seconds",
          "timeout_seconds",
          "assertions",
          "cleanup",
          "assertion_program_digest",
          "runner_plan_digest"
        ]
      },
      "minItems": 1
    },
    "required_regression_case_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "combination_strength": {
      "enum": [
        "explicit-critical-plus-pairwise",
        "explicit-critical-plus-twise",
        "fully-enumerated-finite-model"
      ]
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "contract_digest",
    "scope_digest",
    "obligations",
    "cases",
    "required_regression_case_ids",
    "combination_strength"
  ]
}
