{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.invalid/assurance/v4/proof-obligation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "4.0"
    },
    "proof_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "trusted_statement_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_model_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_ir_binding_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_artifact_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0
    },
    "allowed_axioms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0
    },
    "toolchain_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checker_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "native_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "minItems": 0
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "PROVED",
        "REFUTED",
        "UNKNOWN"
      ]
    }
  },
  "required": [
    "schema_version",
    "proof_id",
    "claim_id",
    "trusted_statement_digest",
    "semantic_model_digest",
    "source_ir_binding_digest",
    "target_artifact_digest",
    "preconditions",
    "allowed_axioms",
    "toolchain_digest",
    "checker_digest",
    "native_evidence_refs",
    "status"
  ]
}
