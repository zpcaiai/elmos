{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PreparedEnvironment",
  "type": "object",
  "required": [
    "environment_id",
    "fingerprint",
    "platform",
    "toolchain",
    "snapshot_digest",
    "state"
  ],
  "properties": {
    "environment_id": {
      "type": "string",
      "minLength": 1
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "toolchain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "snapshot_digest": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "BUILDING",
        "READY",
        "PINNED",
        "STALE",
        "QUARANTINED",
        "RETIRED"
      ]
    },
    "last_verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
