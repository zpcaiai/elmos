{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeerBinding",
  "type": "object",
  "required": [
    "tenant_id",
    "peer_identity",
    "agent_runtime_id",
    "authority_scope",
    "binding_version"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "peer_identity": {
      "type": "string",
      "minLength": 1
    },
    "agent_runtime_id": {
      "type": "string",
      "minLength": 1
    },
    "authority_scope": {
      "type": "object"
    },
    "repository_scope": {
      "type": "object"
    },
    "binding_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
