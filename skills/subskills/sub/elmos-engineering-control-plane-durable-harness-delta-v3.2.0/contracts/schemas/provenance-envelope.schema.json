{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProvenanceEnvelope",
  "type": "object",
  "required": [
    "producer",
    "trust_domain",
    "source_type",
    "source_digest"
  ],
  "properties": {
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "trust_domain": {
      "enum": [
        "BUILDER",
        "AUTHORITY",
        "TRUTH",
        "CERTIFIER",
        "EXTERNAL",
        "UNTRUSTED"
      ]
    },
    "source_type": {
      "type": "string",
      "minLength": 1
    },
    "source_uri": {
      "type": "string",
      "minLength": 1
    },
    "source_digest": {
      "type": "string",
      "minLength": 1
    },
    "execution_plan_digest": {
      "type": "string",
      "minLength": 1
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
