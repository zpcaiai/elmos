{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolCallJournal",
  "type": "object",
  "required": [
    "call_id",
    "capability",
    "adapter",
    "started_at",
    "terminal_status"
  ],
  "properties": {
    "call_id": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "terminal_status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "TIMED_OUT",
        "UNKNOWN"
      ]
    },
    "result_digest": {
      "type": "string",
      "minLength": 1
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
