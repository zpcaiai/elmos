{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RepositoryCheckpoint",
  "type": "object",
  "required": [
    "checkpoint_id",
    "repository",
    "base_revision",
    "entries",
    "digest"
  ],
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "old_kind",
          "new_kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "old_kind": {
            "enum": [
              "NONE",
              "FILE",
              "DIRECTORY",
              "SYMLINK"
            ]
          },
          "new_kind": {
            "enum": [
              "NONE",
              "FILE",
              "DIRECTORY",
              "SYMLINK"
            ]
          },
          "old_digest": {
            "type": "string",
            "minLength": 1
          },
          "new_digest": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "minLength": 1
          },
          "rename_from": {
            "type": "string",
            "minLength": 1
          },
          "rename_to": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
