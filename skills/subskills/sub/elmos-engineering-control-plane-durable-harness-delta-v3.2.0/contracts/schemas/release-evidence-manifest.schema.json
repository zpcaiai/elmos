{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReleaseEvidenceManifest",
  "type": "object",
  "required": [
    "release_id",
    "repository_commit",
    "verification",
    "publication",
    "status"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_commit": {
      "type": "string",
      "minLength": 1
    },
    "execution_plan_digest": {
      "type": "string",
      "minLength": 1
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "skill_set_digest": {
      "type": "string",
      "minLength": 1
    },
    "runner_image_digest": {
      "type": "string",
      "minLength": 1
    },
    "dependency_lock_digest": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "status"
        ],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "WAIVED",
              "PENDING"
            ]
          },
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "waiver_authority": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "publication": {
      "type": "object"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "WAIVED",
        "PENDING"
      ]
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
