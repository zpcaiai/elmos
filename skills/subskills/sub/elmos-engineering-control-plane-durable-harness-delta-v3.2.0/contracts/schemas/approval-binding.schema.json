{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApprovalBinding",
  "type": "object",
  "required": [
    "approval_id",
    "execution_plan_digest",
    "action_kind",
    "decision"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_plan_digest": {
      "type": "string",
      "minLength": 1
    },
    "action_kind": {
      "enum": [
        "EXEC_COMMAND",
        "WRITE_STDIN",
        "NETWORK",
        "FILE_MUTATION",
        "BROWSER_ACTION",
        "COMPUTER_ACTION",
        "CREDENTIAL_USE",
        "PUBLICATION",
        "DEPLOYMENT",
        "PERMISSION_ESCALATION"
      ]
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY",
        "REQUIRE_APPROVAL"
      ]
    },
    "resource_digest": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
