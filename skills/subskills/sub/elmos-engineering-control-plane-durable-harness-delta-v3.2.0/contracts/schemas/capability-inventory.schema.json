{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityInventory",
  "type": "object",
  "required": [
    "adapter_id",
    "protocol_version",
    "capabilities",
    "approval_modes"
  ],
  "properties": {
    "adapter_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval_modes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "policy_mapping_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
