{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionTimelineEvent",
  "type": "object",
  "required": [
    "execution_id",
    "sequence",
    "event_id",
    "event_type",
    "occurred_at"
  ],
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
