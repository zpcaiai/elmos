{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/execution-evidence.v1.json",
  "title": "Elmos ExecutionEvidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidenceId", "jobId", "ticketId", "subject", "provenance", "executions", "tests", "infrastructure"],
  "properties": {
    "schema": {"const": "elmos.execution-evidence.v1"},
    "evidenceId": {"type": "string", "minLength": 1},
    "jobId": {"type": "string", "minLength": 1},
    "ticketId": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["sourceDigest"],
      "properties": {"sourceDigest": {"$ref": "#/$defs/digest"}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["runnerIdentity", "runnerImageDigest", "caseCatalogDigest", "runnerProfileDigest", "policyDigest"],
      "properties": {
        "runnerIdentity": {"type": "string", "minLength": 1},
        "runnerImageDigest": {"$ref": "#/$defs/digest"},
        "caseCatalogDigest": {"$ref": "#/$defs/digest"},
        "runnerProfileDigest": {"$ref": "#/$defs/digest"},
        "policyDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "executions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["executionId", "stepId", "spawned", "timedOut", "killed", "durationMillis", "stdoutDigest", "stderrDigest"],
        "properties": {
          "executionId": {"type": "string", "minLength": 1},
          "stepId": {"type": "string", "minLength": 1},
          "spawned": {"type": "boolean"},
          "exitCode": {"type": ["integer", "null"]},
          "timedOut": {"type": "boolean"},
          "killed": {"type": "boolean"},
          "durationMillis": {"type": "integer", "minimum": 0},
          "stdoutDigest": {"$ref": "#/$defs/digest"},
          "stderrDigest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "tests": {
      "type": "object", "additionalProperties": false,
      "required": ["discovered", "executed", "passed", "failed", "skipped"],
      "properties": {
        "discovered": {"type": "integer", "minimum": 0},
        "executed": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "infrastructure": {
      "type": "object", "additionalProperties": false,
      "required": ["runnerFailure", "timeout", "dependencyFailure"],
      "properties": {
        "runnerFailure": {"type": "boolean"},
        "timeout": {"type": "boolean"},
        "dependencyFailure": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"}
  }
}
