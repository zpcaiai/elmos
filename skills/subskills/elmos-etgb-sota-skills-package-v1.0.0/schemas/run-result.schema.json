{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/etgb/schemas/run-result.schema.json",
  "title": "ETGB Run Result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "status",
    "started_at",
    "finished_at",
    "duration_ms",
    "oracle_results",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed",
        "skipped",
        "unavailable",
        "error"
      ]
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "oracle_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "object"
    },
    "silent_semantic_error": {
      "type": "boolean"
    },
    "cost": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
