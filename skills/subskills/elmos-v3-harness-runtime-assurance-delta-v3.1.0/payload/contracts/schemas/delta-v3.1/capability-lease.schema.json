{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.ai/schemas/v3.1/capability-lease.schema.json",
  "title": "Invocation Scoped Capability Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "leaseId",
    "invocationId",
    "environmentId",
    "authoritySnapshotId",
    "executionEpoch",
    "capabilities",
    "state"
  ],
  "properties": {
    "leaseId": {
      "type": "string"
    },
    "invocationId": {
      "type": "string"
    },
    "environmentId": {
      "type": "string"
    },
    "authoritySnapshotId": {
      "type": "string"
    },
    "executionEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "ACTIVE",
        "REVOKED",
        "EXPIRED"
      ]
    },
    "delegationAllowed": {
      "type": "boolean"
    }
  }
}
