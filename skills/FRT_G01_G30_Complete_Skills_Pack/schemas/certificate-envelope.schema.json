{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FRT Certificate Envelope",
  "type": "object",
  "required": [
    "certificateId",
    "family",
    "level",
    "scope",
    "digests",
    "status",
    "evidence"
  ],
  "properties": {
    "certificateId": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string"
    },
    "level": {
      "type": "integer",
      "minimum": 0,
      "maximum": 7
    },
    "scope": {
      "type": "object",
      "required": [
        "projectId",
        "releaseId"
      ]
    },
    "digests": {
      "type": "object",
      "minProperties": 1
    },
    "status": {
      "enum": [
        "valid",
        "stale",
        "retest_required",
        "revoked",
        "blocked",
        "inconclusive"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}