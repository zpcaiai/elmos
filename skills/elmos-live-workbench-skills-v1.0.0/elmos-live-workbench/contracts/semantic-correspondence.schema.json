{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.invalid/lw/v1/semantic-correspondence.schema.json",
  "title": "semantic-correspondence",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "lw.v1"
    },
    "mapping_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "target_snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "relation": {
      "type": "string",
      "enum": [
        "one-to-one",
        "one-to-many",
        "many-to-one",
        "many-to-many",
        "deleted",
        "synthesized",
        "unmapped"
      ]
    },
    "source_anchor_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "ir_symbol_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "target_anchor_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "rule_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "rule-derived",
        "observed-scenario",
        "inferred",
        "unknown"
      ]
    },
    "checkpoint_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "universal_equivalence_proven": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "mapping_id",
    "tenant_id",
    "source_snapshot_id",
    "target_snapshot_id",
    "relation",
    "source_anchor_ids",
    "ir_symbol_ids",
    "target_anchor_ids",
    "rule_id",
    "confidence",
    "checkpoint_ids",
    "assumptions",
    "evidence_ids",
    "universal_equivalence_proven"
  ],
  "additionalProperties": false
}
