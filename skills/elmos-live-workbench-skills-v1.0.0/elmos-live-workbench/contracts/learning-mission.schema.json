{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.invalid/lw/v1/learning-mission.schema.json",
  "title": "learning-mission",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "lw.v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "Observe",
        "Guided",
        "Challenge",
        "Free",
        "Compare"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "engineer",
        "cross-language"
      ]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "source_anchor_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "enum": [
              "read",
              "predict",
              "run",
              "breakpoint",
              "inspect",
              "compare",
              "edit",
              "test"
            ]
          },
          "completion_predicate_id": {
            "type": "string",
            "minLength": 1
          },
          "hint_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "step_id",
          "instruction",
          "action",
          "completion_predicate_id",
          "hint_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "assessment_service_ref": {
      "type": "string",
      "minLength": 1
    },
    "answer_in_public_payload": {
      "const": false
    },
    "stale": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "repository_id",
    "snapshot_id",
    "mission_id",
    "title",
    "mode",
    "difficulty",
    "prerequisites",
    "source_anchor_ids",
    "steps",
    "assessment_service_ref",
    "answer_in_public_payload",
    "stale"
  ],
  "additionalProperties": false
}
