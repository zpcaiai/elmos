{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.invalid/lw/v1/qualification-report.schema.json",
  "title": "qualification-report",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "lw.v1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "passed-scoped-tests",
        "failed",
        "not_run"
      ]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "surface": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "not_run",
              "unsupported"
            ]
          },
          "evidence_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "surface",
          "status",
          "evidence_paths",
          "limits"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "wall_clock_seconds": {
      "type": "number",
      "minimum": 0
    },
    "may_self_certify_e5": {
      "const": false
    },
    "deployment_qualified": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "report_id",
    "scope",
    "generated_at",
    "status",
    "results",
    "wall_clock_seconds",
    "may_self_certify_e5",
    "deployment_qualified"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "deployment_qualified": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "passed-scoped-tests"
          }
        }
      }
    }
  ]
}
