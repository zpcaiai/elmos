{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.invalid/lw/v1/cleanup-receipt.schema.json",
  "title": "cleanup-receipt",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "lw.v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "deadline": {
      "type": "number",
      "minimum": 0
    },
    "observed_at": {
      "type": "number",
      "minimum": 0
    },
    "checks": {
      "type": "object",
      "properties": {
        "proxy_revoked": {
          "type": "boolean"
        },
        "connections_closed": {
          "type": "boolean"
        },
        "processes_stopped": {
          "type": "boolean"
        },
        "volumes_deleted": {
          "type": "boolean"
        },
        "secrets_revoked": {
          "type": "boolean"
        },
        "adapters_stopped": {
          "type": "boolean"
        },
        "ports_closed": {
          "type": "boolean"
        }
      },
      "required": [
        "proxy_revoked",
        "connections_closed",
        "processes_stopped",
        "volumes_deleted",
        "secrets_revoked",
        "adapters_stopped",
        "ports_closed"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "cleaned",
        "quarantined"
      ]
    },
    "verifier_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "session_id",
    "generation",
    "deadline",
    "observed_at",
    "checks",
    "status",
    "verifier_id",
    "evidence_ids"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "cleaned"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "properties": {
              "proxy_revoked": {
                "const": true
              },
              "connections_closed": {
                "const": true
              },
              "processes_stopped": {
                "const": true
              },
              "volumes_deleted": {
                "const": true
              },
              "secrets_revoked": {
                "const": true
              },
              "adapters_stopped": {
                "const": true
              },
              "ports_closed": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
