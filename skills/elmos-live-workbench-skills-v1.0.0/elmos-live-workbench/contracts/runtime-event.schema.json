{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.invalid/lw/v1/runtime-event.schema.json",
  "title": "runtime-event",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "lw.v1"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "stop_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "type": "string",
      "enum": [
        "ready",
        "stopped",
        "resumed",
        "output",
        "span",
        "checkpoint",
        "terminated",
        "cleanup"
      ]
    },
    "server_time": {
      "type": "number",
      "minimum": 0
    },
    "trace_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "span_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_anchor_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "commit_status": {
      "type": "string",
      "enum": [
        "raw",
        "intercepted",
        "committed",
        "rejected"
      ]
    },
    "redaction_status": {
      "type": "string",
      "enum": [
        "none-needed",
        "redacted",
        "omitted"
      ]
    },
    "sampling_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "repository_id",
    "snapshot_id",
    "event_id",
    "session_id",
    "generation",
    "stop_epoch",
    "sequence",
    "kind",
    "server_time",
    "trace_id",
    "span_id",
    "source_anchor_ids",
    "payload_digest",
    "commit_status",
    "redaction_status",
    "sampling_note"
  ],
  "additionalProperties": false
}
