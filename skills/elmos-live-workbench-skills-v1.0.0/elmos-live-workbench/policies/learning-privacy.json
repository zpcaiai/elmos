{
  "policy_id": "lw.learning.v1",
  "default_mode": "guided",
  "modes": [
    "observe",
    "guided",
    "challenge",
    "free",
    "compare"
  ],
  "challenge_answers_in_public_payload": false,
  "challenge_answers_in_model_context_before_reveal": false,
  "reveal_requires_explicit_action": true,
  "private_progress_default": true,
  "raw_variable_capture": "minimal and opt-in",
  "demo_data": "synthetic",
  "expiry_stops_compute_not_all_artifacts": true,
  "artifact_retention": "tenant policy with explicit notice; no unconditional default retention",
  "export_requires_current_authorization": true,
  "core_accessibility": "keyboard+non-color-status+screen-reader-labels"
}
