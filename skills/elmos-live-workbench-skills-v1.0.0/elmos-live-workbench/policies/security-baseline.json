{
  "policy_id": "lw.security.v1",
  "treat_as_untrusted": [
    "repository",
    "build-script",
    "language-server-input",
    "debug-adapter-output",
    "preview-page",
    "trace-payload"
  ],
  "default_network": "deny",
  "public_ports": "declared-app-only",
  "deny": [
    "production-attach",
    "docker-socket",
    "host-mount",
    "privileged",
    "cloud-metadata",
    "control-plane-cookies-in-preview",
    "unsigned-authority",
    "cross-tenant-cache-read",
    "arbitrary-shell",
    "evaluate-by-default",
    "hidden-getter-execution-by-default"
  ],
  "require": [
    "server-minted-authority",
    "invocation-scoped-capability",
    "worker-generation-fencing",
    "immutable-revision",
    "artifact-digest-binding",
    "pre-storage-redaction",
    "bounded-output",
    "short-lived-credentials",
    "tenant-and-object-authorization",
    "early-cancel-kill",
    "cleanup-receipt"
  ],
  "preview_site": "separate-from-control-plane-registrable-site",
  "resource_limits": "cpu-memory-disk-pids-egress-output",
  "public_untrusted_execution_requires_qualified_provider": true,
  "security_gate_waiver_allowed": false
}
