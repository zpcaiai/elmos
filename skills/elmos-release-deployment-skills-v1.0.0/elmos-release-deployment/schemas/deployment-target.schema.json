{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://elmos.dev/schemas/deployment-target.schema.json",
  "title":"DeploymentTarget",
  "type":"object",
  "required":["target_id","tenant_id","provider","account_ref","region","compute"],
  "properties":{
    "target_id":{"type":"string"},"tenant_id":{"type":"string"},"provider":{"const":"alibaba_ecs"},
    "account_ref":{"type":"string"},"role_arn_ref":{"type":"string"},"region":{"type":"string"},"resource_group_id":{"type":"string"},
    "compute":{"type":"object","required":["instance_ids"],"properties":{"instance_ids":{"type":"array","minItems":1,"items":{"type":"string"}},"required_tags":{"type":"object"}}},
    "network":{"type":"object"},"registry":{"type":"object"},"ingress":{"type":"object"}
  },
  "additionalProperties": true
}
