{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://elmos.dev/schemas/deployment-evidence.schema.json",
  "title":"DeploymentEvidence",
  "type":"object",
  "required":["deployment_id","ticket_id","release_id","target_id","artifact_digests","steps","final_state","started_at","finished_at"],
  "properties":{
    "deployment_id":{"type":"string"},"ticket_id":{"type":"string"},"release_id":{"type":"string"},"target_id":{"type":"string"},
    "artifact_digests":{"type":"array","minItems":1,"items":{"type":"string"}},
    "provider_identity":{"type":"object"},
    "steps":{"type":"array","minItems":1,"items":{"type":"object","required":["name","status","started_at","finished_at"],"properties":{
      "name":{"type":"string"},"status":{"enum":["PASS","FAIL","SKIP"]},"provider_invocation_id":{"type":"string"},"exit_code":{"type":"integer"},
      "stdout_hash":{"type":"string"},"stderr_hash":{"type":"string"},"artifact_uri":{"type":"string"},"started_at":{"type":"string","format":"date-time"},"finished_at":{"type":"string","format":"date-time"}
    },"additionalProperties":true}},
    "health_results":{"type":"array"},"migration_results":{"type":"array"},"rollback":{"type":"object"},
    "final_state":{"enum":["SUCCEEDED","ROLLED_BACK","FAILED_NO_MUTATION","FAILED_NEEDS_HUMAN"]},
    "started_at":{"type":"string","format":"date-time"},"finished_at":{"type":"string","format":"date-time"},"signatures":{"type":"array"}
  },
  "additionalProperties": true
}
