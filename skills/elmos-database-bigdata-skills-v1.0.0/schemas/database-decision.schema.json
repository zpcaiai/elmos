{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.local/schemas/database-decision.schema.json",
  "title": "Elmos Database and Data-Technology Decision",
  "type": "object",
  "required": [
    "decision_id",
    "selector_version",
    "project_id",
    "roles",
    "rejected",
    "confidence",
    "evidence"
  ],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "selector_version": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "selected", "alternatives", "rationale", "constraints", "top_candidates", "candidate_count"],
        "properties": {
          "role": {"type": "string"},
          "selected": {"type": "array", "maxItems": 1, "items": {"type": "string"}},
          "alternatives": {"type": "array", "items": {"type": "string"}},
          "rationale": {"type": "array", "items": {"type": "string"}},
          "constraints": {"type": "array", "items": {"type": "string"}},
          "candidate_count": {"type": "integer", "minimum": 0},
          "top_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["technology", "name", "score_0_to_5", "components_0_to_5", "adapter_status"],
              "properties": {
                "technology": {"type": "string"},
                "name": {"type": "string"},
                "score_0_to_5": {"type": "number", "minimum": 0, "maximum": 5},
                "components_0_to_5": {"type": "object", "additionalProperties": {"type": "number"}},
                "adjustments": {"type": "array", "items": {"type": "string"}},
                "adapter_status": {"type": ["string", "null"]},
                "best_for": {"type": "array", "items": {"type": "string"}},
                "avoid_for": {"type": "array", "items": {"type": "string"}},
                "official_evidence": {"type": ["string", "null"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "technology", "reason"],
        "properties": {
          "role": {"type": "string"},
          "technology": {"type": "string"},
          "reason": {"type": "string"},
          "constraint": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "reference"],
        "properties": {
          "kind": {"type": "string"},
          "reference": {"type": "string"},
          "as_of": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "sensitivity": {"type": "object"},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
