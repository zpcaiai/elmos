{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.local/schemas/cost-and-eta.schema.json",
  "type": "object",
  "required": [
    "system_autonomous_runtime",
    "human_equivalent_effort",
    "human_in_the_loop_delay",
    "estimated_token_cost"
  ],
  "properties": {
    "system_autonomous_runtime": {
      "$ref": "#/$defs/range"
    },
    "human_equivalent_effort": {
      "$ref": "#/$defs/range"
    },
    "human_in_the_loop_delay": {
      "$ref": "#/$defs/range"
    },
    "estimated_token_cost": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "currency",
        "amount_range"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string"
        },
        "amount_range": {
          "$ref": "#/$defs/money_range"
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "as_of": {
      "type": "string"
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "required": [
        "min",
        "likely",
        "max",
        "unit"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "likely": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "enum": [
            "seconds",
            "minutes",
            "hours",
            "days",
            "person-hours",
            "person-days"
          ]
        }
      }
    },
    "money_range": {
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
