{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "nodes",
    "edges"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "digest",
          "producer",
          "timestamp",
          "tenant_id",
          "project_id",
          "version",
          "trust_level",
          "retention",
          "signature"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "producer": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "project_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "trust_level": {
            "enum": [
              "unverified",
              "internal",
              "certified",
              "customer-accepted",
              "third-party"
            ]
          },
          "retention": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "relation"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
