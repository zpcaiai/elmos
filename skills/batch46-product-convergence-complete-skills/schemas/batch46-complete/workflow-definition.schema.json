{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "workflow_id",
    "version",
    "steps"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "dependencies",
          "idempotency",
          "timeout_seconds",
          "retry",
          "compensation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "activity",
              "human-task",
              "approval",
              "child-workflow",
              "timer"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "idempotency": {
            "type": "object"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "retry": {
            "type": "object"
          },
          "compensation": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
