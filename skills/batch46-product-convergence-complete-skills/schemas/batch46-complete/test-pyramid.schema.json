    "levels",
    "environment_classes"
  ],
  "properties": {
    "levels": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "real_system_requirement"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "real_system_requirement": {
            "type": "string"
          }
        }
      }
    },
    "environment_classes": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": false
}
