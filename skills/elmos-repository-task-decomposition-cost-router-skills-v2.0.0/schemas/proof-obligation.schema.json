{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElmosProofObligation",
  "type": "object",
  "required": [
    "id",
    "statement",
    "scope",
    "preferred_verifier",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "statement": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "task",
        "edge",
        "checkpoint",
        "repository"
      ]
    },
    "scenario_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariant_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_verifier": {
      "enum": [
        "test",
        "compiler",
        "typechecker",
        "static_analyzer",
        "executable_probe",
        "structured_diff",
        "model_review"
      ]
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "open",
        "passed",
        "failed",
        "waived"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
