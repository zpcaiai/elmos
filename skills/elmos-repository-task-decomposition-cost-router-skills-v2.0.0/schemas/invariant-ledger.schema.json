{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElmosInvariantLedger",
  "type": "object",
  "required": [
    "invariants"
  ],
  "properties": {
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "scope",
          "criticality",
          "proof_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "scope": {
            "enum": [
              "local",
              "boundary",
              "repository_global"
            ]
          },
          "criticality": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proof_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
