{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElmosAdaptiveTask",
  "type": "object",
  "required": [
    "id",
    "title",
    "objective",
    "plan_revision",
    "hierarchy_level",
    "owned_paths",
    "dependencies",
    "acceptance",
    "complexity",
    "risk",
    "uncertainty",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "task_class": {
      "type": "string"
    },
    "plan_revision": {
      "type": "integer",
      "minimum": 1
    },
    "hierarchy_level": {
      "enum": [
        "goal",
        "capability",
        "changeset",
        "atomic_task",
        "microstep"
      ]
    },
    "scenario_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariant_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proof_obligation_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "incoming_contract_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outgoing_contract_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owned_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "read_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "semantic_cohesion": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cross_boundary_coupling": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verification_locality": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "impact_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "granularity": {
      "type": "object",
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "decision": {
          "enum": [
            "keep",
            "split",
            "merge",
            "coarse"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "complexity": {
      "type": "object"
    },
    "risk": {
      "type": "object"
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exploration_required": {
          "type": "boolean"
        }
      }
    },
    "context_pack": {
      "type": "object"
    },
    "routing": {
      "type": "object"
    },
    "status": {
      "enum": [
        "coarse",
        "planned",
        "exploring",
        "ready",
        "running",
        "blocked",
        "invalidated",
        "failed",
        "passed",
        "waived",
        "merged"
      ]
    }
  }
}
