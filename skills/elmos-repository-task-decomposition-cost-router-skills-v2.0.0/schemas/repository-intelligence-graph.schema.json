{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElmosRepositoryIntelligenceGraph",
  "type": "object",
  "required": [
    "revision",
    "nodes",
    "edges"
  ],
  "properties": {
    "revision": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "module",
              "source_file",
              "public_symbol",
              "api_endpoint",
              "database_entity",
              "migration",
              "queue_or_topic",
              "external_service",
              "config_surface",
              "build_target",
              "test_target"
            ]
          },
          "label": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "centrality": {
            "type": "number"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type",
          "confidence",
          "evidence"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "imports",
              "calls",
              "implements",
              "exposes",
              "reads",
              "writes",
              "publishes",
              "consumes",
              "migrates",
              "configures",
              "builds",
              "tests",
              "covers"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deterministic": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
