{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElmosBehavioralScenarioGraph",
  "type": "object",
  "required": [
    "scenarios",
    "edges"
  ],
  "properties": {
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "title",
          "steps",
          "acceptance_refs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "happy",
              "failure",
              "boundary",
              "compatibility",
              "rollback",
              "operational"
            ]
          },
          "title": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "observable"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "observable": {
                  "type": "string"
                },
                "component_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "proof_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "acceptance_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array"
    }
  }
}
