{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ElmosPlanRevision",
  "type": "object",
  "required": [
    "run_id",
    "revision",
    "trigger",
    "changes",
    "assumptions_changed",
    "invalidated_evidence"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "parent_revision": {
      "type": [
        "integer",
        "null"
      ]
    },
    "trigger": {
      "type": "string"
    },
    "scope": {
      "enum": [
        "local",
        "boundary_cluster",
        "global"
      ]
    },
    "changes": {
      "type": "object",
      "properties": {
        "added_nodes": {
          "type": "array"
        },
        "removed_nodes": {
          "type": "array"
        },
        "split_nodes": {
          "type": "array"
        },
        "merged_nodes": {
          "type": "array"
        },
        "added_edges": {
          "type": "array"
        },
        "removed_edges": {
          "type": "array"
        }
      }
    },
    "assumptions_changed": {
      "type": "array"
    },
    "invalidated_evidence": {
      "type": "array"
    },
    "preserved_evidence": {
      "type": "array"
    },
    "budget_delta": {
      "type": "number"
    },
    "eta_delta_seconds": {
      "type": "number"
    }
  }
}
