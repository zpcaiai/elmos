{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/formal-assurance/v1/proof-assumption.schema.json",
  "title": "Proof Assumption",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant",
    "statement",
    "riskLevel",
    "owner",
    "status",
    "hash",
    "createdAt"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "tenant": {
      "$ref": "common.schema.json#/$defs/tenantContext"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "formalExpression": {
      "type": "string"
    },
    "riskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROPOSED",
        "ACTIVE",
        "VIOLATED",
        "EXPIRED",
        "REVOKED"
      ]
    },
    "hash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "monitorId": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/artifactRef"
      }
    }
  }
}
