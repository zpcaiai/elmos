{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/formal-assurance/v1/observation-contract.schema.json",
  "title": "Observation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant",
    "sourceSystem",
    "targetSystem",
    "dimensions",
    "normalizers"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "tenant": {
      "$ref": "common.schema.json#/$defs/tenantContext"
    },
    "sourceSystem": {
      "type": "string"
    },
    "targetSystem": {
      "type": "string"
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "comparison",
          "criticality"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "comparison": {
            "enum": [
              "EXACT",
              "SET",
              "BAG",
              "ORDERED",
              "TOLERANT",
              "TRACE_REFINEMENT",
              "IGNORED"
            ]
          },
          "criticality": {
            "$ref": "common.schema.json#/$defs/criticality"
          },
          "tolerance": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "normalizers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "field",
          "operation"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "field": {
            "type": "string"
          },
          "operation": {
            "enum": [
              "DROP_NONCRITICAL",
              "CANONICALIZE",
              "SORT",
              "ROUND",
              "MAP_ID",
              "TIME_WINDOW"
            ]
          },
          "securityReviewed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "forbiddenIgnorePatterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
