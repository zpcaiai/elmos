{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmos.ai/formal-assurance/v1/proof-waiver.schema.json",
  "title": "Proof Waiver",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tenant",
    "obligationId",
    "reason",
    "risk",
    "owner",
    "approvals",
    "createdAt",
    "expiresAt",
    "status"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "tenant": {
      "$ref": "common.schema.json#/$defs/tenantContext"
    },
    "obligationId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "reason": {
      "type": "string",
      "minLength": 20
    },
    "risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "owner": {
      "type": "string"
    },
    "compensatingControls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "approver",
          "role",
          "approvedAt"
        ],
        "properties": {
          "approver": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "approvedAt": {
            "$ref": "common.schema.json#/$defs/timestamp"
          }
        }
      }
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "APPROVED",
        "REJECTED",
        "EXPIRED",
        "REVOKED"
      ]
    }
  }
}
