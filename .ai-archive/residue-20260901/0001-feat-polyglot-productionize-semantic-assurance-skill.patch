+def _relative_parts(value: Path | PurePosixPath, label: str) -> tuple[str, ...]:
+    raw = PurePosixPath(value.as_posix())
+    if raw.is_absolute():
+        raise IntegrationError(f"{label} must be relative: {value}")
+    if raw.as_posix() == ".":
+        return ()
+    _relative(raw.as_posix(), label)
+    return raw.parts
+
