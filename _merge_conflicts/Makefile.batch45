UV ?= uv
BATCH45_PYTHON ?= $(UV) run --quiet --with jsonschema --with pyyaml python
.PHONY: batch45-check batch45-scaffold batch45-gate batch45-gaps batch45-score batch45-manifest batch45-request
batch45-check:
	$(BATCH45_PYTHON) scripts/mature_product_toolkit.py validate --batch 45
	$(BATCH45_PYTHON) -m unittest discover -s tests/batch45 -p 'test_*.py'
batch45-scaffold:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(OWNER)" || (echo "OWNER=<owner> required" && exit 2)
	$(BATCH45_PYTHON) scripts/mature_product_toolkit.py scaffold --batch 45 --key $(PACK) --owner $(OWNER)
batch45-gate:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(TRUST_STORE)" || (echo "TRUST_STORE=<external-trust-store.json> required" && exit 2)
	$(BATCH45_PYTHON) scripts/mature_product_toolkit.py gate --batch 45 mature-product-packs/batch45/$(PACK) --trust-store $(TRUST_STORE)
batch45-gaps:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH45_PYTHON) scripts/mature_product_toolkit.py gaps --batch 45 mature-product-packs/batch45/$(PACK)
batch45-score:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	$(BATCH45_PYTHON) scripts/mature_product_toolkit.py score --batch 45 mature-product-packs/batch45/$(PACK)/candidates.json $(if $(WRITE),--write,)
batch45-manifest:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(EXECUTOR)" || (echo "EXECUTOR=<identity> required" && exit 2)
	@test -n "$(VERIFIER)" || (echo "VERIFIER=<independent identity> required" && exit 2)
	@test -n "$(AUTHORIZATION)" || (echo "AUTHORIZATION=<ref> required" && exit 2)
	@test -n "$(REPLAY)" || (echo "REPLAY=<command> required" && exit 2)
	@test -n "$(STARTED_AT)" || (echo "STARTED_AT=<ISO-8601> required" && exit 2)
	@test -n "$(FINISHED_AT)" || (echo "FINISHED_AT=<ISO-8601> required" && exit 2)
	$(BATCH45_PYTHON) scripts/mature_product_toolkit.py manifest --batch 45 mature-product-packs/batch45/$(PACK) \
		--artifact mature-product-packs/batch45/$(PACK)/$(ARTIFACT) \
		--environment mature-product-packs/batch45/$(PACK)/$(ENVIRONMENT) \
		--executor $(EXECUTOR) --verifier $(VERIFIER) --authorization $(AUTHORIZATION) \
		--replay-command "$(REPLAY)" --started-at $(STARTED_AT) --finished-at $(FINISHED_AT) \
		--attest-verifier-independent --attest-corpus-independence
batch45-request:
	@test -n "$(PACK)" || (echo "PACK=<pack-key> required" && exit 2)
	@test -n "$(KEY_ID)" || (echo "KEY_ID=<certification key id> required" && exit 2)
	$(BATCH45_PYTHON) scripts/mature_product_toolkit.py request --batch 45 mature-product-packs/batch45/$(PACK) --key-id $(KEY_ID)
