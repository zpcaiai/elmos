{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/batch35/frontend-formal-external-evidence-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "campaign_key",
    "scope_digest",
    "authorization",
    "organizations",
    "corpora",
    "route_block_results",
    "artifacts",
    "replay",
    "signatures",
    "status"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "frontend-formal-external-evidence-v2"},
    "campaign_key": {"const": "frontend-72-route-formal-equivalence-v2"},
    "scope_digest": {"$ref": "#/$defs/sha256"},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization_id",
        "purpose",
        "issued_at",
        "expires_at",
        "scope_digest",
        "authorized_organization_ids",
        "authorized_corpus_ids",
        "authorized_route_ids",
        "status"
      ],
      "properties": {
        "authorization_id": {"$ref": "#/$defs/nonEmpty"},
        "purpose": {"const": "INDEPENDENT_FRONTEND_EQUIVALENCE_QUALIFICATION"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "scope_digest": {"$ref": "#/$defs/sha256"},
        "authorized_organization_ids": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmpty"}
        },
        "authorized_corpus_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmpty"}
        },
        "authorized_route_ids": {
          "type": "array",
          "minItems": 72,
          "maxItems": 72,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/routeId"}
        },
        "status": {"const": "PASSED"}
      }
    },
    "organizations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "verifier", "approver", "customer"],
      "properties": {
        "executor": {"$ref": "#/$defs/organization"},
        "verifier": {"$ref": "#/$defs/organization"},
        "approver": {"$ref": "#/$defs/organization"},
        "customer": {"$ref": "#/$defs/organization"}
      }
    },
    "corpora": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holdout", "representative", "customer"],
      "properties": {
        "holdout": {"$ref": "#/$defs/corpus"},
        "representative": {"$ref": "#/$defs/corpus"},
        "customer": {"$ref": "#/$defs/corpus"}
      }
    },
    "route_block_results": {
      "type": "array",
      "minItems": 864,
      "maxItems": 864,
      "items": {"$ref": "#/$defs/routeBlockResult"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "protocol", "environment_artifact_id"],
      "properties": {
        "status": {"const": "PASSED"},
        "protocol": {"const": "EXTERNAL_TRUST_ROOT_VERIFIER_V2"},
        "environment_artifact_id": {"$ref": "#/$defs/sha256"}
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/signature"}
    },
    "status": {"enum": ["PASSED", "FAILED"]}
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "routeId": {
      "type": "string",
      "pattern": "^(angular|flutter|harmony-arkui|jquery|react|react-native|svelte|vue2|vue3)--to--(angular|flutter|harmony-arkui|jquery|react|react-native|svelte|vue2|vue3)$"
    },
    "blockId": {
      "enum": [
        "route-navigation-deeplink-404",
        "component-template-view",
        "state-management",
        "action-event",
        "effect-lifecycle",
        "form-binding-validation",
        "api-network",
        "identity-permission",
        "rendering-hydration",
        "accessibility-focus",
        "i18n-theme-responsive",
        "native-platform"
      ]
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "name"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/nonEmpty"},
        "name": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corpus_id",
        "status",
        "case_ids",
        "manifest_artifact_id",
        "provenance"
      ],
      "properties": {
        "corpus_id": {"$ref": "#/$defs/nonEmpty"},
        "status": {"const": "PASSED"},
        "case_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmpty"}
        },
        "manifest_artifact_id": {"$ref": "#/$defs/sha256"},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_organization_id",
            "created_at",
            "license_or_authorization",
            "content_digest"
          ],
          "properties": {
            "source_organization_id": {"$ref": "#/$defs/nonEmpty"},
            "created_at": {"type": "string", "format": "date-time"},
            "license_or_authorization": {"$ref": "#/$defs/nonEmpty"},
            "content_digest": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "routeBlockResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_id",
        "block_id",
        "status",
        "corpus_case_ids",
        "execution_artifact_ids",
        "replay_artifact_id",
        "executor_organization_id",
        "verifier_organization_id"
      ],
      "properties": {
        "route_id": {"$ref": "#/$defs/routeId"},
        "block_id": {"$ref": "#/$defs/blockId"},
        "status": {"enum": ["PASSED", "FAILED"]},
        "corpus_case_ids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmpty"}
        },
        "execution_artifact_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "replay_artifact_id": {"$ref": "#/$defs/sha256"},
        "executor_organization_id": {"$ref": "#/$defs/nonEmpty"},
        "verifier_organization_id": {"$ref": "#/$defs/nonEmpty"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "producer_organization_id",
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/sha256"},
        "role": {
          "enum": [
            "holdout-corpus-manifest",
            "representative-corpus-manifest",
            "customer-corpus-manifest",
            "route-block-execution",
            "route-block-replay",
            "route-block-runtime-environment",
            "source-runtime-observation",
            "target-runtime-observation",
            "replay-environment"
          ]
        },
        "producer_organization_id": {"$ref": "#/$defs/nonEmpty"},
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "organization_id",
        "key_id",
        "algorithm",
        "signed_payload_sha256",
        "signature_base64"
      ],
      "properties": {
        "role": {"enum": ["AUTHORIZATION", "EXECUTOR", "VERIFIER", "CUSTOMER"]},
        "organization_id": {"$ref": "#/$defs/nonEmpty"},
        "key_id": {"$ref": "#/$defs/nonEmpty"},
        "algorithm": {"const": "ed25519"},
        "signed_payload_sha256": {"$ref": "#/$defs/sha256"},
        "signature_base64": {"type": "string", "minLength": 40}
      }
    }
  }
}
