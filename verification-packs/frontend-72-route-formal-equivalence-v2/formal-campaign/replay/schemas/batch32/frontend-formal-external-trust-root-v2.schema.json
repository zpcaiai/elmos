{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/batch32/frontend-formal-external-trust-root-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "root_id",
    "policy_id",
    "valid_from",
    "valid_until",
    "revoked",
    "trust_store_signing_keys",
    "organization_key_allowlist",
    "revocations",
    "replay_verifier"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "frontend-formal-external-trust-root-v2"},
    "root_id": {"$ref": "#/$defs/nonEmpty"},
    "policy_id": {"const": "frontend-independent-evidence-policy-v2"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": "string", "format": "date-time"},
    "revoked": {"type": "boolean"},
    "trust_store_signing_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/rootKey"}
    },
    "organization_key_allowlist": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/allowedKey"}
    },
    "revocations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_ids", "organization_ids", "updated_at"],
      "properties": {
        "key_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "organization_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonEmpty"}},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "replay_verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier_id", "path", "realpath", "sha256", "bytes", "version"],
      "properties": {
        "verifier_id": {"$ref": "#/$defs/nonEmpty"},
        "path": {"type": "string", "pattern": "^/", "minLength": 2},
        "realpath": {"type": "string", "pattern": "^/", "minLength": 2},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "version": {"$ref": "#/$defs/nonEmpty"}
      }
    }
  },
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "publicKey": {
      "type": "string",
      "pattern": "^-----BEGIN PUBLIC KEY-----[\\s\\S]+-----END PUBLIC KEY-----\\n?$"
    },
    "rootKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "public_key_pem", "valid_from", "valid_until", "revoked"],
      "properties": {
        "key_id": {"$ref": "#/$defs/nonEmpty"},
        "public_key_pem": {"$ref": "#/$defs/publicKey"},
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "revoked": {"type": "boolean"}
      }
    },
    "allowedKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_id", "key_id", "role", "public_key_sha256"],
      "properties": {
        "organization_id": {"$ref": "#/$defs/nonEmpty"},
        "key_id": {"$ref": "#/$defs/nonEmpty"},
        "role": {"enum": ["AUTHORIZATION", "EXECUTOR", "VERIFIER"]},
        "public_key_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
