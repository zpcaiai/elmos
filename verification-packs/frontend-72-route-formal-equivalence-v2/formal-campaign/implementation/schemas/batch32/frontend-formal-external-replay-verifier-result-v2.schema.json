{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/batch32/frontend-formal-external-replay-verifier-result-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "verifier_id", "scope_digest", "intake_sha256",
    "trust_store_sha256", "verified_execution_artifact_ids",
    "verified_replay_artifact_ids", "verified_raw_artifact_ids",
    "verified_route_block_count", "status"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "frontend-formal-external-replay-verifier-result-v2"},
    "verifier_id": {"type": "string", "minLength": 1},
    "scope_digest": {"$ref": "#/$defs/sha256"},
    "intake_sha256": {"$ref": "#/$defs/sha256"},
    "trust_store_sha256": {"$ref": "#/$defs/sha256"},
    "verified_execution_artifact_ids": {"type": "array", "minItems": 864, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "verified_replay_artifact_ids": {"type": "array", "minItems": 864, "maxItems": 864, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "verified_raw_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
    "verified_route_block_count": {"const": 864},
    "status": {"const": "PASSED"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
