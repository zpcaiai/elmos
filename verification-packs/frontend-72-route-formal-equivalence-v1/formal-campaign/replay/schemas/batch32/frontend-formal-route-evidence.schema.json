{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/batch32/frontend-formal-route-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "source_profile_id",
    "target_profile_id",
    "source_profile_digest",
    "target_profile_digest",
    "semantic_blocks",
    "chunk_equivalence",
    "behavior",
    "formal",
    "implementation_fingerprint",
    "replay_fingerprint",
    "corpus_ids",
    "artifact_refs",
    "certification"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "route_id": { "$ref": "#/$defs/routeId" },
    "source_profile_id": { "$ref": "#/$defs/profileId" },
    "target_profile_id": { "$ref": "#/$defs/profileId" },
    "source_profile_digest": { "$ref": "#/$defs/sha256" },
    "target_profile_digest": { "$ref": "#/$defs/sha256" },
    "semantic_blocks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/semanticBlock" }
    },
    "chunk_equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path_scheme", "mappings", "status"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "path_scheme": { "const": "rfc6901-json-pointer-v1" },
        "mappings": {
          "type": "array",
          "minItems": 12,
          "items": { "$ref": "#/$defs/chunkMapping" }
        },
        "status": { "$ref": "#/$defs/layerStatus" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "canonical_oracle_artifact_id",
        "independent_oracle_artifact_id",
        "source_runtime_kind",
        "target_runtime_kind",
        "case_count",
        "pass_count",
        "status",
        "native_execution",
        "native_evidence_status",
        "toolchain_evidence_artifact_id",
        "source_execution_id",
        "target_execution_id",
        "source_build_status",
        "target_build_status",
        "source_browser_status",
        "target_browser_status"
      ],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "canonical_oracle_artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "independent_oracle_artifact_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "source_runtime_kind": { "$ref": "#/$defs/runtimeKind" },
        "target_runtime_kind": { "$ref": "#/$defs/runtimeKind" },
        "case_count": { "type": "integer", "minimum": 0 },
        "pass_count": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/$defs/layerStatus" },
        "native_execution": { "type": "boolean" },
        "native_evidence_status": { "$ref": "#/$defs/executionStatus" },
        "toolchain_evidence_artifact_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "source_execution_id": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "target_execution_id": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "source_build_status": { "$ref": "#/$defs/executionStatus" },
        "target_build_status": { "$ref": "#/$defs/executionStatus" },
        "source_browser_status": { "$ref": "#/$defs/executionStatus" },
        "target_browser_status": { "$ref": "#/$defs/executionStatus" }
      }
    },
    "formal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formal_input_artifact_id",
        "smt_artifact_id",
        "solver_result_artifact_id",
        "formal_input_sha256",
        "solver_input_sha256",
        "solver_result_sha256",
        "raw_solver_input_sha256",
        "raw_solver_result_sha256",
        "solver_binary_artifact_id",
        "solver_binary_sha256",
        "solver_binary_bytes",
        "raw_layered_result_artifact_id",
        "raw_layered_result_sha256",
        "raw_layered_solver_result_sha256",
        "status",
        "proof_strength",
        "composition_id",
        "composition_status",
        "assumptions",
        "unsupported_semantics",
        "unconditional"
      ],
      "properties": {
        "formal_input_artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "smt_artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "solver_result_artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "formal_input_sha256": { "$ref": "#/$defs/sha256" },
        "solver_input_sha256": { "$ref": "#/$defs/sha256" },
        "solver_result_sha256": { "$ref": "#/$defs/sha256" },
        "raw_solver_input_sha256": { "$ref": "#/$defs/sha256" },
        "raw_solver_result_sha256": { "$ref": "#/$defs/sha256" },
        "solver_binary_artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "solver_binary_sha256": {
          "const": "sha256:537a502af2f4013a8e887beebe525a0dae84918a61ff545991e36dfda07ed6d7"
        },
        "solver_binary_bytes": { "type": "integer", "minimum": 1 },
        "raw_layered_result_artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "raw_layered_result_sha256": { "$ref": "#/$defs/sha256" },
        "raw_layered_solver_result_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "$ref": "#/$defs/formalStatus" },
        "proof_strength": {
          "enum": ["theorem", "assumption", "bounded", "axiom", "none"]
        },
        "composition_id": { "$ref": "#/$defs/nonEmpty" },
        "composition_status": {
          "enum": [
            "PROVED",
            "PROVED_UNDER_ASSUMPTIONS",
            "REFUTED",
            "NOT_PROVED"
          ]
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "unsupported_semantics": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        },
        "unconditional": { "type": "boolean" }
      }
    },
    "implementation_fingerprint": { "$ref": "#/$defs/sha256" },
    "replay_fingerprint": { "$ref": "#/$defs/sha256" },
    "corpus_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["development", "negative", "holdout", "representative_workloads"],
      "properties": {
        "development": { "$ref": "#/$defs/nonEmpty" },
        "negative": { "$ref": "#/$defs/nonEmpty" },
        "holdout": { "$ref": "#/$defs/nonEmpty" },
        "representative_workloads": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactRef" }
    },
    "certification": { "enum": ["NOT_CERTIFIED", "CERTIFIED"] }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profileId": {
      "enum": [
        "angular",
        "flutter",
        "harmony-arkui",
        "jquery",
        "react",
        "react-native",
        "svelte",
        "vue2",
        "vue3"
      ]
    },
    "routeId": {
      "type": "string",
      "pattern": "^(angular|flutter|harmony-arkui|jquery|react|react-native|svelte|vue2|vue3)--to--(angular|flutter|harmony-arkui|jquery|react|react-native|svelte|vue2|vue3)$"
    },
    "runtimeKind": { "enum": ["model", "browser", "device"] },
    "layerStatus": { "enum": ["PASSED", "FAILED", "NOT_RUN"] },
    "executionStatus": { "enum": ["PASSED", "FAILED", "NOT_RUN"] },
    "formalStatus": {
      "enum": [
        "PROVED",
        "PROVED_UNDER_ASSUMPTIONS",
        "REFUTED",
        "NOT_PROVED",
        "UNKNOWN",
        "TIMEOUT",
        "NOT_RUN",
        "AXIOM",
        "BOUNDED"
      ]
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "path", "sha256", "bytes"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmpty" },
        "role": { "$ref": "#/$defs/nonEmpty" },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "spanRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "pointer", "span", "sha256"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "pointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
        },
        "span": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "integer", "minimum": 0 },
            "end": { "type": "integer", "minimum": 1 }
          }
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "semanticBlockId": {
      "enum": [
        "route-navigation-deeplink-404",
        "component-template-view",
        "state-management",
        "action-event",
        "effect-lifecycle",
        "form-binding-validation",
        "api-network",
        "identity-permission",
        "rendering-hydration",
        "accessibility-focus",
        "i18n-theme-responsive",
        "native-platform"
      ]
    },
    "semanticBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "canonical_ir",
        "source_relift_ir",
        "target_relift_ir",
        "source_code",
        "target_code",
        "semantic_hash",
        "status"
      ],
      "properties": {
        "block_id": { "$ref": "#/$defs/semanticBlockId" },
        "canonical_ir": { "$ref": "#/$defs/spanRef" },
        "source_relift_ir": { "$ref": "#/$defs/spanRef" },
        "target_relift_ir": { "$ref": "#/$defs/spanRef" },
        "source_code": { "$ref": "#/$defs/codeSpanRef" },
        "target_code": { "$ref": "#/$defs/codeSpanRef" },
        "semantic_hash": { "$ref": "#/$defs/sha256" },
        "status": { "$ref": "#/$defs/layerStatus" }
      }
    },
    "chunkMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "semantic_block",
        "canonical",
        "source",
        "target",
        "source_code",
        "target_code",
        "semantic_hash",
        "status"
      ],
      "properties": {
        "chunk_id": { "$ref": "#/$defs/nonEmpty" },
        "semantic_block": { "$ref": "#/$defs/semanticBlockId" },
        "canonical": { "$ref": "#/$defs/spanRef" },
        "source": { "$ref": "#/$defs/spanRef" },
        "target": { "$ref": "#/$defs/spanRef" },
        "source_code": { "$ref": "#/$defs/codeSpanRef" },
        "target_code": { "$ref": "#/$defs/codeSpanRef" },
        "semantic_hash": { "$ref": "#/$defs/sha256" },
        "status": { "$ref": "#/$defs/layerStatus" }
      }
    },
    "codeSpanRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "start", "end", "sha256", "parser_node_kind"],
      "properties": {
        "artifact_id": { "$ref": "#/$defs/nonEmpty" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "parser_node_kind": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
