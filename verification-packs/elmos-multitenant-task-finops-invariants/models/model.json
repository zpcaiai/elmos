{
  "schema_version": 1,
  "model_key": "account-task-control-v1",
  "owner": "elmos-workflow-engineering",
  "states": [
    "waiting_for_slot",
    "admitted",
    "running",
    "pause_requested",
    "paused",
    "unknown_result",
    "reconciling",
    "succeeded",
    "failed",
    "cancelled"
  ],
  "initial_state": "waiting_for_slot",
  "commands": [
    {
      "command": "admit-with-slot",
      "from": [
        "waiting_for_slot"
      ],
      "to": "admitted",
      "guard": "free-account-slot-and-generation-fence",
      "effects": [
        "lease-account-slot"
      ]
    },
    {
      "command": "start",
      "from": [
        "admitted"
      ],
      "to": "running",
      "guard": "valid-lease-generation",
      "effects": [
        "append-ordered-event"
      ]
    },
    {
      "command": "pause",
      "from": ["running"],
      "to": "pause_requested",
      "guard": "authenticated-account-control",
      "effects": ["append-control-audit"]
    },
    {
      "command": "complete-pause",
      "from": ["pause_requested"],
      "to": "paused",
      "guard": "valid-lease-generation",
      "effects": ["preserve-checkpoint", "release-account-slot"]
    },
    {
      "command": "mark-unknown",
      "from": ["admitted", "running", "pause_requested"],
      "to": "unknown_result",
      "guard": "effect-outcome-unknown",
      "effects": ["retain-reconciling-capacity"]
    },
    {
      "command": "reconcile",
      "from": ["unknown_result"],
      "to": "reconciling",
      "guard": "manual-reconciliation-requested",
      "effects": ["append-pending-reconciliation"]
    },
    {
      "command": "succeed",
      "from": ["running", "reconciling"],
      "to": "succeeded",
      "guard": "valid-terminal-proof",
      "effects": ["release-account-slot"]
    }
  ],
  "invariants": [
    "at-most-three-active-or-reconciling-root-tasks-per-account",
    "lost-generation-cannot-heartbeat-or-complete",
    "non-success-progress-is-at-most-99",
    "unknown-result-is-not-success",
    "terminal-state-releases-owned-slot"
  ],
  "forbidden_transitions": [
    {
      "from": "waiting_for_slot",
      "event": "start"
    },
    {
      "from": "paused",
      "event": "succeed-without-readmission"
    },
    {
      "from": "unknown_result",
      "event": "publish-success-without-reconciliation"
    }
  ],
  "timeouts": []
}
