  "invariants": [
    {
      "invariant_id": "INV-MONEY-LEDGER-001",
      "claim_id": "claim.ledger-conservation",
      "grain": ["tenant_id", "transaction_id", "currency"],
      "relationship": "sum(DEBIT.amount) == sum(CREDIT.amount)",
      "uniqueness": ["tenant_id", "posting_id"],
      "violation_codes": ["LEDGER_UNBALANCED", "DUPLICATE_LEDGER_POSTING_ID"],
      "detail_before_aggregate": true
    },
    {
      "invariant_id": "INV-MONEY-ALLOCATION-001",
      "claim_id": "claim.allocation-conservation",
      "grain": ["tenant_id", "source_id", "currency"],
      "relationship": "sum(allocation.amount) == source_amount",
      "violation_codes": ["ALLOCATION_LEAKAGE"],
      "detail_before_aggregate": true
    },
    {
      "invariant_id": "INV-MONEY-REFUND-001",
      "claim_id": "claim.refund-ceiling",
      "grain": ["tenant_id", "payment_id", "currency"],
      "relationship": "sum(refund.amount) <= charged_amount",
      "violation_codes": ["REFUND_EXCEEDS_PAYMENT"],
      "unknown_provider_result": "BLOCK"
    },
    {
      "invariant_id": "INV-MONEY-IDEMPOTENCY-001",
      "claim_id": "claim.idempotent-effect-uniqueness",
      "grain": ["tenant_id", "operation", "idempotency_key"],
      "relationship": "count(durable_effect) <= 1",
      "violation_codes": ["DUPLICATE_IDEMPOTENCY_EFFECT"]
    },
    {
      "invariant_id": "INV-MONEY-INVOICE-001",
      "claim_id": "claim.invoice-detail-reconciliation",
      "grain": ["tenant_id", "invoice_id", "currency"],
      "relationship": "declared_subtotal == sum(line.amount) AND declared_total == sum(line.amount) + tax_amount",
      "violation_codes": ["INVOICE_TOTAL_MISMATCH"],
      "detail_before_aggregate": true
    }
  ],
