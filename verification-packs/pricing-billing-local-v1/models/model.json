{
  "schema_version": 1,
  "model_key": "pricing-billing-invariant-evaluation-v1",
  "owner": "ELMOS pricing-billing engineering",
  "states": [
    "observation-loaded",
    "verified-clean",
    "violation-detected"
  ],
  "initial_state": "observation-loaded",
  "commands": [
    {
      "command": "verify-clean",
      "from": ["observation-loaded"],
      "to": "verified-clean",
      "guard": "all-required-observations-present-and-no-violations",
      "effects": ["emit-empty-violation-set"]
    },
    {
      "command": "detect-violation",
      "from": ["observation-loaded"],
      "to": "violation-detected",
      "guard": "one-or-more-invariants-fail",
      "effects": ["emit-stable-fingerprinted-violations"]
    }
  ],
  "invariants": [
    "verification-never-mutates-source-observation",
    "unknown-or-malformed-input-never-passes",
    "violations-are-tenant-currency-and-entity-scoped"
  ],
  "forbidden_transitions": [
    {
      "from": "violation-detected",
      "event": "mark-clean-without-new-observation"
    }
  ],
  "timeouts": [],
  "execution_state": "NOT_RUN",
  "limitations": [
    "This model documents the bounded harness lifecycle; model-based exploration was NOT_RUN."
  ]
}
