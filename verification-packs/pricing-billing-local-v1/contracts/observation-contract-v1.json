{
  "schema_version": 1,
  "contract_key": "pricing-billing-money-observation-v1",
  "owner": "ELMOS pricing-billing engineering",
  "unknown_policy": "BLOCK",
  "input_policy": {
    "money_and_quantity": "finite-decimal-string-with-at-most-six-fractional-digits",
    "currency": "three-letter-ASCII-code",
    "tenant": "required-and-never-wildcard",
    "partial_observation": "NOT_A_PASS",
    "float": "REJECT",
    "mutation": "READ_ONLY"
  },
  "observations": [
    {
      "name": "ledger_posting",
      "required_fields": ["tenant_id", "transaction_id", "posting_id", "currency", "side", "amount"],
      "grain": ["tenant_id", "transaction_id", "currency"]
    },
    {
      "name": "allocation_pool",
      "required_fields": ["tenant_id", "source_id", "currency", "source_amount", "allocations"],
      "grain": ["tenant_id", "source_id", "currency"]
    },
    {
      "name": "payment_refund",
      "required_fields": ["tenant_id", "payment_id", "currency", "charged_amount", "refund_amounts"],
      "grain": ["tenant_id", "payment_id", "currency"]
    },
    {
      "name": "idempotent_effect",
      "required_fields": ["tenant_id", "operation", "idempotency_key", "effect_id", "payload_digest"],
      "grain": ["tenant_id", "operation", "idempotency_key"]
    },
    {
      "name": "invoice",
      "required_fields": ["tenant_id", "invoice_id", "currency", "line_amounts", "declared_subtotal", "tax_amount", "declared_total"],
      "grain": ["tenant_id", "invoice_id", "currency"]
    }
  ],
  "local_execution": "LOCAL_EXECUTED_SELF_ATTESTED",
  "postgresql_execution": "NOT_RUN",
  "provider_execution": "NOT_RUN",
  "production_execution": "NOT_RUN"
}
