package resilience

import (
	"errors"
	"fmt"
	"sync"
	"time"
)

// State represents the current lifecycle phase of a circuit breaker.
type State int

const (
	StateClosed State = iota
	StateHalfOpen
	StateOpen
)

func (s State) String() string {
	switch s {
	case StateClosed:
		return "CLOSED"
	case StateHalfOpen:
		return "HALF-OPEN"
	case StateOpen:
		return "OPEN"
	default:
		return fmt.Sprintf("UNKNOWN(%d)", s)
	}
}

var (
	// ErrCircuitOpen is returned when an execution attempt is rejected because the circuit is open.
	ErrCircuitOpen = errors.New("circuit breaker is open; requests are shedding")
	// ErrTooManyRequests is returned when requests exceed the allowed limit in half-open state.
	ErrTooManyRequests = errors.New("circuit breaker is half-open; trial capacity exceeded")
)

// Counts tracks execution statistics within the current state cycle.
type Counts struct {
	Requests             uint32
	TotalSuccesses       uint32
	TotalFailures        uint32
	ConsecutiveSuccesses uint32
	ConsecutiveFailures  uint32
}

// Settings configures the thresholds and timeouts for a CircuitBreaker.
type Settings struct {
	Name                   string
	FailureThreshold       uint32        // Failures in Closed state to trip open (default 5)
	RecoveryTimeout        time.Duration // Time to remain Open before entering Half-Open (default 5s)
	MaxRequestsInHalfOpen  uint32        // Max trial requests allowed in Half-Open (default 1)
	SuccessThresholdInHalf uint32        // Consecutive successes in Half-Open to reset to Closed (default 1)
	OnStateChange          func(name string, from State, to State)
}

// CircuitBreaker guards operations from cascading failures using a state machine.
type CircuitBreaker struct {
	mu                     sync.RWMutex
	name                   string
	state                  State
	counts                 Counts
	openSince              time.Time
	failureThreshold       uint32
	recoveryTimeout        time.Duration
	maxRequestsInHalfOpen  uint32
	successThresholdInHalf uint32
	onStateChange          func(name string, from State, to State)
}

// NewCircuitBreaker constructs a mutex-safe CircuitBreaker instance.
func NewCircuitBreaker(st Settings) *CircuitBreaker {
	if st.FailureThreshold == 0 {
		st.FailureThreshold = 5
	}
	if st.RecoveryTimeout <= 0 {
		st.RecoveryTimeout = 5 * time.Second
	}
	if st.MaxRequestsInHalfOpen == 0 {
		st.MaxRequestsInHalfOpen = 1
	}
	if st.SuccessThresholdInHalf == 0 {
		st.SuccessThresholdInHalf = 1
	}

	return &CircuitBreaker{
		name:                   st.Name,
		state:                  StateClosed,
		failureThreshold:       st.FailureThreshold,
		recoveryTimeout:        st.RecoveryTimeout,
		maxRequestsInHalfOpen:  st.MaxRequestsInHalfOpen,
		successThresholdInHalf: st.SuccessThresholdInHalf,
		onStateChange:          st.OnStateChange,
	}
}

// Name returns the breaker name.
func (cb *CircuitBreaker) Name() string {
	return cb.name
}

// State returns the current State, evaluating automatic Open -> Half-Open timeout transition.
func (cb *CircuitBreaker) State() State {
	cb.mu.Lock()
	defer cb.mu.Unlock()
	cb.checkStateTimeoutLocked(time.Now())
	return cb.state
}

// Counts returns a snapshot of the current counts.
func (cb *CircuitBreaker) Counts() Counts {
	cb.mu.RLock()
	defer cb.mu.RUnlock()
	return cb.counts
}

// Reset resets the circuit breaker to StateClosed with empty counts.
func (cb *CircuitBreaker) Reset() {
	cb.mu.Lock()
	defer cb.mu.Unlock()
	cb.toNewStateLocked(StateClosed, time.Now())
}

// Execute wraps a callable function in circuit-breaker protection.
func (cb *CircuitBreaker) Execute(fn func() error) error {
	_, err := cb.ExecuteGeneric(func() (any, error) {
		return nil, fn()
	})
	return err
}

// ExecuteGeneric wraps a callable returning a value and error.
func (cb *CircuitBreaker) ExecuteGeneric(fn func() (any, error)) (any, error) {
	if err := cb.beforeExecution(); err != nil {
		return nil, err
	}

	result, err := fn()

	cb.afterExecution(err)
	return result, err
}

func (cb *CircuitBreaker) beforeExecution() error {
	cb.mu.Lock()
	defer cb.mu.Unlock()

	now := time.Now()
	cb.checkStateTimeoutLocked(now)

	switch cb.state {
	case StateOpen:
		return ErrCircuitOpen
	case StateHalfOpen:
		if cb.counts.Requests >= cb.maxRequestsInHalfOpen {
			return ErrTooManyRequests
		}
		cb.counts.Requests++
		return nil
	default: // StateClosed
		cb.counts.Requests++
		return nil
	}
}

func (cb *CircuitBreaker) afterExecution(err error) {
	cb.mu.Lock()
	defer cb.mu.Unlock()

	now := time.Now()
	if err != nil {
		cb.onFailureLocked(now)
	} else {
		cb.onSuccessLocked(now)
	}
}

func (cb *CircuitBreaker) onSuccessLocked(now time.Time) {
	cb.counts.TotalSuccesses++
	cb.counts.ConsecutiveSuccesses++
	cb.counts.ConsecutiveFailures = 0

	if cb.state == StateHalfOpen {
		if cb.counts.ConsecutiveSuccesses >= cb.successThresholdInHalf {
			cb.toNewStateLocked(StateClosed, now)
		}
	}
}

func (cb *CircuitBreaker) onFailureLocked(now time.Time) {
	cb.counts.TotalFailures++
	cb.counts.ConsecutiveFailures++
	cb.counts.ConsecutiveSuccesses = 0

	switch cb.state {
	case StateClosed:
		if cb.counts.ConsecutiveFailures >= cb.failureThreshold {
			cb.toNewStateLocked(StateOpen, now)
		}
	case StateHalfOpen:
		// Any failure in half-open immediately returns to Open
		cb.toNewStateLocked(StateOpen, now)
	}
}

func (cb *CircuitBreaker) checkStateTimeoutLocked(now time.Time) {
	if cb.state == StateOpen && now.Sub(cb.openSince) >= cb.recoveryTimeout {
		cb.toNewStateLocked(StateHalfOpen, now)
	}
}

func (cb *CircuitBreaker) toNewStateLocked(newState State, now time.Time) {
	if cb.state == newState {
		return
	}

	from := cb.state
	cb.state = newState
	cb.counts = Counts{}

	if newState == StateOpen {
		cb.openSince = now
	}

	if cb.onStateChange != nil {
		cb.onStateChange(cb.name, from, newState)
	}
}
