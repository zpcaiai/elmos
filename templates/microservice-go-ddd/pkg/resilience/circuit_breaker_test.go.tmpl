package resilience_test

import (
	"errors"
	"sync"
	"testing"
	"time"

	"{{.ModuleName}}/pkg/resilience"
)

func TestCircuitBreaker_ClosedToOpen(t *testing.T) {
	cb := resilience.NewCircuitBreaker(resilience.Settings{
		Name:             "test-breaker",
		FailureThreshold: 3,
		RecoveryTimeout:  100 * time.Millisecond,
	})

	if cb.State() != resilience.StateClosed {
		t.Fatalf("expected StateClosed, got %v", cb.State())
	}

	testErr := errors.New("upstream service error")

	// 2 failures: still closed
	for i := 0; i < 2; i++ {
		_ = cb.Execute(func() error {
			return testErr
		})
		if cb.State() != resilience.StateClosed {
			t.Fatalf("expected StateClosed after %d failures, got %v", i+1, cb.State())
		}
	}

	// 3rd failure: trips to Open
	_ = cb.Execute(func() error {
		return testErr
	})
	if cb.State() != resilience.StateOpen {
		t.Fatalf("expected StateOpen after reaching threshold, got %v", cb.State())
	}

	// In Open state, requests should fail fast with ErrCircuitOpen
	err := cb.Execute(func() error {
		return nil
	})
	if !errors.Is(err, resilience.ErrCircuitOpen) {
		t.Fatalf("expected ErrCircuitOpen, got %v", err)
	}
}

func TestCircuitBreaker_OpenToHalfOpenToClosed(t *testing.T) {
	stateChanges := make([]string, 0)
	cb := resilience.NewCircuitBreaker(resilience.Settings{
		Name:                   "recovery-breaker",
		FailureThreshold:       2,
		RecoveryTimeout:        50 * time.Millisecond,
		MaxRequestsInHalfOpen:  1,
		SuccessThresholdInHalf: 1,
		OnStateChange: func(name string, from, to resilience.State) {
			stateChanges = append(stateChanges, from.String()+"->"+to.String())
		},
	})

	// Trip to open
	_ = cb.Execute(func() error { return errors.New("err1") })
	_ = cb.Execute(func() error { return errors.New("err2") })

	if cb.State() != resilience.StateOpen {
		t.Fatalf("expected StateOpen, got %v", cb.State())
	}

	// Wait for recovery timeout
	time.Sleep(70 * time.Millisecond)

	// Breaker should now be Half-Open
	if cb.State() != resilience.StateHalfOpen {
		t.Fatalf("expected StateHalfOpen after timeout, got %v", cb.State())
	}

	// Successful trial request in Half-Open resets breaker to Closed
	err := cb.Execute(func() error {
		return nil
	})
	if err != nil {
		t.Fatalf("unexpected error during half-open trial: %v", err)
	}

	if cb.State() != resilience.StateClosed {
		t.Fatalf("expected StateClosed after successful trial, got %v", cb.State())
	}
}

func TestCircuitBreaker_HalfOpenFailureTripsOpen(t *testing.T) {
	cb := resilience.NewCircuitBreaker(resilience.Settings{
		Name:             "fail-fast-breaker",
		FailureThreshold: 1,
		RecoveryTimeout:  30 * time.Millisecond,
	})

	// Trip to open
	_ = cb.Execute(func() error { return errors.New("initial failure") })
	if cb.State() != resilience.StateOpen {
		t.Fatalf("expected StateOpen, got %v", cb.State())
	}

	// Wait for timeout to enter Half-Open
	time.Sleep(50 * time.Millisecond)
	if cb.State() != resilience.StateHalfOpen {
		t.Fatalf("expected StateHalfOpen, got %v", cb.State())
	}

	// Failure in Half-Open trips immediately back to Open
	_ = cb.Execute(func() error { return errors.New("trial failure") })
	if cb.State() != resilience.StateOpen {
		t.Fatalf("expected StateOpen after failed trial, got %v", cb.State())
	}
}

func TestCircuitBreaker_ConcurrentAccess(t *testing.T) {
	cb := resilience.NewCircuitBreaker(resilience.Settings{
		Name:             "concurrent-breaker",
		FailureThreshold: 10,
		RecoveryTimeout:  50 * time.Millisecond,
	})

	var wg sync.WaitGroup
	for i := 0; i < 50; i++ {
		wg.Add(1)
		go func(idx int) {
			defer wg.Done()
			_ = cb.Execute(func() error {
				if idx%5 == 0 {
					return errors.New("intermittent error")
				}
				return nil
			})
			_ = cb.State()
			_ = cb.Counts()
		}(i)
	}
	wg.Wait()
}
