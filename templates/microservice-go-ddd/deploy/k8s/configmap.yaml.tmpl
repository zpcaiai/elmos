apiVersion: v1
kind: ConfigMap
metadata:
  name: {{.ServiceName}}-config
  namespace: {{.Namespace}}
  labels:
    app.kubernetes.io/name: {{.ServiceName}}
    app.kubernetes.io/instance: {{.ServiceName}}-{{.Environment}}
    app.kubernetes.io/version: "{{.Version}}"
    app.kubernetes.io/component: backend
    app.kubernetes.io/part-of: {{.ProjectName}}
data:
  APP_ENV: "{{.Environment}}"
  HTTP_PORT: "{{.Port}}"
  GRPC_PORT: "{{.GRPCPort}}"
  LOG_LEVEL: "info"
  LOG_FORMAT: "json"
  DATABASE_URL: "{{.Database}}://user:pass@{{.ServiceName}}-db:5432/{{.ServiceName}}?sslmode=disable"
