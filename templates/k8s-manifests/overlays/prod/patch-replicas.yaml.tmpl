apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{.ServiceName}}
spec:
  replicas: {{.Replicas}}
  template:
    spec:
      containers:
        - name: {{.ServiceName}}
          resources:
            requests:
              cpu: 250m
              memory: 256Mi
            limits:
              cpu: 1000m
              memory: 1Gi
