{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.example/schemas/console-telemetry-event-1.0.0.json",
  "title": "ELMOS privacy-safe console telemetry event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventName",
    "businessLine",
    "route",
    "actionKey",
    "targetKind",
    "outcome",
    "durationBucket",
    "viewportClass",
    "sessionId",
    "occurredAt",
    "durationMs",
    "errorCode"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "eventName": { "enum": ["page_view", "interaction", "form_submit", "api_request", "js_error", "performance"] },
    "businessLine": { "enum": ["overview", "spring", "translation", "generation", "repositories", "migration", "commercialization", "pricing", "skills", "admin"] },
    "route": { "type": "string", "pattern": "^/[^?#\\r\\n\\u0000]{0,159}$" },
    "actionKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$" },
    "targetKind": { "enum": ["page", "api", "window", "button", "link", "form", "input", "select", "textarea", "unknown"] },
    "outcome": { "enum": ["succeeded", "failed", "cancelled"] },
    "durationBucket": { "enum": ["not_measured", "lt_100ms", "100_499ms", "500_999ms", "1_2s", "2_5s", "gte_5s"] },
    "viewportClass": { "enum": ["mobile", "tablet", "desktop"] },
    "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": ["integer", "null"], "minimum": 0, "maximum": 3600000 },
    "errorCode": { "type": ["string", "null"], "pattern": "^[A-Z0-9][A-Z0-9._:-]{0,95}$" }
  }
}
