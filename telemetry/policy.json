{
  "schemaVersion": "1.0.0",
  "policyVersion": "2.0.0",
  "purpose": ["product_reliability", "performance_optimization", "bug_diagnosis"],
  "approvedQuestions": [
    "Which business workflows fail or are cancelled?",
    "Which stable route templates exceed latency budgets?",
    "Which stable error codes recur after a release?",
    "Do supported viewport classes complete the same workflows?"
  ],
  "classification": "PSEUDONYMOUS_TECHNICAL",
  "regions": ["TENANT_CONFIGURED"],
  "consentMode": "USER_OPT_OUT_FOR_PRODUCT_TELEMETRY",
  "securityAuditConsentMode": "LEGITIMATE_SECURITY_INTEREST",
  "samplingBasisPoints": 10000,
  "rawEventRetentionDaysTarget": 30,
  "automaticPruneAvailable": true,
  "automaticPruneDefaultEnabled": false,
  "deletionScope": "product_telemetry_events_only",
  "appendOnlyAuditDeleted": false,
  "productionRetentionEvidence": "NOT_RUN",
  "eventNames": ["page_view", "interaction", "form_submit", "api_request", "js_error", "performance"],
  "metrics": ["event_count", "failure_rate_bps", "p95_duration_ms", "active_sessions"],
  "allowedDimensions": [
    "business_line",
    "event_kind",
    "action",
    "route_template",
    "result",
    "error_code",
    "duration_bucket",
    "viewport_class"
  ],
  "interactionCollection": "SEMANTIC_CONTROLS_WITHOUT_VALUES_OR_VISIBLE_TEXT",
  "fieldChangeCollection": "PROHIBITED",
  "individualProductivityScoring": "PROHIBITED",
  "forbiddenFields": [
    "input_value",
    "token",
    "authorization",
    "cookie",
    "query_string",
    "request_body",
    "response_body",
    "error_message",
    "stack",
    "raw_ip",
    "raw_user_agent"
  ]
}
