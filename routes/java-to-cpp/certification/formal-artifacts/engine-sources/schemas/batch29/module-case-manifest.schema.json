{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/batch29/module-case-manifest.schema.json",
  "title": "Batch29TypedPureModuleCaseManifest",
  "type": "object",
  "required": ["schema_version", "profile", "composition", "functions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "typed-pure-module-v1"},
    "composition": {
      "oneOf": [
        {
          "const": {
            "call_graph": [],
            "global_state": "none",
            "effects": "none",
            "exceptions": "canonical-arithmetic-errors-only",
            "input_domain": "canonical-finite-no-error-input-domain"
          }
        },
        {
          "const": {
            "call_graph": [],
            "global_state": "none",
            "effects": "none",
            "exceptions": "domain-guards-fail-closed-before-execution",
            "input_domain": "nodejs-es2022-esm-safe-integer-finite-v1"
          }
        }
      ]
    },
    "functions": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["symbol", "signature", "cases"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "signature": {
            "type": "object",
            "required": ["parameters", "return_type"],
            "properties": {
              "parameters": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "type"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "type": {"enum": ["integer", "number", "boolean", "string"]}
                  },
                  "additionalProperties": false
                }
              },
              "return_type": {"enum": ["integer", "number", "boolean", "string"]}
            },
            "additionalProperties": false
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["args", "expected"],
              "properties": {
                "args": {"type": "array"},
                "expected": {}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "composition": {
            "properties": {
              "input_domain": {"const": "canonical-finite-no-error-input-domain"}
            },
            "required": ["input_domain"]
          }
        },
        "required": ["composition"]
      },
      "then": {
        "properties": {
          "functions": {
            "items": {
              "properties": {
                "signature": {
                  "properties": {
                    "parameters": {
                      "items": {
                        "properties": {
                          "type": {"enum": ["integer", "number", "boolean"]}
                        }
                      }
                    },
                    "return_type": {"enum": ["integer", "number", "boolean"]}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
