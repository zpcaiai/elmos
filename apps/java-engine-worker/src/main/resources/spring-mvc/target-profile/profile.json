{
  "schema_version": 1,
  "profile_key": "spring-framework-5-3-mvc-to-spring-boot-3-5-3-target",
  "version": "0.1.0",
  "owner": "ELMOS Java Modernization Team",
  "framework": "spring-boot",
  "framework_versions": [
    "3.5.3"
  ],
  "runtime": "java",
  "runtime_versions": [
    "21"
  ],
  "architecture_style": "executable-spring-boot-servlet-application-generated-from-fcm",
  "providers": {
    "spring_framework": {
      "provider": "spring-framework",
      "version": "6.2.8"
    },
    "servlet": {
      "namespace": "jakarta.servlet",
      "version": "6.1",
      "embedded_container": "tomcat-10.1.42"
    },
    "serializer": {
      "provider": "jackson",
      "version_authority": "spring-boot-3.5.3-bom",
      "exact_resolution_status": "PASSED_LOCAL"
    },
    "dependency_injection": {
      "provider": "spring-framework",
      "version": "6.2.8",
      "context_merge_requires_fcm": true
    },
    "validation": {
      "namespace": "jakarta.validation",
      "api_version": "3.0.2",
      "provider": "hibernate-validator",
      "provider_version": "8.0.2.Final"
    },
    "authentication": {
      "strategy": "fail-closed-require-exact-security-profile",
      "automatic_support": false
    },
    "authorization": {
      "strategy": "fail-closed-require-exact-security-profile",
      "automatic_support": false
    },
    "persistence": {
      "strategy": "fail-closed-require-exact-provider-profile",
      "automatic_support": false
    },
    "transactions": {
      "strategy": "fail-closed-require-exact-transaction-profile",
      "automatic_support": false
    },
    "messaging": {
      "strategy": "fail-closed-require-exact-provider-profile"
    },
    "cache": {
      "strategy": "fail-closed-require-exact-provider-profile"
    },
    "scheduler": {
      "strategy": "fail-closed-require-exact-provider-profile"
    },
    "observability": {
      "provider": "spring-boot-actuator",
      "health_path": "/actuator/health",
      "exposure_requires_policy": true
    },
    "views": {
      "packaging": "executable-war",
      "provider": "tomcat-embed-jasper",
      "provider_version": "10.1.42",
      "dependency_scope": "provided",
      "jsp_prefix": "/WEB-INF/views/",
      "jsp_suffix": ".jsp",
      "unsupported_construct_policy": "fail-closed"
    }
  },
  "build": {
    "commands": [
      "mvn -B --no-transfer-progress test",
      "mvn -B --no-transfer-progress verify",
      "mvn -B --no-transfer-progress package"
    ],
    "required_maven": "3.9.11",
    "toolchain_digests": [
      "sha256:0d7125e8c91097b36edb990ea5934e6c68b4440eef4ea96510a0f6815e7eeadb"
    ],
    "execution_status": "PASSED_LOCAL",
    "execution_scope": "LOCAL_ENGINEERING_EXACT_FIXTURE_ONLY",
    "evidence_ref": "certification/local-execution/2026-08-27/evidence-index.json"
  },
  "startup": {
    "command": "java -jar target/<verified-boot-artifact>.war --server.address=127.0.0.1 --server.port=<ephemeral-port>",
    "health_check": "GET http://127.0.0.1:<ephemeral-port>/actuator/health",
    "shutdown_check": "SIGTERM followed by bounded graceful completion",
    "execution_status": "PASSED_LOCAL",
    "execution_scope": "LOCAL_ENGINEERING_EXACT_FIXTURE_ONLY",
    "evidence_ref": "certification/local-execution/2026-08-27/evidence-index.json"
  },
  "manual_obligations": [
    "existing corporate Maven parents require an approved parent/BOM strategy",
    "JSP tag libraries, JSP XML actions and non-Tomcat view providers require separate exact profiles",
    "JNDI, realms and container descriptors require provider-specific adapters",
    "security, persistence, transactions, messaging, cache and scheduler must remain blocked without exact profiles"
  ]
}
