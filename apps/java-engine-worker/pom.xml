<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.elmos</groupId><artifactId>elmos-parent</artifactId><version>0.1.0-SNAPSHOT</version><relativePath>../../pom.xml</relativePath></parent>
  <artifactId>elmos-java-engine-worker</artifactId>
  <dependencies>
    <dependency><groupId>io.elmos</groupId><artifactId>elmos-engine-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.elmos</groupId><artifactId>elmos-evidence</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.elmos</groupId><artifactId>elmos-health-check</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.elmos</groupId><artifactId>elmos-planning</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.elmos</groupId><artifactId>elmos-integrations</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.elmos</groupId><artifactId>elmos-recipe-governance</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.elmos</groupId><artifactId>elmos-validation</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>io.elmos</groupId><artifactId>elmos-enterprise-governance</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId><configuration><classifier>exec</classifier></configuration><executions><execution><goals><goal>repackage</goal></goals></execution></executions></plugin></plugins></build>
  <profiles>
    <profile>
      <id>spring-coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.13</version>
            <configuration>
              <includes>
                <include>io/elmos/worker/SpringRouteCatalog*</include>
                <include>io/elmos/worker/SpringCapabilityFingerprint*</include>
                <include>io/elmos/worker/SpringUpgradeModels*</include>
              </includes>
            </configuration>
            <executions>
              <execution>
                <id>spring-coverage-prepare-agent</id>
                <goals><goal>prepare-agent</goal></goals>
              </execution>
              <execution>
                <id>spring-coverage-report</id>
                <phase>verify</phase>
                <goals><goal>report</goal></goals>
              </execution>
              <execution>
                <id>spring-coverage-check</id>
                <phase>verify</phase>
                <goals><goal>check</goal></goals>
                <configuration>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.96</minimum>
                        </limit>
                        <limit>
                          <counter>BRANCH</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.80</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
