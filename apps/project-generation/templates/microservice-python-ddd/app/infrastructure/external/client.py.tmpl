import logging
from typing import Any

import httpx

logger = logging.getLogger(__name__)


class ExternalServiceClient:
    """Async HTTP client for consuming downstream microservices."""

    def __init__(self, base_url: str, timeout: float = 5.0) -> None:
        self.base_url = base_url.rstrip("/")
        self.timeout = timeout
        self._client: httpx.AsyncClient | None = None

    async def open(self) -> None:
        """Initialize HTTP connection pool."""
        self._client = httpx.AsyncClient(
            base_url=self.base_url,
            timeout=self.timeout,
            headers={"Content-Type": "application/json", "Accept": "application/json"},
        )

    async def close(self) -> None:
        """Close HTTP connection pool."""
        if self._client:
            await self._client.aclose()
            self._client = None

    async def get_data(
        self, endpoint: str, params: dict[str, Any] | None = None
    ) -> dict[str, Any]:
        """Perform a GET request with error handling."""
        if not self._client:
            raise RuntimeError("Client not opened. Call open() first.")
        try:
            response = await self._client.get(endpoint, params=params)
            response.raise_for_status()
            return response.json()
        except httpx.HTTPError as exc:
            logger.error(f"External request to {endpoint} failed: {exc}")
            raise
