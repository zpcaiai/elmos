import logging
import time
import uuid
from collections.abc import AsyncGenerator
from contextlib import asynccontextmanager

from fastapi import FastAPI, Request, Response, status
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse

from app.config import get_settings
from app.domain.exceptions.domain_exceptions import DomainException
from app.infrastructure.database.session import get_db_manager
from app.interfaces.api.router import api_router, probe_router

settings = get_settings()

logging.basicConfig(
    level=settings.log_level.upper(),
    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
)
logger = logging.getLogger("{{.ServiceName}}")


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncGenerator[None, None]:
    """Lifespan context manager managing application startup and graceful shutdown."""
    logger.info(f"Starting {{.ServiceName}} in {settings.app_env} environment...")

    # Initialize async database engine pool
    db_manager = get_db_manager(settings)
    await db_manager.init()

    yield

    # Graceful shutdown: close pools and client connections
    logger.info("Shutting down {{.ServiceName}}...")
    await db_manager.close()
    logger.info("Service shutdown complete.")


def create_app() -> FastAPI:
    """Factory function for FastAPI application instance."""
    app = FastAPI(
        title="{{.ProjectName}}",
        description="{{.Description}}",
        version="{{.Version}}",
        docs_url="/docs",
        redoc_url="/redoc",
        openapi_url="/openapi.json",
        lifespan=lifespan,
    )

    # 1. CORS Middleware
    app.add_middleware(
        CORSMiddleware,
        allow_origins=["*"],
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )

    # 2. Request ID and Timing Middleware
    @app.middleware("http")
    async def request_context_middleware(request: Request, call_next) -> Response:
        request_id = request.headers.get("X-Request-ID") or f"req-{uuid.uuid4().hex[:12]}"
        start_time = time.perf_counter()

        response = await call_next(request)

        duration = time.perf_counter() - start_time
        response.headers["X-Request-ID"] = request_id
        response.headers["X-Response-Time"] = f"{duration * 1000:.2f}ms"

        logger.info(
            f"{request.method} {request.url.path} "
            f"status={response.status_code} "
            f"duration={duration * 1000:.2f}ms "
            f"req_id={request_id}"
        )
        return response

    # 3. Domain Exception Handler
    @app.exception_handler(DomainException)
    async def domain_exception_handler(request: Request, exc: DomainException) -> JSONResponse:
        return JSONResponse(
            status_code=status.HTTP_400_BAD_REQUEST,
            content={"error": exc.__class__.__name__, "message": str(exc)},
        )

    # 4. Include Routers
    app.include_router(probe_router)
    app.include_router(api_router)

    return app


app = create_app()
