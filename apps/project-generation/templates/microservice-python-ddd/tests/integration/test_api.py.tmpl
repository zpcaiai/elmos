import pytest
from fastapi.testclient import TestClient

from app.main import app


@pytest.fixture
def client():
    """Test client fixture running against the FastAPI app instance."""
    with TestClient(app) as test_client:
        yield test_client


def test_healthz_endpoint(client: TestClient):
    """Verify Kubernetes liveness probe."""
    response = client.get("/healthz")
    assert response.status_code == 200
    data = response.json()
    assert data["status"] == "healthy"
    assert data["service"] == "{{.ServiceName}}"


def test_readyz_endpoint(client: TestClient):
    """Verify Kubernetes readiness probe."""
    response = client.get("/readyz")
    assert response.status_code == 200
    assert response.json()["status"] == "ready"


def test_livez_endpoint(client: TestClient):
    """Verify Kubernetes liveness probe."""
    response = client.get("/livez")
    assert response.status_code == 200
    assert response.json()["status"] == "alive"


def test_metrics_endpoint(client: TestClient):
    """Verify Prometheus metrics endpoint."""
    response = client.get("/metrics")
    assert response.status_code == 200
    assert "service_up 1" in response.text
    assert response.headers["content-type"].startswith("text/plain")


def test_entity_crud_lifecycle(client: TestClient):
    """Verify full CRUD lifecycle via HTTP endpoints."""
    # 1. Create
    create_resp = client.post(
        "/api/v1/entities",
        json={"name": "Widget Alpha", "description": "High performance widget"},
    )
    assert create_resp.status_code == 201
    created_data = create_resp.json()
    entity_id = created_data["id"]
    assert created_data["name"] == "Widget Alpha"
    assert created_data["status"] == "PENDING"

    # 2. Get by ID
    get_resp = client.get(f"/api/v1/entities/{entity_id}")
    assert get_resp.status_code == 200
    assert get_resp.json()["id"] == entity_id

    # 3. Update
    update_resp = client.put(
        f"/api/v1/entities/{entity_id}",
        json={"name": "Widget Alpha Revised", "description": "Updated description"},
    )
    assert update_resp.status_code == 200
    assert update_resp.json()["name"] == "Widget Alpha Revised"

    # 4. Activate
    activate_resp = client.post(f"/api/v1/entities/{entity_id}/activate")
    assert activate_resp.status_code == 200
    assert activate_resp.json()["status"] == "ACTIVE"

    # 5. List
    list_resp = client.get("/api/v1/entities?offset=0&limit=10")
    assert list_resp.status_code == 200
    list_data = list_resp.json()
    assert list_data["total_count"] >= 1

    # 6. Delete
    del_resp = client.delete(f"/api/v1/entities/{entity_id}")
    assert del_resp.status_code == 204

    # 7. Verify deletion returns RFC 7807 problem details
    not_found_resp = client.get(f"/api/v1/entities/{entity_id}")
    assert not_found_resp.status_code == 404
    assert not_found_resp.headers["content-type"].startswith("application/problem+json")
    problem = not_found_resp.json()
    assert problem["status"] == 404
    assert "detail" in problem
    assert "instance" in problem
    assert "title" in problem


def test_rfc7807_validation_error(client: TestClient):
    """Verify RFC 7807 problem details response on invalid request schema."""
    response = client.post("/api/v1/entities", json={})
    assert response.status_code == 422
    assert response.headers["content-type"].startswith("application/problem+json")
    problem = response.json()
    assert problem["status"] == 422
    assert problem["type"] == "urn:problem-type:validation-error"
    assert problem["title"] == "Request Validation Failed"
    assert "invalid_params" in problem
    assert len(problem["invalid_params"]) > 0


def test_telemetry_traceparent_propagation(client: TestClient):
    """Verify W3C traceparent header is propagated in HTTP response."""
    traceparent = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
    response = client.get("/healthz", headers={"traceparent": traceparent})
    assert response.status_code == 200
    assert "traceparent" in response.headers
    assert response.headers["traceparent"].startswith("00-4bf92f3577b34da6a3ce929d0e0e4736-")
