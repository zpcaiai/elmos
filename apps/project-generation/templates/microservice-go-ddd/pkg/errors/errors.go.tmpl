package errors

import (
	"fmt"
	"net/http"
)

// Kind classifies application errors for mapping to transport status codes.
type Kind int

const (
	KindUnknown Kind = iota
	KindNotFound
	KindValidation
	KindConflict
	KindUnauthorized
	KindForbidden
	KindInternal
)

// AppError represents a typed domain or application error.
type AppError struct {
	Kind     Kind
	Message  string
	Err      error
	Instance string
}

func (e *AppError) Error() string {
	if e.Err != nil {
		return fmt.Sprintf("%s: %v", e.Message, e.Err)
	}
	return e.Message
}

func (e *AppError) Unwrap() error {
	return e.Err
}

// ProblemDetails represents an RFC 7807 Problem Details object.
type ProblemDetails struct {
	Type     string `json:"type"`
	Title    string `json:"title"`
	Status   int    `json:"status"`
	Detail   string `json:"detail"`
	Instance string `json:"instance,omitempty"`
}

// ProblemTypeForKind maps an error Kind to an RFC 7807 type URI.
func ProblemTypeForKind(k Kind) string {
	switch k {
	case KindNotFound:
		return "urn:problem-type:not-found"
	case KindValidation:
		return "urn:problem-type:validation-error"
	case KindConflict:
		return "urn:problem-type:conflict"
	case KindUnauthorized:
		return "urn:problem-type:unauthorized"
	case KindForbidden:
		return "urn:problem-type:forbidden"
	case KindInternal:
		return "urn:problem-type:internal-server-error"
	default:
		return "urn:problem-type:unknown"
	}
}

// ProblemTitleForKind maps an error Kind to an RFC 7807 short title.
func ProblemTitleForKind(k Kind) string {
	switch k {
	case KindNotFound:
		return "Resource Not Found"
	case KindValidation:
		return "Validation Failed"
	case KindConflict:
		return "Conflict"
	case KindUnauthorized:
		return "Unauthorized"
	case KindForbidden:
		return "Forbidden"
	case KindInternal:
		return "Internal Server Error"
	default:
		return "An Error Occurred"
	}
}

// ToProblemDetails converts an AppError into an RFC 7807 ProblemDetails struct.
func (e *AppError) ToProblemDetails(instance string) *ProblemDetails {
	inst := instance
	if inst == "" {
		inst = e.Instance
	}
	return &ProblemDetails{
		Type:     ProblemTypeForKind(e.Kind),
		Title:    ProblemTitleForKind(e.Kind),
		Status:   HTTPStatusCode(e),
		Detail:   e.Error(),
		Instance: inst,
	}
}

// ToProblemDetails transforms any Go error into an RFC 7807 ProblemDetails representation.
func ToProblemDetails(err error, instance string) *ProblemDetails {
	if err == nil {
		return &ProblemDetails{
			Type:     "about:blank",
			Title:    "OK",
			Status:   http.StatusOK,
			Detail:   "Operation completed successfully",
			Instance: instance,
		}
	}

	var appErr *AppError
	if As(err, &appErr) {
		return appErr.ToProblemDetails(instance)
	}

	return &ProblemDetails{
		Type:     "urn:problem-type:internal-server-error",
		Title:    "Internal Server Error",
		Status:   http.StatusInternalServerError,
		Detail:   err.Error(),
		Instance: instance,
	}
}

// NewNotFound creates a resource not found error (HTTP 404).
func NewNotFound(msg string) *AppError {
	return &AppError{Kind: KindNotFound, Message: msg}
}

// NewValidation creates a client validation error (HTTP 400).
func NewValidation(msg string) *AppError {
	return &AppError{Kind: KindValidation, Message: msg}
}

// NewConflict creates a state conflict error (HTTP 409).
func NewConflict(msg string) *AppError {
	return &AppError{Kind: KindConflict, Message: msg}
}

// NewUnauthorized creates an authentication error (HTTP 401).
func NewUnauthorized(msg string) *AppError {
	return &AppError{Kind: KindUnauthorized, Message: msg}
}

// NewForbidden creates an authorization error (HTTP 403).
func NewForbidden(msg string) *AppError {
	return &AppError{Kind: KindForbidden, Message: msg}
}

// NewInternal creates an unexpected internal error (HTTP 500).
func NewInternal(msg string, err error) *AppError {
	return &AppError{Kind: KindInternal, Message: msg, Err: err}
}

// HTTPStatusCode maps an AppError Kind to standard HTTP status codes.
func HTTPStatusCode(err error) int {
	if err == nil {
		return http.StatusOK
	}

	var appErr *AppError
	if As(err, &appErr) {
		switch appErr.Kind {
		case KindNotFound:
			return http.StatusNotFound
		case KindValidation:
			return http.StatusBadRequest
		case KindConflict:
			return http.StatusConflict
		case KindUnauthorized:
			return http.StatusUnauthorized
		case KindForbidden:
			return http.StatusForbidden
		case KindInternal:
			return http.StatusInternalServerError
		default:
			return http.StatusInternalServerError
		}
	}

	return http.StatusInternalServerError
}

// As wraps errors.As for convenience.
func As(err error, target any) bool {
	return genericAs(err, target)
}

func genericAs(err error, target any) bool {
	t, ok := target.(**AppError)
	if !ok {
		return false
	}
	curr := err
	for curr != nil {
		if e, ok := curr.(*AppError); ok {
			*t = e
			return true
		}
		if u, ok := curr.(interface{ Unwrap() error }); ok {
			curr = u.Unwrap()
		} else {
			break
		}
	}
	return false
}
