package main

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"{{.ModuleName}}/internal/application/service"
	"{{.ModuleName}}/internal/infrastructure/config"
	"{{.ModuleName}}/internal/infrastructure/persistence"
	grpcInterface "{{.ModuleName}}/internal/interfaces/grpc"
	httpInterface "{{.ModuleName}}/internal/interfaces/http"
	"{{.ModuleName}}/pkg/logger"
)

func main() {
	// 1. Load Configuration
	cfg := config.Load()

	// 2. Initialize Structured Logger
	log := logger.New(cfg.LogLevel, cfg.LogFormat)
	log.Info("Starting service",
		"service", "{{.ServiceName}}",
		"version", "{{.Version}}",
		"env", cfg.Environment,
	)

	// 3. Initialize Infrastructure & Repositories
	repo := persistence.NewRepository(cfg.DatabaseURL)
	log.Info("Initialized database persistence layer", "database", "{{.Database}}")

	// 4. Initialize Application Services (Use Cases)
	entityService := service.NewEntityService(repo, log)

	// 5. Initialize Interfaces (HTTP & gRPC)
	httpHandler := httpInterface.NewHandler(entityService, log)
	httpRouter := httpInterface.NewRouter(httpHandler, log)

	httpServer := &http.Server{
		Addr:         fmt.Sprintf(":%s", cfg.HTTPPort),
		Handler:      httpRouter,
		ReadTimeout:  cfg.ReadTimeout,
		WriteTimeout: cfg.WriteTimeout,
		IdleTimeout:  cfg.IdleTimeout,
	}

	grpcServer := grpcInterface.NewServer(entityService, log, cfg.GRPCPort)

	// 6. Start Servers in Goroutines
	go func() {
		log.Info("HTTP server listening", "port", cfg.HTTPPort)
		if err := httpServer.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			log.Error("HTTP server failed to listen", "error", err)
			os.Exit(1)
		}
	}()

	go func() {
		log.Info("gRPC server listening", "port", cfg.GRPCPort)
		if err := grpcServer.Start(); err != nil {
			log.Error("gRPC server failed to run", "error", err)
		}
	}()

	// 7. Graceful Shutdown on SIGINT / SIGTERM
	quit := make(chan os.Signal, 1)
	signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
	sig := <-quit

	log.Info("Received shutdown signal", "signal", sig.String())

	shutdownCtx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
	defer cancel()

	// Stop gRPC server
	grpcServer.GracefulStop()
	log.Info("gRPC server stopped")

	// Stop HTTP server
	if err := httpServer.Shutdown(shutdownCtx); err != nil {
		log.Error("HTTP server forced to shutdown", "error", err)
	} else {
		log.Info("HTTP server exited cleanly")
	}

	// Close repository connections if needed
	if closer, ok := any(repo).(interface{ Close() error }); ok {
		if err := closer.Close(); err != nil {
			log.Error("Failed to close persistence connection", "error", err)
		}
	}

	log.Info("Service shutdown complete")
}
