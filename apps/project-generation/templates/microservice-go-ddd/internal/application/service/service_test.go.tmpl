package service_test

import (
	"context"
	"errors"
	"fmt"
	"sync"
	"testing"
	"time"

	"{{.ModuleName}}/internal/application/dto"
	"{{.ModuleName}}/internal/application/service"
	"{{.ModuleName}}/internal/domain/model"
	"{{.ModuleName}}/internal/domain/repository"
	"{{.ModuleName}}/pkg/logger"
)

// mockRepository implements repository.Repository in-memory for testing application service without infrastructure dependencies.
type mockRepository struct {
	mu    sync.RWMutex
	items map[string]*model.Entity
}

var _ repository.Repository = (*mockRepository)(nil)

func newMockRepository() *mockRepository {
	return &mockRepository{
		items: make(map[string]*model.Entity),
	}
}

func (m *mockRepository) FindByID(ctx context.Context, id string) (*model.Entity, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()
	ent, ok := m.items[id]
	if !ok {
		return nil, nil
	}
	return ent, nil
}

func (m *mockRepository) Save(ctx context.Context, ent *model.Entity) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	if ent == nil {
		return errors.New("nil entity")
	}
	m.items[ent.ID()] = ent
	return nil
}

func (m *mockRepository) Update(ctx context.Context, ent *model.Entity) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	if ent == nil {
		return errors.New("nil entity")
	}
	m.items[ent.ID()] = ent
	return nil
}

func (m *mockRepository) Delete(ctx context.Context, id string) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	delete(m.items, id)
	return nil
}

func (m *mockRepository) List(ctx context.Context, offset, limit int) ([]*model.Entity, int64, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()
	var list []*model.Entity
	for _, v := range m.items {
		list = append(list, v)
	}
	return list, int64(len(list)), nil
}

func TestEntityService_Lifecycle(t *testing.T) {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	repo := newMockRepository()
	log := logger.New("error", "text")
	svc := service.NewEntityService(repo, log)

	// 1. Create Entity
	createReq := dto.CreateEntityRequest{
		Name:        "Test Item",
		Description: "A test item for DDD service verification",
	}
	created, err := svc.CreateEntity(ctx, createReq)
	if err != nil {
		t.Fatalf("unexpected error creating entity: %v", err)
	}
	if created.ID == "" {
		t.Fatal("expected non-empty entity ID")
	}
	if created.Name != "Test Item" {
		t.Fatalf("expected name 'Test Item', got %s", created.Name)
	}

	// 2. Get Entity
	fetched, err := svc.GetEntity(ctx, created.ID)
	if err != nil {
		t.Fatalf("unexpected error fetching entity: %v", err)
	}
	if fetched.ID != created.ID {
		t.Fatalf("expected id %s, got %s", created.ID, fetched.ID)
	}

	// 3. Update Entity
	updateReq := dto.UpdateEntityRequest{
		Name:        "Updated Test Item",
		Description: "Updated description",
	}
	updated, err := svc.UpdateEntity(ctx, created.ID, updateReq)
	if err != nil {
		t.Fatalf("unexpected error updating entity: %v", err)
	}
	if updated.Name != "Updated Test Item" {
		t.Fatalf("expected name 'Updated Test Item', got %s", updated.Name)
	}

	// 4. List Entities
	listResp, err := svc.ListEntities(ctx, dto.PaginationParam{Offset: 0, Limit: 10})
	if err != nil {
		t.Fatalf("unexpected error listing entities: %v", err)
	}
	if listResp.TotalCount != 1 {
		t.Fatalf("expected 1 entity in list, got %d", listResp.TotalCount)
	}

	// 5. Delete Entity
	if err := svc.DeleteEntity(ctx, created.ID); err != nil {
		t.Fatalf("unexpected error deleting entity: %v", err)
	}

	// 6. Verify NotFound after deletion
	_, err = svc.GetEntity(ctx, created.ID)
	if err == nil {
		t.Fatal("expected not found error after deletion, got nil")
	}
	_ = fmt.Sprintf("Finished verification for entity %s", created.ID)
}
