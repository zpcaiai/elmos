<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.elmos</groupId>
    <artifactId>elmos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>elmos-runner-agent</artifactId>
  <properties>
    <elmos.test.requireRealContainer>false</elmos.test.requireRealContainer>
  </properties>
  <dependencies/>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>io.elmos.runner.RunnerAgentMain</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>21</release>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <id>runner-agent-self-test</id>
            <phase>test</phase>
            <goals><goal>java</goal></goals>
            <configuration>
              <mainClass>io.elmos.runner.AgentSelfTest</mainClass>
              <classpathScope>test</classpathScope>
              <systemProperties>
                <systemProperty>
                  <key>elmos.test.requireRealContainer</key>
                  <value>${elmos.test.requireRealContainer}</value>
                </systemProperty>
              </systemProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>real-container-acceptance</id>
      <properties>
        <elmos.test.requireRealContainer>true</elmos.test.requireRealContainer>
      </properties>
    </profile>
  </profiles>
</project>
