# This file intentionally lives at the configured Vercel project root.
# In a monorepo Vercel gives this policy precedence over a repository-root
# .vercelignore, so the Git integration and CLI evaluate the same rules.
/*
!app
!app/**
!lib
!lib/**
!public
!public/**
!.vercelignore
!.npmrc
!next-env.d.ts
!next.config.ts
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!proxy.ts
!tsconfig.json
!vercel.json

# Derived local output must never be part of a deployment input manifest.
/.next/**
/node_modules/**
/test-results/**
/playwright-report/**
/coverage/**
/.turbo/**
