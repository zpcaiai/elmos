{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmos.dev/schemas/evidence-manifest.v1.json",
  "title": "Elmos EvidenceManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "jobId", "sourceDigest", "objects"],
  "properties": {
    "schema": {"const": "elmos.evidence-manifest.v1"},
    "jobId": {"type": "string", "minLength": 1},
    "sourceDigest": {"$ref": "#/$defs/digest"},
    "objects": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "digest", "sizeBytes"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/digest"},
          "sizeBytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"}
  }
}
