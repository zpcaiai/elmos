<view class="{{styles.container}}">
  <view class="{{styles.header}}">
    <view class="{{styles.titleRow}}">
      <text class="{{styles.badge}}">ELMOS Governance &amp; Assurance OS</text>
      <view class="{{styles.title}}">契约治理、变异测试与多级缓存中心</view>
    </view>
    <view class="{{styles.subtitle}}">展示变异、API 差分和缓存治理的交互形态；本页面未连接真实 Runner，所有示例均不构成执行证据。</view>
    <view class="{{styles.notice}}" role="status">SAMPLE_ONLY · Runner execution NOT_RUN · Independent verification NOT_RUN · Certification NOT_CERTIFIED</view>
    <view class="{{styles.tabBar}}">
      <button type="button" class="{{`${styles.tabBtn} ${activeTab === &quot;mutation&quot; ? styles.activeTab : &quot;&quot;}`}}" aria-pressed="{{activeTab === &quot;mutation&quot;}}" bindtap="onTap">
        <Icon name="test" size="{{16}}" />
        <text>变异测试充分性分析 (Mutation Testing)</text>
      </button>
      <button type="button" class="{{`${styles.tabBtn} ${activeTab === &quot;api-diff&quot; ? styles.activeTab : &quot;&quot;}`}}" aria-pressed="{{activeTab === &quot;api-diff&quot;}}" bindtap="onTap">
        <Icon name="route" size="{{16}}" />
        <text>API 契约向后兼容漂移差分 (API Diff)</text>
      </button>
      <button type="button" class="{{`${styles.tabBtn} ${activeTab === &quot;cas-cache&quot; ? styles.activeTab : &quot;&quot;}`}}" aria-pressed="{{activeTab === &quot;cas-cache&quot;}}" bindtap="onTap">
        <Icon name="database" size="{{16}}" />
        <text>多级 CAS 缓存网络 (CAS Cache &amp; Bloom)</text>
      </button>
    </view>
  </view>
  <view wx:if="{{activeTab === "mutation"}}" class="{{styles.mainGrid}}">
    <view class="{{styles.panel}}">
      <view class="{{styles.panelHeader}}">
        <view>待测业务逻辑 (Source Code)</view>
        <button type="button" class="{{styles.runBtn}}" disabled="{{isAnalyzing}}" bindtap="handleRunMutation">
          <Icon name="play" size="{{14}}" />
          <text wx:if="{{isAnalyzing}}">{{"生成示例中..."}}</text>
          <text wx:else>{{"生成变异结果示例（不执行 Runner）"}}</text>
        </button>
      </view>
      <textarea aria-label="待测业务逻辑示例" class="{{styles.editor}}" value="{{codeSnippet}}" rows="{{8}}" bindchange="onChange" />
      <view class="{{styles.scoreBoard}}" aria-label="变异测试示例状态">
        <view class="{{styles.scoreItem}}">
          <text class="{{styles.scoreVal}}">
            <text wx:if="{{mutationResults}}">{{"75.0%"}}</text>
            <text wx:else>{{"NOT_RUN"}}</text>
          </text>
          <text class="{{styles.scoreLbl}}">变异杀伤率 (Kill Score)</text>
        </view>
        <view class="{{styles.scoreItem}}">
          <text class="{{styles.scoreVal}}">
            <text wx:if="{{mutationResults}}">{{"3 / 4"}}</text>
            <text wx:else>{{"—"}}</text>
          </text>
          <text class="{{styles.scoreLbl}}">已击杀变异体 (Killed Mutants)</text>
        </view>
        <view class="{{styles.scoreItem}}">
          <text class="{{styles.scoreVal}}">
            <text wx:if="{{mutationResults}}">{{"1"}}</text>
            <text wx:else>{{"—"}}</text>
          </text>
          <text class="{{styles.scoreLbl}}">存活变异体 (Survived)</text>
        </view>
      </view>
    </view>
    <view class="{{styles.panel}}">
      <view class="{{styles.panelHeader}}">
        <view>变异体示例 (Illustrative Mutants)</view>
        <text class="{{styles.metaTag}}">
          <text wx:if="{{mutationResults}}">{{"SAMPLE_ONLY"}}</text>
          <text wx:else>{{"NOT_RUN"}}</text>
        </text>
      </view>
      <view class="{{styles.mutantList}}">
        <view wx:if="{{!mutationResults}}" class="{{styles.emptyState}}">尚未生成示例；真实变异测试、编译与测试回放均为 NOT_RUN。</view>
        <text wx:else>{{mutationResults.map((m) => (
                <div key={m.id} className={styles.mutantCard}>
                  <div className={styles.mutantHeader}>
                    <span className={styles.mutantId}>{m.id}</span>
                    <span className={styles.mutantOp}>{m.operator}</span>
                    <span
                      className={`${styles.statusBadge} ${
                        m.status === "KILLED" ? styles.statusKilled : styles.statusSurvived
                      }`}
                    >
                      {m.status === "KILLED" ? "✓ KILLED" : "⚠ SURVIVED"}
                    </span>
                  </div>
                  <div className={styles.diffSnippet}>
                    <div className={styles.diffOrig}>- Line {m.line}: {m.original}</div>
                    <div className={styles.diffMut}>+ Line {m.line}: {m.mutated}</div>
                  </div>
                </div>
              ))}}</text>
      </view>
    </view>
  </view>
  <view wx:if="{{activeTab === "api-diff"}}" class="{{styles.fullPanel}}">
    <view class="{{styles.panelHeader}}">
      <view>API 契约差分静态示例</view>
      <text class="{{styles.dangerTag}}">SAMPLE_ONLY · NOT_RUN</text>
    </view>
    <view class="{{styles.diffList}}">
      <view wx:for="{{sampleDiffs}}" wx:for-item="d" wx:for-index="i" wx:key="d.id" key="{{i}}" class="{{styles.diffCard}}">
        <view class="{{styles.diffCardHeader}}">
          <text class="{{styles.endpointName}}">{{d.endpoint}}</text>
          <text class="{{`${styles.sevBadge} ${
                      d.severity === &quot;BREAKING&quot;
                        ? styles.sevBreaking
                        : d.severity === &quot;WARNING&quot;
                        ? styles.sevWarning
                        : styles.sevNonBreaking
                    }`}}">{{d.severity}}</text>
        </view>
        <view class="{{styles.diffCardBody}}">
          <text class="{{styles.catLabel}}">{{d.category}}</text>
          <text>:</text>
          <text>{{d.description}}</text>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{activeTab === "cas-cache"}}" class="{{styles.fullPanel}}">
    <view class="{{styles.panelHeader}}">
      <view>浏览器内缓存状态示例</view>
      <button type="button" class="{{styles.purgeBtn}}" bindtap="handlePurgeL1">
        <Icon name="refresh" size="{{14}}" />
        <text>清空页面示例 L1 状态</text>
      </button>
    </view>
    <view class="{{styles.metricsGrid}}">
      <view class="{{styles.metricCard}}">
        <text class="{{styles.mValue}}">{{cacheStats.l1Items}}</text>
        <text class="{{styles.mLabel}}">L1 Memory Items</text>
        <text class="{{styles.mDesc}}">高速内存 LRU 缓存条目数</text>
      </view>
      <view class="{{styles.metricCard}}">
        <text class="{{styles.mValue}}">{{cacheStats.totalEntries}}</text>
        <text class="{{styles.mLabel}}">Total Cached DAG Units</text>
        <text class="{{styles.mDesc}}">多级缓存持久化总单元</text>
      </view>
      <view class="{{styles.metricCard}}">
        <text class="{{styles.mValue}}">
          <text>{{(cacheStats.hitRatio * 100).toFixed(1)}}</text>
          <text>%</text>
        </text>
        <text class="{{styles.mLabel}}">Cache Hit Ratio</text>
        <text class="{{styles.mDesc}}">CAS 命中加速比</text>
      </view>
      <view class="{{styles.metricCard}}">
        <text class="{{styles.mValue}}">
          <text>{{cacheStats.bloomFilterBits}}</text>
          <text>bits</text>
        </text>
        <text class="{{styles.mLabel}}">Bloom Filter Active</text>
        <text class="{{styles.mDesc}}">布隆过滤器极速预检</text>
      </view>
    </view>
  </view>
</view>
