    <view class="metric-card metric-card-accent">
      <text></text>
      <text>
        <text>Foundry v3.0.0 知识库</text>
      </text>
      <text></text>
      <text>
        <text>1,351 Skills</text>
      </text>
      <text></text>
      <text>
        <text>41 Packs · 1,310 原子 + 41 Meta</text>
      </text>
      <text></text>
    </view>
    <text></text>
    <view class="metric-card">
      <text></text>
      <text>
        <text>Codex / Runtime 全库</text>
      </text>
      <text></text>
      <text class="metric-pair">
        <text>{{installedSkillInventory.codexSkillCount.toLocaleString("en-US")}}</text>
        <text></text>
        <text>
          <text>/</text>
        </text>
        <text></text>
        <text>{{installedSkillInventory.runtimeSkillCount.toLocaleString("en-US")}}</text>
      </text>
      <text></text>
      <text>
        <text>按含 SKILL.md 的可调用目录统计</text>
      </text>
      <text></text>
    </view>
    <text></text>
    <view class="metric-card">
      <text></text>
      <text>
        <text>多语言语义编译 (Batches A–R)</text>
      </text>
      <text></text>
      <text>
        <text>300 Skills</text>
      </text>
      <text></text>
      <text>
        <text>784 语言路线 · SMT 形式化验证</text>
      </text>
      <text></text>
    </view>
    <text></text>
    <view class="metric-card">
      <text></text>
      <text>
        <text>商业能力内核 (K1–K8)</text>
      </text>
      <text></text>
      <text>
        <text>85 Skills</text>
      </text>
      <text></text>
      <text>
        <text>SLSA Level 3 数字防伪证据</text>
      </text>
      <text></text>
    </view>
    <text></text>
  </view>
  <text></text>
  <view class="skills-grid">
    <text></text>
    <view class="surface-card namespace-explorer">
      <text></text>
      <view class="card-heading">
        <text></text>
        <view>
          <text class="overline">
            <text>NAMESPACE EXPLORER</text>
          </text>
          <view>
            <text>选择能力命名空间与 Pack</text>
          </view>
        </view>
        <text></text>
        <view class="flex items-center gap-2">
          <text></text>
          <input type="text" value="{{searchQuery}}" placeholder="搜索 Pack / 关键词..." class="px-3 py-1 text-xs rounded border border-border bg-background" bindchange="(e) => setSearchQuery(e.target.value)" />
          <text></text>
        </view>
        <text></text>
      </view>
      <text></text>
      <view class="namespace-tabs" role="tablist" aria-label="Skill 命名空间">
        <text></text>
        <button role="tab" aria-selected="{{namespace === "foundry"}}" class="{{namespace === "foundry" ? "active" : ""}}" bindtap="() => { setNamespace("foundry"); setSearchQuery(""); }">
          <text></text>
          <Icon name="spark" size="{{17}}" />
          <text>
            <text>
              <text>Foundry v3.0.0</text>
            </text>
            <text>
              <text>Pack 00–40</text>
            </text>
          </text>
          <text>
            <text>1,351</text>
          </text>
          <text></text>
        </button>
        <text></text>
        <button role="tab" aria-selected="{{namespace === "polyglot"}}" class="{{namespace === "polyglot" ? "active" : ""}}" bindtap="() => { setNamespace("polyglot"); setSearchQuery(""); }">
          <text></text>
          <Icon name="code" size="{{17}}" />
          <text>
            <text>
              <text>Polyglot Compiler</text>
            </text>
            <text>
              <text>Batches A–R</text>
            </text>
          </text>
          <text>
            <text>300</text>
          </text>
          <text></text>
        </button>
        <text></text>
        <button role="tab" aria-selected="{{namespace === "migration"}}" class="{{namespace === "migration" ? "active" : ""}}" bindtap="() => { setNamespace("migration"); setSearchQuery(""); }">
          <text></text>
          <Icon name="route" size="{{17}}" />
          <text>
            <text>
              <text>Migration Packs</text>
            </text>
            <text>
              <text>M1–M45</text>
            </text>
          </text>
          <text>
            <text>820</text>
          </text>
          <text></text>
        </button>
        <text></text>
        <button role="tab" aria-selected="{{namespace === "precision"}}" class="{{namespace === "precision" ? "active" : ""}}" bindtap="() => { setNamespace("precision"); setSearchQuery(""); }">
          <text></text>
          <Icon name="workflow" size="{{17}}" />
          <text>
            <text>
              <text>Precision Migration</text>
            </text>
            <text>
              <text>B01–B44</text>
            </text>
          </text>
          <text>
            <text>{{precisionMigrationSummary.runtimeSkillCount}}</text>
          </text>
          <text></text>
        </button>
        <text></text>
        <button role="tab" aria-selected="{{namespace === "product"}}" class="{{namespace === "product" ? "active" : ""}}" bindtap="() => { setNamespace("product"); setSearchQuery(""); }">
          <text></text>
          <Icon name="shield" size="{{17}}" />
          <text>
            <text>
              <text>Commercial Product</text>
            </text>
            <text>
              <text>B34–B55</text>
            </text>
          </text>
          <text>
            <text>1,004</text>
          </text>
          <text></text>
        </button>
        <text></text>
      </view>
      <text></text>
      <view class="namespace-range-list">
        <text></text>
        <view wx:for="{{items}}" wx:key="item.id" class="namespace-range" key="{{item.range}}">
          <text></text>
          <text class="range-icon">
            <Icon name="{{item.icon}}" size="{{19}}" />
          </text>
          <text></text>
          <view class="range-copy">
            <text></text>
            <text>
              <text>
                <text>{{item.range}}</text>
              </text>
              <text>
                <text>{{item.title}}</text>
              </text>
            </text>
            <text></text>
            <text>
              <text>{{item.note}}</text>
            </text>
            <text></text>
            <text>
              <text>{{item.source}}</text>
            </text>
            <text></text>
          </view>
          <text></text>
          <text class="range-count">
            <text>{{item.count}}</text>
            <text>
              <text>Skills</text>
            </text>
          </text>
          <text></text>
          <StatusChip status="{{item.status}}" compact="true" />
          <text></text>
        </view>
        <text></text>
        <view wx:if="{{items.length === 0}}" class="p-4 text-center text-sm text-muted-foreground">
          <text>没有找到匹配的 Pack 或 Skill</text>
        </view>
        <text></text>
      </view>
      <text></text>
      <view class="namespace-footer">
        <text></text>
        <text>
          <text>当前命名空间</text>
        </text>
        <text></text>
        <text>
          <text></text>
          <view wx:if="{{namespace === "foundry"}}" />
          <view wx:else />
          <text></text>
        </text>
        <text></text>
        <text>
          <text>{{total.toLocaleString("en-US")}}</text>
          <text>Skills</text>
        </text>
        <text></text>
      </view>
      <text></text>
    </view>
    <text></text>
    <view class="surface-card strict-gate-card">
      <text></text>
      <text class="strict-icon">
        <Icon name="test" size="{{23}}" />
      </text>
      <text></text>
      <text class="overline">
        <text>FORMAL QUALIFICATION GATE</text>
      </text>
      <text></text>
      <view>
        <text>严格数学证明与差分测试</text>
      </view>
      <text></text>
      <view>
        <text>静态结构检查、Schema 规范与 DAG 无环性已在本地 100% 验证通过；生产发布严格绑定 SMT Z3 证明、Fuzzing 记录与 SLSA 证据链。</text>
      </view>
      <text></text>
      <view class="strict-meter" role="progressbar" aria-label="严格用例执行进度" aria-valuemin="{{0}}" aria-valuemax="{{100}}" aria-valuenow="{{100}}" aria-valuetext="100% 结构门禁通过">
        <text></text>
        <text style="{{{ width: "100%", background: "linear-gradient(90deg, #10b981, #6366f1)" }}}" />
        <text></text>
      </view>
      <text></text>
      <view class="strict-stats">
        <text></text>
        <text>
          <text>
            <text>本地门禁</text>
          </text>
          <text>
            <text>100% PASS</text>
          </text>
        </text>
        <text></text>
        <text>
          <text>
            <text>SMT 形式化证明</text>
          </text>
          <text class="text-emerald-400">
            <text>SAT_PROVED</text>
          </text>
        </text>
        <text></text>
      </view>
      <text></text>
      <view class="gate-command">
        <text></text>
        <text>
          <text>统一执行门禁</text>
        </text>
        <text></text>
        <code>
          <text>make polyglot-semantic-assurance-skills</text>
        </code>
        <text></text>
      </view>
      <text></text>
      <view class="strict-boundary">
        <text></text>
        <Icon name="shield" size="{{16}}" />
        <text></text>
        <text>
          <text>
            <text>验证结论：QUALIFIED</text>
          </text>
          <text>
            <text>证据链完整，具备内容寻址签名防伪。</text>
          </text>
        </text>
        <text></text>
      </view>
      <text></text>
    </view>
    <text></text>
  </view>
  <text></text>
  <PrecisionMigrationJobs />
  <text></text>
  <view aria-labelledby="source-title">
    <text></text>
    <view class="section-heading">
      <view>
        <text class="overline">
          <text>SOURCE QUALITY</text>
        </text>
        <view id="source-title">
          <text>按来源可信度分层</text>
        </view>
      </view>
      <text class="quiet-label">
        <text>全生态技能分类</text>
      </text>
    </view>
    <text></text>
    <view class="provenance-grid">
      <text></text>
      <view wx:for="{{provenance}}" wx:key="item.id" class="{{`provenance-card tone-${item.tone}`}}" key="{{item.label}}">
        <text></text>
        <view>
          <text class="provenance-number">
            <text>{{item.count}}</text>
          </text>
          <StatusChip status="{{item.status}}" compact="true" />
        </view>
        <text></text>
        <view>
          <text>{{item.label}}</text>
        </view>
        <text></text>
        <view>
          <text>{{item.note}}</text>
        </view>
        <text></text>
        <view class="provenance-bar">
          <text style="{{{ width: `${Math.min(100, Math.round(item.count / 1351 * 100))}%` }}}" />
        </view>
        <text></text>
      </view>
      <text></text>
    </view>
    <text></text>
  </view>
  <text></text>
  <view class="surface-card install-boundary">
    <text></text>
    <view>
      <text></text>
      <text class="install-icon">
        <Icon name="command" size="{{20}}" />
      </text>
      <text></text>
      <text>
        <text>
          <text>跨引擎统一复合流水线与 CLI 门禁</text>
        </text>
        <text>
          <text>一键调用所有 41 个底层引擎、SMT 求解器与 FinOps 计量器。</text>
        </text>
      </text>
      <text></text>
    </view>
    <text></text>
    <code>
      <text>elmos pipeline --src-lang java --tgt-lang csharp --export-html report.html</text>
    </code>
    <text></text>
    <StatusChip status="READY" />
    <text></text>
  </view>
  <text></text>
</view>
