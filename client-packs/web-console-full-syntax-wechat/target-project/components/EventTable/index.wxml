<view class="{{styles.tableWrap}}">
  <view>
    <view>
      <view>
        <view>时间</view>
        <view>业务线</view>
        <view>动作</view>
        <view>目标</view>
        <view>结果</view>
        <view>耗时</view>
      </view>
    </view>
    <view>
      <view wx:for="{{events}}" wx:key="item.id" key="{{item.eventId}}">
        <view>{{formatTime(item.occurredAt)}}</view>
        <view>{{lineLabels[item.businessLine] ?? item.businessLine}}</view>
        <view>
          <code>{{item.action}}</code>
        </view>
        <view title="{{item.target}}">{{displayTarget(item.target)}}</view>
        <view>
          <text class="{{item.result === &quot;FAILURE&quot; ? styles.resultBad : styles.resultGood}}">{{item.result}}</text>
          <text wx:if="{{item.errorCode}}">{{item.errorCode}}</text>
        </view>
        <view>{{item.durationMs === null ? "—" : `${item.durationMs} ms`}}</view>
      </view>
    </view>
  </view>
</view>
