<view class="page-stack control-page">
  <view class="page-header control-header">
    <view>
      <text class="overline">ENTERPRISE COMMERCIAL CONTROL PLANE · v3.0.0</text>
      <view>商业化控制面与能力内核</view>
      <view>整合 8 大商业内核 (K1–K8)、工程翻新底座（41 个能力域、1,351 项功能）与 18 批次多语言编译器控制链。</view>
    </view>
    <view class="header-actions">
      <text class="environment-selector">
        <text />
        <text>环境：本地工程契约</text>
      </text>
      <button class="button button-secondary" disabled="{{refreshing}}" bindtap="refresh">
        <Icon name="refresh" size="{{16}}" class="{{refreshing ? &quot;spinning&quot; : undefined}}" />
        <text>刷新能力</text>
      </button>
    </view>
  </view>
  <view class="metric-grid metric-grid-four" aria-label="控制面摘要">
    <view class="metric-card">
      <text>商业能力内核</text>
      <text>8 (K1–K8)</text>
      <text>85 项商业扩展功能</text>
    </view>
    <view class="metric-card">
      <text>工程翻新底座</text>
      <text>1,351 项功能</text>
      <text>41 个能力域 (v3.0.0)</text>
    </view>
    <view class="metric-card">
      <text>多语言语义编译</text>
      <text>784 Routes</text>
      <text>18 个 Batches (A–R)</text>
    </view>
    <view class="metric-card">
      <text>决策上限</text>
      <text class="metric-word">Gate / Human</text>
      <text>不批准、不执行</text>
    </view>
  </view>
  <view class="source-notice" role="status">
    <Icon name="{{payload.source === &quot;LIVE_API&quot; ? &quot;check&quot; : &quot;clock&quot;}}" size="{{16}}" />
    <text>{{payload.note}}</text>
    <text class="source-freshness">
      <text>最近刷新</text>
      <text>{{fetchedAt}}</text>
    </text>
    <StatusChip status="{{payload.source}}" compact="true" />
  </view>
  <view class="surface-card" aria-labelledby="kernels-title">
    <view class="section-heading compact-heading">
      <view>
        <text class="overline">COMMERCIAL CAPABILITY KERNELS (K1–K8)</text>
        <view id="kernels-title">八大商业能力内核</view>
      </view>
      <StatusChip status="READY" compact="true" />
    </view>
    <view class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 mt-3">
      <view wx:for="{{commercialKernels}}" wx:for-item="k" wx:key="k.id" key="{{k.id}}" class="p-3 rounded-lg border border-border bg-card/60 flex flex-col justify-between">
        <view>
          <view class="flex items-center justify-between mb-1">
            <text class="text-sm font-semibold text-primary">
              <text>{{k.id}}</text>
              <text>·</text>
              <text>{{k.name}}</text>
            </text>
            <text class="text-xs px-2 py-0.5 rounded bg-primary/10 text-primary font-mono">
              <text>{{k.skills}}</text>
              <text>skills</text>
            </text>
          </view>
          <view class="text-xs text-muted-foreground">{{k.desc}}</view>
        </view>
        <view class="mt-2 flex items-center justify-between text-xs text-muted-foreground">
          <text>
            <text>状态:</text>
            <text>{{k.status}}</text>
          </text>
          <Icon name="check" size="{{13}}" class="text-emerald-500" />
        </view>
      </view>
    </view>
  </view>
  <view class="surface-card" aria-labelledby="foundry-title">
    <view class="section-heading compact-heading">
      <view>
        <text class="overline">工程翻新底座 v3.0.0</text>
        <view id="foundry-title">知识 · 能力 · 模型底座（41 个能力域）</view>
      </view>
      <text class="text-xs px-2 py-0.5 rounded bg-violet-500/10 text-violet-400 font-mono">合计 1,351 项功能</text>
    </view>
    <view class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 mt-3">
      <view wx:for="{{foundryHighlights}}" wx:for-item="f" wx:key="f.id" key="{{f.pack}}" class="p-3 rounded-lg border border-border bg-card/40">
        <view class="flex items-center justify-between mb-1">
          <text class="text-xs font-mono text-muted-foreground">
            <text>Pack</text>
            <text>{{f.pack}}</text>
          </text>
          <text class="text-xs text-emerald-400">
            <text>{{f.skills}}</text>
            <text>项功能</text>
          </text>
        </view>
        <text class="text-sm font-medium block">{{f.name}}</text>
        <view class="text-xs text-muted-foreground mt-1">{{f.desc}}</view>
      </view>
    </view>
  </view>
  <view class="trust-chain" aria-labelledby="trust-chain-title">
    <view class="section-heading compact-heading">
      <view>
        <text class="overline">TRUST CHAIN</text>
        <view id="trust-chain-title">从身份到执行回执</view>
      </view>
      <text class="quiet-label">点击任一阶段查看检查项</text>
    </view>
    <view class="trust-steps" role="tablist" aria-label="商业化可信链阶段">
      <view wx:for="{{payload.stages}}" wx:for-item="stage" wx:for-index="index" wx:key="stage.id" class="trust-step-wrap" key="{{stage.batch}}">
        <button id="{{`trust-tab-${stage.batch}`}}" class="{{`trust-step ${selected === stage.batch ? &quot;selected&quot; : &quot;&quot;}`}}" role="tab" aria-selected="{{selected === stage.batch}}" aria-controls="trust-stage-panel" tabIndex="{{selected === stage.batch ? 0 : -1}}" bindtap="onTap" bindkeydown="onKeydown">
          <text class="trust-step-icon">
            <Icon name="{{stage.icon}}" size="{{20}}" />
          </text>
          <text>
            <text>{{stage.batch}}</text>
            <text>{{stage.shortTitle}}</text>
          </text>
          <StatusChip status="{{stage.status}}" compact="true" />
        </button>
        <text wx:if="{{index < payload.stages.length - 1}}" class="step-connector">
          <Icon name="arrow" size="{{15}}" />
        </text>
      </view>
    </view>
  </view>
  <view class="control-grid">
    <view class="surface-card stage-detail" id="trust-stage-panel" role="tabpanel" aria-labelledby="{{`trust-tab-${selectedStage.batch}`}}" tabIndex="{{0}}">
      <view class="stage-detail-heading">
        <text class="large-stage-icon">
          <Icon name="{{selectedStage.icon}}" size="{{23}}" />
        </text>
        <view>
          <text class="overline">
            <text>{{selectedStage.batch}}</text>
            <text>·</text>
            <text>{{selectedStage.subtitle}}</text>
          </text>
          <view>{{selectedStage.title}}</view>
        </view>
        <StatusChip status="{{selectedStage.status}}" />
      </view>
      <view class="check-list">
        <view wx:for="{{selectedStage.checks}}" wx:for-item="check" wx:key="check.id" class="check-row" key="{{check.label}}">
          <text class="{{`check-dot dot-${check.status.toLowerCase().replaceAll(&quot;_&quot;, &quot;-&quot;)}`}}">
            <Icon name="{{check.status === &quot;READY&quot; || check.status === &quot;ENFORCED&quot; ? &quot;check&quot; : check.status === &quot;BLOCKED&quot; ? &quot;lock&quot; : &quot;clock&quot;}}" size="{{14}}" />
          </text>
          <view>
            <text>{{check.label}}</text>
            <text>{{check.detail}}</text>
          </view>
          <StatusChip status="{{check.status}}" compact="true" />
        </view>
      </view>
      <view class="restriction-block">
        <text class="overline">NON-NEGOTIABLE</text>
        <view wx:for="{{selectedStage.restrictions}}" wx:for-item="restriction" wx:key="restriction.id" key="{{restriction}}">
          <Icon name="shield" size="{{15}}" />
          <text>{{restriction}}</text>
        </view>
      </view>
    </view>
    <view class="surface-card decision-card">
      <view class="decision-card-top">
        <text class="decision-symbol">
          <Icon name="lock" size="{{20}}" />
        </text>
        <StatusChip status="BLOCKED" compact="true" />
      </view>
      <text class="overline">CURRENT DECISION</text>
      <view>拒绝执行副作用</view>
      <view>当前只有结构与本地契约证据。没有外部 Runner、独立 Judge 或 PEP 回执，因此不能展示为可发布。</view>
      <view class="decision-facts">
        <view>
          <view>控制面输出</view>
          <view>READY / BLOCKED</view>
        </view>
        <view>
          <view>外部执行</view>
          <view class="warning-text">NOT_RUN</view>
        </view>
        <view>
          <view>认证 / 批准</view>
          <view>FALSE</view>
        </view>
      </view>
      <view class="decision-footer">
        <Icon name="shield" size="{{16}}" />
        <text>缺少上下文、错误或不支持的义务都会安全降级为 DENY。</text>
      </view>
    </view>
  </view>
  <view class="surface-card queue-card">
    <view class="card-heading">
      <view>
        <text class="overline">ASSURANCE QUEUE</text>
        <view>证据审阅队列</view>
      </view>
      <text class="quiet-label">合成演示数据 · 不含客户内容</text>
    </view>
    <view class="queue-table" role="table" aria-label="证据审阅队列">
      <view class="queue-head" role="row">
        <text role="columnheader">事项</text>
        <text role="columnheader">对象</text>
        <text role="columnheader">阶段</text>
        <text role="columnheader">负责人</text>
        <text role="columnheader">状态</text>
      </view>
      <view wx:for="{{reviewQueue}}" wx:key="item.id" class="queue-row" role="row" key="{{item.id}}">
        <text role="cell" data-label="事项">
          <text>{{item.id}}</text>
          <text>{{item.title}}</text>
        </text>
        <text role="cell" data-label="对象">{{item.subject}}</text>
        <text role="cell" data-label="阶段">
          <text class="batch-pill">{{item.stage}}</text>
        </text>
        <text role="cell" data-label="负责人">{{item.owner}}</text>
        <text role="cell" data-label="状态">
          <StatusChip status="{{item.status}}" compact="true" />
        </text>
      </view>
    </view>
  </view>
  <view class="boundary-strip">
    <view>
      <text class="boundary-strip-icon">
        <Icon name="shield" size="{{21}}" />
      </text>
      <text>
        <text>职责分离保持生效</text>
        <text>Scheduler ≠ Runner · Producer ≠ Verifier · PDP ≠ PEP · 控制台 ≠ 认证机构</text>
      </text>
    </view>
    <navigator href="/api/capabilities/product" target="_blank" rel="noreferrer" class="text-link">
      <text>查看能力响应</text>
      <Icon name="external" size="{{14}}" />
    </navigator>
  </view>
</view>
