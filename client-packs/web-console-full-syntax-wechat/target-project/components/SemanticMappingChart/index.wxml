<view class="evidence-dimension" aria-labelledby="generation-semantic-title">
  <view class="evidence-section-heading">
    <text><view id="generation-semantic-title">语义映射</view> <text>映射覆盖与直接语义等价是两个独立维度</text></text>
    <text class="evidence-heading-statuses"><StatusMark status="{{semantic.mapping_status}}" compact="true" /> <StatusMark status="{{semantic.equivalence_status}}" compact="true" /></text>
  </view>
  <CoverageMeter label="需求主题映射" status="{{semantic.mapping_status}}" passed="{{semantic.mapped_subject_count}}" total="{{semantic.source_subject_count}}" />
  <view class="evidence-subject-grid">
    <view wx:for="{{semantic.subjects}}" wx:for-item="subject" wx:key="subject.id" key="{{subject.id}}">
      <view>
        <text>{{subject.label}}</text>
        <StatusMark status="{{subject.semantic_equivalence_status}}" compact="true" />
      </view>
      <CoverageMeter label="{{`${subject.label}映射`}}" status="{{subject.mapping_status}}" passed="{{subject.mapped_count}}" total="{{subject.source_count}}" />
    </view>
  </view>
  <view class="evidence-limitations" aria-label="语义证据限制">
    <view wx:for="{{semantic.limitations}}" wx:for-item="limitation" wx:key="limitation.id" key="{{limitation}}">{{limitation}}</view>
  </view>
</view>
