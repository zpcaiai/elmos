<view class="{{'controlCard'}}">
  <view>
    <text class="{{'kind'}}">{{proposal.remediationKind}}</text>
    <text>{{proposal.titleCode}}</text>
  </view>
  <code>{{proposal.recipeId}}</code>
  <view>{{proposal.status}} · 风险 {{proposal.riskLevel}}</view>
  <text aria-label="{{`前置摘要：${proposal.preconditionDigest}`}}">前置摘要： {{proposal.preconditionDigest.slice(0, 24)}} …</text>
  <view wx:if="{{proposal.status === 'PROPOSED'}}" class="{{'inlineActions'}}">
    <button class="primary-button" type="button" disabled="{{disabled}}" bindtap="onTap">批准</button>
    <button class="secondary-button" type="button" disabled="{{disabled}}" bindtap="onTap">拒绝</button>
  </view>
  <button wx:if="{{proposal.status === 'APPROVED'}}" class="primary-button" type="button" disabled="{{disabled}}" bindtap="onTap">生成摘要绑定 SCM 计划</button>
  <text wx:if="{{proposal.artifactDigest}}" aria-label="{{`产物摘要：${proposal.artifactDigest}`}}">
    <text>产物摘要：</text>
    <text>{{proposal.artifactDigest.slice(0, 24)}}</text>
    <text>…</text>
  </text>
</view>
