<view class="page-stack help-center">
  <view class="page-header">
    <view>
      <text class="overline">
        <text wx:if="{{english}}">{{"Guidance · Evidence boundaries"}}</text>
        <text wx:else>{{"操作指南 · 证据边界"}}</text>
      </text>
      <view>
        <text wx:if="{{english}}">{{"Help and readiness"}}</text>
        <text wx:else>{{"帮助与就绪状态"}}</text>
      </view>
      <view>
        <text wx:if="{{english}}">{{"Use the four business lines and controlled repository workflow safely. Local engineering evidence is shown separately from external execution."}}</text>
        <text wx:else>{{"安全使用四条业务线与受控仓库流程。本地工程证据与外部执行证据严格分开显示。"}}</text>
      </view>
    </view>
  </view>
  <view class="help-section" aria-labelledby="help-lines-title">
    <view class="section-heading">
      <view>
        <text class="overline">01</text>
        <view id="help-lines-title">
          <text wx:if="{{english}}">{{"Choose a business line"}}</text>
          <text wx:else>{{"选择业务线"}}</text>
        </view>
      </view>
    </view>
    <view class="help-line-grid">
      <view wx:for="{{businessLines}}" wx:for-item="line" wx:key="line.id" key="{{line.href}}">
        <view>
          <text wx:if="{{english}}">{{line.en}}</text>
          <text wx:else>{{line.zh}}</text>
        </view>
        <view>
          <text wx:if="{{english}}">{{line.enDescription}}</text>
          <text wx:else>{{line.zhDescription}}</text>
        </view>
        <navigator class="text-link" href="{{line.href}}">
          <text wx:if="{{english}}">{{"Open workspace"}}</text>
          <text wx:else>{{"打开工作区"}}</text>
          <text>→</text>
        </navigator>
      </view>
    </view>
  </view>
  <view class="help-section" aria-labelledby="help-delivery-title">
    <view class="section-heading">
      <view>
        <text class="overline">02</text>
        <view id="help-delivery-title">
          <text wx:if="{{english}}">{{"Controlled repository delivery"}}</text>
          <text wx:else>{{"受控仓库交付"}}</text>
        </view>
      </view>
      <navigator wx:if="{{hasAdminAccess}}" class="text-link" href="/repositories">
        <text wx:if="{{english}}">{{"Open repository workspace"}}</text>
        <text wx:else>{{"打开仓库工作区"}}</text>
      </navigator>
    </view>
    <view class="help-steps">
      <view wx:for="{{deliverySteps}}" wx:for-item="[number, zh, en]" wx:key="[number, zh, en].id" key="{{number}}">
        <text>{{number}}</text>
        <text>
          <text wx:if="{{english}}">{{en}}</text>
          <text wx:else>{{zh}}</text>
        </text>
      </view>
    </view>
    <view class="help-boundary">
      <text wx:if="{{english}}">{{"Merge, deployment, infrastructure apply, and production database migration are not automatic effects of this workflow."}}</text>
      <text wx:else>{{"合并、部署、基础设施应用和生产数据库迁移都不是该流程的自动副作用。"}}</text>
    </view>
  </view>
  <view class="help-section" aria-labelledby="help-readiness-title">
    <view class="section-heading">
      <view>
        <text class="overline">03</text>
        <view id="help-readiness-title">
          <text wx:if="{{english}}">{{"Evidence and remaining external gates"}}</text>
          <text wx:else>{{"证据与剩余外部门禁"}}</text>
        </view>
      </view>
    </view>
    <view class="help-table-wrap" tabIndex="{{0}}" role="region" aria-label="{{english ? &quot;Readiness evidence table&quot; : &quot;就绪证据表&quot;}}">
      <view class="help-readiness-table">
        <view>
          <view>
            <view scope="col">
              <text wx:if="{{english}}">{{"Area"}}</text>
              <text wx:else>{{"环节"}}</text>
            </view>
            <view scope="col">
              <text wx:if="{{english}}">{{"Current local evidence"}}</text>
              <text wx:else>{{"当前本地证据"}}</text>
            </view>
            <view scope="col">
              <text wx:if="{{english}}">{{"External boundary"}}</text>
              <text wx:else>{{"外部边界"}}</text>
            </view>
          </view>
        </view>
        <view>
          <view wx:for="{{readiness}}" wx:for-item="row" wx:key="row.id" key="{{row[0]}}">
            <view scope="row">
              <text wx:if="{{english}}">{{row[3]}}</text>
              <text wx:else>{{row[0]}}</text>
            </view>
            <view>
              <text wx:if="{{english}}">{{row[4]}}</text>
              <text wx:else>{{row[1]}}</text>
            </view>
            <view>
              <code>
                <text wx:if="{{english}}">{{row[5]}}</text>
                <text wx:else>{{row[2]}}</text>
              </code>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="help-section help-admin" aria-labelledby="help-admin-title">
    <view>
      <text class="overline">04</text>
      <view id="help-admin-title">
        <text wx:if="{{english}}">{{"Operate and diagnose"}}</text>
        <text wx:else>{{"运营与诊断"}}</text>
      </view>
      <view>
        <text wx:if="{{english}}">{{"The admin console exposes tenant-scoped users/session context, tasks, repositories, audit, alerts, usage, and sanitized configuration."}}</text>
        <text wx:else>{{"管理端按租户展示用户/会话上下文、任务、仓库、审计、告警、用量与脱敏配置。"}}</text>
      </view>
    </view>
    <navigator class="{{`button ${hasAdminAccess ? &quot;button-primary&quot; : &quot;admin-entry-button&quot;}`}}" href="{{hasAdminAccess ? &quot;/admin&quot; : &quot;/admin/login&quot;}}">
      <text wx:if="{{hasAdminAccess}}">{{english ? "Open operations admin" : "打开运营管理端"}}</text>
      <text wx:else>{{english ? "Administrator sign in" : "前往管理员登录"}}</text>
    </navigator>
  </view>
</view>
