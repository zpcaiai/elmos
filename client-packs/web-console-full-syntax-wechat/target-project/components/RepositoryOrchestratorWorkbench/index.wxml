<view class="{{styles.workbench}}" aria-labelledby="orchestrator-title">
  <view class="{{styles.hero}}">
    <view>
      <text class="{{styles.eyebrow}}">Repository task decomposition · cost router</text>
      <view id="orchestrator-title">仓库任务编排预检</view>
      <view>在创建任何运行之前，锁定模型选择、检查风险下限，并说明 DAG、成本与证据的真实就绪度。</view>
    </view>
    <view class="{{styles.boundary}}" aria-label="执行边界">
      <text>Planning only</text>
      <text>无 Provider 调用 · 无 Run · 无 SCM 副作用</text>
      <text>外部执行 NOT_RUN · 认证 NOT_CERTIFIED</text>
    </view>
  </view>
  <view wx:if="{{loading}}" class="{{styles.notice}}" role="status">正在从后端加载唯一模型目录…</view>
  <view wx:if="{{catalogError}}" class="{{styles.error}}" role="alert">{{catalogError}}</view>
  <block wx:if="{{catalog}}">
    <view class="{{styles.catalogSection}}" aria-labelledby="execution-model-heading">
      <view class="{{styles.sectionHeader}}">
        <view>
          <text class="{{styles.eyebrow}}">Immutable selection · {{catalog.catalogVersion}}</text>
          <view id="execution-model-heading">执行模型</view>
        </view>
        <text class="{{styles.status}}" data-tone="{{statusTone(catalog.status)}}">{{catalog.status}}</text>
      </view>
      <view wx:if="{{catalog.reasons.length > 0}}" class="{{styles.catalogReasons}}" role="status">
        <text>目录尚未就绪</text>
        <view>
          <view wx:for="{{catalog.reasons}}" wx:for-item="reason" wx:key="reason.id" key="{{reason}}">{{readableReason(reason)}}</view>
        </view>
      </view>
      <fieldset class="{{styles.modeFieldset}}">
        <legend class="sr-only">选择 Smart 或手动模型模式</legend>
        <text class="{{`${styles.modeCard} ${mode === &quot;smart&quot; ? styles.selected : &quot;&quot;}`}}">
          <input type="radio" name="execution-mode" value="smart" checked="{{mode === &quot;smart&quot;}}" bindchange="onChange" />
          <text class="{{styles.modeCopy}}">
            <text>
              <text>Smart — 每个任务的最佳价值</text>
              <text>推荐</text>
            </text>
            <text>后端在固定目录内按原子任务、风险下限与成本性能独立路由。</text>
          </text>
        </text>
        <text class="{{`${styles.modeCard} ${mode === &quot;manual&quot; ? styles.selected : &quot;&quot;}`}}">
          <input type="radio" name="execution-mode" value="manual" checked="{{mode === &quot;manual&quot;}}" bindchange="onChange" />
          <text class="{{styles.modeCopy}}">
            <text>
              <text>手动选择主实现模型</text>
              <text>严格锁定</text>
            </text>
            <text>默认不会静默切换；必需的独立验证仍可由系统策略指定。</text>
          </text>
        </text>
      </fieldset>
      <view class="{{styles.modelGrid}}" aria-label="后端模型目录">
        <text wx:for="{{catalog.models}}" wx:for-item="model" wx:key="model.id" class="{{`${styles.modelCard} ${selectedModel === model.alias ? styles.selectedModel : &quot;&quot;}`}}" key="{{model.alias}}" title="{{model.reasons.map(readableReason).join(&quot;; &quot;)}}">
          <text class="{{styles.modelTitle}}">
            <input type="radio" name="manual-model" value="{{model.alias}}" disabled="{{mode !== &quot;manual&quot; || !model.selectable}}" checked="{{selectedModel === model.alias}}" bindchange="onChange" />
            <text>
              <text>{{model.displayName}}</text>
              <code>{{model.alias}}</code>
            </text>
          </text>
          <text class="{{styles.modelMeta}}">
            <text>{{model.provider}}</text>
            <text>Cost {{model.relativeCostTier}} /5</text>
            <text>{{model.highestRoutingTier}}</text>
          </text>
          <text>{{model.roleHint.replaceAll("_", " ")}}</text>
          <text class="{{styles.unavailable}}">{{model.status}}</text>
          <view>
            <view wx:for="{{model.reasons.slice(0, 3)}}" wx:for-item="reason" wx:key="reason.id" key="{{reason}}">{{readableReason(reason)}}</view>
          </view>
        </text>
      </view>
      <view class="{{styles.policyRow}}">
        <text wx:if="{{mode === 'manual'}}" class="{{styles.toggle}}">
          <input type="checkbox" checked="{{fallbackEnabled}}" bindchange="onChange" />
          <text>模型失败时允许 allowlist 内智能 fallback</text>
        </text>
        <view wx:else class="{{styles.routerPolicy}}">
          <text>Smart 使用服务端 router policy</text>
          <text>调用方不能关闭强制风险门、预算硬停止或有界升级策略。</text>
        </view>
        <text>
          <text>优化策略</text>
          <view value="{{optimizationProfile}}" bindchange="onChange">
            <view wx:for="{{catalog.optimizationProfiles}}" wx:for-item="profile" wx:key="profile.id" key="{{profile}}">{{profile}}</view>
          </view>
        </text>
        <text>
          <text>验证策略</text>
          <view value="{{verificationPolicy}}" bindchange="onChange">
            <view wx:for="{{catalog.verificationPolicies}}" wx:for-item="policy" wx:key="policy.id" key="{{policy}}">{{policy}}</view>
          </view>
        </text>
      </view>
    </view>
    <view class="{{styles.riskSection}}" aria-labelledby="risk-heading">
      <view class="{{styles.sectionHeader}}">
        <view>
          <text class="{{styles.eyebrow}}">Risk gates before ranking</text>
          <view id="risk-heading">风险下限</view>
        </view>
        <text>高风险至少 L3；长周期任务至少 L4。</text>
      </view>
      <view class="{{styles.riskGrid}}">
        <text wx:for="{{([
                ['security', '安全'],
                ['dataMigration', '数据迁移'],
                ['concurrency', '并发'],
                ['publicContract', '公共契约'],
                ['blastRadius', '爆炸半径'],
              ] as const)}}" wx:for-item="[field, label]" wx:key="[field, label].id" key="{{field}}">
          <text>{{label}}</text>
          <view value="{{risk[field]}}" bindchange="onChange">
            <view wx:for="{{riskOptions}}" wx:for-item="level" wx:key="level.id" key="{{level}}">{{level}}</view>
          </view>
        </text>
        <text class="{{styles.longHorizon}}">
          <input type="checkbox" checked="{{risk.longHorizon}}" bindchange="onChange" />
          <text>长周期迁移 / long horizon</text>
        </text>
      </view>
      <view class="{{styles.preflightAction}}">
        <view>{{mode === "manual" && !selectedDescriptor?.selectable
                  ? "所有目录项当前均未配置，无法锁定手动模型；可使用 Smart 验证阻断原因。"
                  : "预检仅验证选择、风险与配置，不会创建任务或调用模型。"}}</view>
        <button type="button" disabled="{{!canPreflight}}" bindtap="onTap">{{submitting ? "预检中…" : "运行保守预检"}}</button>
      </view>
      <view wx:if="{{preflightError}}" class="{{styles.error}}" role="alert">{{preflightError}}</view>
    </view>
    <view wx:if="{{result}}" class="{{styles.resultSection}}" aria-labelledby="preflight-result-heading" aria-live="polite">
      <view class="{{styles.sectionHeader}}">
        <view>
          <text class="{{styles.eyebrow}}">Preflight decision</text>
          <view id="preflight-result-heading">预检结果</view>
        </view>
        <text class="{{styles.status}}" data-tone="{{statusTone(result.status)}}">{{result.status}}</text>
      </view>
      <view class="{{styles.readinessGrid}}">
        <view>
          <text>模型配置</text>
          <text>{{result.configurationStatus}}</text>
          <text>风险下限 {{result.minimumRoutingTier}} · resolved {{result.resolvedModel ?? "none"}}</text>
        </view>
        <view>
          <text>任务 DAG</text>
          <text>{{result.dag.status}}</text>
          <text>{{result.dag.tasks.length}} tasks · {{result.dag.waves.length}} waves</text>
        </view>
        <view>
          <text>成本估算</text>
          <text>{{result.cost.status}}</text>
          <text>{{result.cost.estimatedRunCost === null ? "未产生估算" : `${result.cost.currency} ${result.cost.estimatedRunCost}`}}</text>
        </view>
        <view>
          <text>认证</text>
          <text>{{result.evidence.certification}}</text>
          <text>external {{result.evidence.externalVerification}}</text>
        </view>
      </view>
      <view class="{{styles.resultColumns}}">
        <view>
          <view>阻断与配置原因</view>
          <view>
            <view wx:for="{{result.reasons}}" wx:for-item="reason" wx:key="reason.id" key="{{reason}}">{{readableReason(reason)}}</view>
          </view>
          <view>{{result.cost.reason}}</view>
        </view>
        <view>
          <view>DAG 就绪度</view>
          <view>
            <view wx:for="{{result.dag.requiredStages}}" wx:for-item="stage" wx:key="stage.id" key="{{stage}}">{{readableReason(stage)}}</view>
          </view>
          <view>{{result.dag.reason}}</view>
        </view>
        <view>
          <view>不可变选择与审计解释</view>
          <code wx:if="{{result.selection}}" class="{{styles.digest}}">{{result.selection.digest}}</code>
          <view>
            <view wx:for="{{result.auditExplanation}}" wx:key="item.id" key="{{item}}">{{item}}</view>
          </view>
        </view>
      </view>
      <view class="{{styles.evidenceStrip}}" aria-label="副作用与证据状态">
        <text wx:for="{{Object.entries(result.evidence)}}" wx:for-item="[key, value]" wx:key="[key, value].id" key="{{key}}">
          <text>{{key}}</text>
          <text>{{value}}</text>
        </text>
      </view>
    </view>
    <view class="mt-8 p-5 rounded-xl border border-border bg-card/60 shadow-lg" aria-labelledby="pipeline-sandbox-heading">
      <view class="flex items-center justify-between mb-4">
        <view>
          <text class="text-xs uppercase tracking-wider text-primary font-mono font-semibold">INTERACTIVE PIPELINE SANDBOX</text>
          <view id="pipeline-sandbox-heading" class="text-xl font-bold text-foreground">跨引擎全自动现代化流水线沙箱</view>
        </view>
        <text class="px-2 py-0.5 text-xs rounded bg-emerald-500/10 text-emerald-400 font-mono border border-emerald-500/30">ELMOS v3.0.0</text>
      </view>
      <view class="text-xs text-muted-foreground mb-4">
        <text>在 Web 控制台中实时体验从</text>
        <text>源码摄取</text>
        <text>、</text>
        <text>多语言 AST 语义降级</text>
        <text>、</text>
        <text>SMT 形式化证明</text>
        <text>、</text>
        <text>差分 Fuzzing</text>
        <text>到</text>
        <text>FinOps 计量</text>
        <text>和</text>
        <text>SLSA Level 3 数字回执</text>
        <text>的全生命周期流转。</text>
      </view>
      <view class="grid grid-cols-1 md:grid-cols-6 gap-2 mb-4">
        <view wx:for="{{[
                { step: '1', title: '源码摄取与解析', status: 'INGESTED', desc: 'AST 抽象树提取与依赖图' },
                { step: '2', title: 'Polyglot 语义转换', status: 'TRANSFORMED', desc: '784 路线精确语义重写' },
                { step: '3', title: 'SMT 形式化验证', status: 'SAT_PROVED', desc: 'Z3/CVC5 不可判定项证明' },
                { step: '4', title: '差分 Fuzzing', status: 'FUZZ_PASSED', desc: '双向行为与边界测试' },
                { step: '5', title: 'FinOps 计量', status: 'METERED', desc: 'Token与实时成本核算' },
                { step: '6', title: 'SLSA 证据回执', status: 'CERTIFIED', desc: 'Merkle 防篡改数字防伪' },
              ]}}" wx:for-item="s" wx:key="s.id" key="{{s.step}}" class="p-3 rounded-lg border border-border/80 bg-background/50 flex flex-col justify-between">
          <view>
            <view class="flex items-center justify-between mb-1">
              <text class="w-5 h-5 rounded-full bg-primary/20 text-primary text-xs flex items-center justify-center font-bold">{{s.step}}</text>
              <text class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 font-mono font-semibold">{{s.status}}</text>
            </view>
            <text class="text-xs text-foreground block">{{s.title}}</text>
          </view>
          <text class="text-[11px] text-muted-foreground mt-1">{{s.desc}}</text>
        </view>
      </view>
      <view class="p-4 rounded-lg bg-background border border-border flex flex-col gap-2">
        <view class="flex items-center justify-between text-xs text-muted-foreground font-mono">
          <text>CLI 一键触发命令：</text>
          <text class="text-emerald-400">Action Cache: ENABLED (SHA-256 CAS)</text>
        </view>
        <code class="text-xs text-primary font-mono bg-muted/30 p-2 rounded block overflow-x-auto">elmos pipeline --src-lang java --tgt-lang csharp --code &quot;public class AccountLedger &amp;#123; public double balance; &amp;#125;&quot; --export-html report.html</code>
      </view>
    </view>
  </block>
</view>
