<view class="page-stack">
  <view class="{{'hero'}}">
    <view>
      <text class="overline">OPERATIONS · GOVERNED AUTOMATION</text>
      <view>生产运营管理端</view>
      <view>统一查看业务操作、SLO、告警、事件和修复提案。自动化负责检测、诊断与生成摘要绑定的修复计划；审批、源码变更、测试、SCM 与部署保持权限分离。</view>
    </view>
    <view class="{{'heroStatus'}}">
      <text class="{{'statusDot'}}" />
      <view>
        <text>{{state === "READY" ? `已连接 · ${view?.role}` : "数据链路已锁定"}}</text>
        <text>{{periodLabel}}</text>
      </view>
    </view>
  </view>
  <form class="{{'accessBar'}}" data-telemetry-ignore="true" bindsubmit="load">
    <view class="{{'tokenField'}}">
      <text>管理员身份</text>
      <text>{{account.principal?.email ?? "未登录"}}</text>
      <text>仅接受已验证的管理员企业账户会话</text>
    </view>
    <text><text>时间范围</text> <view value="{{hours}}" aria-label="时间范围" bindchange="onChange">
  <view value="1">最近 1 小时</view>
  <view value="24">最近 24 小时</view>
  <view value="168">最近 7 天</view>
  <view value="720">最近 30 天</view>
</view></text>
    <text><text>业务线</text> <view value="{{businessLine}}" aria-label="业务线" bindchange="onChange">
  <view wx:for="{{lines}}" wx:for-item="[value, label]" wx:key="[value, label].id" key="{{value}}" value="{{value}}">{{label}}</view>
</view></text>
    <text><text>结果</text> <view value="{{result}}" aria-label="操作结果" bindchange="onChange">
  <view value="ALL">全部结果</view>
  <view value="SUCCESS">成功</view>
  <view value="FAILURE">失败</view>
  <view value="CANCELLED">已取消</view>
</view></text>
    <button class="primary-button" type="submit" disabled="{{state === &quot;LOADING&quot; || account.status === &quot;loading&quot;}}">
      <Icon name="{{state === &quot;LOADING&quot; ? &quot;refresh&quot; : &quot;search&quot;}}" size="{{17}}" />
      <text>{{state === "LOADING" ? "读取中…" : "读取数据"}}</text>
    </button>
    <button wx:if="{{state === 'READY'}}" class="secondary-button" type="button" bindtap="lock">锁定</button>
  </form>
  <view wx:if="{{state === 'READY' && adminSection === 'AUDIT'}}" class="{{'panel'}}" aria-label="审计导出">
    <view>
      <Icon name="file" size="{{18}}" />
      <text>审计导出</text>
    </view>
    <view>导出所选窗口内的原始审计与遥测记录（CSV）。按游标逐页读取， 结果与上方筛选的业务线、结果保持一致；时间窗口在此单独选择。</view>
    <view class="{{'inlineActions'}}">
      <text><text>窗口</text> <view value="{{exportDays}}" aria-label="导出时间窗口" disabled="{{exportBusy}}" bindchange="onChange">
  <view value="1">最近 1 天</view>
  <view value="7">最近 7 天</view>
  <view value="30">最近 30 天</view>
  <view value="90">最近 90 天</view>
  <view value="366">最近 366 天</view>
</view></text>
      <button class="secondary-button" type="button" disabled="{{exportBusy}}" bindtap="downloadAuditExport">
        <Icon name="{{exportBusy ? &quot;refresh&quot; : &quot;box&quot;}}" size="{{17}}" />
        <text>{{exportBusy ? "导出中…" : "导出 CSV"}}</text>
      </button>
    </view>
    <view wx:if="{{exportError}}" class="{{'bad'}}" role="alert">{{exportError}}</view>
    <view wx:if="{{exportNotice}}" class="{{'good'}}" role="status">{{exportNotice}}</view>
  </view>
  <view wx:if="{{state === 'READY' && adminSection === 'AUDIT'}}" class="{{'panel'}}" aria-label="运行历史回放">
    <view>
      <Icon name="clock" size="{{18}}" />
      <text>运行历史回放</text>
    </view>
    <view>按迁移运行 ID 重建一次运行的完整过程：每一次步骤尝试、沿途产出的证据、 以及点名这次运行的审计记录。只读重建，不会改动被回放的记录。</view>
    <view class="{{'inlineActions'}}">
      <text><text>运行 ID</text> <input value="{{replayRunId}}" aria-label="迁移运行 ID" placeholder="migration-run-…" disabled="{{replayBusy}}" bindchange="onChange" /></text>
      <button class="secondary-button" type="button" disabled="{{replayBusy}}" bindtap="loadReplay">
        <Icon name="{{replayBusy ? &quot;refresh&quot; : &quot;search&quot;}}" size="{{17}}" />
        <text>{{replayBusy ? "读取中…" : "回放"}}</text>
      </button>
    </view>
    <view wx:if="{{replayError}}" class="{{'bad'}}" role="alert">{{replayError}}</view>
    <view wx:if="{{replay}}" class="{{'evidence'}}">
      <view>
        <text>{{replay.migrationRunId}}</text>
        <text>· 状态</text>
        <text>{{replay.state}}</text>
        <text>· 计划</text>
        <text>{{replay.migrationPlanId}}</text>
        <text>v</text>
        <text>{{replay.planVersion}}</text>
        <text>· 快照</text>
        <text>{{replay.snapshotId}}</text>
      </view>
      <view>步骤尝试（ {{replay.steps.rows.length}} ）</view>
      <view wx:if="{{replay.steps.truncated}}" class="{{'bad'}}" role="alert">步骤过多，仅显示前 {{replay.steps.rows.length}} 条——这份回放不完整，不能作为完整凭据。</view>
      <view class="{{'tableWrap'}}">
        <view>
          <view>
            <view>
              <view>步骤</view>
              <view>第几次</view>
              <view>状态</view>
              <view>开始</view>
              <view>结束</view>
              <view>失败码</view>
            </view>
          </view>
          <view>
            <view wx:for="{{replay.steps.rows}}" wx:for-item="attempt" wx:key="attempt.id" key="{{attempt.stepRunId}}">
              <view>{{attempt.stepId}}</view>
              <view>{{attempt.attempt}}</view>
              <view class="{{attempt.failureCode ? 'resultBad' : 'resultGood'}}">{{attempt.state}}</view>
              <view>{{attempt.startedAt ?? "未开始"}}</view>
              <view>{{attempt.finishedAt ?? "—"}}</view>
              <view>{{attempt.failureCode ?? "—"}}</view>
            </view>
          </view>
        </view>
      </view>
      <view>证据（ {{replay.evidence.rows.length}} ）</view>
      <view wx:if="{{replay.evidence.truncated}}" class="{{'bad'}}" role="alert">证据过多，仅显示前 {{replay.evidence.rows.length}} 条——这份回放不完整。</view>
      <view wx:if="{{replay.evidence.rows.length === 0}}" class="{{'empty'}}">这次运行没有留下证据记录。</view>
      <view wx:else class="{{'lineList'}}">
        <view wx:for="{{replay.evidence.rows}}" wx:key="item.id" key="{{item.evidenceId}}">
          <text class="{{'kind'}}">{{item.evidenceType}}</text>
          <text>{{item.producerName}}</text>
          <text>{{item.producerVersion}}</text>
          <text>·</text>
          <text>{{item.status}}</text>
          <text>·</text>
          <text>{{item.summary}}</text>
        </view>
      </view>
      <view>审计（ {{replay.audit.rows.length}} ）</view>
      <view wx:if="{{replay.audit.truncated}}" class="{{'bad'}}" role="alert">审计记录过多，仅显示前 {{replay.audit.rows.length}} 条——这份回放不完整。</view>
      <view wx:if="{{replay.audit.rows.length === 0}}" class="{{'empty'}}">没有点名这次运行的审计记录。审计行通过 resource_id 关联，未设置该字段的行不会出现在这里。</view>
      <view wx:else class="{{'lineList'}}">
        <view wx:for="{{replay.audit.rows}}" wx:for-item="entry" wx:key="entry.id" key="{{entry.auditId}}">
          <text class="{{'kind'}}">{{entry.action}}</text>
          <text>{{entry.actorType}}</text>
          <text>{{entry.actorId}}</text>
          <text>·</text>
          <text>{{entry.policyDecision}}</text>
          <text>·</text>
          <text>{{entry.result}}</text>
          <text>{{entry.occurredAt ? ` · ${entry.occurredAt}` : ""}}</text>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{state === 'LOCKED'}}" class="{{'locked'}}">
    <text><Icon name="lock" size="{{24}}" /></text>
    <view>
      <text>管理数据默认锁定</text>
      <view>仅已验证的指定管理员邮箱可建立管理会话；角色由服务端决定，页面不能自行提升。</view>
    </view>
  </view>
  <view wx:if="{{error}}" class="{{'error'}}" role="alert">
    <Icon name="shield" size="{{21}}" />
    <view>
      <text>管理操作未完成</text>
      <view>{{error}}</view>
    </view>
  </view>
  <view wx:if="{{notice}}" class="{{'notice'}}" role="status">{{notice}}</view>
  <view wx:if="{{state === 'READY'}}" class="{{'sectionNav'}}" aria-label="管理端功能">
    <button wx:for="{{adminSections}}" wx:for-item="[value, label]" wx:key="[value, label].id" key="{{value}}" type="button" aria-current="{{adminSection === value ? &quot;page&quot; : undefined}}" class="{{adminSection === value ? 'activeSection' : &quot;&quot;}}" bindtap="onTap">{{label}}</button>
  </view>
  <block wx:if="{{summary && view}}">
    <view wx:if="{{adminSection === 'USERS'}}" class="{{'panel'}}">
      <view>
        <view>
          <text class="overline">IDENTITY &amp; TENANCY</text>
          <view>用户、角色与租户成员资格</view>
        </view>
        <text>来源：当前已验证 OIDC 会话</text>
      </view>
      <view class="{{'identityGrid'}}">
        <view>
          <text>当前用户</text>
          <text>{{account.principal?.displayName ?? view.actorId}}</text>
          <text>{{account.principal?.email ?? view.actorId}}</text>
        </view>
        <view>
          <text>当前租户</text>
          <text>{{account.principal?.organizationId ?? "受控本地租户"}}</text>
          <text>管理角色 {{view.role}}</text>
        </view>
        <view>
          <text>权限</text>
          <text>{{account.principal?.permissions.length ?? 0}}</text>
          <text>{{account.principal?.permissions.join(" · ") || "需要已验证的管理员企业会话"}}</text>
        </view>
      </view>
      <view class="{{'membershipList'}}">
        <view wx:for="{{(account.principal?.memberships ?? [])}}" wx:for-item="membership" wx:key="membership.id" key="{{membership.organizationId}}">
          <view>
            <text>{{membership.organizationId}}</text>
            <text>{{membership.roles.join(" · ")}}</text>
          </view>
          <text>{{membership.permissions.length}} 项权限</text>
        </view>
        <Empty wx:if="{{(account.principal?.memberships.length ?? 0) === 0}}" label="外部 IdP 全量用户目录同步尚未执行；不会据当前会话推断其他用户。" />
      </view>
      <view wx:if="{{(account.principal?.memberships.length ?? 0) > 0}}" class="{{'boundaryNote'}}">当前列表仅来自已验证会话的成员资格；外部 IdP 全量用户目录同步尚未执行，不会据当前会话推断其他用户。</view>
      <AccountOrganizationStudio wx:if="{{account.status === 'authenticated'}}" embedded="true" />
      <view wx:if="{{account.status !== 'authenticated'}}" class="{{'boundaryNote'}}">这些动作必须使用已验证的指定管理员企业会话。</view>
    </view>
    <block wx:if="{{adminSection === 'TASKS'}}">
      <view class="{{'panel'}}" aria-label="持久作业队列">
        <view>
          <view>
            <text class="overline">DURABLE JOB CONTROL</text>
            <view>真实持久作业队列</view>
          </view>
          <text>租户隔离 · 最多 100 条 · 取消需 OPERATOR</text>
        </view>
        <view class="{{'inlineActions'}}">
          <text><text>作业类型</text> <view aria-label="持久作业类型" value="{{operationsJobBusinessLine}}" disabled="{{operationsJobsBusy || Boolean(operationsJobCancelBusy)}}" bindchange="onChange">
  <view wx:for="{{jobBusinessLines}}" wx:for-item="[value, label]" wx:key="[value, label].id" key="{{value}}" value="{{value}}">{{label}}</view>
</view></text>
          <text><text>状态</text> <view aria-label="持久作业状态" value="{{operationsJobStatus}}" disabled="{{operationsJobsBusy || Boolean(operationsJobCancelBusy)}}" bindchange="onChange">
  <view wx:for="{{jobStatuses}}" wx:for-item="[value, label]" wx:key="[value, label].id" key="{{value}}" value="{{value}}">{{label}}</view>
</view></text>
          <button class="secondary-button" type="button" disabled="{{operationsJobsBusy || Boolean(operationsJobCancelBusy)}}" bindtap="onTap">
            <Icon name="{{operationsJobsBusy ? &quot;refresh&quot; : &quot;search&quot;}}" size="{{17}}" />
            <text>{{operationsJobsBusy ? "读取中…" : "读取作业"}}</text>
          </button>
        </view>
        <view wx:if="{{operationsJobsError}}" class="{{'bad'}}" role="alert">{{operationsJobsError}}</view>
        <view wx:if="{{operationsJobsNotice}}" class="{{'good'}}" role="status">{{operationsJobsNotice}}</view>
        <Empty wx:if="{{!operationsJobsLoaded}}" label="选择类型和状态后读取真实作业；页面不使用审计事件推断队列状态。" />
        <block wx:else>
          <Empty wx:if="{{operationsJobs.length === 0}}" label="当前租户没有匹配的持久作业" />
          <view wx:else class="{{'tableWrap'}}">
            <view>
              <view>
                <view>
                  <view>作业 / 类型</view>
                  <view>状态 / 阶段</view>
                  <view>进度</view>
                  <view>尝试</view>
                  <view>时间</view>
                  <view>取消</view>
                </view>
              </view>
              <view>
                <view wx:for="{{operationsJobs}}" wx:for-item="job" wx:key="job.id" key="{{job.jobId}}">
                  <view title="{{job.jobId}}">
                    <code>{{displayTarget(job.jobId)}}</code>
                    <text>{{job.businessLine}} · {{job.jobKind}}</text>
                  </view>
                  <view>
                    <text class="{{failed ? 'resultBad' : 'resultGood'}}">{{job.status}}</text>
                    <text>{{job.stage}} · {{job.resultStatus}}</text>
                    <text wx:if="{{job.failureCode}}">{{job.failureCode}}</text>
                  </view>
                  <view>{{job.progress.toFixed(0)}} %</view>
                  <view>
                    <text>{{job.attempt}}</text>
                    <text>/</text>
                    <text>{{job.maxAttempts}}</text>
                    <text>state v {{job.stateVersion}}</text>
                  </view>
                  <view>
                    <text>{{formatTime(job.createdAt)}}</text>
                    <text class="{{'neutralDetail'}}">{{job.finishedAt
                                  ? `结束 ${formatTime(job.finishedAt)}`
                                  : job.startedAt ? `开始 ${formatTime(job.startedAt)}` : "尚未开始"}}</text>
                  </view>
                  <view>
                    <button class="secondary-button" type="button" disabled="{{!can(&quot;OPERATOR&quot;)
                                    || terminal
                                    || job.cancelRequested
                                    || Boolean(operationsJobCancelBusy)}}" bindtap="onTap">{{cancelling
                                    ? "提交中…"
                                    : job.cancelRequested ? "已请求取消" : terminal ? "已终止" : "请求取消"}}</button>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>
        <view class="{{'boundaryNote'}}">取消只写入持久的 cancel-requested 信号，不跳过 Runner 租约、重试门禁或独立验证； 结果未知时不会自动重试写操作。</view>
      </view>
      <view class="{{'panel'}}" aria-label="Runner Fleet">
        <view>
          <view>
            <text class="overline">RUNNER FLEET</text>
            <view>Runner 节点与证明状态</view>
          </view>
          <text>租户 RLS · secret-free 投影 · 最多 100 个节点</text>
        </view>
        <view class="{{'inlineActions'}}">
          <text><text>Fleet 状态</text> <view aria-label="Runner Fleet 状态" value="{{runnerFleetStatus}}" disabled="{{runnerFleetBusy || Boolean(runnerFleetActionBusy)}}" bindchange="onChange">
  <view wx:for="{{runnerFleetStatuses}}" wx:for-item="[value, label]" wx:key="[value, label].id" key="{{value}}" value="{{value}}">{{label}}</view>
</view></text>
          <button class="secondary-button" type="button" disabled="{{runnerFleetBusy || Boolean(runnerFleetActionBusy)}}" bindtap="onTap">
            <Icon name="{{runnerFleetBusy ? &quot;refresh&quot; : &quot;search&quot;}}" size="{{17}}" />
            <text>{{runnerFleetBusy ? "读取中…" : "读取 Fleet"}}</text>
          </button>
        </view>
        <view wx:if="{{runnerFleetError}}" class="{{'bad'}}" role="alert">{{runnerFleetError}}</view>
        <view wx:if="{{runnerFleetNotice}}" class="{{'good'}}" role="status">{{runnerFleetNotice}}</view>
        <Empty wx:if="{{!runnerFleetLoaded}}" label="读取真实 Fleet 投影；凭据、token hash、原始 attestation 和验证者身份均不会返回浏览器。" />
        <block wx:else>
          <Empty wx:if="{{runnerFleet.length === 0}}" label="当前租户没有匹配的 Runner 节点" />
          <view wx:else class="{{'tableWrap'}}">
            <view>
              <view>
                <view>
                  <view>节点 / 池</view>
                  <view>状态 / 版本</view>
                  <view>能力 / 并发</view>
                  <view>Attestation</view>
                  <view>心跳 / 更新</view>
                  <view>操作</view>
                </view>
              </view>
              <view>
                <view wx:for="{{runnerFleet}}" wx:for-item="node" wx:key="node.id" key="{{node.runnerNodeId}}">
                  <view title="{{node.runnerNodeId}}">
                    <code>{{displayTarget(node.runnerNodeId)}}</code>
                    <text>{{node.runnerPoolId}}</text>
                  </view>
                  <view>
                    <text class="{{badStatus
                                  ? 'resultBad' : ready ? 'resultGood' : 'kind'}}">{{node.fleetStatus}}</text>
                    <text>agent {{node.agentVersion}} · {{node.imageAllowlistVersion}}</text>
                  </view>
                  <view>
                    <text>{{node.capabilities.join(" · ") || "无已报能力"}}</text>
                    <text>最大并发 {{node.maxConcurrency}}</text>
                  </view>
                  <view>
                    <text class="{{node.attestationVerified
                                  ? 'resultGood' : 'resultBad'}}">{{node.attestationVerified ? "VERIFIED" : "NOT_VERIFIED"}}</text>
                    <text>{{node.attestationVerifiedAt
                                  ? formatTime(node.attestationVerifiedAt) : "尚无独立验证"}}</text>
                  </view>
                  <view>
                    <text>{{node.lastHeartbeatAt ? formatTime(node.lastHeartbeatAt) : "无心跳"}}</text>
                    <text class="{{'neutralDetail'}}">更新 {{formatTime(node.updatedAt)}}</text>
                  </view>
                  <view>
                    <view class="{{'inlineActions'}}">
                      <button wx:if="{{node.fleetStatus === 'REGISTERED'}}" class="secondary-button" type="button" disabled="{{account.status !== &quot;authenticated&quot;
                                        || !can(&quot;APPROVER&quot;)
                                        || Boolean(runnerFleetActionBusy)}}" bindtap="onTap">{{runnerFleetActionBusy === `${node.runnerNodeId}:attestation/verify`
                                        ? "验证中…" : "确认独立证明"}}</button>
                      <button wx:if="{{(node.fleetStatus === 'READY' || node.fleetStatus === 'DRAINING')}}" class="secondary-button" type="button" disabled="{{account.status !== &quot;authenticated&quot;
                                        || !can(&quot;OPERATOR&quot;)
                                        || node.fleetStatus === &quot;DRAINING&quot;
                                        || Boolean(runnerFleetActionBusy)}}" bindtap="onTap">{{node.fleetStatus === "DRAINING"
                                        ? "正在排空"
                                        : runnerFleetActionBusy === `${node.runnerNodeId}:drain`
                                          ? "提交中…" : "排空节点"}}</button>
                      <text wx:if="{{!actionBusy
                                    && !['REGISTERED', 'READY', 'DRAINING'].includes(node.fleetStatus)}}">当前状态无可用在线操作</text>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>
        <view class="{{'boundaryNote'}}">列表仅允许已验证的指定管理员账户读取；独立证明确认与排空是生产操作， 只接受企业 OIDC 会话的 APPROVER / OPERATOR，结果未知时不自动重试。</view>
      </view>
      <view class="{{'panel'}}" aria-label="作业审计信号">
        <view>
          <view>
            <text class="overline">JOB AUDIT SIGNALS</text>
            <view>作业相关审计事件</view>
          </view>
          <text>仅作证据辅助，不代替队列状态</text>
        </view>
        <EventTable events="{{taskEvents}}" empty="所选窗口内没有作业审计事件" />
      </view>
    </block>
    <view wx:if="{{adminSection === 'REPOSITORIES'}}" class="{{'panel'}}">
      <view>
        <view>
          <text class="overline">REPOSITORY GOVERNANCE</text>
          <view>仓库工作区与交付操作</view>
        </view>
        <text>拉取、变更、Commit、Push、PR</text>
      </view>
      <EventTable events="{{repositoryEvents}}" empty="所选窗口内没有仓库操作" />
      <view class="{{'inlineActions'}}">
        <navigator class="secondary-button" href="/repositories">打开仓库工作区</navigator>
      </view>
    </view>
    <view wx:if="{{adminSection === 'FINANCE'}}" class="{{'panel'}}" aria-label="财务对账">
      <view>
        <view>
          <text class="overline">BILLING RECONCILIATION</text>
          <view>财务对账案件</view>
        </view>
        <text>租户： {{account.principal?.organizationId ?? "企业 OIDC 会话必需"}}</text>
      </view>
      <view>列表来自 commercial-api 的租户隔离对账账本。读取需要 VIEWER，RESOLVED / REJECTED 结案需要 APPROVER、稳定处理依据和客户端 Idempotency-Key。</view>
      <view class="{{'inlineActions'}}">
        <text><text>案件状态</text> <view aria-label="财务对账状态" value="{{financialStatus}}" disabled="{{financialLoadBusy || Boolean(financialBusyAction)}}" bindchange="onChange">
  <view value="OPEN">待处理 OPEN</view>
  <view value="RESOLVED">已解决 RESOLVED</view>
  <view value="REJECTED">已驳回 REJECTED</view>
</view></text>
        <button class="secondary-button" type="button" disabled="{{financialLoadBusy || Boolean(financialBusyAction)}}" bindtap="onTap">
          <Icon name="{{financialLoadBusy ? &quot;refresh&quot; : &quot;search&quot;}}" size="{{17}}" />
          <text>{{financialLoadBusy ? "读取中…" : "读取对账"}}</text>
        </button>
      </view>
      <view class="{{'boundaryNote'}}">管理端不接受共享 Bearer 凭据。切换租户后，Web 会比较已验证会话的所选组织与 JWT organization_id；不一致时拒绝转发并要求重新取得租户授权。未知写入结果不会自动重试。</view>
      <view wx:if="{{financialError}}" class="{{'bad'}}" role="alert">{{financialError}}</view>
      <view wx:if="{{financialUnknown}}" class="{{'bad'}}" role="alert">{{financialUnknown}}</view>
      <view wx:if="{{financialNotice}}" class="{{'good'}}" role="status">{{financialNotice}}</view>
      <Empty wx:if="{{!financialLoaded}}" label="{{account.status === &quot;authenticated&quot;
                  ? &quot;选择状态后读取真实对账案件；页面不会使用样例财务数据。&quot;
                  : &quot;请先通过独立管理员入口登录已验证的管理员企业账户。&quot;}}" />
      <block wx:else>
        <Empty wx:if="{{financialCases.length === 0}}" label="{{`当前租户没有 ${financialStatus} 对账案件`}}" />
        <view wx:else class="{{'tableWrap'}}">
          <view>
            <view>
              <view>
                <view>案件 / Provider</view>
                <view>原因</view>
                <view>预期 / 观测</view>
                <view>状态</view>
                <view>时间</view>
                <view>处理依据与决策</view>
              </view>
            </view>
            <view>
              <view wx:for="{{financialCases}}" wx:key="item.id" key="{{item.reconciliationCaseId}}">
                <view title="{{item.providerObjectRef}}">
                  <code>{{item.reconciliationCaseId}}</code>
                  <text>{{item.provider}} · {{displayTarget(item.providerObjectRef)}}</text>
                </view>
                <view>
                  <code>{{item.reasonCode}}</code>
                </view>
                <view>
                  <text>{{item.expectedState}}</text>
                  <text>观测： {{item.observedState}}</text>
                </view>
                <view>
                  <text class="{{item.status === &quot;RESOLVED&quot; ? 'resultGood' : 'resultBad'}}">{{item.status}}</text>
                </view>
                <view>
                  <text>{{formatTime(item.openedAt)}}</text>
                  <text>{{item.resolvedAt ? `结案 ${formatTime(item.resolvedAt)}` : "尚未结案"}}</text>
                </view>
                <view>
                  <view wx:if="{{item.status === 'OPEN'}}" class="{{'financeActions'}}">
                    <input aria-label="{{`处理依据 ${item.reconciliationCaseId}`}}" value="{{financialResolutionRefs[item.reconciliationCaseId] ?? &quot;&quot;}}" placeholder="bank-statement:2026-08-09/42" pattern="[A-Za-z0-9][A-Za-z0-9._:/-]{7,254}" minLength="{{8}}" maxLength="{{255}}" disabled="{{!canApprove || busy}}" bindchange="onChange" />
                    <view>
                      <button class="secondary-button" type="button" disabled="{{!canApprove || busy}}" bindtap="onTap">{{financialBusyAction === `${item.reconciliationCaseId}:RESOLVED`
                                        ? "提交中…" : "标记已解决"}}</button>
                      <button class="secondary-button" type="button" disabled="{{!canApprove || busy}}" bindtap="onTap">{{financialBusyAction === `${item.reconciliationCaseId}:REJECTED`
                                        ? "提交中…" : "驳回案件"}}</button>
                    </view>
                    <text wx:if="{{!canApprove}}">结案需要企业账户的 admin:approve。</text>
                  </view>
                  <text wx:else>{{item.resolutionRef ?? "—"}} <text>{{item.resolverActorId ?? "—"}}</text></text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
      <view class="{{'boundaryNote'}}">此页面只闭环已有商业对账案件与追加式结案事件；不代表真实支付、税务、银行结算或会计认证已通过。</view>
    </view>
    <view wx:if="{{(adminSection === 'ALERTS' || adminSection === 'CONFIG')}}" class="{{'actionStrip'}}">
      <view>
        <text>自动化控制</text>
        <text>{{view.control.automationMode}} · 源码修改 {{view.control.sourceMutationMode}}</text>
      </view>
      <text>待发送通知 {{view.control.pendingNotifications}}</text>
      <button class="primary-button" type="button" disabled="{{!can(&quot;OPERATOR&quot;) || Boolean(busyAction)}}" data-operation-id="admin.slo.evaluate" bindtap="onTap">立即评估全部 SLO</button>
      <button class="secondary-button" type="button" disabled="{{!can(&quot;APPROVER&quot;) || Boolean(busyAction)}}" data-operation-id="admin.retention.enforce" bindtap="onTap">执行 30 天保留</button>
    </view>
    <view wx:if="{{adminSection === 'USAGE'}}" class="{{'panel'}}" aria-label="租户配额">
      <view>
        <Icon name="database" size="{{18}}" />
        <text>租户配额</text>
      </view>
      <view>读取需要 VIEWER，调整需要 APPROVER。调高会产生费用，调低会中断租户已被允许的工作， 因此与审批修复提案同级——两个动作故意设成不同门槛，否则只为看一个数字就得共用审批凭据。</view>
      <view class="{{'inlineActions'}}">
        <button class="secondary-button" type="button" disabled="{{quotaBusy}}" bindtap="loadQuota">
          <Icon name="{{quotaBusy ? &quot;refresh&quot; : &quot;search&quot;}}" size="{{17}}" />
          <text>{{quotaBusy ? "读取中…" : "读取当前配额"}}</text>
        </button>
      </view>
      <view wx:if="{{quotaError}}" class="{{'bad'}}" role="alert">{{quotaError}}</view>
      <view wx:if="{{quotaNotice}}" class="{{'good'}}" role="status">{{quotaNotice}}</view>
      <view wx:if="{{quota}}" class="{{'evidence'}}">
        <view>
          <text>{{quota.planDisplayName}}</text>
          <text>（</text>
          <text>{{quota.planId}}</text>
          <text>） · 版本</text>
          <text>{{quota.allocationVersion}}</text>
          <text>· 周期</text>
          <text>{{formatTime(quota.periodStartsAt)}}</text>
          <text>—</text>
          <text>{{formatTime(quota.periodEndsAt)}}</text>
        </view>
        <view class="{{'tableWrap'}}">
          <view>
            <view>
              <view>
                <view>额度</view>
                <view>上限</view>
                <view>已消耗</view>
                <view>已预留</view>
                <view>下限</view>
              </view>
            </view>
            <view>
              <view>
                <view>Token</view>
                <view>{{quota.tokenLimit}}</view>
                <view>{{quota.consumedTokens}}</view>
                <view>{{quota.reservedTokens}}</view>
                <view>{{quota.minimumTokenLimit}}</view>
              </view>
              <view>
                <view>Credit</view>
                <view>{{quota.creditLimit}}</view>
                <view>{{quota.consumedCredits}}</view>
                <view>{{quota.reservedCredits}}</view>
                <view>{{quota.minimumCreditLimit}}</view>
              </view>
            </view>
          </view>
        </view>
        <view>下限为「已消耗 + 已预留」，低于它的调整会被拒绝——预留是已经对租户作出的承诺。</view>
        <form wx:if="{{can('APPROVER')}}" class="{{'inlineActions'}}" bindsubmit="submitQuotaAdjustment">
          <text><text>Token 上限</text> <input value="{{quotaTokenLimit}}" aria-label="调整后的 Token 上限" inputMode="decimal" disabled="{{quotaBusy}}" required="true" bindchange="onChange" /></text>
          <text><text>Credit 上限</text> <input value="{{quotaCreditLimit}}" aria-label="调整后的 Credit 上限" inputMode="decimal" disabled="{{quotaBusy}}" required="true" bindchange="onChange" /></text>
          <text><text>调整原因代号</text> <input value="{{quotaReason}}" aria-label="调整原因代号" placeholder="PLAN_UPGRADE" pattern="[A-Za-z][A-Za-z0-9_]{2,47}" title="大写字母、数字与下划线组成的代号，例如 PLAN_UPGRADE。原因会写入只读审计流水与导出。" disabled="{{quotaBusy}}" required="true" bindchange="onChange" /></text>
          <button class="primary-button" type="submit" disabled="{{quotaBusy}}">
            <Icon name="{{quotaBusy ? &quot;refresh&quot; : &quot;check&quot;}}" size="{{17}}" />
            <text>{{quotaBusy ? "提交中…" : "按版本 " + quota.allocationVersion + " 提交调整"}}</text>
          </button>
        </form>
        <view wx:else>当前角色为 {{view.role}} ，只能查看配额；调整需要 APPROVER。</view>
      </view>
    </view>
    <view wx:if="{{adminSection === 'USAGE'}}" class="{{'metrics'}}" aria-label="运营指标">
      <view>
        <text>操作事件</text>
        <text>{{summary.totalEvents.toLocaleString("zh-CN")}}</text>
        <text>审计 + 可删除性能遥测</text>
      </view>
      <view>
        <text>活跃会话</text>
        <text>{{summary.activeSessions.toLocaleString("zh-CN")}}</text>
        <text>服务端 HMAC 会话</text>
      </view>
      <view>
        <text>失败率</text>
        <text>{{summary.failureRate.toFixed(2)}} %</text>
        <text>{{summary.failedEvents}} 次失败</text>
      </view>
      <view>
        <text>P95 耗时</text>
        <text>{{summary.p95DurationMs === null ? "—" : `${summary.p95DurationMs} ms`}}</text>
        <text>API 与页面性能</text>
      </view>
    </view>
    <view wx:if="{{adminSection === 'USAGE'}}" class="{{'dashboardGrid'}}">
      <view class="{{'panel'}}">
        <view>
          <view>
            <text class="overline">BUSINESS LINES</text>
            <view>所有业务线表现</view>
          </view>
          <text>失败率与 P95 耗时</text>
        </view>
        <Empty wx:if="{{summary.businessLines.length === 0}}" label="所选范围内暂无事件" />
        <view wx:else class="{{'lineList'}}">
          <view wx:for="{{summary.businessLines}}" wx:for-item="line" wx:key="line.id" key="{{line.businessLine}}">
            <view>
              <text>{{lineLabels[line.businessLine] ?? line.businessLine}}</text>
              <text>{{line.eventCount}} 次操作 · {{line.sessionCount}} 个会话</text>
            </view>
            <text class="{{line.failureRate &gt; 5 ? 'bad' : 'good'}}">{{line.failureRate.toFixed(2)}} %</text>
            <text>{{line.p95DurationMs === null ? "—" : `${line.p95DurationMs} ms`}}</text>
          </view>
        </view>
      </view>
      <view class="{{'panel'}}">
        <view>
          <view>
            <text class="overline">ERROR SIGNALS</text>
            <view>高频错误</view>
          </view>
          <text>只记录稳定错误码</text>
        </view>
        <Empty wx:if="{{summary.topErrors.length === 0}}" label="所选范围内没有失败事件" />
        <view wx:else class="{{'errorList'}}">
          <view wx:for="{{summary.topErrors}}" wx:key="item.id" key="{{item.errorCode}}">
            <text>{{item.count}}</text>
            <view>
              <text>{{item.errorCode}}</text>
              <text>最近： {{formatTime(item.lastSeenAt)}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{adminSection === 'ALERTS'}}" class="{{'panel'}}">
      <view>
        <view>
          <text class="overline">SLO &amp; ALERTS</text>
          <view>SLO 与告警</view>
        </view>
        <text>{{view.control.policies.length}} 条业务线策略</text>
      </view>
      <view class="{{'cardGrid'}}">
        <Empty wx:if="{{view.control.alerts.length === 0}}" label="当前没有告警" />
        <block wx:else>
          <view wx:for="{{view.control.alerts}}" wx:for-item="alert" wx:key="alert.id" class="{{'controlCard'}}" key="{{alert.alertId}}">
            <view>
              <text class="{{'severity'}}">{{alert.severity}}</text>
              <text>{{lineLabels[alert.businessLine] ?? alert.businessLine}}</text>
            </view>
            <code>{{alert.signal}}</code>
            <view>{{alert.observedValue}} / 预算 {{alert.thresholdValue}} · {{alert.status}}</view>
            <button wx:if="{{alert.status !== 'RESOLVED' && alert.status !== 'ACKNOWLEDGED'}}" class="secondary-button" type="button" disabled="{{!can(&quot;OPERATOR&quot;) || Boolean(busyAction)}}" bindtap="onTap">确认告警</button>
          </view>
        </block>
      </view>
    </view>
    <view wx:if="{{adminSection === 'ALERTS'}}" class="{{'panel'}}">
      <view>
        <view>
          <text class="overline">INCIDENTS</text>
          <view>生产事件</view>
        </view>
        <text>负责人、状态和并发版本均受控</text>
      </view>
      <view class="{{'cardGrid'}}">
        <Empty wx:if="{{view.control.incidents.length === 0}}" label="当前没有生产事件" />
        <block wx:else>
          <IncidentCard wx:for="{{view.control.incidents}}" wx:for-item="incident" wx:key="incident.id" key="{{incident.incidentId}}" incident="{{incident}}" businessLineLabel="{{lineLabels[incident.businessLine] ?? incident.businessLine}}" disabled="{{!can(&quot;OPERATOR&quot;) || Boolean(busyAction)}}" bindassign="onAssign" bindresolve="onResolve" />
        </block>
      </view>
    </view>
    <view wx:if="{{adminSection === 'ALERTS'}}" class="{{'panel'}}">
      <view>
        <view>
          <text class="overline">QUICK FIX GOVERNANCE</text>
          <view>性能优化与 Bug 修复提案</view>
        </view>
        <text>预览、审批、SCM 准备、验证、回滚</text>
      </view>
      <view class="{{'cardGrid'}}">
        <Empty wx:if="{{view.control.remediations.length === 0}}" label="尚无修复提案；先运行 SLO 评估" />
        <block wx:else>
          <RemediationCard wx:for="{{view.control.remediations}}" wx:for-item="proposal" wx:key="proposal.id" key="{{proposal.proposalId}}" proposal="{{proposal}}" disabled="{{!can(&quot;APPROVER&quot;) || Boolean(busyAction)}}" bindapprove="onApprove" bindreject="onReject" bindpreparescm="onPreparescm" />
        </block>
      </view>
    </view>
    <view wx:if="{{adminSection === 'AUDIT'}}" class="{{'panel'}}">
      <view>
        <view>
          <text class="overline">RECENT ACTIVITY</text>
          <view>最近操作</view>
        </view>
        <text>{{summary.persistence}} · 外部生产证据 {{summary.externalEvidence}}</text>
      </view>
      <Empty wx:if="{{summary.recentEvents.length === 0}}" label="所选范围内暂无事件" />
      <view wx:else class="{{'tableWrap'}}">
        <view>
          <view>
            <view>
              <view>时间</view>
              <view>业务线</view>
              <view>动作</view>
              <view>目标</view>
              <view>结果</view>
              <view>耗时</view>
            </view>
          </view>
          <view>
            <view wx:for="{{summary.recentEvents}}" wx:key="item.id" key="{{item.eventId}}">
              <view>{{formatTime(item.occurredAt)}}</view>
              <view>{{lineLabels[item.businessLine] ?? item.businessLine}}</view>
              <view>
                <code>{{item.action}}</code>
              </view>
              <view title="{{item.target}}">{{displayTarget(item.target)}}</view>
              <view>
                <text class="{{item.result === &quot;FAILURE&quot; ? 'resultBad' : 'resultGood'}}">{{item.result}}</text>
                <text wx:if="{{item.errorCode}}">{{item.errorCode}}</text>
              </view>
              <view>{{item.durationMs === null ? "—" : `${item.durationMs} ms`}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{adminSection === 'CONFIG'}}" class="{{'panel'}}">
      <view>
        <view>
          <text class="overline">SYSTEM STATUS</text>
          <view>核心依赖就绪状态</view>
        </view>
        <button class="secondary-button" type="button" disabled="{{systemReadinessBusy}}" bindtap="onTap">{{systemReadinessBusy ? "检测中…" : "重新检测"}}</button>
      </view>
      <view wx:if="{{systemReadinessError}}" class="{{'bad'}}" role="alert">{{systemReadinessError}}</view>
      <view wx:if="{{systemReadiness}}" class="{{'cardGrid'}}">
        <view class="{{'controlCard'}}">
          <view>
            <text class="{{systemReadiness.status === &quot;UP&quot; ? 'good' : 'bad'}}">{{systemReadiness.status}}</text>
            <text>Web 聚合就绪</text>
          </view>
          <text>{{formatTime(systemReadiness.checkedAt)}}</text>
        </view>
        <view wx:for="{{systemReadiness.dependencies}}" wx:for-item="dependency" wx:key="dependency.id" class="{{'controlCard'}}" key="{{dependency.dependency}}">
          <view>
            <text class="{{dependency.status === &quot;UP&quot; ? 'good' : 'bad'}}">{{dependency.status}}</text>
            <text>{{dependency.dependency}}</text>
          </view>
          <text>{{dependency.reason ?? "readiness probe passed"}}</text>
        </view>
        <view class="{{'controlCard'}}">
          <view>
            <text class="{{systemReadiness.localRunner.status === &quot;BLOCKED&quot; ? 'bad' : 'kind'}}">{{systemReadiness.localRunner.status}}</text>
            <text>local-runner</text>
          </view>
          <text>生产默认 DISABLED；托管 Runner 池须另行验证。</text>
        </view>
      </view>
    </view>
    <view wx:if="{{adminSection === 'CONFIG'}}" class="{{'panel'}}">
      <view>
        <view>
          <text class="overline">POLICY &amp; READINESS</text>
          <view>配置、SLO 与外部门禁</view>
        </view>
        <text>敏感配置值永不回传</text>
      </view>
      <view class="{{'cardGrid'}}">
        <view wx:for="{{view.control.policies}}" wx:for-item="policy" wx:key="policy.id" class="{{'controlCard'}}" key="{{policy.policyId}}">
          <view>
            <text class="{{'kind'}}">{{policy.enabled ? "ENABLED" : "DISABLED"}}</text>
            <text>{{lineLabels[policy.businessLine] ?? policy.businessLine}}</text>
          </view>
          <code>{{policy.policyId}}</code>
          <view>失败率 {{(policy.failureRateBudgetBps / 100).toFixed(2)}} % · P95 {{policy.latencyP95BudgetMs}} ms</view>
          <text>窗口 {{policy.evaluationWindowMinutes}} 分钟 · 最小样本 {{policy.minimumEventCount}}</text>
        </view>
      </view>
    </view>
    <view wx:if="{{adminSection === 'CONFIG'}}" class="{{'evidence'}}">
      <text>外部门禁</text>
      <text>通知投递： {{view.control.notificationDeliveryEvidence}}</text>
      <text>生产部署： {{view.control.productionDeploymentEvidence}}</text>
      <text>保留执行： {{view.control.retentionRuns.length ? "有本地/当前环境证据" : "NOT_RUN"}}</text>
    </view>
  </block>
</view>
