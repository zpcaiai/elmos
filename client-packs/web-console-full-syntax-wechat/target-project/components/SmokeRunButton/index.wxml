<view class="{{styles.panel}}" aria-label="一键冒烟运行">
  <view class="{{styles.header}}">
    <view>
      <view>一键运行冒烟测试</view>
      <view class="{{styles.subtitle}}">
        <text>用生成的一次性数据把产物跑起来，验证「能启动、能响应一次请求、能干净退出」。
            免费额度</text>
        <text>{{Math.round((capability?.freeQuotaSeconds ?? 600) / 60)}}</text>
        <text>分钟，到期自动停止服务、删除容器与卷、清空临时数据。
            冒烟结果不构成路线等价、性能、安全或认证证据。</text>
      </view>
    </view>
    <StatusChip wx:if="{{session}}" status="{{session.state}}" />
    <StatusChip wx:else status="NOT_RUN" />
  </view>
  <view wx:if="{{pack}}" class="{{styles.facts}}">
    <text wx:for="{{pack.languages}}" wx:for-item="language" wx:key="language.id" key="{{language}}" class="{{styles.fact}}">{{language}}</text>
    <text wx:for="{{pack.frameworks}}" wx:for-item="framework" wx:key="framework.id" key="{{framework}}" class="{{styles.fact}}">{{framework}}</text>
    <text wx:for="{{pack.datastores}}" wx:for-item="store" wx:key="store.id" key="{{store}}" class="{{styles.fact}}">{{store}}</text>
    <text wx:if="{{runnableLocation}}" class="{{styles.fact}}">
      <text>执行位置：</text>
      <text>{{LOCATION_LABELS[runnableLocation] ?? runnableLocation}}</text>
    </text>
    <text wx:else>{{null}}</text>
  </view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{pack && pack.unknownCount > 0}}" class="{{`${styles.notice} ${styles.noticeWarning}`}}">
    <text>该冒烟包仍有</text>
    <text>{{pack.unknownCount}}</text>
    <text>项未解决的未知项，运行可以进行，但门禁会因此阻断认证。</text>
  </view>
  <text wx:else>{{null}}</text>
  <view class="{{styles.controls}}">
    <text class="{{styles.entrySelect}}">
      <text>运行入口</text>
      <view value="{{entry}}" disabled="{{live || busy || !pack}}" bindchange="onChange">
        <view wx:for="{{(pack?.entries ?? [])}}" wx:key="item.id" key="{{item.entry}}" value="{{item.entry}}" disabled="{{item.status !== &quot;available&quot;}}">
          <text>{{ENTRY_LABELS[item.entry]}}</text>
          <text wx:if="{{item.status === "available"}}">{{""}}</text>
          <text wx:else>{{"（不可用）"}}</text>
        </view>
      </view>
    </text>
    <button type="button" class="{{`button button-primary ${styles.runButton}`}}" disabled="{{!canStart}}" bindtap="onTap">
      <text wx:if="{{busy && !session}}">{{"正在启动…"}}</text>
      <text wx:else>{{live ? "运行中"
            : expired ? "重新运行（新的免费额度）"
            : `一键运行（免费 ${Math.round((capability?.freeQuotaSeconds ?? 600) / 60)} 分钟）`}}</text>
    </button>
    <button wx:if="{{live}}" type="button" class="button button-secondary" disabled="{{busy}}" bindtap="stop">立即停止并回收</button>
    <text wx:else>{{null}}</text>
    <button wx:if="{{live}}" type="button" class="button button-secondary" disabled="{{busy}}" bindtap="onTap">续期</button>
    <text wx:else>{{null}}</text>
  </view>
  <view wx:if="{{selectedEntry?.status === "unavailable" && selectedEntry.reason}}" class="{{`${styles.notice} ${styles.noticeBlocked}`}}">
    <text>入口不可用：</text>
    <text>{{selectedEntry.reason}}</text>
  </view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{selectedEntry?.semanticWarning}}" class="{{`${styles.notice} ${styles.noticeWarning}`}}">{{selectedEntry.semanticWarning}}</view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{!runnableLocation && capability}}" class="{{`${styles.notice} ${styles.noticeBlocked}`}}">
    <text>当前没有可用的执行位置，无法运行：</text>
    <text>{{blockedLocations.map((item) => `${LOCATION_LABELS[item.location] ?? item.location} — ${item.reason ?? item.status}`).join("；")}}</text>
  </view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{error}}" class="{{`${styles.notice} ${styles.noticeBlocked}`}}">
    <text>操作失败：</text>
    <text>{{error}}</text>
  </view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{live && session}}" class="{{`${styles.countdown} ${remaining &lt;= 60 ? styles.countdownExpiring : &quot;&quot;}`}}">
    <text class="{{styles.countdownClock}}">{{clock(remaining)}}</text>
    <text class="{{styles.countdownLabel}}">
      <text>剩余免费运行时间</text>
      <text wx:if="{{session.billableSeconds > 0}}">{{`（其中 ${session.billableSeconds} 秒超出免费额度，计入计费）`}}</text>
      <text wx:else>{{""}}</text>
      <br />
      <navigator wx:if="{{session.url}}" class="{{styles.serviceLink}}" href="{{session.url}}" target="_blank" rel="noreferrer">{{session.url}}</navigator>
      <text wx:else>{{"服务地址分配中…"}}</text>
    </text>
  </view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{extendOpen && live}}" class="{{styles.extendForm}}">
    <view class="{{styles.subtitle}}">续期不会自动发生，必须写明理由与操作人。超出免费额度的秒数会被记录为计费时长。</view>
    <view class="{{styles.extendGrid}}">
      <text>
        <text>时长</text>
        <view value="{{extendSeconds}}" bindchange="onChange">
          <view wx:for="{{EXTENSION_CHOICES}}" wx:for-item="choice" wx:key="choice.id" key="{{choice.seconds}}" value="{{choice.seconds}}">{{choice.label}}</view>
        </view>
      </text>
      <text>
        <text>理由（必填，至少 4 个字符）</text>
        <input value="{{extendReason}}" placeholder="例如：复现 POST /orders 的 500" maxLength="{{240}}" bindchange="onChange" />
      </text>
      <text>
        <text>操作人</text>
        <input value="{{extendActor}}" placeholder="留空则使用当前账号" maxLength="{{120}}" bindchange="onChange" />
      </text>
    </view>
    <view class="{{styles.controls}}">
      <button type="button" class="button button-primary" disabled="{{!extensionValid || busy}}" bindtap="extend">
        <text>确认续期</text>
        <text>{{EXTENSION_CHOICES.find((choice) => choice.seconds === extendSeconds)?.label}}</text>
      </button>
      <button type="button" class="button button-secondary" bindtap="onTap">取消</button>
    </view>
  </view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{session && session.checks.length > 0}}" class="{{styles.section}}">
    <text class="{{styles.sectionTitle}}">冒烟断言</text>
    <view class="{{styles.checks}}">
      <view wx:for="{{session.checks}}" wx:for-item="check" wx:key="check.id" key="{{check.id}}" class="{{styles.checkRow}}">
        <StatusChip status="{{check.status}}" compact="true" />
        <text class="{{styles.checkId}}">
          <text>{{check.id}}</text>
          <text wx:if="{{check.required}}">{{""}}</text>
          <text wx:else>{{"（非必需）"}}</text>
        </text>
        <text class="{{styles.checkDetail}}">{{check.detail}}</text>
      </view>
    </view>
  </view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{session?.notes.length}}" class="{{styles.section}}">
    <text class="{{styles.sectionTitle}}">运行说明</text>
    <view wx:for="{{session.notes}}" wx:for-item="note" wx:key="note.id" key="{{note}}" class="{{styles.notice}}">{{note}}</view>
  </view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{session?.extensions.length}}" class="{{styles.section}}">
    <text class="{{styles.sectionTitle}}">续期记录</text>
    <view class="{{styles.teardownList}}">
      <view wx:for="{{session.extensions}}" wx:for-index="index" wx:key="item.id" key="{{`${item.grantedAt}-${index}`}}">
        <text>{{item.grantedAt}}</text>
        <text>·</text>
        <text>{{item.seconds}}</text>
        <text>秒 ·</text>
        <text>{{item.actor}}</text>
        <text>·</text>
        <text>{{item.reason}}</text>
        <text wx:if="{{item.beyondFreeQuota}}">{{"（超出免费额度）"}}</text>
        <text wx:else>{{""}}</text>
      </view>
    </view>
  </view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{expired && session?.teardown}}" class="{{styles.section}}">
    <text class="{{styles.sectionTitle}}">
      <text>回收报告（</text>
      <text wx:if="{{session.teardown.reason === "expired"}}">{{"额度到期"}}</text>
      <text wx:else>{{"手工停止"}}</text>
      <text>）</text>
    </text>
    <view class="{{styles.teardownList}}">
      <view>
        <text>进程：</text>
        <text>{{session.teardown.processes.length}}</text>
        <text>个</text>
        <text wx:if="{{session.teardown.processes.some((item) => item.killed)}}">{{"，其中有进程未在宽限期内响应 SIGTERM，已强制终止"}}</text>
        <text wx:else>{{"，全部在宽限期内优雅退出"}}</text>
      </view>
      <view>
        <text>容器编排：</text>
        <text wx:if="{{session.teardown.compose.length === 0}}">{{"本次运行未启动容器"}}</text>
        <text wx:else>{{session.teardown.compose.map((item) => `${item.status}`).join("、")}}</text>
      </view>
      <view>
        <text>临时数据：已删除</text>
        <text>{{session.teardown.removedPaths.filter((item) => item.removed !== "absent").length}}</text>
        <text>项</text>
        <text wx:if="{{session.teardown.removedPaths.some((item) => item.removed === "failed")}}">{{"，存在删除失败项"}}</text>
        <text wx:else>{{""}}</text>
      </view>
      <view>
        <text>回收结论：</text>
        <text wx:if="{{session.teardown.complete}}">{{"无残留"}}</text>
        <text wx:else>{{"存在残留，门禁将阻断"}}</text>
      </view>
    </view>
  </view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{expired && session}}" class="{{styles.section}}">
    <text class="{{styles.sectionTitle}}">门禁结论</text>
    <view class="{{styles.notice}}">
      <StatusChip status="{{session.gateStatus.toUpperCase()}}" compact="true" />
      <text>· 服务已回收，证据与日志仍然保留。</text>
    </view>
    <view wx:for="{{session.gateFailures}}" wx:for-item="failure" wx:key="failure.id" key="{{failure}}" class="{{`${styles.notice} ${styles.noticeBlocked}`}}">
      <text>阻断：</text>
      <text>{{failure}}</text>
    </view>
    <view wx:for="{{session.gateLimitations}}" wx:for-item="limitation" wx:key="limitation.id" key="{{limitation}}" class="{{`${styles.notice} ${styles.noticeWarning}`}}">
      <text>受限：</text>
      <text>{{limitation}}</text>
    </view>
    <view class="{{styles.controls}}">
      <button type="button" class="button button-secondary" disabled="{{busy}}" bindtap="onTap">查看证据与日志</button>
    </view>
  </view>
  <text wx:else>{{null}}</text>
  <view wx:if="{{evidence}}" class="{{styles.evidence}}">
    <text class="{{styles.sectionTitle}}">证据（到期后保留）</text>
    <view wx:for="{{evidence.logs}}" wx:for-item="log" wx:key="log.id" key="{{log.name}}">
      <view class="{{styles.checkId}}">
        <text>{{log.name}}</text>
        <text>（</text>
        <text>{{log.bytes}}</text>
        <text>字节，显示尾部）</text>
      </view>
      <pre class="{{styles.logBlock}}">{{log.tail || "（空）"}}</pre>
    </view>
    <view>
      <view class="{{styles.checkId}}">result.json</view>
      <pre class="{{styles.logBlock}}">{{JSON.stringify(evidence.result, null, 2)}}</pre>
    </view>
    <view>
      <view class="{{styles.checkId}}">lease-result.json</view>
      <pre class="{{styles.logBlock}}">{{JSON.stringify(evidence.lease, null, 2)}}</pre>
    </view>
  </view>
  <text wx:else>{{null}}</text>
</view>
