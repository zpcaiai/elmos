<view class="{{styles.panel}}" aria-label="一键冒烟运行">
  <text></text>
  <view class="{{styles.header}}">
    <text></text>
    <view>
      <text></text>
      <view>
        <text>一键运行冒烟测试</text>
      </view>
      <text></text>
      <view class="{{styles.subtitle}}">
        <text>用生成的一次性数据把产物跑起来，验证「能启动、能响应一次请求、能干净退出」。
            免费额度</text>
        <text>{{Math.round((capability?.freeQuotaSeconds ?? 600) / 60)}}</text>
        <text>分钟，到期自动停止服务、删除容器与卷、清空临时数据。
            冒烟结果不构成路线等价、性能、安全或认证证据。</text>
      </view>
      <text></text>
    </view>
    <text></text>
    <StatusChip wx:if="{{session}}" status="{{session.state}}" />
    <StatusChip wx:else status="NOT_RUN" />
    <text></text>
  </view>
  <text></text>
  <view wx:if="{{pack}}" class="{{styles.facts}}">
    <text></text>
    <text wx:for="{{pack.languages}}" wx:for-item="language" wx:key="language.id" key="{{language}}" class="{{styles.fact}}">
      <text>{{language}}</text>
    </text>
    <text></text>
    <text wx:for="{{pack.frameworks}}" wx:for-item="framework" wx:key="framework.id" key="{{framework}}" class="{{styles.fact}}">
      <text>{{framework}}</text>
    </text>
    <text></text>
    <text wx:for="{{pack.datastores}}" wx:for-item="store" wx:key="store.id" key="{{store}}" class="{{styles.fact}}">
      <text>{{store}}</text>
    </text>
    <text></text>
    <text wx:if="{{runnableLocation}}" class="{{styles.fact}}">
      <text>执行位置：</text>
      <text>{{LOCATION_LABELS[runnableLocation] ?? runnableLocation}}</text>
    </text>
    <view wx:else />
    <text></text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{pack && pack.unknownCount > 0}}" class="{{`${styles.notice} ${styles.noticeWarning}`}}">
    <text>该冒烟包仍有</text>
    <text>{{pack.unknownCount}}</text>
    <text>项未解决的未知项，运行可以进行，但门禁会因此阻断认证。</text>
  </view>
  <view wx:else />
  <text></text>
  <view class="{{styles.controls}}">
    <text></text>
    <text class="{{styles.entrySelect}}">
      <text></text>
      <text>
        <text>运行入口</text>
      </text>
      <text></text>
      <select value="{{entry}}" disabled="{{live || busy || !pack}}" bindchange="(event) => setEntry(event.target.value as SmokeEntry)">
        <text></text>
        <option wx:for="{{(pack?.entries ?? [])}}" wx:key="item.id" key="{{item.entry}}" value="{{item.entry}}" disabled="{{item.status !== "available"}}">
          <text></text>
          <text>{{ENTRY_LABELS[item.entry]}}</text>
          <view wx:if="{{item.status === "available"}}" />
          <view wx:else />
          <text></text>
        </option>
        <text></text>
      </select>
      <text></text>
    </text>
    <text></text>
    <button type="button" class="{{`button button-primary ${styles.runButton}`}}" disabled="{{!canStart}}" bindtap="() => void start()">
      <text></text>
      <view wx:if="{{busy && !session}}" />
      <view wx:else />
      <text></text>
    </button>
    <text></text>
    <button wx:if="{{live}}" type="button" class="button button-secondary" disabled="{{busy}}" bindtap="stop">
      <text>立即停止并回收</text>
    </button>
    <view wx:else />
    <text></text>
    <button wx:if="{{live}}" type="button" class="button button-secondary" disabled="{{busy}}" bindtap="() => setExtendOpen((open) => !open)">
      <text>续期</text>
    </button>
    <view wx:else />
    <text></text>
  </view>
  <text></text>
  <view wx:if="{{selectedEntry?.status === "unavailable" && selectedEntry.reason}}" class="{{`${styles.notice} ${styles.noticeBlocked}`}}">
    <text>入口不可用：</text>
    <text>{{selectedEntry.reason}}</text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{selectedEntry?.semanticWarning}}" class="{{`${styles.notice} ${styles.noticeWarning}`}}">
    <text>{{selectedEntry.semanticWarning}}</text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{!runnableLocation && capability}}" class="{{`${styles.notice} ${styles.noticeBlocked}`}}">
    <text>当前没有可用的执行位置，无法运行：</text>
    <text>{{blockedLocations.map((item) => `${LOCATION_LABELS[item.location] ?? item.location} — ${item.reason ?? item.status}`).join("；")}}</text>
    <text></text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{error}}" class="{{`${styles.notice} ${styles.noticeBlocked}`}}">
    <text>操作失败：</text>
    <text>{{error}}</text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{live && session}}" class="{{`${styles.countdown} ${remaining <= 60 ? styles.countdownExpiring : ""}`}}">
    <text></text>
    <text class="{{styles.countdownClock}}">
      <text>{{clock(remaining)}}</text>
    </text>
    <text></text>
    <text class="{{styles.countdownLabel}}">
      <text>剩余免费运行时间</text>
      <view wx:if="{{session.billableSeconds > 0}}" />
      <view wx:else />
      <text></text>
      <br />
      <text></text>
      <navigator wx:if="{{session.url}}" class="{{styles.serviceLink}}" href="{{session.url}}" target="_blank" rel="noreferrer">
        <text></text>
        <text>{{session.url}}</text>
        <text></text>
      </navigator>
      <view wx:else />
      <text></text>
    </text>
    <text></text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{extendOpen && live}}" class="{{styles.extendForm}}">
    <text></text>
    <view class="{{styles.subtitle}}">
      <text>续期不会自动发生，必须写明理由与操作人。超出免费额度的秒数会被记录为计费时长。</text>
    </view>
    <text></text>
    <view class="{{styles.extendGrid}}">
      <text></text>
      <text>
        <text></text>
        <text>
          <text>时长</text>
        </text>
        <text></text>
        <select value="{{extendSeconds}}" bindchange="(event) => setExtendSeconds(Number(event.target.value))">
          <text></text>
          <option wx:for="{{EXTENSION_CHOICES}}" wx:for-item="choice" wx:key="choice.id" key="{{choice.seconds}}" value="{{choice.seconds}}">
            <text>{{choice.label}}</text>
          </option>
          <text></text>
        </select>
        <text></text>
      </text>
      <text></text>
      <text>
        <text></text>
        <text>
          <text>理由（必填，至少 4 个字符）</text>
        </text>
        <text></text>
        <input value="{{extendReason}}" placeholder="例如：复现 POST /orders 的 500" maxLength="{{240}}" bindchange="(event) => setExtendReason(event.target.value)" />
        <text></text>
      </text>
      <text></text>
      <text>
        <text></text>
        <text>
          <text>操作人</text>
        </text>
        <text></text>
        <input value="{{extendActor}}" placeholder="留空则使用当前账号" maxLength="{{120}}" bindchange="(event) => setExtendActor(event.target.value)" />
        <text></text>
      </text>
      <text></text>
    </view>
    <text></text>
    <view class="{{styles.controls}}">
      <text></text>
      <button type="button" class="button button-primary" disabled="{{!extensionValid || busy}}" bindtap="extend">
        <text>确认续期</text>
        <text>{{EXTENSION_CHOICES.find((choice) => choice.seconds === extendSeconds)?.label}}</text>
        <text></text>
      </button>
      <text></text>
      <button type="button" class="button button-secondary" bindtap="() => setExtendOpen(false)">
        <text>取消</text>
      </button>
      <text></text>
    </view>
    <text></text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{session && session.checks.length > 0}}" class="{{styles.section}}">
    <text></text>
    <text class="{{styles.sectionTitle}}">
      <text>冒烟断言</text>
    </text>
    <text></text>
    <view class="{{styles.checks}}">
      <text></text>
      <view wx:for="{{session.checks}}" wx:for-item="check" wx:key="check.id" key="{{check.id}}" class="{{styles.checkRow}}">
        <text></text>
        <StatusChip status="{{check.status}}" compact="true" />
        <text></text>
        <text class="{{styles.checkId}}">
          <text>{{check.id}}</text>
          <view wx:if="{{check.required}}" />
          <view wx:else />
        </text>
        <text></text>
        <text class="{{styles.checkDetail}}">
          <text>{{check.detail}}</text>
        </text>
        <text></text>
      </view>
      <text></text>
    </view>
    <text></text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{session?.notes.length}}" class="{{styles.section}}">
    <text></text>
    <text class="{{styles.sectionTitle}}">
      <text>运行说明</text>
    </text>
    <text></text>
    <view wx:for="{{session.notes}}" wx:for-item="note" wx:key="note.id" key="{{note}}" class="{{styles.notice}}">
      <text>{{note}}</text>
    </view>
    <text></text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{session?.extensions.length}}" class="{{styles.section}}">
    <text></text>
    <text class="{{styles.sectionTitle}}">
      <text>续期记录</text>
    </text>
    <text></text>
    <view class="{{styles.teardownList}}">
      <text></text>
      <view wx:for="{{session.extensions}}" wx:for-index="index" wx:key="item.id" key="{{`${item.grantedAt}-${index}`}}">
        <text></text>
        <text>{{item.grantedAt}}</text>
        <text>·</text>
        <text>{{item.seconds}}</text>
        <text>秒 ·</text>
        <text>{{item.actor}}</text>
        <text>·</text>
        <text>{{item.reason}}</text>
        <text></text>
        <view wx:if="{{item.beyondFreeQuota}}" />
        <view wx:else />
        <text></text>
      </view>
      <text></text>
    </view>
    <text></text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{expired && session?.teardown}}" class="{{styles.section}}">
    <text></text>
    <text class="{{styles.sectionTitle}}">
      <text>回收报告（</text>
      <view wx:if="{{session.teardown.reason === "expired"}}" />
      <view wx:else />
      <text>）</text>
    </text>
    <text></text>
    <view class="{{styles.teardownList}}">
      <text></text>
      <view>
        <text>进程：</text>
        <text>{{session.teardown.processes.length}}</text>
        <text>个</text>
        <view wx:if="{{session.teardown.processes.some((item) => item.killed)}}" />
        <view wx:else />
        <text></text>
      </view>
      <text></text>
      <view>
        <text>容器编排：</text>
        <view wx:if="{{session.teardown.compose.length === 0}}" />
        <view wx:else />
        <text></text>
      </view>
      <text></text>
      <view>
        <text>临时数据：已删除</text>
        <text>{{session.teardown.removedPaths.filter((item) => item.removed !== "absent").length}}</text>
        <text>项</text>
        <view wx:if="{{session.teardown.removedPaths.some((item) => item.removed === "failed")}}" />
        <view wx:else />
        <text></text>
      </view>
      <text></text>
      <view>
        <text>回收结论：</text>
        <view wx:if="{{session.teardown.complete}}" />
        <view wx:else />
      </view>
      <text></text>
    </view>
    <text></text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{expired && session}}" class="{{styles.section}}">
    <text></text>
    <text class="{{styles.sectionTitle}}">
      <text>门禁结论</text>
    </text>
    <text></text>
    <view class="{{styles.notice}}">
      <text></text>
      <StatusChip status="{{session.gateStatus.toUpperCase()}}" compact="true" />
      <text>· 服务已回收，证据与日志仍然保留。</text>
    </view>
    <text></text>
    <view wx:for="{{session.gateFailures}}" wx:for-item="failure" wx:key="failure.id" key="{{failure}}" class="{{`${styles.notice} ${styles.noticeBlocked}`}}">
      <text>阻断：</text>
      <text>{{failure}}</text>
    </view>
    <text></text>
    <view wx:for="{{session.gateLimitations}}" wx:for-item="limitation" wx:key="limitation.id" key="{{limitation}}" class="{{`${styles.notice} ${styles.noticeWarning}`}}">
      <text>受限：</text>
      <text>{{limitation}}</text>
    </view>
    <text></text>
    <view class="{{styles.controls}}">
      <text></text>
      <button type="button" class="button button-secondary" disabled="{{busy}}" bindtap="() => void loadEvidence()">
        <text>查看证据与日志</text>
      </button>
      <text></text>
    </view>
    <text></text>
  </view>
  <view wx:else />
  <text></text>
  <view wx:if="{{evidence}}" class="{{styles.evidence}}">
    <text></text>
    <text class="{{styles.sectionTitle}}">
      <text>证据（到期后保留）</text>
    </text>
    <text></text>
    <details wx:for="{{evidence.logs}}" wx:for-item="log" wx:key="log.id" key="{{log.name}}">
      <text></text>
      <summary class="{{styles.checkId}}">
        <text>{{log.name}}</text>
        <text>（</text>
        <text>{{log.bytes}}</text>
        <text>字节，显示尾部）</text>
      </summary>
      <text></text>
      <pre class="{{styles.logBlock}}">
        <text>{{log.tail || "（空）"}}</text>
      </pre>
      <text></text>
    </details>
    <text></text>
    <details>
      <text></text>
      <summary class="{{styles.checkId}}">
        <text>result.json</text>
      </summary>
      <text></text>
      <pre class="{{styles.logBlock}}">
        <text>{{JSON.stringify(evidence.result, null, 2)}}</text>
      </pre>
      <text></text>
    </details>
    <text></text>
    <details>
      <text></text>
      <summary class="{{styles.checkId}}">
        <text>lease-result.json</text>
      </summary>
      <text></text>
      <pre class="{{styles.logBlock}}">
        <text>{{JSON.stringify(evidence.lease, null, 2)}}</text>
      </pre>
      <text></text>
    </details>
    <text></text>
  </view>
  <view wx:else />
  <text></text>
</view>
