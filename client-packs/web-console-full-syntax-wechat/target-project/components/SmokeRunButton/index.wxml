<view class="{{'panel'}}" aria-label="一键冒烟运行">
  <view class="{{'header'}}">
    <view>
      <view>一键运行冒烟测试</view>
      <view class="{{'subtitle'}}">用生成的一次性数据把产物跑起来，验证「能启动、能响应一次请求、能干净退出」。 免费额度 {{Math.round((capability?.freeQuotaSeconds ?? 600) / 60)}} 分钟，到期自动停止服务、删除容器与卷、清空临时数据。 冒烟结果不构成路线等价、性能、安全或认证证据。</view>
    </view>
    <StatusChip wx:if="{{session}}" status="{{session.state}}" />
    <StatusChip wx:else status="NOT_RUN" />
  </view>
  <view wx:if="{{pack}}" class="{{'facts'}}">
    <text wx:for="{{pack.languages}}" wx:for-item="language" wx:key="language.id" key="{{language}}" class="{{'fact'}}">{{language}}</text>
    <text wx:for="{{pack.frameworks}}" wx:for-item="framework" wx:key="framework.id" key="{{framework}}" class="{{'fact'}}">{{framework}}</text>
    <text wx:for="{{pack.datastores}}" wx:for-item="store" wx:key="store.id" key="{{store}}" class="{{'fact'}}">{{store}}</text>
    <text wx:if="{{runnableLocation}}" class="{{'fact'}}">执行位置： {{LOCATION_LABELS[runnableLocation] ?? runnableLocation}}</text>
  </view>
  <view wx:if="{{pack && pack.unknownCount > 0}}" class="{{`${'notice'} ${'noticeWarning'}`}}">该冒烟包仍有 {{pack.unknownCount}} 项未解决的未知项，运行可以进行，但门禁会因此阻断认证。</view>
  <view class="{{'controls'}}">
    <text class="{{'entrySelect'}}"><text>运行入口</text> <view value="{{entry}}" disabled="{{live || busy || !pack}}" bindchange="onChange">
  <view wx:for="{{(pack?.entries ?? [])}}" wx:key="item.id" key="{{item.entry}}" value="{{item.entry}}" disabled="{{item.status !== &quot;available&quot;}}">{{ENTRY_LABELS[item.entry]}} {{item.status === "available" ? "" : "（不可用）"}}</view>
</view></text>
    <button type="button" class="{{`button button-primary ${'runButton'}`}}" disabled="{{!canStart}}" bindtap="onTap">{{busy && !session ? "正在启动…"
            : live ? "运行中"
            : expired ? "重新运行（新的免费额度）"
            : `一键运行（免费 ${Math.round((capability?.freeQuotaSeconds ?? 600) / 60)} 分钟）`}}</button>
    <button wx:if="{{live}}" type="button" class="button button-secondary" disabled="{{busy}}" bindtap="stop">立即停止并回收</button>
    <button wx:if="{{live}}" type="button" class="button button-secondary" disabled="{{busy}}" bindtap="onTap">续期</button>
  </view>
  <view wx:if="{{selectedEntry?.status === 'unavailable' && selectedEntry.reason}}" class="{{`${'notice'} ${'noticeBlocked'}`}}">入口不可用： {{selectedEntry.reason}}</view>
  <view wx:if="{{selectedEntry?.semanticWarning}}" class="{{`${'notice'} ${'noticeWarning'}`}}">{{selectedEntry.semanticWarning}}</view>
  <view wx:if="{{!runnableLocation && capability}}" class="{{`${'notice'} ${'noticeBlocked'}`}}">当前没有可用的执行位置，无法运行： {{blockedLocations.map((item) => `${LOCATION_LABELS[item.location] ?? item.location} — ${item.reason ?? item.status}`).join("；")}}</view>
  <view wx:if="{{error}}" class="{{`${'notice'} ${'noticeBlocked'}`}}">操作失败： {{error}}</view>
  <view wx:if="{{live && session}}" class="{{`${'countdown'} ${remaining &lt;= 60 ? 'countdownExpiring' : &quot;&quot;}`}}">
    <text class="{{'countdownClock'}}">{{clock(remaining)}}</text>
    <text class="{{'countdownLabel'}}">剩余免费运行时间 {{session.billableSeconds > 0 ? `（其中 ${session.billableSeconds} 秒超出免费额度，计入计费）` : ""}} <br /> <navigator wx:if="{{session.url}}" class="{{'serviceLink'}}" href="{{session.url}}" target="_blank" rel="noreferrer">{{session.url}}</navigator>
<text wx:else>{{"服务地址分配中…"}}</text></text>
  </view>
  <view wx:if="{{extendOpen && live}}" class="{{'extendForm'}}">
    <view class="{{'subtitle'}}">续期不会自动发生，必须写明理由与操作人。超出免费额度的秒数会被记录为计费时长。</view>
    <view class="{{'extendGrid'}}">
      <text><text>时长</text> <view value="{{extendSeconds}}" bindchange="onChange">
  <view wx:for="{{EXTENSION_CHOICES}}" wx:for-item="choice" wx:key="choice.id" key="{{choice.seconds}}" value="{{choice.seconds}}">{{choice.label}}</view>
</view></text>
      <text><text>理由（必填，至少 4 个字符）</text> <input value="{{extendReason}}" placeholder="例如：复现 POST /orders 的 500" maxLength="{{240}}" bindchange="onChange" /></text>
      <text><text>操作人</text> <input value="{{extendActor}}" placeholder="留空则使用当前账号" maxLength="{{120}}" bindchange="onChange" /></text>
    </view>
    <view class="{{'controls'}}">
      <button type="button" class="button button-primary" disabled="{{!extensionValid || busy}}" bindtap="extend">确认续期 {{EXTENSION_CHOICES.find((choice) => choice.seconds === extendSeconds)?.label}}</button>
      <button type="button" class="button button-secondary" bindtap="onTap">取消</button>
    </view>
  </view>
  <view wx:if="{{session && session.checks.length > 0}}" class="{{'section'}}">
    <text class="{{'sectionTitle'}}">冒烟断言</text>
    <view class="{{'checks'}}">
      <view wx:for="{{session.checks}}" wx:for-item="check" wx:key="check.id" key="{{check.id}}" class="{{'checkRow'}}">
        <StatusChip status="{{check.status}}" compact="true" />
        <text class="{{'checkId'}}">{{check.id}} {{check.required ? "" : "（非必需）"}}</text>
        <text class="{{'checkDetail'}}">{{check.detail}}</text>
      </view>
    </view>
  </view>
  <view wx:if="{{session?.notes.length}}" class="{{'section'}}">
    <text class="{{'sectionTitle'}}">运行说明</text>
    <view wx:for="{{session.notes}}" wx:for-item="note" wx:key="note.id" key="{{note}}" class="{{'notice'}}">{{note}}</view>
  </view>
  <view wx:if="{{session?.extensions.length}}" class="{{'section'}}">
    <text class="{{'sectionTitle'}}">续期记录</text>
    <view class="{{'teardownList'}}">
      <view wx:for="{{session.extensions}}" wx:for-index="index" wx:key="item.id" key="{{`${item.grantedAt}-${index}`}}">{{item.grantedAt}} · {{item.seconds}} 秒 · {{item.actor}} · {{item.reason}} {{item.beyondFreeQuota ? "（超出免费额度）" : ""}}</view>
    </view>
  </view>
  <view wx:if="{{expired && session?.teardown}}" class="{{'section'}}">
    <text class="{{'sectionTitle'}}">回收报告（ {{session.teardown.reason === "expired" ? "额度到期" : "手工停止"}} ）</text>
    <view class="{{'teardownList'}}">
      <view>进程： {{session.teardown.processes.length}} 个 {{session.teardown.processes.some((item) => item.killed)
                ? "，其中有进程未在宽限期内响应 SIGTERM，已强制终止"
                : "，全部在宽限期内优雅退出"}}</view>
      <view>容器编排： {{session.teardown.compose.length === 0
                ? "本次运行未启动容器"
                : session.teardown.compose.map((item) => `${item.status}`).join("、")}}</view>
      <view>临时数据：已删除 {{session.teardown.removedPaths.filter((item) => item.removed !== "absent").length}} 项 {{session.teardown.removedPaths.some((item) => item.removed === "failed") ? "，存在删除失败项" : ""}}</view>
      <view>回收结论： {{session.teardown.complete ? "无残留" : "存在残留，门禁将阻断"}}</view>
    </view>
  </view>
  <view wx:if="{{expired && session}}" class="{{'section'}}">
    <text class="{{'sectionTitle'}}">门禁结论</text>
    <view class="{{'notice'}}">
      <StatusChip status="{{session.gateStatus.toUpperCase()}}" compact="true" />
      <text>· 服务已回收，证据与日志仍然保留。</text>
    </view>
    <view wx:for="{{session.gateFailures}}" wx:for-item="failure" wx:key="failure.id" key="{{failure}}" class="{{`${'notice'} ${'noticeBlocked'}`}}">阻断： {{failure}}</view>
    <view wx:for="{{session.gateLimitations}}" wx:for-item="limitation" wx:key="limitation.id" key="{{limitation}}" class="{{`${'notice'} ${'noticeWarning'}`}}">受限： {{limitation}}</view>
    <view class="{{'controls'}}">
      <button type="button" class="button button-secondary" disabled="{{busy}}" bindtap="onTap">查看证据与日志</button>
    </view>
  </view>
  <view wx:if="{{evidence}}" class="{{'evidence'}}">
    <text class="{{'sectionTitle'}}">证据（到期后保留）</text>
    <view wx:for="{{evidence.logs}}" wx:for-item="log" wx:key="log.id" key="{{log.name}}">
      <view class="{{'checkId'}}">{{log.name}} （ {{log.bytes}} 字节，显示尾部）</view>
      <pre class="{{'logBlock'}}">{{log.tail || "（空）"}}</pre>
    </view>
    <view>
      <view class="{{'checkId'}}">result.json</view>
      <pre class="{{'logBlock'}}">{{JSON.stringify(evidence.result, null, 2)}}</pre>
    </view>
    <view>
      <view class="{{'checkId'}}">lease-result.json</view>
      <pre class="{{'logBlock'}}">{{JSON.stringify(evidence.lease, null, 2)}}</pre>
    </view>
  </view>
</view>
