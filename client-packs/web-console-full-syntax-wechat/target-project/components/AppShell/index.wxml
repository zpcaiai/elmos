<view class="{{`app-shell ${adminSurface ? &quot;admin-shell&quot; : &quot;&quot;}`}}">
  <navigator class="skip-link" href="#main-content">{{english ? "Skip to main content" : "跳到主要内容"}}</navigator>
  <view class="{{`sidebar ${mobileOpen ? &quot;sidebar-open&quot; : &quot;&quot;}`}}" aria-label="{{english ? &quot;Primary navigation&quot; : &quot;主导航&quot;}}">
    <view class="brand-row">
      <navigator class="brand-mark" href="/" bindtap="onTap">E</navigator>
      <view>
        <text>ELMOS</text>
        <text>{{adminSurface
              ? (english ? "Administrator center" : "管理员中心")
              : (english ? "Control center" : "控制中心")}}</text>
      </view>
      <button class="icon-button sidebar-close" aria-label="{{english ? &quot;Close navigation&quot; : &quot;关闭导航&quot;}}" bindtap="closeSidebar">
        <Icon name="close" />
      </button>
    </view>
    <view class="primary-nav">
      <text class="nav-label">{{english ? "Product features · user access" : "产品功能 · 用户端"}}</text>
      <navigator wx:for="{{userNavigation}}" wx:key="item.id" class="{{`nav-item ${active ? &quot;active&quot; : &quot;&quot;}`}}" href="{{item.href}}" key="{{item.href}}" aria-current="{{active ? &quot;page&quot; : undefined}}" bindtap="closeSidebar">
        <Icon name="{{item.icon}}" size="{{19}}" />
        <text>
          <text>{{navLabel(item)}}</text>
          <text>{{item.hint}}</text>
        </text>
      </navigator>
      <block wx:if="{{operationsNavigation.length > 0}}">
        <text class="nav-label nav-label-operations">{{english ? "Platform operations · administrator" : "平台运营 · 管理员端"}}</text>
        <navigator wx:for="{{operationsNavigation}}" wx:key="item.id" class="{{`nav-item admin-nav-item ${active ? &quot;active&quot; : &quot;&quot;}`}}" href="{{item.href}}" key="{{item.href}}" aria-current="{{active ? &quot;page&quot; : undefined}}" bindtap="closeSidebar">
          <Icon name="{{item.icon}}" size="{{19}}" />
          <text>
            <text>{{navLabel(item)}}</text>
            <text>{{item.hint}}</text>
          </text>
        </navigator>
      </block>
    </view>
    <view class="sidebar-spacer" />
    <view class="guardrail-card">
      <text class="guardrail-icon">
        <Icon name="lock" size="{{17}}" />
      </text>
      <view>
        <text>Fail closed</text>
        <text>{{english ? "Not run is not passed" : "未运行不等于通过"}}</text>
      </view>
    </view>
    <view class="secondary-nav" aria-label="{{english ? &quot;Utility navigation&quot; : &quot;辅助导航&quot;}}">
      <navigator class="{{`secondary-link ${styles.readableSecondary}`}}" href="/api/capabilities/migration" target="_blank" rel="noreferrer">
        <Icon name="box" size="{{18}}" />
        <text>{{english ? "Capability API" : "能力 API"}}</text>
      </navigator>
      <button class="{{`secondary-link ${styles.readableSecondary}`}}" type="button" data-telemetry-ignore="true" bindtap="toggleTelemetry">
        <Icon name="{{telemetryEnabled ? &quot;check&quot; : &quot;close&quot;}}" size="{{18}}" />
        <text>{{english
              ? `Anonymous performance log: ${telemetryEnabled ? "on" : "off"}`
              : `匿名性能日志：${telemetryEnabled ? "开" : "关"}`}}</text>
      </button>
      <navigator class="{{`secondary-link ${styles.readableSecondary}`}}" href="/help">
        <Icon name="help" size="{{18}}" />
        <text>{{english ? "Help and readiness" : "帮助与就绪状态"}}</text>
      </navigator>
    </view>
    <view class="profile-area">
      <block wx:if="{{account.status === 'authenticated' && account.principal}}">
        <button class="profile-row" type="button" aria-expanded="{{profileOpen}}" aria-controls="account-profile-menu" bindtap="onTap">
          <text class="{{`avatar ${hasAdminAccess ? &quot;admin-avatar&quot; : &quot;&quot;}`}}">{{account.principal.displayName.slice(0, 1)}}</text>
          <view>
            <text>{{account.principal.displayName}}</text>
            <text>{{hasAdminAccess ? (english ? "Administrator" : "管理员") + " · " : ""}} {{account.principal.organizationId}}</text>
          </view>
          <Icon name="chevron" size="{{16}}" />
        </button>
        <view wx:if="{{profileOpen}}" class="profile-menu" id="account-profile-menu">
          <view class="profile-menu-summary">
            <text>{{account.principal.displayName}}</text>
            <text>{{account.principal.roles.join(" · ") || "无业务角色"}}</text>
            <text wx:if="{{hasAdminAccess}}" class="admin-session-badge">管理员会话</text>
          </view>
          <navigator href="/account" bindtap="closeSidebar">{{english ? "Account and organizations" : "账户与组织"}}</navigator>
          <text wx:if="{{account.principal.memberships.length > 1}}">
            <text>{{english ? "Current tenant" : "当前租户"}}</text>
            <view value="{{account.principal.organizationId}}" bindchange="onChange">
              <view wx:for="{{account.principal.memberships}}" wx:for-item="membership" wx:key="membership.id" value="{{membership.organizationId}}" key="{{membership.organizationId}}">{{membership.organizationId}}</view>
            </view>
          </text>
          <button type="button" bindtap="onTap">{{english ? "Sign out securely" : "安全退出"}}</button>
        </view>
      </block>
      <block wx:else>
        <navigator class="{{`profile-row profile-login-row ${pathname === &quot;/login&quot; ? &quot;active&quot; : &quot;&quot;}`}}" href="{{`/login?${new URLSearchParams({ returnTo: pathname })}`}}" bindtap="closeSidebar">
          <text class="avatar">访</text>
          <view>
            <text>{{english ? "User sign in" : "用户登录"}}</text>
            <text>{{english ? "Signed out · click to sign in" : "未登录 · 点击进入登录"}}</text>
          </view>
          <Icon name="chevron" size="{{16}}" />
        </navigator>
        <navigator class="profile-guest-admin" href="{{`/admin/login?${new URLSearchParams({ returnTo: &quot;/admin&quot; })}`}}" bindtap="closeSidebar">{{english ? "Administrator sign in" : "管理员登录"}}</navigator>
      </block>
    </view>
  </view>
  <button wx:if="{{mobileOpen}}" class="sidebar-scrim" aria-label="{{english ? &quot;Close navigation overlay&quot; : &quot;关闭导航遮罩&quot;}}" bindtap="closeSidebar" />
  <view class="content-shell">
    <view class="topbar">
      <button class="icon-button mobile-menu" aria-label="{{english ? &quot;Open navigation&quot; : &quot;打开导航&quot;}}" bindtap="onTap">
        <Icon name="menu" />
      </button>
      <view class="breadcrumb">
        <text>ELMOS</text>
        <Icon name="chevron" size="{{13}}" />
        <text>{{currentLabel}}</text>
      </view>
      <button class="command-trigger" aria-label="{{english ? &quot;Open global search&quot; : &quot;打开全局搜索&quot;}}" bindtap="onTap">
        <Icon name="search" size="{{16}}" />
        <text>{{english ? "Search pages and capabilities" : "搜索页面或功能"}}</text>
        <kbd>⌘ K</kbd>
      </button>
      <view class="topbar-actions">
        <text class="environment-pill">
          <text />
          <text>{{english ? "Local contract environment" : "本地契约环境"}}</text>
        </text>
        <text class="topbar-divider" />
        <button class="preference-button" type="button" aria-label="{{english ? &quot;Switch navigation and help to Chinese&quot; : &quot;将导航和帮助切换为英文&quot;}}" bindtap="onTap">{{english ? "中" : "EN"}}</button>
        <button class="preference-button" type="button" aria-label="{{preferences.theme === &quot;light&quot; ? (english ? &quot;Use dark theme&quot; : &quot;使用深色主题&quot;) : (english ? &quot;Use light theme&quot; : &quot;使用浅色主题&quot;)}}" bindtap="onTap">{{preferences.theme === "light" ? "☾" : "☀"}}</button>
        <button class="icon-button" aria-label="{{english ? &quot;Reload current page (clears unsaved input)&quot; : &quot;重新载入当前页面（会清除未保存输入）&quot;}}" bindtap="reloadPage">
          <Icon name="refresh" size="{{18}}" />
        </button>
        <button wx:if="{{account.status === 'authenticated'}}" class="{{`top-avatar ${hasAdminAccess ? &quot;admin-avatar&quot; : &quot;&quot;}`}}" type="button" aria-label="{{english ? &quot;Open account menu&quot; : &quot;打开账户菜单&quot;}}" bindtap="toggleTopProfileMenu">{{account.principal?.displayName.slice(0, 1) ?? "企"}}</button>
        <view wx:else class="anonymous-login-actions">
          <navigator class="{{`top-login-link ${pathname === &quot;/login&quot; ? &quot;active&quot; : &quot;&quot;}`}}" href="{{`/login?${new URLSearchParams({ returnTo: pathname })}`}}">{{english ? "User sign in" : "用户登录"}}</navigator>
          <navigator class="{{`top-login-link top-admin-login-link ${pathname.startsWith(&quot;/admin&quot;) ? &quot;active&quot; : &quot;&quot;}`}}" href="{{`/admin/login?${new URLSearchParams({ returnTo: &quot;/admin&quot; })}`}}">{{english ? "Admin sign in" : "管理员登录"}}</navigator>
        </view>
      </view>
    </view>
    <view id="main-content" class="main-content" tabIndex="{{-1}}">
      <slot />
    </view>
  </view>
  <view class="mobile-bottom-nav" aria-label="{{english ? &quot;Mobile primary navigation&quot; : &quot;移动端主导航&quot;}}">
    <navigator wx:for="{{mobileNavigation}}" wx:key="item.id" href="{{item.href}}" class="{{active ? &quot;active&quot; : &quot;&quot;}}" aria-current="{{active ? &quot;page&quot; : undefined}}" key="{{item.href}}">
      <Icon name="{{item.icon}}" size="{{19}}" />
      <text>{{english ? label : label.replace("Spring 老项目翻新", "Spring").replace("全库跨语言转换", "转换").replace("多语言项目生成", "生成").replace("前端转换工厂", "前端").replace("功能能力中心", "功能")}}</text>
    </navigator>
  </view>
  <button wx:if="{{showBackToTop}}" class="back-to-top" type="button" aria-label="返回页面顶部" bindtap="scrollToTop">
    <Icon name="arrow" size="{{15}}" />
    <text>返回顶部</text>
  </button>
  <view wx:if="{{commandOpen}}" class="command-backdrop" role="presentation" bindmousedown="onMousedown">
    <view ref="{{commandPanel}}" class="command-panel" role="dialog" aria-modal="true" aria-labelledby="command-title" bindkeydown="containDialogFocus">
      <view id="command-title" class="sr-only">全局搜索</view>
      <view class="command-search">
        <Icon name="search" size="{{20}}" />
        <input ref="{{commandInput}}" value="{{commandQuery}}" placeholder="搜索页面或功能…" aria-label="搜索页面或功能" role="combobox" aria-expanded="true" aria-autocomplete="list" aria-controls="command-results" aria-activedescendant="{{visibleCommands.length ? `command-result-${commandActive}` : undefined}}" bindchange="onChange" bindkeydown="handleCommandKey" />
        <button class="icon-button command-close" type="button" aria-label="关闭全局搜索" bindtap="closeCommand">
          <Icon name="close" size="{{17}}" />
        </button>
        <kbd>ESC</kbd>
      </view>
      <view class="command-results" id="command-results" role="listbox" aria-label="搜索结果">
        <navigator wx:for="{{visibleCommands}}" wx:for-index="index" wx:key="item.id" href="{{item.href}}" role="option" aria-selected="{{index === commandActive}}" id="{{`command-result-${index}`}}" class="{{`command-result ${index === commandActive ? &quot;active&quot; : &quot;&quot;}`}}" key="{{`${item.group}-${item.label}`}}" bindtap="closeCommand" bindmouseenter="onMouseenter">
          <text class="command-icon">
            <Icon name="{{item.icon}}" size="{{18}}" />
          </text>
          <text>
            <text>{{item.label}}</text>
            <text>{{item.hint}}</text>
          </text>
          <text>{{item.group}}</text>
          <Icon name="arrow" size="{{15}}" />
        </navigator>
        <view wx:if="{{visibleCommands.length === 0}}" class="command-empty">
          <Icon name="search" size="{{22}}" />
          <text>没有匹配结果</text>
          <text>换个关键词，或直接输入页面名称。</text>
        </view>
      </view>
      <view class="command-footer">
        <text>
          <kbd>↑</kbd>
          <kbd>↓</kbd>
          <text>浏览</text>
        </text>
        <text>
          <kbd>↵</kbd>
          <text>打开</text>
        </text>
        <text>仅导航，不执行外部操作</text>
      </view>
    </view>
  </view>
</view>
