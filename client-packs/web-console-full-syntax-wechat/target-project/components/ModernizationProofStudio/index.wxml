<view class="proof-loop-page">
  <view class="page-hero compact-hero">
    <view>
      <text class="eyebrow">BATCH 105–108 · EVIDENCE-BOUND</text>
      <view>现代化生产证据闭环</view>
    </view>
    <view>
      <text>从 Golden Route、隔离预览、实时 API/浏览器验证，到证据 PR 与客户证书。缺失或过期的独立证据保持</text>
      <code>BLOCKED</code>
      <text>，本地执行不会授予生产批准。</text>
    </view>
  </view>
  <view class="studio-layout proof-loop-layout">
    <view class="surface-card" aria-labelledby="proof-loop-form-title">
      <view class="card-heading">
        <view>
          <text class="overline">DURABLE TENANT JOB</text>
          <view id="proof-loop-form-title">提交验证计划</view>
        </view>
        <StatusChip status="{{job?.resultStatus ?? &quot;NOT_RUN&quot;}}" compact="true" />
      </view>
      <view class="business-form-grid">
        <text><text>闭环目标功能</text> <view value="{{targetSkillId}}" required="true" bindchange="onChange">
  <block wx:if="{{contracts.length}}">
    <view wx:for="{{contracts}}" wx:for-item="contract" wx:key="contract.id" key="{{contract.id}}" value="{{contract.id}}">{{contract.id}} · {{contract.name}}</view>
  </block>
  <view wx:else value="B108-S16">B108-S16 · customer-ready-modernization-certificate</view>
</view></text>
        <text><text>项目 ID</text> <input value="{{projectId}}" required="true" pattern="[A-Za-z0-9][A-Za-z0-9._:@/-]{0,159}" autoComplete="off" bindchange="onChange" /></text>
        <text><text>仓库 ID</text> <input value="{{repositoryId}}" required="true" pattern="[A-Za-z0-9][A-Za-z0-9._:@/-]{0,159}" autoComplete="off" bindchange="onChange" /></text>
        <text><text>策略摘要</text> <input value="{{policyDigest}}" required="true" pattern="(?:sha256:)?[a-f0-9]{64}" placeholder="sha256:…" spellCheck="{{false}}" bindchange="onChange" /></text>
        <text><text>Baseline Commit（可选）</text> <input value="{{baselineCommit}}" pattern="[a-f0-9]{40,64}" spellCheck="{{false}}" bindchange="onChange" /></text>
        <text><text>Candidate Commit（可选）</text> <input value="{{candidateCommit}}" pattern="[a-f0-9]{40,64}" spellCheck="{{false}}" bindchange="onChange" /></text>
        <text class="proof-wide"><text>OCI 镜像摘要（可选）</text> <input value="{{imageDigest}}" pattern="(?:sha256:)?[a-f0-9]{64}" placeholder="sha256:…" spellCheck="{{false}}" bindchange="onChange" /></text>
        <text class="proof-wide"><text>类型化 Inputs JSON</text> <textarea value="{{inputs}}" rows="{{8}}" spellCheck="{{false}}" bindchange="onChange" /></text>
        <text class="proof-wide"><text>独立 Evidence Assertions JSON</text> <textarea value="{{evidence}}" rows="{{10}}" spellCheck="{{false}}" bindchange="onChange" /></text>
      </view>
      <view class="form-note">提交不会重试非幂等写操作；服务端按租户、Actor 与规范请求摘要生成幂等键。证据必须含独立 Producer/Verifier、签名校验、重算字节和内容地址。</view>
      <view class="business-actions">
        <button class="button button-primary" type="button" disabled="{{busy || !projectId.trim() || !repositoryId.trim() || !policyDigest.trim()}}" bindtap="onTap">{{busy ? "处理中…" : "提交证据闭环"}}</button>
        <button wx:if="{{job && !terminal.has(job.status)}}" class="button button-secondary" type="button" disabled="{{busy}}" bindtap="onTap">取消作业</button>
      </view>
      <view wx:if="{{error}}" class="field-error" role="alert">{{error}}</view>
    </view>
    <view class="surface-card detail-panel proof-loop-summary" aria-labelledby="proof-loop-summary-title">
      <view class="card-heading">
        <view>
          <text class="overline">FAIL-CLOSED STATUS</text>
          <view id="proof-loop-summary-title">计划与证据</view>
        </view>
      </view>
      <view wx:if="{{selected}}">
        <view>
          <view>目标</view>
          <view>
            <code>{{selected.id}}</code>
          </view>
        </view>
        <view>
          <view>执行边界</view>
          <view>{{selected.executionClass}}</view>
        </view>
        <view>
          <view>合同摘要</view>
          <view>
            <code>{{selected.canonicalSha256.slice(0, 22)}} …</code>
          </view>
        </view>
        <view>
          <view>直接依赖</view>
          <view>{{selected.dependencies.join(", ") || "无"}}</view>
        </view>
      </view>
      <view wx:else>正在读取 64 个不可变合同…</view>
      <view wx:if="{{subjectDigest}}" class="proof-subject">
        <text>Subject Digest</text>
        <code>{{subjectDigest}}</code>
      </view>
      <view wx:if="{{selected}}">
        <view>声明的证据槽位</view>
        <view>
          <view wx:for="{{selected.evidenceSlots}}" wx:for-item="slot" wx:key="slot.id" key="{{slot}}">
            <code>{{slot}}</code>
          </view>
        </view>
      </view>
      <view wx:if="{{job}}" class="proof-job" aria-live="polite">
        <view class="generation-progress" aria-label="{{`作业进度 ${job.progress}%`}}">
          <text style="{{{ width: `${job.progress}%` }}}" />
        </view>
        <view>
          <view>
            <view>Job</view>
            <view>
              <code>{{job.jobId}}</code>
            </view>
          </view>
          <view>
            <view>队列状态</view>
            <view>{{job.status}}</view>
          </view>
          <view>
            <view>证据结果</view>
            <view>{{job.resultStatus}}</view>
          </view>
          <view>
            <view>阶段</view>
            <view>{{job.stage}}</view>
          </view>
          <view wx:if="{{job.failureCode}}">
            <view>失败代码</view>
            <view>{{job.failureCode}}</view>
          </view>
        </view>
        <view wx:if="{{job.artifacts?.length}}" class="proof-artifacts">
          <view wx:for="{{job.artifacts}}" wx:for-item="artifact" wx:key="artifact.id" key="{{`${artifact.role}:${artifact.contentSha256}`}}">
            <text>{{artifact.role}}</text>
            <text>{{artifact.filename}}</text>
            <code>{{artifact.contentSha256.slice(0, 22)}} … · {{artifact.byteSize}} B</code>
          </view>
        </view>
        <view wx:else class="form-note">结果工件尚未由对象存储发布。</view>
      </view>
      <view wx:else class="form-note">尚未提交。即使代码构建通过，外部 Provider、浏览器、SCM 与客户验收证据也不会自动变成 PASS。</view>
    </view>
  </view>
</view>
