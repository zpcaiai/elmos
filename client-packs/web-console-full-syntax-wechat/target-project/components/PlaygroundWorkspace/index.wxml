        <text>{{`// SPECIFICATION EXAMPLE ONLY — NOT GENERATED OR VERIFIED
method {:verify true} Withdraw(balance: int, amount: int) returns (newBal: int, ok: bool)
  requires balance >= 0
  requires amount > 0
  ensures ok ==> newBal == balance - amount && newBal >= 0
  ensures !ok ==> newBal == balance
{
  if balance >= amount {
    newBal := balance - amount;
    ok := true;
  } else {
    newBal := balance;
    ok := false;
  }
}`}}</text>
        <text></text>
