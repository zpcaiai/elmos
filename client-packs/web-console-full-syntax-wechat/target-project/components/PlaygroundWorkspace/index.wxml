        <text></text>
        <text>
          <text>Lines:</text>
          <text>{{sourceCode.split("\n").length}}</text>
        </text>
        <text></text>
        <text>
          <text>Parser: NOT_RUN</text>
        </text>
        <text></text>
      </view>
      <text></text>
    </view>
    <text></text>
    <text></text>
    <text></text>
    <view class="flex flex-col rounded-2xl border border-border bg-card p-5 shadow-xs">
      <text></text>
      <view class="mb-3 flex items-center justify-between">
        <text></text>
        <view class="flex items-center gap-2">
          <text></text>
          <text class="flex h-2.5 w-2.5 rounded-full bg-emerald-500" />
          <text></text>
          <text htmlFor="playground-target-code" class="font-semibold text-foreground">
            <text>静态目标示例（非转换结果）</text>
