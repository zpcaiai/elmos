        </select>
        <text></text>
      </view>
      <text></text>
      <textarea id="playground-target-code" aria-label="静态目标代码示例" readOnly="true" value="{{targetCode}}" rows="{{16}}" class="w-full resize-y rounded-xl border border-border bg-muted/40 p-4 font-mono text-xs text-foreground focus:outline-hidden" spellCheck="{{false}}" />
