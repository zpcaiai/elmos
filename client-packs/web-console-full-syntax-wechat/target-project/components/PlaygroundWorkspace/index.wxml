<view class="space-y-6">
  <text></text>
  <text></text>
  <text></text>
  <view class="rounded-2xl border border-border bg-card p-6 shadow-sm">
    <text></text>
    <view class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
