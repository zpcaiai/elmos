<view class="{{styles.page}}">
  <view class="{{styles.hero}}">
    <view>
      <text class="{{styles.eyebrow}}">Repository workspace</text>
      <view>代码仓库工作区</view>
      <view>从 GitHub、Gitee 或其他 HTTPS Git 服务拉取精确提交，读取并修改代码、说明、配置以及本地/云端部署文件，并交接到完整项目生成流程。</view>
    </view>
    <view class="{{styles.boundary}}">
      <Icon name="lock" size="{{18}}" />
      <view>
        <text>受控交付边界</text>
        <text>Commit、Push、PR 分权执行；不自动合并或部署</text>
      </view>
    </view>
  </view>
  <form class="{{styles.connect}}" bindsubmit="createWorkspace">
    <text wx:if="{{account.status !== 'authenticated'}}" class="{{styles.tokenField}}">
      <text>开发访问令牌</text>
      <input type="password" autoComplete="off" value="{{accessToken}}" placeholder="仅保存在当前页面内存中" required="true" minLength="{{24}}" bindchange="onChange" />
    </text>
    <view wx:if="{{account.status === 'authenticated'}}" class="{{styles.accountIdentity}}">
      <text>当前企业身份</text>
      <text>{{account.principal?.displayName}}</text>
      <text>{{account.principal?.organizationId}}</text>
    </view>
    <text>
      <text>托管平台</text>
      <view value="{{provider}}" bindchange="onChange">
        <view value="GITHUB">GitHub</view>
        <view value="GITEE">Gitee</view>
        <view value="GENERIC_GIT">其他 Git</view>
      </view>
    </text>
    <text class="{{styles.urlField}}">
      <text>HTTPS Clone URL</text>
      <input value="{{cloneUrl}}" placeholder="https://host/owner/repository.git" required="true" bindchange="onChange" />
    </text>
    <text>
      <text>分支 / 标签 / 提交</text>
      <input value="{{requestedRef}}" required="true" bindchange="onChange" />
    </text>
    <text>
      <text>仓库原生标识</text>
      <input value="{{nativeRepositoryId}}" placeholder="owner/repository" required="true" bindchange="onChange" />
    </text>
    <text>
      <text>Provider 实例</text>
      <input value="{{providerInstanceId}}" required="true" bindchange="onChange" />
    </text>
    <text>
      <text>私库凭据引用（可选）</text>
      <input value="{{credentialRef}}" placeholder="server-side credential ref" bindchange="onChange" />
    </text>
    <button class="{{styles.primary}}" type="submit" disabled="{{busy}}">拉取并建立工作区</button>
    <text class="{{styles.recoveryField}}">
      <text>恢复工作区 ID</text>
      <input value="{{recoveryId}}" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" bindchange="onChange" />
    </text>
    <button class="{{styles.secondary}}" type="button" disabled="{{busy || !recoveryId}}" bindtap="recoverWorkspace">按身份恢复</button>
  </form>
  <view wx:if="{{feedback}}" class="{{styles.feedback}}" role="status">{{feedback}}</view>
  <block wx:if="{{workspace}}">
    <view class="{{styles.metrics}}" aria-label="工作区状态">
      <view>
        <text>当前 HEAD</text>
        <text>{{workspace.currentHeadCommit.slice(0, 12)}}</text>
        <text>来源 {{workspace.sourceCommit.slice(0, 12)}} · {{workspace.requestedRef}}</text>
      </view>
      <view>
        <text>文件总数</text>
        <text>{{workspace.files.length}}</text>
        <text>最多受服务端限额约束</text>
      </view>
      <view>
        <text>完整性</text>
        <text>{{workspace.completeness === "COMPLETE" ? "完整" : "只读"}}</text>
        <text>{{workspace.blockers.join(" · ") || "无阻断项"}}</text>
      </view>
      <view>
        <text>交付状态</text>
        <text>{{workspace.status}}</text>
        <text>{{workspace.pullRequestId ? `PR ${workspace.pullRequestId}` : workspace.pushedCommit ? "远端分支已校验" : "远端未变更"}}</text>
      </view>
    </view>
    <view class="{{styles.toolbar}}">
      <view>
        <text>{{workspace.nativeRepositoryId}}</text>
        <text>{{workspace.workspaceId}} · {{workspace.branch}}</text>
      </view>
      <text>
        <text>新文件路径</text>
        <input value="{{newPath}}" placeholder="docs/new-file.md" bindchange="onChange" />
      </text>
      <button class="{{styles.secondary}}" type="button" disabled="{{busy || workspace.completeness !== &quot;COMPLETE&quot;}}" bindtap="beginNewFile">新建文件</button>
      <button class="{{styles.primary}}" type="button" disabled="{{busy || workspace.completeness !== &quot;COMPLETE&quot;
              || workspace.pendingPaths.length &gt; 0}}" bindtap="continueToProjectGeneration">项目生成</button>
      <button class="{{styles.secondary}}" type="button" disabled="{{busy || workspace.completeness !== &quot;COMPLETE&quot;
              || workspace.pendingPaths.length &gt; 0}}" bindtap="continueToTranslation">跨语言转换</button>
      <button class="{{styles.secondary}}" type="button" disabled="{{busy || workspace.completeness !== &quot;COMPLETE&quot;
              || workspace.pendingPaths.length &gt; 0}}" bindtap="continueToSpring">Spring 现代化</button>
      <text>
        <text>文件分类</text>
        <view value="{{filter}}" bindchange="onChange">
          <view value="ALL">全部</view>
          <view wx:for="{{Object.entries(categoryLabels)}}" wx:for-item="[value, label]" wx:key="[value, label].id" value="{{value}}" key="{{value}}">{{label}}</view>
        </view>
      </text>
      <button class="{{styles.danger}}" type="button" disabled="{{busy}}" bindtap="deleteWorkspace">删除本地工作区</button>
    </view>
    <view class="{{styles.workspaceGrid}}">
      <view class="{{styles.filePanel}}">
        <view>
          <view>仓库文件</view>
          <text>{{files.length}} 项</text>
        </view>
        <view class="{{styles.fileList}}">
          <button wx:for="{{files}}" wx:for-item="file" wx:key="file.id" type="button" key="{{file.path}}" class="{{selected?.path === file.path ? styles.activeFile : &quot;&quot;}}" disabled="{{busy || !file.readable}}" bindtap="onTap">
            <text>
              <text>{{file.path}}</text>
              <text>{{categoryLabels[file.category]}} · {{file.bytes}} B</text>
            </text>
            <text>{{!file.readable ? "受保护" : file.writable ? "可修改" : "只读"}}</text>
          </button>
        </view>
      </view>
      <view class="{{styles.editorPanel}}">
        <block wx:if="{{selected}}">
          <view>
            <view>
              <view>{{selected.path}}</view>
              <text>UTF-8 · {{selected.sha256.slice(0, 16)}} …</text>
            </view>
            <text>{{categoryLabels[selected.category]}}</text>
          </view>
          <textarea aria-label="文件内容" spellCheck="{{false}}" value="{{editor}}" disabled="{{workspace.completeness !== &quot;COMPLETE&quot;
                  || workspace.files.find((file) =&gt; file.path === selected.path)?.readable === false
                  || workspace.files.find((file) =&gt; file.path === selected.path)?.writable === false}}" bindchange="onChange" />
          <text class="{{styles.intent}}">
            <text>变更意图</text>
            <textarea value="{{intent}}" maxLength="{{2000}}" bindchange="onChange" />
          </text>
          <text wx:if="{{workspace.codeOwnersPresent}}" class="{{styles.approval}}">
            <input type="checkbox" checked="{{ownerApproved}}" bindchange="onChange" />
            <text>已获得此路径所需的 CODEOWNERS 明确批准</text>
          </text>
          <view class="{{styles.editorActions}}">
            <text>保存只写入隔离工作区，不触发外部操作。</text>
            <view>
              <button class="{{styles.danger}}" type="button" disabled="{{busy || !selected.sha256 || workspace.completeness !== &quot;COMPLETE&quot;}}" bindtap="deleteSelectedFile">删除文件</button>
              <button class="{{styles.primary}}" type="button" disabled="{{busy
                      || (selected.sha256 !== &quot;&quot; &amp;&amp; editor === selected.content)
                      || workspace.completeness !== &quot;COMPLETE&quot;}}" bindtap="applyChange">保存本地修改</button>
            </view>
          </view>
        </block>
        <view wx:else class="{{styles.empty}}">
          <Icon name="file" size="{{26}}" />
          <text>选择一个文本文件</text>
          <text>二进制、密钥与受保护路径不会开放编辑。</text>
        </view>
      </view>
    </view>
    <view class="{{styles.delivery}}" aria-label="受控代码交付">
      <view>
        <view>
          <text class="{{styles.eyebrow}}">Controlled delivery</text>
          <view>提交、推送与 Pull Request</view>
        </view>
        <text>每一步都校验租户、权限、HEAD 和路径范围；不会自动合并或部署。</text>
      </view>
      <view class="{{styles.deliveryGrid}}">
        <view>
          <text>1. 本地 Commit</text>
          <text>
            <text>提交说明</text>
            <input value="{{commitMessage}}" maxLength="{{4000}}" bindchange="onChange" />
          </text>
          <text>{{workspace.pendingPaths.length > 0
                ? `${workspace.pendingPaths.length} 个待提交路径：${workspace.pendingPaths.join("、")}`
                : "没有待提交文件。"}}</text>
          <button class="{{styles.primary}}" type="button" data-operation-id="repository.commit" disabled="{{busy || workspace.pendingPaths.length === 0 || commitMessage.trim().length === 0}}" bindtap="commitWorkspace">提交已批准路径</button>
        </view>
        <view>
          <text>2. 推送受控分支</text>
          <text>
            <text>短期凭据引用</text>
            <input value="{{deliveryCredentialRef}}" placeholder="最长 1 小时的服务端 Lease" bindchange="onChange" />
          </text>
          <text>仅推送 {{workspace.branch}} ；禁止 force push，并回读远端 SHA。</text>
          <button class="{{styles.primary}}" type="button" data-operation-id="repository.push" disabled="{{busy || workspace.pendingPaths.length &gt; 0
                  || workspace.currentHeadCommit === workspace.sourceCommit
                  || workspace.pushedCommit === workspace.currentHeadCommit}}" bindtap="pushWorkspace">推送并校验远端</button>
        </view>
        <view>
          <text>3. 创建 Pull Request</text>
          <text>
            <text>目标分支</text>
            <input value="{{baseBranch}}" bindchange="onChange" />
          </text>
          <text>
            <text>标题</text>
            <input value="{{pullRequestTitle}}" maxLength="{{240}}" bindchange="onChange" />
          </text>
          <text>
            <text>说明</text>
            <textarea value="{{pullRequestBody}}" maxLength="{{8000}}" bindchange="onChange" />
          </text>
          <button class="{{styles.primary}}" type="button" data-operation-id="repository.pull_request" disabled="{{busy || provider === &quot;GENERIC_GIT&quot;
                  || workspace.pushedCommit !== workspace.currentHeadCommit
                  || Boolean(workspace.pullRequestId)}}" bindtap="createPullRequest">创建 PR</button>
          <navigator wx:if="{{workspace.pullRequestUrl}}" href="{{workspace.pullRequestUrl}}" target="_blank" rel="noreferrer">
            <text>打开 PR</text>
            <text>{{workspace.pullRequestId}}</text>
          </navigator>
        </view>
      </view>
      <input type="hidden" value="{{pullRequestKey}}" bindchange="onChange" />
    </view>
  </block>
</view>
