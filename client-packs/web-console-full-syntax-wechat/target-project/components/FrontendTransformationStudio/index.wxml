            <text>{{action}}</text>
          </button>
          <text></text>
        </view>
        <text></text>
        <view wx:if="{{operationError}}" class="{{styles.operationError}}" role="alert">
          <text>{{operationError}}</text>
        </view>
        <text></text>
      </view>
      <text></text>
      <view class="{{styles.runWorkspace}}" aria-live="polite">
        <text></text>
        <view class="{{styles.runSummary}}">
          <text></text>
          <view>
            <text>
              <text>Run</text>
            </text>
            <text>
              <text>{{run?.runId ?? "尚未创建"}}</text>
            </text>
          </view>
          <text></text>
          <view>
            <text>
              <text>状态</text>
            </text>
            <text data-run-state="{{run?.state ?? "EMPTY"}}">
              <text>{{run?.state ?? "EMPTY"}}</text>
            </text>
          </view>
          <text></text>
          <view>
            <text>
              <text>结果</text>
            </text>
            <text>
              <text>{{run?.outcome ?? "等待操作"}}</text>
            </text>
          </view>
          <text></text>
          <view>
            <text>
              <text>版本</text>
            </text>
            <text>
              <text>{{run?.version ?? 0}}</text>
            </text>
          </view>
          <text></text>
          <view wx:if="{{run}}" class="{{styles.lifecycleActions}}">
            <text></text>
            <button type="button" disabled="{{busy || run.state !== "QUEUED"}}" bindtap="() => void transition("claim")">
              <text>Runner 领取</text>
            </button>
            <text></text>
            <button type="button" disabled="{{busy || run.state !== "RUNNING"}}" bindtap="() => void transition("heartbeat")">
              <text>续租</text>
            </button>
            <text></text>
            <button type="button" disabled="{{busy || !["QUEUED", "RUNNING"].includes(run.state)}}" bindtap="() => void transition("cancel")">
              <text>取消</text>
            </button>
            <text></text>
            <button type="button" disabled="{{busy || !["BLOCKED", "FAILED", "CANCELLED"].includes(run.state) || run.action !== "EXECUTE"}}" bindtap="() => void transition("retry")">
              <text>重试</text>
            </button>
            <text></text>
            <button type="button" disabled="{{busy}}" bindtap="() => void refreshRun()">
              <text>刷新</text>
            </button>
            <text></text>
          </view>
          <text></text>
        </view>
        <text></text>
        <view class="{{styles.resultPanels}}">
          <text></text>
          <view>
            <text></text>
            <view>
              <text>Findings</text>
              <text>
                <text>{{run?.findings.length ?? 0}}</text>
              </text>
            </view>
            <text></text>
            <view wx:if="{{run?.findings.length}}" tabIndex="{{0}}" aria-label="FRT Findings 列表">
              <view wx:for="{{run.findings}}" wx:for-index="index" wx:key="item.id" key="{{`${item.code}-${index}`}}" data-severity="{{item.severity}}">
                <text>
                  <text>{{item.code}}</text>
                </text>
                <view>
                  <text>{{item.message}}</text>
                </view>
                <text>
                  <view wx:if="{{item.blocking}}" />
                  <view wx:else />
                </text>
              </view>
            </view>
            <view wx:else>
              <text>暂无 Finding。</text>
            </view>
            <text></text>
          </view>
          <text></text>
          <view>
            <text></text>
            <view>
              <text>Artifacts</text>
              <button type="button" disabled="{{!run}}" bindtap="downloadArtifacts">
                <text>下载 JSON</text>
              </button>
            </view>
            <text></text>
            <pre tabIndex="{{0}}" aria-label="FRT 运行产物 JSON">
              <view wx:if="{{run}}" />
              <view wx:else />
            </pre>
            <text></text>
          </view>
          <text></text>
          <view>
            <text></text>
            <view>
              <text>Evidence</text>
              <text>
                <text>{{run?.evidence.length ?? 0}}</text>
              </text>
            </view>
            <text></text>
            <view wx:if="{{run?.evidence.length}}" tabIndex="{{0}}" aria-label="FRT Evidence 列表">
              <view wx:for="{{run.evidence}}" wx:key="item.id" key="{{`${item.role}-${item.uri}`}}">
                <text>
                  <text>{{item.role}}</text>
                </text>
                <code>
                  <text>{{item.state}}</text>
                </code>
                <text>
                  <text>{{item.digest}}</text>
                </text>
              </view>
            </view>
            <view wx:else>
              <text>没有签名 Evidence；VERIFY 将 fail-closed。</text>
            </view>
            <text></text>
            <text wx:if="{{run}}">
              <text>Gate eligible:</text>
              <text>{{String(run.certificateFragment.eligibleForBatchGate)}}</text>
              <text>·</text>
              <text>{{run.certificateFragment.certification}}</text>
            </text>
            <text></text>
          </view>
          <text></text>
          <view>
            <text></text>
            <view>
              <text>Audit trail</text>
              <text>
                <text>{{audit.length}}</text>
              </text>
            </view>
            <text></text>
            <view wx:if="{{audit.length}}" tabIndex="{{0}}" aria-label="FRT Audit trail">
              <view wx:for="{{audit}}" wx:key="item.id" key="{{item.sequence}}">
                <text>
                  <text>{{item.event}}</text>
                </text>
                <text>
                  <text>{{item.state}}</text>
                  <text>· v</text>
                  <text>{{item.version}}</text>
                </text>
                <text>
                  <text>{{item.actor}}</text>
                  <text>·</text>
                  <text>{{new Date(item.at).toLocaleString()}}</text>
                </text>
              </view>
            </view>
            <view wx:else>
              <text>运行创建后显示持久化审计事件。</text>
            </view>
            <text></text>
          </view>
          <text></text>
        </view>
        <text></text>
      </view>
      <text></text>
    </view>
    <text></text>
  </view>
  <text></text>
