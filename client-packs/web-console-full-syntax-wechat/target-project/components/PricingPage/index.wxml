<view class="{{`page-stack ${'page'}`}}">
  <view class="{{'hero'}}">
    <view>
      <text class="overline">ELMOS SELF-SERVE · CNY</text>
      <view>先验证价值，再为持续交付付费。</view>
      <view>参考主流 AI 开发工具的免费与专业版结构，以人民币提供清晰的 token、 credits 和项目额度。没有“无限使用”的模糊承诺，也不会自动产生超额费用。</view>
    </view>
    <view class="{{'heroFacts'}}" aria-label="套餐摘要">
      <view>
        <text>14 天</text>
        <text>免费体验</text>
      </view>
      <view>
        <text>¥129</text>
        <text>专业月付</text>
      </view>
      <view>
        <text>省 ¥258</text>
        <text>专业年付</text>
      </view>
    </view>
  </view>
  <view class="{{'statusNotice'}}" role="status">
    <Icon name="clock" size="{{17}}" />
    <view>
      <text>套餐目录已实现，收款尚未开放</text>
      <text>当前目录版本 {{pricingCatalog.catalogVersion}} 为 DRAFT；支付、税务与开票均为 NOT_CONFIGURED。</text>
    </view>
    <navigator href="/commercialization">
      <text>查看控制面</text>
      <Icon name="arrow" size="{{14}}" />
    </navigator>
  </view>
  <SubscriptionManager />
  <UsageDashboard allowLocalCredentials="{{process.env.ELMOS_LOCAL_RUNNER_ENABLED === &quot;true&quot;}}" emailAlertsEnabled="{{process.env.ELMOS_USAGE_EMAIL_ALERTS_ENABLED === &quot;true&quot;}}" />
  <CreditWalletPanel />
  <view aria-labelledby="pricing-plans-title">
    <view class="section-heading">
      <view>
        <text class="overline">PLANS</text>
        <view id="pricing-plans-title">选择适合当前阶段的计划</view>
      </view>
      <text class="quiet-label">全部以人民币结算 · 税费口径待配置</text>
    </view>
    <view class="{{'planGrid'}}">
      <view wx:for="{{pricingCatalog.plans}}" wx:for-item="plan" wx:key="plan.id" class="{{`${'planCard'} ${plan.featured ? 'featured' : &quot;&quot;}`}}" key="{{plan.planId}}">
        <text wx:if="{{plan.featured}}" class="{{'recommended'}}">推荐</text>
        <text class="overline">{{plan.eyebrow}}</text>
        <view>{{plan.name}}</view>
        <view class="{{'planDescription'}}">{{plan.description}}</view>
        <view class="{{'priceLine'}}">
          <text>{{formatCny(plan.priceFen)}}</text>
          <text>/ {{plan.billingLabel}}</text>
        </view>
        <view wx:if="{{plan.planId === 'elmos-pro-annual'}}" class="{{'savings'}}">折合 {{formatCny(plan.effectiveMonthlyFen)}} /月，比连续月付节省 ¥258.00</view>
        <view wx:if="{{plan.planId === 'elmos-free-trial'}}" class="{{'savings'}}">一次性额度 · 到期不自动扣费</view>
        <view wx:if="{{plan.planId === 'elmos-pro-monthly'}}" class="{{'savings'}}">随时按月评估 · 不自动超额计费</view>
        <view class="{{'quotaPanel'}}" aria-label="{{`${plan.name}用量额度`}}">
          <view>
            <text>模型 Token</text>
            <text>{{formatQuota(plan.tokens)}}</text>
            <text>{{plan.allowanceWindow === "MONTHLY" ? "每月重置" : "14 天总额"}}</text>
          </view>
          <view>
            <text>平台 Credits</text>
            <text>{{formatQuota(plan.credits)}}</text>
            <text>{{plan.allowanceWindow === "MONTHLY" ? "每月重置" : "14 天总额"}}</text>
          </view>
        </view>
        <view wx:if="{{plan.allowanceWindow === 'MONTHLY'}}" class="{{'annualCeiling'}}">{{plan.planId === "elmos-pro-annual" ? "年度合同上限" : "连续使用 12 个月"}} ： {{formatQuota(plan.annualTokens)}} token · {{formatQuota(plan.annualCredits)}} credits</view>
        <view class="{{'featureList'}}">
          <view wx:for="{{plan.features}}" wx:for-item="feature" wx:key="feature.id" key="{{feature}}">
            <Icon name="check" size="{{15}}" />
            <text>{{feature}}</text>
          </view>
        </view>
        <view class="{{'planAction'}}">
          <PlanBillingAction plan="{{plan}}" orderable="{{catalogOrderable}}" />
        </view>
      </view>
    </view>
  </view>
  <view aria-labelledby="one-time-products-title">
    <view class="section-heading">
      <view>
        <text class="overline">ONE-TIME PURCHASES</text>
        <view id="one-time-products-title">按需购买，不必先订阅</view>
      </view>
      <text class="quiet-label">订单、履约与消耗记录均可追溯</text>
    </view>
    <view class="{{'planGrid'}}">
      <view wx:for="{{pricingCatalog.creditPacks}}" wx:for-item="product" wx:key="product.id" class="{{'planCard'}}" key="{{product.sku}}">
        <text class="overline">CREDIT PACK</text>
        <view>{{product.name}}</view>
        <view class="{{'planDescription'}}">{{product.description}}</view>
        <view class="{{'priceLine'}}">
          <text>{{formatCny(product.priceFen)}}</text>
        </view>
        <view class="{{'savings'}}">{{formatQuota(product.credits)}} Credits · {{product.expiryDays}} 天有效</view>
        <ProductBillingAction product="{{product}}" orderable="{{catalogOrderable}}" />
      </view>
      <view wx:for="{{pricingCatalog.oneTimeProducts}}" wx:for-item="product" wx:key="product.id" class="{{'planCard'}}" key="{{product.sku}}">
        <text class="overline">PROJECT PASS</text>
        <view>{{product.name}}</view>
        <view class="{{'planDescription'}}">{{product.description}}</view>
        <view class="{{'priceLine'}}">
          <text>{{formatCny(product.priceFen)}}</text>
        </view>
        <view class="{{'savings'}}">绑定一个项目 · 最多 {{product.maxRunnerMinutes}} 分钟 Runner</view>
        <ProductBillingAction product="{{product}}" orderable="{{catalogOrderable}}" />
      </view>
    </view>
  </view>
  <view class="{{'meterSection'}}" aria-labelledby="credit-meter-title">
    <view class="{{'meterIntro'}}">
      <text class="overline">USAGE METER</text>
      <view id="credit-meter-title">Token 与 Credit 如何扣减</view>
      <view>Token 衡量模型实际推理量；Credit 衡量 ELMOS 的分析、隔离执行和验证资源。 使用模型的工作会同时扣减已确认 token 与对应操作 credits。</view>
    </view>
    <view class="{{'rateTable'}}" role="table" aria-label="Credit 扣减表">
      <view class="{{'rateHead'}}" role="row">
        <text role="columnheader">操作</text>
        <text role="columnheader">单价</text>
      </view>
      <view wx:for="{{pricingCatalog.creditRates}}" wx:for-item="rate" wx:key="rate.id" class="{{'rateRow'}}" role="row" key="{{rate.operationKey}}">
        <text role="cell">{{rate.label}}</text>
        <text role="cell">{{rate.credits}} credits / {{rate.unit}}</text>
      </view>
    </view>
  </view>
  <view class="{{'rules'}}" aria-labelledby="usage-rules-title">
    <view>
      <text class="overline">BILLING GUARDRAILS</text>
      <view id="usage-rules-title">用量规则</view>
    </view>
    <view>
      <view wx:for="{{pricingCatalog.limitations}}" wx:for-item="limitation" wx:key="limitation.id" key="{{limitation}}">
        <Icon name="shield" size="{{16}}" />
        <text>{{limitation}}</text>
      </view>
    </view>
    <navigator class="text-link" href="/api/pricing" target="_blank" rel="noreferrer">
      <text>查看套餐 API</text>
      <Icon name="external" size="{{14}}" />
    </navigator>
  </view>
</view>
