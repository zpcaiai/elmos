<view class="{{styles.dashboard}}" aria-labelledby="live-usage-title">
  <view class="{{styles.intro}}">
    <text class="overline">LIVE USAGE</text>
    <view id="live-usage-title">实时查看 Token 与 Credit 消耗</view>
    <view>每 5 秒读取一次 PostgreSQL 原子计量账本。已结算与处理中额度分别显示；
          页面隐藏时暂停刷新，返回后立即同步。</view>
  </view>
  <form wx:if="{{allowLocalCredentials && !session}}" class="{{styles.connection}}" bindsubmit="connect">
    <text>
      <text>本地租户标识</text>
      <input aria-label="用量租户标识" value="{{form.tenantId}}" pattern="[A-Za-z0-9][A-Za-z0-9._:-]{0,127}" required="true" autoComplete="off" bindchange="onChange" />
    </text>
    <text>
      <text>本地用户标识</text>
      <input aria-label="用量用户标识" value="{{form.actorId}}" pattern="[A-Za-z0-9][A-Za-z0-9._:-]{0,127}" required="true" autoComplete="off" bindchange="onChange" />
    </text>
    <text class="{{styles.tokenField}}">
      <text>本地短期令牌</text>
      <input aria-label="用量短期访问令牌" type="password" value="{{form.token}}" minLength="{{24}}" required="true" autoComplete="off" bindchange="onChange" />
    </text>
    <button class="button button-primary" type="submit">
      <text>连接本地用量</text>
      <Icon name="arrow" size="{{15}}" />
    </button>
  </form>
  <view wx:if="{{session}}" class="{{styles.sessionBar}}">
    <view>
      <text class="{{styles.liveDot}}" aria-hidden="true" />
      <text>
        <text wx:if="{{readState.kind === "loading"}}">{{"正在同步"}}</text>
        <text wx:else>{{"账户计量已连接"}}</text>
      </text>
      <text>
        <text wx:if="{{session.kind === "account"}}">{{"安全账户会话 · 租户由身份声明确定"}}</text>
        <text wx:else>{{`${session.credentials.tenantId} · ${session.credentials.actorId}`}}</text>
      </text>
    </view>
    <button wx:if="{{session.kind === "local"}}" class="button button-secondary" type="button" bindtap="onTap">断开本地连接</button>
  </view>
  <view class="{{styles.announcement}}" aria-live="polite" aria-atomic="true">
    <text wx:if="{{readState.kind === "idle"}}">{{"连接本地开发凭证后显示可信用量。"}}</text>
    <text wx:if="{{readState.kind === "loading"}}">{{"正在读取最新用量。"}}</text>
    <text wx:if="{{error}}">{{`${error.code}：${error.message}`}}</text>
    <text wx:if="{{readState.kind === "current"}}">{{snapshot?.status === "CURRENT"
            ? "已同步全部已对账用量。"
            : `当前有 ${snapshot?.unreconciledEventCount ?? 0} 条未对账事件。`}}</text>
  </view>
  <view wx:if="{{error}}" class="{{styles.errorNotice}}" role="alert">
    <Icon name="{{error.status === &quot;NOT_CONFIGURED&quot; ? &quot;clock&quot; : &quot;help&quot;}}" size="{{17}}" />
    <view>
      <text>
        <text wx:if="{{error.status === "NOT_CONFIGURED"}}">{{"计量源尚未就绪"}}</text>
        <text wx:else>{{"实时读数暂不可用"}}</text>
      </text>
      <text>{{error.message}}</text>
    </view>
  </view>
  <block wx:if="{{snapshot}}">
    <view class="{{styles.snapshotHead}}">
      <view>
        <text>当前计划</text>
        <text>{{snapshot.plan.displayName}}</text>
        <text>{{snapshot.plan.planId}}</text>
      </view>
      <view>
        <text>刷新状态</text>
        <text class="{{snapshot.status === &quot;PARTIAL&quot; ? styles.warning : &quot;&quot;}}">
          <text wx:if="{{readState.kind === "stale"}}">{{"STALE"}}</text>
          <text wx:else>{{snapshot.status}}</text>
        </text>
        <text>
          <text>更新于</text>
          <text>{{localTime(snapshot.generatedAt)}}</text>
        </text>
      </view>
      <view>
        <text>额度重置</text>
        <text>
          <text wx:if="{{snapshot.period.resetsAt}}">{{localTime(snapshot.period.resetsAt)}}</text>
          <text wx:else>{{"到期后结束"}}</text>
        </text>
        <text>
          <text>{{localTime(snapshot.period.startsAt)}}</text>
          <text>起</text>
        </text>
      </view>
    </view>
    <view class="{{styles.meterGrid}}">
      <UsageMeter label="模型 Token" unit="tokens" measure="{{snapshot.tokens}}" />
      <UsageMeter label="平台 Credits" unit="credits" measure="{{snapshot.credits}}" />
    </view>
    <view class="{{styles.evidenceLine}}">
      <text>
        <Icon name="check" size="{{14}}" />
        <text>已对账事件</text>
        <text>{{snapshot.reconciledEventCount}}</text>
      </text>
      <text>
        <Icon name="clock" size="{{14}}" />
        <text>未对账事件</text>
        <text>{{snapshot.unreconciledEventCount}}</text>
      </text>
      <text>
        <text>事件水位</text>
        <text wx:if="{{snapshot.eventWatermark}}">{{localTime(snapshot.eventWatermark)}}</text>
        <text wx:else>{{"暂无事件"}}</text>
      </text>
    </view>
  </block>
  <view wx:if="{{!allowLocalCredentials && snapshot}}" class="{{styles.insights}}" aria-labelledby="usage-insights-title">
    <view class="{{styles.insightsHead}}">
      <view>
        <text class="overline">DETAILS &amp; ALERTS</text>
        <view id="usage-insights-title">趋势、明细与提醒</view>
      </view>
      <navigator class="button button-secondary" href="{{`/api/usage/export?${exportQuery}`}}">
        <text>导出近 30 天 CSV</text>
        <Icon name="external" size="{{14}}" />
      </navigator>
    </view>
    <view wx:if="{{insights.kind === "loading"}}" class="{{styles.insightStatus}}">正在读取历史明细。</view>
    <view wx:if="{{insights.kind === "error"}}" class="{{styles.insightError}}">{{insights.message}}</view>
    <block wx:if="{{insights.kind === "ready"}}">
      <view class="{{styles.forecast}}">
        <text>额度预测</text>
        <text>{{forecast?.label}}</text>
        <text>{{forecast?.detail}}</text>
      </view>
      <view class="{{styles.historyTable}}" role="table" aria-label="近 30 天用量明细">
        <view class="{{styles.historyHead}}" role="row">
          <text role="columnheader">日期</text>
          <text role="columnheader">计量项</text>
          <text role="columnheader">Token 类别</text>
          <text role="columnheader">用户</text>
          <text role="columnheader">净用量</text>
        </view>
        <view wx:for="{{insights.history.slice(-8).reverse()}}" wx:for-item="point" wx:key="point.id" class="{{styles.historyRow}}" role="row" key="{{`${point.bucketStartsAt}-${point.meterId}-${point.tokenClass}-${point.actorId}-${point.projectId}-${point.jobId}-${point.model}`}}">
          <text role="cell">{{localDate(point.bucketStartsAt)}}</text>
          <text role="cell" title="{{point.operationKey}}">
            <text wx:if="{{point.meterId === "model-token-v1"}}">{{"Token"}}</text>
            <text wx:else>{{"Credit"}}</text>
          </text>
          <text role="cell">{{point.tokenClass ?? "—"}}</text>
          <text role="cell">{{point.actorId}}</text>
          <text role="cell">{{Number(point.net).toLocaleString("zh-CN")}}</text>
        </view>
        <view wx:if="{{insights.history.length === 0}}" class="{{styles.emptyHistory}}">近 30 天暂无已结算用量。</view>
      </view>
      <view>
        <text class="{{styles.detailTitle}}">逐笔 Token 消耗事件（最近 100 条）</text>
        <view class="{{styles.historyTable}}" role="table" aria-label="逐笔 Token 消耗事件">
          <view class="{{styles.eventHead}}" role="row">
            <text role="columnheader">时间</text>
            <text role="columnheader">项目 / 任务</text>
            <text role="columnheader">模型</text>
            <text role="columnheader">类别</text>
            <text role="columnheader">数量</text>
            <text role="columnheader">对账</text>
          </view>
          <view wx:for="{{insights.events.filter((event) => event.meterId === "model-token-v1")
                    .slice(0, 100)}}" wx:for-item="event" wx:key="event.id" class="{{styles.eventRow}}" role="row" key="{{event.usageEventId}}">
            <text role="cell">{{localTime(event.occurredAt)}}</text>
            <text role="cell" title="{{`${event.projectId ?? &quot;—&quot;} / ${event.jobId ?? &quot;—&quot;}`}}">
              <text>{{event.projectId ?? "—"}}</text>
              <text>/</text>
              <text>{{event.jobId ?? "—"}}</text>
            </text>
            <text role="cell" title="{{event.model ?? &quot;—&quot;}}">{{event.model ?? "—"}}</text>
            <text role="cell">{{event.tokenClass ?? "—"}}</text>
            <text role="cell">{{Number(event.quantity).toLocaleString("zh-CN")}}</text>
            <text role="cell">{{event.reconciliationStatus}}</text>
          </view>
          <view wx:if="{{insights.events.every((event) => event.meterId !== "model-token-v1")}}" class="{{styles.emptyHistory}}">近 30 天暂无逐笔 Token 消耗事件。</view>
        </view>
      </view>
      <view class="{{styles.alertPanel}}">
        <view>
          <text>用量阈值提醒</text>
          <text>达到所选比例时发送一次提醒；100% 仍由数据库硬停止。</text>
        </view>
        <view class="{{styles.thresholds}}">
          <text wx:for="{{alertThresholds}}" wx:for-item="threshold" wx:key="threshold.id" key="{{threshold}}">
            <input type="checkbox" checked="{{insights.preference.thresholdBps.includes(threshold)}}" bindchange="onChange" />
            <text>{{threshold / 100}}</text>
            <text>%</text>
          </text>
        </view>
        <text class="{{styles.channel}}">
          <input type="checkbox" checked="{{insights.preference.inAppEnabled}}" bindchange="onChange" />
          <text>站内提醒</text>
        </text>
        <text class="{{styles.channel}}">
          <input type="checkbox" checked="{{insights.preference.emailEnabled}}" disabled="{{!emailAlertsEnabled}}" bindchange="onChange" />
          <text>邮件提醒</text>
          <text wx:if="{{emailAlertsEnabled}}">{{""}}</text>
          <text wx:else>{{"（未配置）"}}</text>
        </text>
        <button class="button button-primary" type="button" disabled="{{savingAlerts}}" bindtap="onTap">
          <text wx:if="{{savingAlerts}}">{{"保存中"}}</text>
          <text wx:else>{{"保存提醒"}}</text>
        </button>
      </view>
    </block>
  </view>
</view>
