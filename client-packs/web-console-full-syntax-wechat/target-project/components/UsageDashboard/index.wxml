<view class="{{styles.dashboard}}" aria-labelledby="live-usage-title">
  <text></text>
  <view class="{{styles.intro}}">
    <text></text>
    <text class="overline">
      <text>LIVE USAGE</text>
    </text>
    <text></text>
    <view id="live-usage-title">
      <text>实时查看 Token 与 Credit 消耗</text>
    </view>
    <text></text>
    <view>
      <text>每 5 秒读取一次 PostgreSQL 原子计量账本。已结算与处理中额度分别显示；
          页面隐藏时暂停刷新，返回后立即同步。</text>
    </view>
    <text></text>
  </view>
  <text></text>
  <form wx:if="{{allowLocalCredentials && !session}}" class="{{styles.connection}}" bindsubmit="connect">
    <text></text>
    <text>
      <text></text>
      <text>
        <text>本地租户标识</text>
      </text>
      <text></text>
      <input aria-label="用量租户标识" value="{{form.tenantId}}" pattern="[A-Za-z0-9][A-Za-z0-9._:-]{0,127}" required="true" autoComplete="off" bindchange="(event) => setForm((current) => ({ ...current, tenantId: event.target.value }))" />
      <text></text>
    </text>
    <text></text>
    <text>
      <text></text>
      <text>
        <text>本地用户标识</text>
      </text>
      <text></text>
      <input aria-label="用量用户标识" value="{{form.actorId}}" pattern="[A-Za-z0-9][A-Za-z0-9._:-]{0,127}" required="true" autoComplete="off" bindchange="(event) => setForm((current) => ({ ...current, actorId: event.target.value }))" />
      <text></text>
    </text>
    <text></text>
    <text class="{{styles.tokenField}}">
      <text></text>
      <text>
        <text>本地短期令牌</text>
      </text>
      <text></text>
      <input aria-label="用量短期访问令牌" type="password" value="{{form.token}}" minLength="{{24}}" required="true" autoComplete="off" bindchange="(event) => setForm((current) => ({ ...current, token: event.target.value }))" />
      <text></text>
    </text>
    <text></text>
    <button class="button button-primary" type="submit">
      <text>连接本地用量</text>
      <Icon name="arrow" size="{{15}}" />
      <text></text>
    </button>
    <text></text>
  </form>
  <text></text>
  <view wx:if="{{session}}" class="{{styles.sessionBar}}">
    <text></text>
    <view>
      <text></text>
      <text class="{{styles.liveDot}}" aria-hidden="true" />
      <text></text>
      <text>
        <view wx:if="{{readState.kind === "loading"}}" />
        <view wx:else />
      </text>
      <text></text>
      <text>
        <text></text>
        <view wx:if="{{session.kind === "account"}}" />
        <view wx:else />
        <text></text>
      </text>
      <text></text>
    </view>
    <text></text>
    <button wx:if="{{session.kind === "local"}}" class="button button-secondary" type="button" bindtap="() => {
                setSession(null);
                setForm(emptyCredentials);
                setReadState({ kind: "idle" });
              }">
      <text>断开本地连接</text>
    </button>
    <text></text>
  </view>
  <text></text>
  <view class="{{styles.announcement}}" aria-live="polite" aria-atomic="true">
    <text></text>
    <view wx:if="{{readState.kind === "idle"}}" />
    <text></text>
    <view wx:if="{{readState.kind === "loading"}}" />
    <text></text>
    <view wx:if="{{error}}" />
    <text></text>
    <view wx:if="{{readState.kind === "current"}}" />
    <text></text>
  </view>
  <text></text>
  <view wx:if="{{error}}" class="{{styles.errorNotice}}" role="alert">
    <text></text>
    <Icon name="{{error.status === "NOT_CONFIGURED" ? "clock" : "help"}}" size="{{17}}" />
    <text></text>
    <view>
      <text></text>
      <text>
        <view wx:if="{{error.status === "NOT_CONFIGURED"}}" />
        <view wx:else />
      </text>
      <text></text>
      <text>
        <text>{{error.message}}</text>
      </text>
      <text></text>
    </view>
    <text></text>
  </view>
  <text></text>
  <view wx:if="{{snapshot}}">
    <text></text>
    <view class="{{styles.snapshotHead}}">
      <text></text>
      <view>
        <text></text>
        <text>
          <text>当前计划</text>
        </text>
        <text></text>
        <text>
          <text>{{snapshot.plan.displayName}}</text>
        </text>
        <text></text>
        <text>
          <text>{{snapshot.plan.planId}}</text>
        </text>
        <text></text>
      </view>
      <text></text>
      <view>
        <text></text>
        <text>
          <text>刷新状态</text>
        </text>
        <text></text>
        <text class="{{snapshot.status === "PARTIAL" ? styles.warning : ""}}">
          <text></text>
          <view wx:if="{{readState.kind === "stale"}}" />
          <view wx:else />
          <text></text>
        </text>
        <text></text>
        <text>
          <text>更新于</text>
          <text>{{localTime(snapshot.generatedAt)}}</text>
        </text>
        <text></text>
      </view>
      <text></text>
      <view>
        <text></text>
        <text>
          <text>额度重置</text>
        </text>
        <text></text>
        <text>
          <view wx:if="{{snapshot.period.resetsAt}}" />
          <view wx:else />
        </text>
        <text></text>
        <text>
          <text>{{localTime(snapshot.period.startsAt)}}</text>
          <text>起</text>
        </text>
        <text></text>
      </view>
      <text></text>
    </view>
    <text></text>
    <view class="{{styles.meterGrid}}">
      <text></text>
      <UsageMeter label="模型 Token" unit="tokens" measure="{{snapshot.tokens}}" />
      <text></text>
      <UsageMeter label="平台 Credits" unit="credits" measure="{{snapshot.credits}}" />
      <text></text>
    </view>
    <text></text>
    <view class="{{styles.evidenceLine}}">
      <text></text>
      <text>
        <Icon name="check" size="{{14}}" />
        <text>已对账事件</text>
        <text>{{snapshot.reconciledEventCount}}</text>
      </text>
      <text></text>
      <text>
        <Icon name="clock" size="{{14}}" />
        <text>未对账事件</text>
        <text>{{snapshot.unreconciledEventCount}}</text>
      </text>
      <text></text>
      <text>
        <text>事件水位</text>
        <view wx:if="{{snapshot.eventWatermark}}" />
        <view wx:else />
      </text>
      <text></text>
    </view>
    <text></text>
  </view>
  <text></text>
  <view wx:if="{{!allowLocalCredentials && snapshot}}" class="{{styles.insights}}" aria-labelledby="usage-insights-title">
    <text></text>
    <view class="{{styles.insightsHead}}">
      <text></text>
      <view>
        <text></text>
        <text class="overline">
          <text>DETAILS &amp; ALERTS</text>
        </text>
        <text></text>
        <view id="usage-insights-title">
          <text>趋势、明细与提醒</text>
        </view>
        <text></text>
      </view>
      <text></text>
      <navigator class="button button-secondary" href="{{`/api/usage/export?${exportQuery}`}}">
        <text>导出近 30 天 CSV</text>
        <Icon name="external" size="{{14}}" />
        <text></text>
      </navigator>
      <text></text>
    </view>
    <text></text>
    <view wx:if="{{insights.kind === "loading"}}" class="{{styles.insightStatus}}">
      <text>正在读取历史明细。</text>
    </view>
    <text></text>
    <view wx:if="{{insights.kind === "error"}}" class="{{styles.insightError}}">
      <text>{{insights.message}}</text>
    </view>
    <text></text>
    <view wx:if="{{insights.kind === "ready"}}">
      <text></text>
      <view class="{{styles.forecast}}">
        <text></text>
        <text>
          <text>额度预测</text>
        </text>
        <text></text>
        <text>
          <text>{{forecast?.label}}</text>
        </text>
        <text></text>
        <text>
          <text>{{forecast?.detail}}</text>
        </text>
        <text></text>
      </view>
      <text></text>
      <view class="{{styles.historyTable}}" role="table" aria-label="近 30 天用量明细">
        <text></text>
        <view class="{{styles.historyHead}}" role="row">
          <text></text>
          <text role="columnheader">
            <text>日期</text>
          </text>
          <text></text>
          <text role="columnheader">
            <text>计量项</text>
          </text>
          <text></text>
          <text role="columnheader">
            <text>Token 类别</text>
          </text>
          <text></text>
          <text role="columnheader">
            <text>用户</text>
          </text>
          <text></text>
          <text role="columnheader">
            <text>净用量</text>
          </text>
          <text></text>
        </view>
        <text></text>
        <view wx:for="{{insights.history.slice(-8).reverse()}}" wx:for-item="point" wx:key="point.id" class="{{styles.historyRow}}" role="row" key="{{`${point.bucketStartsAt}-${point.meterId}-${point.tokenClass}-${point.actorId}-${point.projectId}-${point.jobId}-${point.model}`}}">
          <text></text>
          <text role="cell">
            <text>{{localDate(point.bucketStartsAt)}}</text>
          </text>
          <text></text>
          <text role="cell" title="{{point.operationKey}}">
            <text></text>
            <view wx:if="{{point.meterId === "model-token-v1"}}" />
            <view wx:else />
            <text></text>
          </text>
          <text></text>
          <text role="cell">
            <text>{{point.tokenClass ?? "—"}}</text>
          </text>
          <text></text>
          <text role="cell">
            <text>{{point.actorId}}</text>
          </text>
          <text></text>
          <text role="cell">
            <text>{{Number(point.net).toLocaleString("zh-CN")}}</text>
          </text>
          <text></text>
        </view>
        <text></text>
        <view wx:if="{{insights.history.length === 0}}" class="{{styles.emptyHistory}}">
          <text>近 30 天暂无已结算用量。</text>
        </view>
        <text></text>
      </view>
      <text></text>
      <view>
        <text></text>
        <text class="{{styles.detailTitle}}">
          <text>逐笔 Token 消耗事件（最近 100 条）</text>
        </text>
        <text></text>
        <view class="{{styles.historyTable}}" role="table" aria-label="逐笔 Token 消耗事件">
          <text></text>
          <view class="{{styles.eventHead}}" role="row">
            <text></text>
            <text role="columnheader">
              <text>时间</text>
            </text>
            <text></text>
            <text role="columnheader">
              <text>项目 / 任务</text>
            </text>
            <text></text>
            <text role="columnheader">
              <text>模型</text>
            </text>
            <text></text>
            <text role="columnheader">
              <text>类别</text>
            </text>
            <text></text>
            <text role="columnheader">
              <text>数量</text>
            </text>
            <text></text>
            <text role="columnheader">
              <text>对账</text>
            </text>
            <text></text>
          </view>
          <text></text>
          <view wx:for="{{insights.events.filter((event) => event.meterId === "model-token-v1")
                    .slice(0, 100)}}" wx:for-item="event" wx:key="event.id" class="{{styles.eventRow}}" role="row" key="{{event.usageEventId}}">
            <text></text>
            <text role="cell">
              <text>{{localTime(event.occurredAt)}}</text>
            </text>
            <text></text>
            <text role="cell" title="{{`${event.projectId ?? "—"} / ${event.jobId ?? "—"}`}}">
              <text></text>
              <text>{{event.projectId ?? "—"}}</text>
              <text>/</text>
              <text>{{event.jobId ?? "—"}}</text>
              <text></text>
            </text>
            <text></text>
            <text role="cell" title="{{event.model ?? "—"}}">
              <text>{{event.model ?? "—"}}</text>
            </text>
            <text></text>
            <text role="cell">
              <text>{{event.tokenClass ?? "—"}}</text>
            </text>
            <text></text>
            <text role="cell">
              <text>{{Number(event.quantity).toLocaleString("zh-CN")}}</text>
            </text>
            <text></text>
            <text role="cell">
              <text>{{event.reconciliationStatus}}</text>
            </text>
            <text></text>
          </view>
          <text></text>
          <view wx:if="{{insights.events.every((event) => event.meterId !== "model-token-v1")}}" class="{{styles.emptyHistory}}">
            <text>近 30 天暂无逐笔 Token 消耗事件。</text>
          </view>
          <text></text>
        </view>
        <text></text>
      </view>
      <text></text>
      <view class="{{styles.alertPanel}}">
        <text></text>
        <view>
          <text></text>
          <text>
            <text>用量阈值提醒</text>
          </text>
          <text></text>
          <text>
            <text>达到所选比例时发送一次提醒；100% 仍由数据库硬停止。</text>
          </text>
          <text></text>
        </view>
        <text></text>
        <view class="{{styles.thresholds}}">
          <text></text>
          <text wx:for="{{alertThresholds}}" wx:for-item="threshold" wx:key="threshold.id" key="{{threshold}}">
            <text></text>
            <input type="checkbox" checked="{{insights.preference.thresholdBps.includes(threshold)}}" bindchange="() => toggleThreshold(threshold)" />
            <text></text>
            <text>{{threshold / 100}}</text>
            <text>%</text>
          </text>
          <text></text>
        </view>
        <text></text>
        <text class="{{styles.channel}}">
          <text></text>
          <input type="checkbox" checked="{{insights.preference.inAppEnabled}}" bindchange="(event) => updatePreference({ inAppEnabled: event.target.checked })" />
          <text>站内提醒</text>
        </text>
        <text></text>
        <text class="{{styles.channel}}">
          <text></text>
          <input type="checkbox" checked="{{insights.preference.emailEnabled}}" disabled="{{!emailAlertsEnabled}}" bindchange="(event) => updatePreference({ emailEnabled: event.target.checked })" />
          <text>邮件提醒</text>
          <view wx:if="{{emailAlertsEnabled}}" />
          <view wx:else />
          <text></text>
        </text>
        <text></text>
        <button class="button button-primary" type="button" disabled="{{savingAlerts}}" bindtap="() => void savePreference(insights.preference)">
          <text></text>
          <view wx:if="{{savingAlerts}}" />
          <view wx:else />
          <text></text>
        </button>
        <text></text>
      </view>
      <text></text>
    </view>
    <text></text>
  </view>
  <text></text>
</view>
