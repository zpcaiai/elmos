<view class="{{styles.page}}">
  <view wx:if="{{!embedded}}" class="page-header">
    <view>
      <text class="eyebrow">IDENTITY &amp; TENANCY</text>
      <view>账户与组织</view>
      <view>创建组织、邀请成员、切换租户和管理最小权限角色。租户选择只是选择器，授权以控制面数据库为准。</view>
    </view>
  </view>
  <view wx:if="{{feedback}}" class="{{styles.feedback}}" role="status">{{feedback}}</view>
  <view class="{{styles.grid}}">
    <view class="{{styles.panel}}">
      <view>我的组织</view>
      <text>
        <text>组织</text>
        <view value="{{selectedId}}" bindchange="onChange">
          <view wx:for="{{organizations}}" wx:for-item="organization" wx:key="organization.id" value="{{organization.organizationId}}" key="{{organization.organizationId}}">
            <text>{{organization.displayName}}</text>
            <text>·</text>
            <text>{{organization.role}}</text>
          </view>
        </view>
      </text>
      <button class="button primary" type="button" disabled="{{!selectedId || busy}}" bindtap="switchOrganization">设为当前组织</button>
      <form bindsubmit="createOrganization">
        <view>创建组织</view>
        <text>
          <text>名称</text>
          <input required="true" minLength="{{2}}" maxLength="{{128}}" value="{{name}}" bindchange="onChange" />
        </text>
        <text>
          <text>数据区域</text>
          <view value="{{region}}" bindchange="onChange">
            <view value="cn-north">中国北区</view>
            <view value="ap-southeast">亚太东南</view>
            <view value="eu-central">欧洲中部</view>
          </view>
        </text>
        <button class="button" disabled="{{busy}}">创建</button>
      </form>
    </view>
    <view class="{{styles.panel}}">
      <view>接受邀请</view>
      <form bindsubmit="acceptInvitation">
        <text>
          <text>一次性邀请令牌</text>
          <textarea required="true" rows="{{4}}" value="{{acceptToken}}" bindchange="onChange" />
        </text>
        <button class="button" disabled="{{busy}}">验证并加入</button>
      </form>
      <form wx:if="{{canAdmin}}" bindsubmit="invite">
        <view>邀请成员</view>
        <text>
          <text>已验证邮箱</text>
          <input type="email" required="true" value="{{inviteEmail}}" bindchange="onChange" />
        </text>
        <text>
          <text>角色</text>
          <view value="{{inviteRole}}" bindchange="onChange">
            <view wx:for="{{['ADMIN', 'MAINTAINER', 'MEMBER', 'BILLING', 'VIEWER']}}" wx:for-item="role" wx:key="role.id" value="{{role}}" key="{{role}}">{{role}}</view>
          </view>
        </text>
        <button class="button" disabled="{{busy || !selectedId}}">创建邀请</button>
      </form>
      <view wx:if="{{invitationToken}}" class="{{styles.token}}">
        <text>仅显示一次</text>
        <code>{{invitationToken}}</code>
        <text>邮件/SMS 提供商未配置前，不会自动发送；外部投递证据保持 NOT_RUN。</text>
      </view>
    </view>
  </view>
  <view class="{{styles.members}}">
    <view>
      <view>成员</view>
      <text>{{selected?.displayName ?? "未选择组织"}}</text>
    </view>
    <view class="{{styles.memberList}}">
      <view wx:for="{{members}}" wx:for-item="member" wx:key="member.id" class="{{styles.member}}" key="{{member.accountId}}">
        <view>
          <text>{{member.displayName}}</text>
          <text>{{member.accountId}} · {{member.state}}</text>
        </view>
        <view value="{{member.role}}" disabled="{{!canAdmin || busy}}" bindchange="onChange">
          <view wx:for="{{['OWNER', 'ADMIN', 'MAINTAINER', 'MEMBER', 'BILLING', 'VIEWER']}}" wx:for-item="role" wx:key="role.id" value="{{role}}" key="{{role}}">{{role}}</view>
        </view>
        <button class="button ghost" type="button" disabled="{{!canAdmin || busy}}" bindtap="onTap">移除</button>
      </view>
      <view wx:if="{{members.length === 0}}">暂无可见成员。</view>
    </view>
  </view>
</view>
