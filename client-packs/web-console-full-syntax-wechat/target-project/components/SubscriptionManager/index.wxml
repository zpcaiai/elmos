<view class="{{styles.subscriptionPanel}}" aria-label="当前订阅">
  <view class="{{styles.subscriptionCopy}}">
    <text>当前订阅</text>
    <text>{{copy}}</text>
    <text wx:if="{{message}}" role="status">{{message}}</text>
  </view>
  <view class="{{styles.subscriptionActions}}">
    <button wx:if="{{state === "UNAVAILABLE"}}" class="button button-secondary" type="button" bindtap="onTap">重试</button>
    <button wx:if="{{state === "READY" && subscription?.canCancel && !confirming}}" class="button button-secondary" type="button" bindtap="onTap">到期取消</button>
    <block wx:if="{{state === "READY" && subscription?.canCancel && confirming}}">
      <button class="button button-secondary" type="button" disabled="{{pending}}" bindtap="onTap">保留订阅</button>
      <button class="button button-primary" type="button" disabled="{{pending}}" bindtap="cancel">
        <text wx:if="{{pending}}">{{"正在提交…"}}</text>
        <text wx:else>{{"确认到期取消"}}</text>
      </button>
    </block>
  </view>
</view>
