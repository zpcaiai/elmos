<view class="card" data-component="{{componentName}}">
  <button class="heading" bindtap="toggleExpanded" aria-expanded="{{expanded}}">{{title}}</button>
  <view wx:if="{{expanded}}" class="content">
    <text class="source-label">evidence-edge-details</text>
    <text class="source-label">evidence-graph-card</text>
    <text class="source-label">evidence-graph-layer</text>
    <text class="source-label">evidence-graph-layers</text>
    <text class="source-label">evidence-graph-node</text>
    <text class="source-label">evidence-layer-label</text>
    <view wx:for="{{rows}}" wx:key="key"><text>{{item.key}}: {{item.value}}</text></view>
  </view>
</view>
