.source-field { box-sizing: border-box; }
.source-header { box-sizing: border-box; }
.source-headerStatus { box-sizing: border-box; }
.source-inlineControl { box-sizing: border-box; }
.source-jsonPreview { box-sizing: border-box; }
.source-layout { box-sizing: border-box; }
.source-overline { box-sizing: border-box; }
