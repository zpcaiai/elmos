<view class="shell" data-component="{{componentName}}">
  <view class="heading"><text>{{title}}</text></view>
  <view class="status status--{{status}}"><text>{{status}}</text><text wx:if="{{error}}"> · {{error}}</text></view>
  <slot />
  <view class="source-labels">
    <text class="source-label">(prefers-reduced-motion: reduce)</text>
    <text class="source-label">/account</text>
    <text class="source-label">/admin</text>
    <text class="source-label">/api/capabilities/migration</text>
    <text class="source-label">/help</text>
    <text class="source-label">Account and organizations</text>
  </view>
</view>
