<view class="card" data-component="{{componentName}}">
  <view class="heading"><text>{{title}}</text><button size="mini" bindtap="reload">刷新</button></view>
  <view class="status status--{{status}}"><text>{{status}}</text><text wx:if="{{error}}"> · {{error}}</text></view>
  <view class="chart" wx:if="{{rows.length}}">
    <view wx:for="{{rows}}" wx:key="key" class="bar-row"><text class="bar-label">{{item.key}}</text><view class="bar" style="width: {{item.width}}%"></view><text>{{item.value}}</text></view>
  </view>
  <view wx:else class="source-labels">
    <text class="source-label">NOT_CERTIFIED</text>
    <text class="source-label">NOT_RUN</text>
    <text class="source-label">PASSED</text>
    <text class="source-label">UNKNOWN</text>
    <text class="source-label">evidence-boundary</text>
    <text class="source-label">evidence-coverage-grid</text>
  </view>
</view>
