<view class="shell" data-component="{{componentName}}">
  <view class="heading"><text>{{title}}</text></view>
  <view class="status status--{{status}}"><text>{{status}}</text><text wx:if="{{error}}"> · {{error}}</text></view>
  <slot />
  <view class="source-labels">
    <text class="source-label">/api/auth/login</text>
    <text class="source-label">Enterprise identity</text>
    <text class="source-label">alert</text>
    <text class="source-label">auth-card</text>
    <text class="source-label">auth-error</text>
    <text class="source-label">auth-form</text>
  </view>
</view>
