<view class="card" data-component="{{componentName}}">
  <view class="heading"><text>{{title}}</text><button size="mini" bindtap="reload">刷新</button></view>
  <view class="status status--{{status}}"><text>{{status}}</text><text wx:if="{{error}}"> · {{error}}</text></view>
  <view class="source-labels">
    <text class="source-label">/api/wallet</text>
    <text class="source-label">/api/wallet/ledger?limit=50</text>
    <text class="source-label">/api/wallet/topup</text>
    <text class="source-label">0 0 4px</text>
    <text class="source-label">100</text>
    <text class="source-label">ACTIVE</text>
  </view>
  <view class="actions">
    <button wx:for="{{actions}}" wx:key="id" size="mini" data-action="{{item.id}}" bindtap="runAction">{{item.label}}</button>
  </view>
  <view wx:for="{{rows}}" wx:key="key" class="data-row"><text>{{item.key}}</text><text>{{item.value}}</text></view>
</view>
