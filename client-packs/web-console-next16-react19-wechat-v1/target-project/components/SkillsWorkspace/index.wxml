<view class="page-stack skills-page">
  <view class="page-header skills-header">
    <view>
      <text class="overline">FOUNDRY v3.0.0 · POLYGLOT · MIGRATION · PRECISION · PRODUCT</text>
      <view>Skills 技能库与形式化验证</view>
      <view>涵盖 Foundry 41 个能力 Pack、Polyglot 18 个 Batches、迁移及商业化控制链。双根目录安装，杜绝未经验证的随意发布。</view>
    </view>
    <view class="header-actions">
      <navigator class="button button-secondary" href="/translation">
        <Icon name="code" size="{{16}}" />
        <text>跨语言转换</text>
      </navigator>
      <navigator class="button button-primary" href="/commercialization">
        <text>商业化控制面</text>
        <Icon name="arrow" size="{{15}}" />
      </navigator>
    </view>
  </view>
  <view class="metric-grid metric-grid-four" aria-label="Skills 资格摘要">
    <view class="metric-card metric-card-accent">
      <text>Foundry v3.0.0 知识库</text>
      <text>1,351 Skills</text>
      <text>41 Packs · 1,310 原子 + 41 Meta</text>
    </view>
    <view class="metric-card">
      <text>Codex / Runtime 全库</text>
      <text class="metric-pair">
        <text>{{installedSkillInventory.codexSkillCount.toLocaleString("en-US")}}</text>
        <text>/</text>
        <text>{{installedSkillInventory.runtimeSkillCount.toLocaleString("en-US")}}</text>
      </text>
      <text>按含 SKILL.md 的可调用目录统计</text>
    </view>
    <view class="metric-card">
      <text>多语言语义编译 (Batches A–R)</text>
      <text>300 Skills</text>
      <text>784 语言路线 · SMT 形式化验证</text>
    </view>
    <view class="metric-card">
      <text>商业能力内核 (K1–K8)</text>
      <text>85 Skills</text>
      <text>SLSA Level 3 数字防伪证据</text>
    </view>
  </view>
  <view class="skills-grid">
    <view class="surface-card namespace-explorer">
      <view class="card-heading">
        <view>
          <text class="overline">NAMESPACE EXPLORER</text>
          <view>选择能力命名空间与 Pack</view>
        </view>
        <view class="flex items-center gap-2">
          <input type="text" value="{{searchQuery}}" placeholder="搜索 Pack / 关键词..." class="px-3 py-1 text-xs rounded border border-border bg-background" bindchange="onChange" />
        </view>
      </view>
      <view class="namespace-tabs" role="tablist" aria-label="Skill 命名空间">
        <button role="tab" aria-selected="{{namespace === &quot;foundry&quot;}}" class="{{namespace === &quot;foundry&quot; ? &quot;active&quot; : &quot;&quot;}}" bindtap="onTap">
          <Icon name="spark" size="{{17}}" />
          <text>
            <text>Foundry v3.0.0</text>
            <text>Pack 00–40</text>
          </text>
          <text>1,351</text>
        </button>
        <button role="tab" aria-selected="{{namespace === &quot;polyglot&quot;}}" class="{{namespace === &quot;polyglot&quot; ? &quot;active&quot; : &quot;&quot;}}" bindtap="onTap">
          <Icon name="code" size="{{17}}" />
          <text>
            <text>Polyglot Compiler</text>
            <text>Batches A–R</text>
          </text>
          <text>300</text>
        </button>
        <button role="tab" aria-selected="{{namespace === &quot;migration&quot;}}" class="{{namespace === &quot;migration&quot; ? &quot;active&quot; : &quot;&quot;}}" bindtap="onTap">
          <Icon name="route" size="{{17}}" />
          <text>
            <text>Migration Packs</text>
            <text>M1–M45</text>
          </text>
          <text>820</text>
        </button>
        <button role="tab" aria-selected="{{namespace === &quot;precision&quot;}}" class="{{namespace === &quot;precision&quot; ? &quot;active&quot; : &quot;&quot;}}" bindtap="onTap">
          <Icon name="workflow" size="{{17}}" />
          <text>
            <text>Precision Migration</text>
            <text>B01–B44</text>
          </text>
          <text>{{precisionMigrationSummary.runtimeSkillCount}}</text>
        </button>
        <button role="tab" aria-selected="{{namespace === &quot;product&quot;}}" class="{{namespace === &quot;product&quot; ? &quot;active&quot; : &quot;&quot;}}" bindtap="onTap">
          <Icon name="shield" size="{{17}}" />
          <text>
            <text>Commercial Product</text>
            <text>B34–B55</text>
          </text>
          <text>1,004</text>
        </button>
      </view>
      <view class="namespace-range-list">
        <view wx:for="{{items}}" wx:key="item.id" class="namespace-range" key="{{item.range}}">
          <text class="range-icon">
            <Icon name="{{item.icon}}" size="{{19}}" />
          </text>
          <view class="range-copy">
            <text>
              <text>{{item.range}}</text>
              <text>{{item.title}}</text>
            </text>
            <text>{{item.note}}</text>
            <text>{{item.source}}</text>
          </view>
          <text class="range-count">
            <text>{{item.count}}</text>
            <text>Skills</text>
          </text>
          <StatusChip status="{{item.status}}" compact="true" />
        </view>
        <view wx:if="{{items.length === 0}}" class="p-4 text-center text-sm text-muted-foreground">没有找到匹配的 Pack 或 Skill</view>
      </view>
      <view class="namespace-footer">
        <text>当前命名空间</text>
        <text>{{namespace === "foundry" ? "Knowledge-Skill-Model Foundry v3.0.0 (41 Packs)"
                : namespace === "polyglot" ? "Polyglot Semantic Compiler (18 Batches)"
                : namespace === "migration" ? "Migration M1–M45"
                : namespace === "precision" ? "Precision Migration B01–B44"
                : "Product Commercialization B34–B55"}}</text>
        <text>{{total.toLocaleString("en-US")}} Skills</text>
      </view>
    </view>
    <view class="surface-card strict-gate-card">
      <text class="strict-icon">
        <Icon name="test" size="{{23}}" />
      </text>
      <text class="overline">FORMAL QUALIFICATION GATE</text>
      <view>严格数学证明与差分测试</view>
      <view>静态结构检查、Schema 规范与 DAG 无环性已在本地 100% 验证通过；生产发布严格绑定 SMT Z3 证明、Fuzzing 记录与 SLSA 证据链。</view>
      <view class="strict-meter" role="progressbar" aria-label="严格用例执行进度" aria-valuemin="{{0}}" aria-valuemax="{{100}}" aria-valuenow="{{100}}" aria-valuetext="100% 结构门禁通过">
        <text style="{{{ width: &quot;100%&quot;, background: &quot;linear-gradient(90deg, #10b981, #6366f1)&quot; }}}" />
      </view>
      <view class="strict-stats">
        <text>
          <text>本地门禁</text>
          <text>100% PASS</text>
        </text>
        <text>
          <text>SMT 形式化证明</text>
          <text class="text-emerald-400">SAT_PROVED</text>
        </text>
      </view>
      <view class="gate-command">
        <text>统一执行门禁</text>
        <code>make polyglot-semantic-assurance-skills</code>
      </view>
      <view class="strict-boundary">
        <Icon name="shield" size="{{16}}" />
        <text>
          <text>验证结论：QUALIFIED</text>
          <text>证据链完整，具备内容寻址签名防伪。</text>
        </text>
      </view>
    </view>
  </view>
  <PrecisionMigrationJobs />
  <view aria-labelledby="source-title">
    <view class="section-heading">
      <view>
        <text class="overline">SOURCE QUALITY</text>
        <view id="source-title">按来源可信度分层</view>
      </view>
      <text class="quiet-label">全生态技能分类</text>
    </view>
    <view class="provenance-grid">
      <view wx:for="{{provenance}}" wx:key="item.id" class="{{`provenance-card tone-${item.tone}`}}" key="{{item.label}}">
        <view>
          <text class="provenance-number">{{item.count}}</text>
          <StatusChip status="{{item.status}}" compact="true" />
        </view>
        <view>{{item.label}}</view>
        <view>{{item.note}}</view>
        <view class="provenance-bar">
          <text style="{{{ width: `${Math.min(100, Math.round(item.count / 1351 * 100))}%` }}}" />
        </view>
      </view>
    </view>
  </view>
  <view class="surface-card install-boundary">
    <view>
      <text class="install-icon">
        <Icon name="command" size="{{20}}" />
      </text>
      <text>
        <text>跨引擎统一复合流水线与 CLI 门禁</text>
        <text>一键调用所有 41 个底层引擎、SMT 求解器与 FinOps 计量器。</text>
      </text>
    </view>
    <code>elmos pipeline --src-lang java --tgt-lang csharp --export-html report.html</code>
    <StatusChip status="READY" />
  </view>
</view>
