<view class="page-stack">
  <view class="page-header">
    <view>
      <text class="overline">BATCH 31 · READ-ONLY SOURCE PREFLIGHT</text>
      <view>ChinaDB SQL 预检</view>
      <view>在显式兼容模式下发射本地目标 SQL；实库执行、结果等价与认证仍失败关闭。</view>
    </view>
    <navigator class="button button-secondary" href="/migration">
      <Icon name="arrow" size="{{16}}" />
      <text>返回迁移工坊</text>
    </navigator>
  </view>
  <view class="source-notice" role="status" aria-live="polite">
    <Icon name="{{capabilities ? &quot;check&quot; : &quot;clock&quot;}}" size="{{16}}" />
    <text>{{loadingCapabilities
            ? "正在读取受保护的 control-plane 能力快照…"
            : capabilities
              ? `已绑定 ${capabilities.targetCount} 个目标、${capabilities.plannedRouteCount} 条规划路线；不会连接数据库。`
              : "能力服务不可用；提交保持禁用。"}}</text>
    <StatusChip status="{{capabilities ? &quot;LOCAL_ADAPTER&quot; : &quot;BLOCKED&quot;}}" compact="true" />
  </view>
  <view wx:if="{{error}}" ref="{{errorSummary}}" class="{{'errorSummary'}}" role="alert" tabIndex="{{-1}}">
    <Icon name="lock" size="{{18}}" />
    <view>
      <text>预检未执行</text>
      <view>{{error}}</view>
    </view>
  </view>
  <view class="{{'workspace'}}">
    <form class="{{`surface-card ${'form'}`}}" data-telemetry-ignore="true" aria-busy="{{busy}}" bindsubmit="submit">
      <view class="{{'sectionHeading'}}">
        <view>
          <text class="overline">EXACT REQUEST</text>
          <view>源 SQL 与目标精确元组</view>
        </view>
        <StatusChip status="{{capabilities ? &quot;LOCAL_ADAPTER&quot; : &quot;BLOCKED&quot;}}" compact="true" />
      </view>
      <fieldset class="{{'fieldset'}}">
        <legend>源查询身份</legend>
        <view class="{{'gridTwo'}}">
          <text htmlFor="sql-query-id"><text>Query ID</text> <input id="sql-query-id" value="{{fields.queryId}}" maxLength="{{160}}" required="true" autoComplete="off" bindchange="onChange" /></text>
          <text htmlFor="sql-source-profile"><text>精确源 Profile</text> <view id="sql-source-profile" aria-describedby="sql-source-profile-hint" value="{{fields.sourceProfile}}" bindchange="onChange">
  <view wx:for="{{chinaDbSqlSourceProfiles}}" wx:for-item="profile" wx:key="profile.id" value="{{profile}}" key="{{profile}}">{{profile}}</view>
</view></text>
        </view>
        <view id="sql-source-profile-hint" class="{{'sourceProfileHint'}}">{{sourceRoutePlanned
                ? "该源家族存在 13 条商业目标规划路线；仅在显式兼容模式下有限发射 SQL，不代表厂商原生适配。"
                : "该 Profile 仅用于 typed source intake，不在 78 条商业规划路线内；结果将明确标记 COMMERCIAL_ROUTE_NOT_PLANNED。"}}</view>
      </fieldset>
      <fieldset class="{{'fieldset'}}" aria-describedby="{{selectedTarget ? &quot;sql-target-requirement&quot; : undefined}}">
        <legend>目标精确元组</legend>
        <view class="{{'gridTwo'}}">
          <text htmlFor="sql-target-id"><text>ChinaDB 目标</text> <view id="sql-target-id" value="{{fields.targetId}}" disabled="{{!capabilities}}" bindchange="onChange">{{capabilities?.targets.map((target) => <option value={target.id} key={target.id}>{target.label} · {target.id}</option>) ?? <option value="dm8">等待能力快照</option>}}</view></text>
          <text htmlFor="sql-target-version"><text>精确版本</text> <input id="sql-target-version" value="{{fields.targetVersion}}" maxLength="{{128}}" placeholder="例如 8.1.3.140" required="true" autoComplete="off" bindchange="onChange" /></text>
          <text htmlFor="sql-target-edition"><text>Edition</text> <input id="sql-target-edition" value="{{fields.targetEdition}}" maxLength="{{128}}" placeholder="例如 enterprise" required="true" autoComplete="off" bindchange="onChange" /></text>
          <text htmlFor="sql-compatibility-mode"><text>Compatibility mode</text> <input id="sql-compatibility-mode" value="{{fields.compatibilityMode}}" maxLength="{{128}}" placeholder="例如 oracle-compatible-explicit" required="true" autoComplete="off" bindchange="onChange" /></text>
          <text htmlFor="sql-target-driver"><text>Driver</text> <input id="sql-target-driver" value="{{fields.targetDriver}}" maxLength="{{128}}" placeholder="精确驱动与版本" required="true" autoComplete="off" bindchange="onChange" /></text>
          <text htmlFor="sql-target-charset"><text>Charset</text> <input id="sql-target-charset" value="{{fields.targetCharset}}" maxLength="{{128}}" placeholder="例如 UTF-8" required="true" autoComplete="off" bindchange="onChange" /></text>
          <text htmlFor="sql-target-collation"><text>Collation</text> <input id="sql-target-collation" value="{{fields.targetCollation}}" maxLength="{{128}}" placeholder="例如 BINARY" required="true" autoComplete="off" bindchange="onChange" /></text>
          <text htmlFor="sql-target-timezone"><text>Time zone</text> <input id="sql-target-timezone" value="{{fields.targetTimeZone}}" maxLength="{{128}}" placeholder="例如 Asia/Shanghai" required="true" autoComplete="off" bindchange="onChange" /></text>
        </view>
        <view wx:if="{{selectedTarget}}" id="sql-target-requirement" class="{{'requirement'}}">
          <Icon name="database" size="{{16}}" />
          <text><text>{{selectedTarget.label}}</text> {{selectedTarget.versionRequirement}} ； {{selectedTarget.compatibilityModeRequirement}}</text>
        </view>
      </fieldset>
      <fieldset class="{{'fieldset'}}">
        <legend>参数契约</legend>
        <view class="{{'parameterToolbar'}}">
          <view>仅声明名称、逻辑类型与 nullability；最多 {{chinaDbSqlParameterLimit}} 项。</view>
          <button type="button" class="button button-secondary" disabled="{{parameters.length &gt;= chinaDbSqlParameterLimit}}" bindtap="addParameter">
            <Icon name="plus" size="{{15}}" />
            <text>添加参数</text>
          </button>
        </view>
        <view wx:if="{{parameters.length === 0}}" class="{{'emptyParameters'}}">当前请求使用空参数契约。</view>
        <view wx:else class="{{'parameterList'}}">
          <view wx:for="{{parameters}}" wx:for-item="parameter" wx:for-index="index" wx:key="parameter.id" class="{{'parameterRow'}}" key="{{`parameter-${index}`}}">
            <text htmlFor="{{`sql-parameter-name-${index}`}}"><text>名称</text> <input id="{{`sql-parameter-name-${index}`}}" value="{{parameter.name}}" maxLength="{{128}}" required="true" autoComplete="off" bindchange="onChange" /></text>
            <text htmlFor="{{`sql-parameter-type-${index}`}}"><text>逻辑类型</text> <input id="{{`sql-parameter-type-${index}`}}" value="{{parameter.logicalType}}" maxLength="{{128}}" required="true" autoComplete="off" bindchange="onChange" /></text>
            <text class="{{'checkbox'}}" htmlFor="{{`sql-parameter-nullable-${index}`}}"><input id="{{`sql-parameter-nullable-${index}`}}" type="checkbox" checked="{{parameter.nullable}}" bindchange="onChange" /> <text>Nullable</text></text>
            <button type="button" class="icon-button bordered" aria-label="{{`删除参数 ${index + 1}`}}" bindtap="onTap">
              <Icon name="close" size="{{14}}" />
            </button>
          </view>
        </view>
      </fieldset>
      <text class="{{'sqlField'}}" htmlFor="sql-source"><text>源 SQL</text> <textarea id="sql-source" aria-describedby="sql-source-hint" value="{{fields.sql}}" placeholder="粘贴已脱敏的查询；不要包含凭据、个人信息或未授权生产数据。" required="true" spellCheck="{{false}}" bindchange="onChange" /> <text id="sql-source-hint">UTF-8 最大 {{chinaDbSqlInputLimitBytes / 1024}} KiB。SQL 只发送到同源 BFF 和受信 control-plane，不保存为草稿。</text></text>
      <view class="{{'digestBlock'}}">
        <text>能力快照摘要</text>
        <code>{{capabilities?.capabilitySnapshotDigest ?? "尚未绑定"}}</code>
      </view>
      <view class="{{'boundary'}}">
        <Icon name="shield" size="{{17}}" />
        <view>本操作可在显式兼容模式下生成本地目标 SQL。不会连接数据库、验证行值等价或签发认证。</view>
      </view>
      <view class="{{'actions'}}">
        <button wx:if="{{busy}}" class="button button-secondary" type="button" bindtap="cancelAssessment">取消本次预检</button>
        <button class="button button-primary" type="submit" disabled="{{!capabilities || busy}}">{{busy ? "正在评估…" : "运行 SQL 预检"}}</button>
      </view>
    </form>
    <view class="{{`surface-card ${'boundaryCard'}`}}">
      <text class="overline">FAIL-CLOSED BOUNDARY</text>
      <view>当前能力上限</view>
      <view>
        <view>
          <view>目标 Renderer</view>
          <view>{{capabilities?.boundaries.verifiedTargetRenderers ?? 0}}</view>
        </view>
        <view>
          <view>生产数据库访问</view>
          <view>FALSE</view>
        </view>
        <view>
          <view>目标 SQL</view>
          <view>{{capabilities?.boundaries.targetSqlMayBeEmitted ? "LOCAL_ONLY" : "PROHIBITED"}}</view>
        </view>
        <view>
          <view>外部执行</view>
          <view>NOT_RUN</view>
        </view>
        <view>
          <view>认证</view>
          <view>NOT_CERTIFIED</view>
        </view>
      </view>
      <view>{{capabilities?.boundaries.claim ?? "等待受保护能力快照。"}}</view>
    </view>
  </view>
  <view wx:if="{{result}}" ref="{{resultPanel}}" class="{{`surface-card ${'result'}`}}" tabIndex="{{-1}}" aria-labelledby="sql-preflight-result-title">
    <view class="{{'resultHeading'}}">
      <view>
        <text class="overline">TYPED SOURCE ASSESSMENT</text>
        <view id="sql-preflight-result-title">预检结果： {{result.state === "LOCAL_EMITTED" ? "本地已发射" : "已阻断"}}</view>
        <view>{{result.routeId}} · {{result.queryId}}</view>
      </view>
      <StatusChip status="{{result.state}}" />
    </view>
    <view class="{{'resultFacts'}}">
      <view>
        <text>源解析</text>
        <StatusChip status="{{result.verification.sourceParse}}" compact="true" />
      </view>
      <view>
        <text>目标 SQL</text>
        <text>{{result.targetSql ? "已生成本地 SQL" : "NULL · 未生成"}}</text>
      </view>
      <view>
        <text>目标状态</text>
        <StatusChip status="{{result.target.implementationStatus}}" compact="true" />
      </view>
      <view>
        <text>认证</text>
        <StatusChip status="{{result.certification}}" compact="true" />
      </view>
    </view>
    <view wx:if="{{result.targetSql}}" class="{{'statementSection'}}">
      <view>本地目标 SQL</view>
      <pre aria-label="本地发射的目标 SQL">{{result.targetSql}}</pre>
      <view class="{{'noStatements'}}">此 SQL 未经目标库执行或等价验证，不得当作认证产物。</view>
    </view>
    <view class="{{'resultGrid'}}">
      <view>
        <view>Blockers</view>
        <view class="{{'blockerList'}}">
          <view wx:for="{{result.blockers}}" wx:for-item="blocker" wx:for-index="index" wx:key="blocker.id" class="{{'blocker'}}" key="{{`${blocker.code}-${index}`}}">
            <view>
              <StatusChip status="{{blocker.severity === &quot;ERROR&quot; ? &quot;BLOCKED&quot; : &quot;REVIEW&quot;}}" compact="true" />
              <code>{{blocker.code}}</code>
            </view>
            <view>{{blocker.message}}</view>
            <text>{{blocker.statementIndex === null ? "全局阻断" : `Statement ${blocker.statementIndex}`}}</text>
          </view>
        </view>
      </view>
      <view>
        <view>Verification</view>
        <view class="{{'verification'}}">
          <view wx:for="{{(Object.entries(result.verification) as Array<[keyof typeof result.verification, string]>)}}" wx:for-item="[key, value]" wx:key="[key, value].id" key="{{key}}">
            <view>{{verificationLabels[key]}}</view>
            <view>
              <StatusChip status="{{value}}" compact="true" />
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="{{'statementSection'}}">
      <view>Typed AST 与语义义务</view>
      <view wx:if="{{result.statements.length === 0}}" class="{{'noStatements'}}">源解析失败，没有生成 typed AST。</view>
      <block wx:else>
        <view wx:for="{{result.statements}}" wx:for-item="statement" wx:key="statement.id" class="{{'statement'}}" key="{{statement.index}}">
          <view class="{{'statementHeading'}}">
            <text>Statement {{statement.index}}</text>
            <text>{{statement.kind}}</text>
          </view>
          <view class="{{'obligations'}}">
            <code wx:for="{{statement.obligations}}" wx:for-item="obligation" wx:key="obligation.id" key="{{obligation}}">{{obligation}}</code>
          </view>
          <view>
            <view>查看 typed source AST</view>
            <pre>{{JSON.stringify(statement.sourceAst, null, 2)}}</pre>
          </view>
        </view>
      </block>
    </view>
  </view>
</view>
