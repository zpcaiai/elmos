          "profile_version": "1.0.0", "status": "ACTIVE", "platforms": ["ANDROID", "IOS", "WEB"],
          "language": "TypeScript", "language_version": "6.0.3", "runtime": "Expo",
          "runtime_version": "57.0.8", "node_version": "26.0.0", "build_tool": "Expo CLI",
          "build_tool_version": "57.0.10", "package_manager": "npm", "package_manager_version": "11.12.1",
          "router": "React Navigation 7.3.14", "state": "React reducer/context",
