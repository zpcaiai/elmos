          "router": "react-router-dom 7.18.1", "state": "React reducer/context", "rendering": "CSR",
          "test_tool": "Vitest 4.1.10", "runner_profile": "MODERN_WEB",
          "required_project_files": ["package.json", "vite.config.ts", "src/main.tsx", "src/App.tsx"]
        } },
        { "const": {
