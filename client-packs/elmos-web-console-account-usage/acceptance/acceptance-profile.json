  "thresholds": {"source_fingerprint_coverage":0.95, "ui_ir_source_map_coverage":1.0, "target_build_green_rate":1.0, "target_startup_or_launch_rate":1.0, "p0_journey_pass_rate":1.0, "critical_accessibility_violations":0, "authorization_regressions":0},
  "exclusions": ["external-idp-runtime", "independent-assistive-technology", "customer-data", "customer-acceptance", "external-certification"]
