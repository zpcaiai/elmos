  "target": {
    "stack": "nextjs-app-router",
    "versions": ["16.2.10"],
    "language": "typescript",
    "language_versions": ["5.9.2"],
    "runtime": "nodejs",
    "runtime_versions": ["22"],
    "renderer": ["react-19.2.7-client-hydration"],
    "identity": ["server-bound-oidc-session-bff"],
