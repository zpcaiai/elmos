{
  "profile_key": "elmos-web-console-account-usage-target",
  "version": "1.1.0",
  "owner": "elmos-web-console-maintainers",
  "framework": "nextjs-app-router",
  "versions": ["16.3.0"],
  "language": "typescript",
  "language_versions": ["5.9.2"],
  "runtime": "nodejs",
  "runtime_versions": ["22.23.1", "26.0.0"],
  "build_tool": "next-16.3.0",
  "package_manager": "pnpm-10.12.4",
  "router": ["next-app-router-16.3.0"],
  "rendering_strategy": {"mode":"client-dashboard-with-server-bff"},
  "state_strategy": {"provider":"typed-react-state-machines-19.2.7"},
  "form_strategy": {"provider":"native-controls-server-validation"},
  "styling_strategy": {"mode":"css-modules"},
  "design_system_strategy": {"mode":"repository-local-elmos-console"},
  "api_client_strategy": {"provider":"same-origin-no-store-fetch"},
  "auth_strategy": {"mode":"http-only-cookie-session-with-development-only-local-bearer"},
  "i18n_strategy": {"provider":"zh-CN-visible-copy"},
  "accessibility_profile": {"standard":"WCAG-2.2-AA-local-automated-subset"},
  "browser_matrix": ["chromium-playwright-1228", "google-chrome-150.0.7871.189"],
  "device_profiles": ["desktop-1440x900", "mobile-chromium-390x844"],
  "test_profiles": ["playwright-pricing-ui", "playwright-usage-meter-ui", "axe-core-4.12.1"],
  "provision": {"commands":["pnpm --dir apps/web-console install --frozen-lockfile"]},
  "health_check": {"commands":["pnpm --dir apps/web-console check", "python3 scripts/batch32/validate_ui_ir.py client-packs/elmos-web-console-account-usage/ui-ir/model.json"]},
  "security": {"tenant_context":"verified-session-or-development-only-explicit-headers", "cache":"private-no-store", "unknown_authorization":"deny"},
  "lifecycle": {"support_until":"2027-08-06", "upgrade_policy":"exact dependency, API schema and identity tuple recertification required"}
}
