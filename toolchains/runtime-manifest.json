      "required_by": ["core-reactor", "project-synthesis", "polyglot-routes", "kotlin"],
      "probes": [
        {"id": "java", "expected": "OpenJDK 21.0.11", "pattern": "version \\\"21\\.0\\.11"},
        {"id": "javac", "expected": "javac 21.0.11", "pattern": "^javac 21\\.0\\.11$"}
