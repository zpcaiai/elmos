{
  "$schema": "../schemas/toolchains/runtime-manifest.schema.json",
  "schema_version": "1.0.0",
  "manifest_id": "elmos-language-runtime-matrix-v1",
  "description": "Task-scoped runtime matrix for the ELMOS repository, Project Synthesis, polyglot routes, frontend-native work, and specialized Language Packs.",
  "toolchain_root_env": "ELMOS_PROJECT_SYNTHESIS_TOOLCHAIN_ROOT",
  "default_toolchain_root": "~/.local/share/elmos/toolchains",
  "claim_boundary": {
    "maximum_local_state": "TOOLCHAIN_READY",
    "external_evidence_status": "NOT_RUN",
    "certification_status": "NOT_CERTIFIED",
    "limitations": [
      "A matching version probe proves only local tool availability; it does not prove a build, startup, behavior equivalence, deployment, device run, or certification.",
      "Vendor, licensed, remote-system, physical-device, and safety runtimes require an exact selected target profile and remain NOT_RUN until real authorized execution occurs.",
      "Multiple versions are intentional. Commands must select the profile-specific runtime instead of relying on one ambient global PATH."
    ]
  },
  "profiles": {
    "core": {
      "description": "Default repository build and test languages.",
      "required": [
        "java-21",
        "maven-3.9.10",
        "python-3.14.6",
        "uv-0.11.16",
        "dotnet-sdk-10.0.301",
        "node-26.0.0",
        "pnpm-10.12.4"
      ],
      "optional": [
        "container-cli"
      ]
    },
    "synthesis": {
      "description": "All eight bundled Project Synthesis emitters and the PostgreSQL production-profile harness.",
      "required": [
        "java-21",
        "maven-3.9.10",
        "python-3.12.12",
        "uv-0.11.16",
        "dotnet-sdk-10.0.301",
        "node-26.0.0",
        "pnpm-10.12.4",
        "go-1.25.0",
        "kotlin-2.2.20",
        "php-8.4.12",
        "rust-1.89.0",
        "postgresql-17.5"
      ],
      "optional": []
    },
    "routes-macos": {
      "description": "Exact thirteen-identity polyglot-route host profile. React is bound to the locked Node/TypeScript/React package tuple and Flutter to its bundled Dart SDK; deprecated JavaScript evidence is retained outside this active profile.",
      "platforms": [
        "darwin-arm64"
      ],
      "required": [
        "java-21",
        "python-3.12.12",
        "dotnet-sdk-10.0.301",
        "node-26.0.0",
        "typescript-5.9.2",
        "go-1.25.0",
        "rust-1.89.0",
        "apple-clang-21",
        "objective-c-apple",
        "swift-6.3.3",
        "php-route-8.5.9",
        "kotlin-route-2.2.20",
        "react-19.2.7",
        "flutter-3.44.1"
      ],
      "optional": []
    },
    "b66-80": {
      "description": "Governed polyglot capability catalog. Tools are optional until an exact Batch Skill and target profile are selected.",
      "required": [],
      "optional": [
        "java-21",
        "python-3.12.12",
        "dotnet-sdk-10.0.301",
        "node-26.0.0",
        "pnpm-10.12.4",
        "typescript-5.9.2",
        "go-1.25.0",
        "kotlin-2.2.20",
        "php-8.4.12",
        "apple-clang-21",
        "rust-1.89.0",
        "flutter-3.44.1",
        "swift-6.3.3",
        "posix-shells",
        "powershell",
        "postgresql-17.5",
        "cmake-ninja",
        "container-cli",
        "iac-kubernetes-cli",
        "ci-provider-runtimes"
      ]
    },
    "spring-legacy": {
      "description": "Directional Spring source tuples. JDK and Maven versions are isolated in approved containers rather than flattened onto host PATH.",
      "required": [],
      "optional": [
        "spring-jdk-matrix",
        "maven-3.9.11"
      ]
    },
    "frontend-native": {
      "description": "Flutter, Apple, Android, and HarmonyOS execution surfaces selected per journey and device profile.",
      "required": [],
      "optional": [
        "flutter-3.44.1",
        "swift-6.3.3",
        "android-sdk",
        "harmonyos-sdk"
      ]
    },
    "language-packs": {
      "description": "Batch 81-95 specialized runtimes. Every entry remains target-profile-specific and fail-closed.",
      "required": [],
      "optional": [
        "mainframe-runtime",
        "sap-abap-runtime",
        "database-procedural-runtimes",
        "plc-runtime",
        "matlab-simulink-runtime",
        "modelica-fmi-runtime",
        "vb-office-runtime",
        "ibmi-rpg-runtime",
        "r-runtime",
        "sas-runtime",
        "salesforce-runtime",
        "objective-c-apple",
        "swift-6.3.3",
        "delphi-runtime",
        "beam-runtime",
        "lua-openresty-runtime"
      ]
    },
    "all": {
      "description": "All active local language runtimes plus visible optional and external boundaries.",
      "required": [
        "java-21",
        "maven-3.9.10",
        "python-3.14.6",
        "python-3.12.12",
        "uv-0.11.16",
        "dotnet-sdk-10.0.301",
        "node-26.0.0",
        "pnpm-10.12.4",
        "typescript-5.9.2",
        "go-1.25.0",
        "kotlin-2.2.20",
        "php-8.4.12",
        "rust-1.89.0",
        "postgresql-17.5",
        "apple-clang-21",
        "objective-c-apple",
        "swift-6.3.3",
        "php-route-8.5.9",
        "kotlin-route-2.2.20",
        "react-19.2.7",
        "flutter-3.44.1"
      ],
      "optional": [
        "posix-shells",
        "powershell",
        "cmake-ninja",
        "container-cli",
        "iac-kubernetes-cli",
        "spring-jdk-matrix",
        "maven-3.9.11",
        "android-sdk",
        "harmonyos-sdk",
        "mainframe-runtime",
        "sap-abap-runtime",
        "database-procedural-runtimes",
        "plc-runtime",
        "matlab-simulink-runtime",
        "modelica-fmi-runtime",
        "vb-office-runtime",
        "ibmi-rpg-runtime",
        "r-runtime",
        "sas-runtime",
        "salesforce-runtime",
        "delphi-runtime",
        "beam-runtime",
        "lua-openresty-runtime",
        "ci-provider-runtimes"
      ]
    }
  },
  "runtimes": [
