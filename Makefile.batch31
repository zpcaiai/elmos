UV ?= uv
BATCH31_PYTHON ?= $(UV) run --quiet --with jsonschema --with pyyaml python
.PHONY: b31-skills-test b31-pack-validate b31-pack-gate b31-ir-validate b31-all-packs-check b31-release-gate b31-manual-review-backlog
b31-skills-test:
	$(BATCH31_PYTHON) scripts/batch31/validate_skill_bundle.py
	$(BATCH31_PYTHON) scripts/batch31/validate_sql_line_launch_scope.py docs/batch31/sql-line-launch-scope.json
	$(BATCH31_PYTHON) -m unittest discover -s tests/batch31 -p 'test_*.py'
	$(UV) run --quiet --with ruff ruff check scripts/batch31 tests/batch31
	$(UV) run --quiet --with ruff ruff format --check scripts/batch31 tests/batch31
b31-pack-validate:
	@test -n "$(PACK)" || (echo "PACK=<database-pack-key> required" && exit 2)
	$(BATCH31_PYTHON) scripts/batch31/validate_database_pack.py database-packs/$(PACK)
b31-ir-validate:
	@test -n "$(PACK)" || (echo "PACK=<database-pack-key> required" && exit 2)
	$(BATCH31_PYTHON) scripts/batch31/validate_canonical_ir.py database-packs/$(PACK)/canonical-ir/model.json
b31-pack-gate:
	@test -n "$(PACK)" || (echo "PACK=<database-pack-key> required" && exit 2)
	$(BATCH31_PYTHON) scripts/batch31/run_database_gate.py database-packs/$(PACK)
b31-all-packs-check:
	@set -eu; for pack in database-packs/*; do \
		test -f "$$pack/pack.json" || continue; \
		$(BATCH31_PYTHON) scripts/batch31/validate_database_pack.py "$$pack"; \
		$(BATCH31_PYTHON) scripts/batch31/validate_canonical_ir.py "$$pack/canonical-ir/model.json"; \
		$(BATCH31_PYTHON) scripts/batch31/run_database_gate.py "$$pack"; \
	done
b31-release-gate:
	@test -n "$(PACK)" || (echo "PACK=<database-pack-key> required" && exit 2)
	$(BATCH31_PYTHON) scripts/batch31/run_database_gate.py --require-release-ready database-packs/$(PACK)
b31-manual-review-backlog:
	@test -n "$(SCAN_REPORT)" || (echo "SCAN_REPORT=<feasibility-report.json> required" && exit 2)
	@test -n "$(OUTPUT)" || (echo "OUTPUT=<manual-review-backlog.json> required" && exit 2)
	$(BATCH31_PYTHON) scripts/batch31/build_manual_review_backlog.py "$(SCAN_REPORT)" --output "$(OUTPUT)"
