{
  "schema_version": 1,
  "profile_key": "spring-boot-2-x-gradle-to-3-5-3-target",
  "version": "0.1.0",
  "owner": "ELMOS Java Modernization Team",
  "framework": "spring-boot",
  "framework_versions": [
    "3.5.3"
  ],
  "runtime": "java",
  "runtime_versions": [
    "21"
  ],
  "architecture_style": "modular-monolith-compatible-spring-boot-application",
  "providers": {
    "serializer": {
      "provider": "jackson",
      "version": "2.19.1"
    },
    "dependency_injection": {
      "provider": "spring-framework",
      "version": "6.2.8"
    },
    "validation": {
      "provider": "hibernate-validator",
      "version": "8.0.2.Final",
      "namespace": "jakarta.validation",
      "api_version": "3.0.2"
    },
    "authentication": {
      "strategy": "preserve-and-independently-verify",
      "automatic_support": false
    },
    "authorization": {
      "strategy": "preserve-and-independently-verify",
      "automatic_support": false
    },
    "persistence": {
      "strategy": "preserve-and-independently-verify",
      "automatic_support": false
    },
    "messaging": {
      "strategy": "detect-and-block-without-provider-profile"
    },
    "cache": {
      "strategy": "detect-and-block-without-provider-profile"
    },
    "scheduler": {
      "strategy": "preserve-and-replay"
    },
    "observability": {
      "provider": "spring-boot-actuator",
      "health_path": "/actuator/health"
    }
  },
  "build": {
    "commands": [
      "gradle test",
      "gradle check",
      "gradle build -x test"
    ],
    "toolchain_digests": [
      "gradle:8.14.3-eclipse-temurin-21@sha256:7fdc855a6ed81d288ca7ca37ac6ff5e9308b612485c0801d70b25a858c83d238"
    ]
  },
  "startup": {
    "command": "java -jar build/libs/<verified-boot-artifact>.jar",
    "health_check": "GET http://127.0.0.1:<ephemeral-port>/actuator/health"
  }
}
